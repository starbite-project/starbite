+	bool underUs(IORegistryEntry *e) const;
+
+	static IOReturn gatedSubmit(OSObject *owner, void *a0, void *a1, void *a2, void *a3);
+	static IOReturn gatedSync(OSObject *owner, void *a0, void *a1, void *a2, void *a3);
