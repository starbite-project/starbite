+static void
+setNum(IOService *s, const char *key, uint64_t v, unsigned bits)
+{
+	OSNumber *n = OSNumber::withNumber(v, bits);
+	if (n != NULL) {
+		s->setProperty(key, n);
+		n->release();
+	}
