+IOReturn
+StarbiteUFSRange::doUnmap(IOBlockStorageDeviceExtent *extents, UInt32 extentsCount, IOStorageUnmapOptions options)
+{
+	(void)extents;
+	(void)extentsCount;
+	(void)options;
