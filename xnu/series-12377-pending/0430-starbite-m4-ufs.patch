+	void putXfer(StarbiteUFSXfer *x);
+	IOReturn submitGated(StarbiteUFSXfer *x);
+	void pump(void);
+	bool startChunk(StarbiteUFSXfer *x);
+	void chunkDone(StarbiteUFSXfer *x, unsigned slot, const struct sbufs_result *r);
