+/*
+ * 0468: a finger that rests for 550 ms without moving (40 panel px from where it landed, one finger only, not the
+ * touch after a tap, which is the drag) is a right click where the pointer is: the context menu, as a long press is
+ * everywhere else on a phone. The click is sent when the time is up, with the finger still down; lifting does
+ * nothing more, and moving the finger afterwards moves the pointer into the menu. Boot-arg sweetpadhold=MS changes
+ * the time, sweetpadhold=0 turns it off. The two-finger tap stays a right click too.
+ */
+static int
+sweet_pad_hold_ms(void)
+{
+	static int ms = -1;
+	if (ms < 0) {
+		ms = 550;
+		PE_parse_boot_argn("sweetpadhold", &ms, sizeof(ms));
+		if (ms < 0 || ms > 5000) {
+			ms = 550;
+		}
+	}
+	return ms;
+}
