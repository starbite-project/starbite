+enum {
+    kIONetworkTransmitStatusSuccess     = 0,
+    kIONetworkTransmitStatusFailed      = 1,
+    kIONetworkTransmitStatusAborted     = 2,
+    kIONetworkTransmitStatusQueueFull   = 3
+};
