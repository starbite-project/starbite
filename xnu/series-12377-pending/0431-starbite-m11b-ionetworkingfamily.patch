+//---------------------------------------------------------------------------
+// 'C' function glue to dispatch the IONetworkData notification.
+
+IOReturn
+IOBasicOutputQueue::dispatchNetworkDataNotification(void *          target,
+                                                    void *          param,
+                                                    IONetworkData * data,
