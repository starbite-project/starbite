+    @result Returns a BSD return value defined in <code>bsd/sys/errno.h</code>.
+*/
+    virtual SInt32   performCommand(
+                                IONetworkController * controller,
+                                unsigned long         cmd,
+                                void *                arg0,
+                                void *                arg1 );
+
+public:
+
+/*! @function getIfnet
