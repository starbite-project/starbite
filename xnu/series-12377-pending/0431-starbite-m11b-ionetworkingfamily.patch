+UInt32 IOBasicOutputQueue::getSize() const
+{
+    UInt32 total = 0;
+    for(UInt32 i = 0; i < _priorities; i++)
+    {
+        total += IOMbufQueueGetSize(&(_primaryQueues[i]));
+    }
+    return total;
+}
