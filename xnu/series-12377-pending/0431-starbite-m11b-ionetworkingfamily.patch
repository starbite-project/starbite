+        if (m->m_flags & MBUF_PKTHDR)
+            IOLog("m_pkthdr.len  : %d\n", (UInt) m->m_pkthdr.len);
+
+        if (m->m_flags & MBUF_EXT) {
+            IOLog("m_ext.ext_buf : %08x\n", (UInt) m->m_ext.ext_buf);
+            IOLog("m_ext.ext_size: %d\n", (UInt) m->m_ext.ext_size);
+        }
+        
+        m = m->m_next;
+    }
+    IOLog("\n");
+}
