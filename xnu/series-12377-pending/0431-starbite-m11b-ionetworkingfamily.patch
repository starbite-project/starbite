+                            mbuf_t *            packetHead,
+                            mbuf_t *            packetTail  = 0,
+                            uint32_t *          packetCount = 0,
+                            uint64_t *          packetBytes = 0 );
+
+    OSMetaClassDeclareReservedUsed(IONetworkInterface, 8);
+
+/*! @function dequeueOutputPacketsWithServiceClass
