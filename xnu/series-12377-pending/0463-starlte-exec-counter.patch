 /*
+ * 0463: which programs are started, and how often. S6f 2026-11-16 (macOS idle, nobody touching it): the pid
+ * counter rises by 45-75 a minute and launchd uses 14 % of a core handling it, but the log names only the few
+ * that crash. Every exec is counted by name (kern_exec.c set_proc_name); with STARLTE TOP every 10 s:
+ * "STARLTE EXEC (10 s): 9 started: voicebankingd x3 NotificationCenter x1 ...". Nothing is printed for a
+ * window without starts.
+ */
+#define ST_EXEC_NAMES 40
+static struct { char name[17]; uint32_t n; } st_exec[ST_EXEC_NAMES];
+static uint32_t st_exec_other;
+static LCK_GRP_DECLARE(st_exec_grp, "starlte-exec");
+static LCK_MTX_DECLARE(st_exec_lock, &st_exec_grp);
+
+void starlte_exec_note(const char *name);
+void
+starlte_exec_note(const char *name)
+{
+	lck_mtx_lock(&st_exec_lock);
+	int free = -1, i;
+	for (i = 0; i < ST_EXEC_NAMES; i++) {
+		if (st_exec[i].n == 0) {
+			free = free < 0 ? i : free;
+		} else if (strncmp(st_exec[i].name, name, sizeof(st_exec[i].name) - 1) == 0) {
+			st_exec[i].n++;
+			break;
+		}
+	}
+	if (i == ST_EXEC_NAMES) {
+		if (free >= 0) {
+			strlcpy(st_exec[free].name, name, sizeof(st_exec[free].name));
+			st_exec[free].n = 1;
+		} else {
+			st_exec_other++;
+		}
+	}
+	lck_mtx_unlock(&st_exec_lock);
+}
+
+static void
+st_top_exec(uint64_t window_ns)
+{
+	char line[512];
+	uint32_t total = 0;
+	lck_mtx_lock(&st_exec_lock);
+	for (int i = 0; i < ST_EXEC_NAMES; i++) {
+		total += st_exec[i].n;
+	}
+	total += st_exec_other;
+	if (total == 0) {
+		lck_mtx_unlock(&st_exec_lock);
+		return;
+	}
+	int n = snprintf(line, sizeof(line), "STARLTE EXEC (%llu s): %u started:", window_ns / NSEC_PER_SEC, total);
+	for (int k = 0; k < ST_EXEC_NAMES && n < (int)sizeof(line) - 28; k++) {
+		int best = -1;
+		for (int i = 0; i < ST_EXEC_NAMES; i++) {
+			if (st_exec[i].n != 0 && (best < 0 || st_exec[i].n > st_exec[best].n)) {
+				best = i;
+			}
+		}
+		if (best < 0) {
+			break;
+		}
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " %s x%u", st_exec[best].name, st_exec[best].n);
+		st_exec[best].n = 0;
+	}
+	if (st_exec_other != 0) {
+		snprintf(line + n, sizeof(line) - (size_t)n, " others x%u", st_exec_other);
+	}
+	bzero(st_exec, sizeof(st_exec));
+	st_exec_other = 0;
+	lck_mtx_unlock(&st_exec_lock);
+	printf("%s\n", line);
+}
+
