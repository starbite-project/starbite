From e01b854426f43ae9c0deaeaab8b01710cd979e83 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Thu, 12 Nov 2026 15:06:43 +0200
Subject: [PATCH] patch: 0439-a5xelte-iokit-trace.patch - the SWEET IOKit trace
 (boot-arg sweetiolog=NAMES: matching with result counts, registry path
 lookups, user-client opens; 400 lines a boot) on A5XELTE boards too, to see
 macOS Metal's own device discovery in WindowServer (S2g 2026-11-12: the
 StarbiteMetal bundle never loaded, WindowServer aborted in
 WSSystemCanCompositeWithMetal)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 iokit/Kernel/IOUserClient.cpp | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/iokit/Kernel/IOUserClient.cpp b/iokit/Kernel/IOUserClient.cpp
index 504a9dfe..58b74a7c 100644
--- a/iokit/Kernel/IOUserClient.cpp
+++ b/iokit/Kernel/IOUserClient.cpp
@@ -2729,12 +2729,13 @@ is_io_service_match_property_table_bin(
 }
 
 static 
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 /*
  * SWEET IOKit trace: registry and matching calls made by the processes
  * named in boot-arg sweetiolog (comma separated, default "backboardd,SpringBoard";
  * "-" turns it off) are printed as "IOK name: ...", at most 400 lines per
  * boot, to find out what a daemon looks for before it gives up.
+ * 0439: also on A5XELTE boards (STARLTE: macOS WindowServer's Metal discovery, sweetiolog=WindowServer).
  */
 static char sweet_iolog_names[128];
 static int sweet_iolog_parsed;
@@ -2804,7 +2805,7 @@ internal_io_service_get_matching_services(
 	if ((dict = OSDynamicCast( OSDictionary, obj))) {
 		IOTaskRegistryCompatibilityMatching(current_task(), dict);
 		OSIterator *found = IOService::getMatchingServices( dict );
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 		char sname[32];
 		if (sweet_iolog(sname, sizeof(sname))) {
 			unsigned int count = 0;
@@ -2904,7 +2905,7 @@ internal_io_service_get_matching_service(
 		IOTaskRegistryCompatibilityMatching(current_task(), dict);
 		*service = IOService::copyMatchingService( dict );
 		kr = *service ? kIOReturnSuccess : kIOReturnNotFound;
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 		char sname[32];
 		if (sweet_iolog(sname, sizeof(sname))) {
 			sweet_iolog_dict(sname, "matching1", dict,
@@ -3014,7 +3015,7 @@ internal_io_service_add_notification(
 			continue;
 		}
 		IOTaskRegistryCompatibilityMatching(current_task(), dict);
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 		{
 			char sname[32];
 			if (sweet_iolog(sname, sizeof(sname))) {
@@ -3503,7 +3504,7 @@ is_io_registry_entry_from_path(
 	}
 
 	entry = IORegistryEntry::fromPath( path );
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 	{
 		char sname[32];
 		if (sweet_iolog(sname, sizeof(sname))) {
@@ -4321,7 +4322,7 @@ is_io_registry_entry_get_child_iterator(
 
 	*iterator = IOUserIterator::withIterator(entry->getChildIterator(
 		    IORegistryEntry::getPlane( plane )));
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 	{
 		char sname[32];
 		if (sweet_iolog(sname, sizeof(sname))) {
@@ -4544,7 +4545,7 @@ is_io_service_open_extended(
 #endif
 		res = service->newUserClient( owningTask, (void *) owningTask,
 		    connect_type, propertiesDict, &client );
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 		{
 			char sname[32];
 			if (sweet_iolog(sname, sizeof(sname))) {
