diff --git a/bsd/dev/starlte_m11b.c b/bsd/dev/starlte_m11b.c
new file mode 100644
index 00000000..afe5bd68
--- /dev/null
+++ b/bsd/dev/starlte_m11b.c
@@ -0,0 +1,168 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * 0432, M11b (docs/APPLE-S9-DRIVERS.md M11, StarbiteUSB/PHONE-TEST.md): the BSD half of the sbstop=ncm test. With no
+ * user space, nobody names or configures StarbiteUSBNCM's interface; iokit/Kernel/arm/starbite/StarbiteM11b.cpp
+ * names it through IONetworkStack (as IOKitBSDInit does for a network root) and then calls this file, which does
+ * what configd would: interface up (SIOCSIFFLAGS), IPv6 attached (SIOCPROTOATTACH_IN6) and the EUI-64 link-local
+ * address started (SIOCLL_START, with DAD), all through ifioctl() on kernel sockets, the path netboot.c uses. The
+ * ping answers then come from XNU's own IPv6 stack (no echo responder: sbusb_echo stays 0). The counters below are
+ * XNU's ICMPv6 histograms; only this one interface (plus lo0, which nobody pings) exists in an sbstop boot.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/socket.h>
+#include <sys/socketvar.h>
+#include <sys/sockio.h>
+#include <net/if.h>
+#include <net/if_var.h>
+#include <net/if_var_private.h>
+#include <net/init.h>
+#include <net/kpi_interface.h>
+#include <netinet/in.h>
+#include <netinet/ip6.h>
+#include <netinet/icmp6.h>
+#include <netinet6/in6_var.h>
+#include <libkern/libkern.h>
+
+int starlte_m11b_net_ready(void);
+int starlte_m11b_ifup(const char *name);
+void starlte_m11b_counts(uint64_t *echo_in, uint64_t *reply_out, uint64_t *ns_in, uint64_t *na_out);
+void starlte_m11b_ifstats(uint64_t *ipackets, uint64_t *opackets, uint64_t *ierrors, uint64_t *oerrors);
+int starlte_m11b_lladdr(char *buf, size_t len);
+
+static volatile int m11b_net_inited;
+static int m11b_net_asked;
+static ifnet_t m11b_ifp;
+
+static void
+m11b_net_init_done(void)
+{
+	m11b_net_inited = 1;
+}
+
+/* bsd_init publishes IOBSD (IONetworkStack starts) before net_init_run(): wait for the delayed IPv6 init too */
+int
+starlte_m11b_net_ready(void)
+{
+	if (!m11b_net_asked) {
+		m11b_net_asked = 1;
+		if (net_init_add(m11b_net_init_done) == EALREADY) {
+			m11b_net_inited = 1;
+		}
+	}
+	return m11b_net_inited;
+}
+
+static int
+m11b_ioctl(int family, u_long cmd, void *data, size_t len, const char *what)
+{
+	struct socket *so = NULL;
+	int error = socreate(family, &so, SOCK_DGRAM, 0);
+
+	if (error != 0) {
+		printf("StarbiteM11b: socreate(%d) for %s: error %d\n", family, what, error);
+		return error;
+	}
+	(void)len;
+	error = ifioctl(so, cmd, (caddr_t)data, current_proc());
+	if (error != 0) {
+		printf("StarbiteM11b: %s: error %d\n", what, error);
+	}
+	soclose(so);
+	return error;
+}
+
+int
+starlte_m11b_ifup(const char *name)
+{
+	struct ifreq ifr;
+	struct in6_aliasreq_64 ifra;
+	ifnet_t ifp = NULL;
+	int error;
+
+	error = ifnet_find_by_name(name, &ifp);
+	if (error != 0 || ifp == NULL) {
+		printf("StarbiteM11b: %s: no such interface (%d)\n", name, error);
+		return error ? error : ENXIO;
+	}
+	m11b_ifp = ifp;                         /* kept (retained) for the counters until the stop */
+
+	bzero(&ifr, sizeof(ifr));
+	strlcpy(ifr.ifr_name, name, sizeof(ifr.ifr_name));
+	ifr.ifr_flags = (short)(ifnet_flags(ifp) | IFF_UP);
+	error = m11b_ioctl(AF_INET, SIOCSIFFLAGS, &ifr, sizeof(ifr), "SIOCSIFFLAGS IFF_UP");
+	if (error != 0) {
+		return error;
+	}
+	bzero(&ifra, sizeof(ifra));
+	strlcpy(ifra.ifra_name, name, sizeof(ifra.ifra_name));
+	error = m11b_ioctl(AF_INET6, SIOCPROTOATTACH_IN6_64, &ifra, sizeof(ifra), "SIOCPROTOATTACH_IN6");
+	if (error != 0 && error != EEXIST) {
+		return error;
+	}
+	bzero(&ifra, sizeof(ifra));             /* no address given: the EUI-64 link-local of the interface's MAC */
+	strlcpy(ifra.ifra_name, name, sizeof(ifra.ifra_name));
+	error = m11b_ioctl(AF_INET6, SIOCLL_START_64, &ifra, sizeof(ifra), "SIOCLL_START");
+	if (error != 0) {
+		return error;
+	}
+	printf("StarbiteM11b: %s up (flags 0x%x), IPv6 attached, link-local started (DAD running)\n", name,
+	    (unsigned)ifnet_flags(ifp));
+	return 0;
+}
+
+/* the first IPv6 address of the interface (its link-local), printable; 0 if there is one */
+int
+starlte_m11b_lladdr(char *buf, size_t len)
+{
+	ifaddr_t *addrs = NULL;
+	int found = 0;
+
+	buf[0] = '\0';
+	if (m11b_ifp == NULL || ifnet_get_address_list_family(m11b_ifp, &addrs, AF_INET6) != 0 || addrs == NULL) {
+		return ENOENT;
+	}
+	for (int i = 0; addrs[i] != NULL && !found; i++) {
+		struct sockaddr_in6 sin6;
+		if (ifaddr_address(addrs[i], (struct sockaddr *)&sin6, sizeof(sin6)) != 0 || sin6.sin6_family != AF_INET6) {
+			continue;
+		}
+		if (IN6_IS_ADDR_LINKLOCAL(&sin6.sin6_addr)) {
+			sin6.sin6_addr.s6_addr16[1] = 0;        /* embedded scope */
+		}
+		(void)inet_ntop(AF_INET6, &sin6.sin6_addr, buf, (socklen_t)len);
+		found = 1;
+	}
+	ifnet_free_address_list(addrs);
+	return found ? 0 : ENOENT;
+}
+
+void
+starlte_m11b_counts(uint64_t *echo_in, uint64_t *reply_out, uint64_t *ns_in, uint64_t *na_out)
+{
+	*echo_in = icmp6stat.icp6s_inhist[ICMP6_ECHO_REQUEST];
+	*reply_out = icmp6stat.icp6s_outhist[ICMP6_ECHO_REPLY];
+	*ns_in = icmp6stat.icp6s_inhist[ND_NEIGHBOR_SOLICIT];
+	*na_out = icmp6stat.icp6s_outhist[ND_NEIGHBOR_ADVERT];
+}
+
+void
+starlte_m11b_ifstats(uint64_t *ipackets, uint64_t *opackets, uint64_t *ierrors, uint64_t *oerrors)
+{
+	struct ifnet_stats_param st;
+
+	bzero(&st, sizeof(st));
+	if (m11b_ifp != NULL) {
+		(void)ifnet_stat(m11b_ifp, &st);
+	}
+	*ipackets = st.packets_in;
+	*opackets = st.packets_out;
+	*ierrors = st.errors_in;
+	*oerrors = st.errors_out;
+}
+#endif /* ARM64_BOARD_CONFIG_STARLTE */
