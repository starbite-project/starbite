@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * Build unit for a Starbite S9 platform driver (docs/APPLE-S9-DRIVERS.md), STARLTE only. The driver source under
+ * StarbiteUSB/ is a verbatim copy of the main repository's starbite/apple-drivers/StarbiteUSB/
+ * (commit 0d957fd); edit it there and copy it here again. Other boards get an empty translation unit.
+ */
+/*
+ * __PRIVATE_SPI__ as for IONetworkingFamily itself (0431): the family is built with it, so IONetworkController's
+ * vtable slots 2-5 are real methods there, not _RESERVED placeholders; a client built without it would reference
+ * placeholders that do not exist. The public and private views have the same slots.
+ */
+#define __PRIVATE_SPI__ 1
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+#include "StarbiteUSB/StarbiteUSBNCM.cpp"
+#endif
