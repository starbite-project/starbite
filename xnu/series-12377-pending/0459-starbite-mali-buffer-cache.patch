+
+/*
+ * 0459: buffers of ours are recycled. S5a 2026-11-15 (macOS at 2x): WindowServer creates and closes a full-screen
+ * 34 MB render target for almost every frame ("STARLTE GPU BIG: WindowServer create 34099200 bytes"), and here a
+ * create took 43 ms and a close 98 ms on average ("STARLTE GPU CALLS": 36 s + 122 s of a 300 s session, against
+ * 9.7 s of GPU jobs): wired write-combined memory is allocated, flushed, zeroed and mapped, and on close every
+ * page's cache attribute is put back and the GPU's address space flushed. That, not the GPU, was the slow macOS.
+ *
+ * A closed buffer now goes to a small cache as it is: its memory (still write-combined) and its GPU address and
+ * mapping. A worker thread zeroes it there, off the caller's time. A create of exactly that size takes it (zeroing
+ * it itself if the worker has not yet): no allocation, no attribute change, no GPU map. Buffers always come
+ * out zeroed, as before, so the cache is shared by all clients. Buffers not reused within 3 s, and the oldest
+ * ones when the cache holds more than sbmcache MiB (boot-arg, default 160, 0 = off), are freed by the worker
+ * the old way. "STARLTE GPU CALLS" ends with the cache's numbers.
+ */
+#define SBM_CACHE_SLOTS 48
+enum { SBM_C_FREE = 0, SBM_C_DIRTY, SBM_C_BUSY, SBM_C_READY, SBM_C_EVICT };
+static struct {
+	IOBufferMemoryDescriptor *mem;
+	uint64_t va;
+	uint32_t pages;                 /* 4 KiB pages */
+	uint32_t state;
+	uint64_t stamp;                 /* mach time it was closed */
+} sbm_cache[SBM_CACHE_SLOTS];
+static IOLock *sbm_cache_lock;
+static uint64_t sbm_cache_pages;        /* held and reusable: dirty, being zeroed, ready */
+static uint64_t sbm_cache_limit;        /* pages; 0 = no cache */
+static uint64_t sbm_cache_hits, sbm_cache_hits_dirty, sbm_cache_misses, sbm_cache_evicted, sbm_cache_full;
+
+/* the end of a buffer of ours: out of the GPU's address space, its pages' cache attribute back, released */
+static void
+sbm_free_buffer(IOMemoryDescriptor *mem, uint64_t va, uint32_t pages)
+{
+	starlte_gpu_user_unmap(va, pages);
+	sbm_va_free(va, (uint64_t)pages * 0x1000);
+	/*
+	 * A buffer of ours was write-combined: its pages keep that attribute when freed
+	 * (kernel-object pages are not reset by vm_page_free), and came back as Normal-NC
+	 * heap in some task, where atomics take an external abort. Default them first.
+	 */
+	IOByteCount length = mem->getLength();
+	for (IOByteCount offset = 0; offset < length; offset += PAGE_SIZE) {
+		IOByteCount len = 0;
+		addr64_t pa = mem->getPhysicalSegment(offset, &len, kIOMemoryMapperNone);
+		if (pa != 0) {
+			pmap_set_cache_attributes((ppnum_t)atop_64(pa), 0);
+		}
+	}
+	mem->release();
+}
+
+/* a closed buffer into the cache; false: no room, the caller frees it */
+static bool
+sbm_cache_put(IOMemoryDescriptor *mem, uint64_t va, uint32_t pages)
+{
+	IOBufferMemoryDescriptor *buf = OSDynamicCast(IOBufferMemoryDescriptor, mem);
+	if (sbm_cache_lock == NULL || sbm_cache_limit == 0 || buf == NULL || pages <= 16 || pages > sbm_cache_limit) {      /* (not the many 64 KiB pool pieces) */
+		return false;
+	}
+	IOLockLock(sbm_cache_lock);
+	int slot = -1;
+	for (int i = 0; i < SBM_CACHE_SLOTS; i++) {
+		if (sbm_cache[i].state == SBM_C_FREE) {
+			slot = i;
+			break;
+		}
 	}
+	if (slot < 0) {
+		sbm_cache_full++;
+		IOLockUnlock(sbm_cache_lock);
+		return false;
+	}
+	sbm_cache[slot].mem = buf;
+	sbm_cache[slot].va = va;
+	sbm_cache[slot].pages = pages;
+	sbm_cache[slot].stamp = mach_absolute_time();
+	sbm_cache[slot].state = SBM_C_DIRTY;
+	sbm_cache_pages += pages;
+	/* over the limit: the oldest others go (the worker frees them) */
+	while (sbm_cache_pages > sbm_cache_limit) {
+		int oldest = -1;
+		for (int i = 0; i < SBM_CACHE_SLOTS; i++) {
+			if (i != slot && (sbm_cache[i].state == SBM_C_DIRTY || sbm_cache[i].state == SBM_C_READY) &&
+			    (oldest < 0 || sbm_cache[i].stamp < sbm_cache[oldest].stamp)) {
+				oldest = i;
+			}
+		}
+		if (oldest < 0) {
+			break;
+		}
+		sbm_cache[oldest].state = SBM_C_EVICT;
+		sbm_cache_pages -= sbm_cache[oldest].pages;
+	}
+	IOLockWakeup(sbm_cache_lock, &sbm_cache, false);
+	IOLockUnlock(sbm_cache_lock);
+	return true;
 }
 
+/* a cached buffer of exactly pages 4 KiB pages; *zeroed: the worker has zeroed it already */
+static bool
+sbm_cache_get(uint32_t pages, IOBufferMemoryDescriptor **mem, uint64_t *va, bool *zeroed)
+{
+	if (sbm_cache_lock == NULL || sbm_cache_limit == 0) {
+		return false;
+	}
+	IOLockLock(sbm_cache_lock);
+	int best = -1;
+	for (int i = 0; i < SBM_CACHE_SLOTS; i++) {
+		if (sbm_cache[i].pages != pages) {
+			continue;
+		}
+		if (sbm_cache[i].state == SBM_C_READY) {
+			best = i;
+			break;
+		}
+		if (sbm_cache[i].state == SBM_C_DIRTY && best < 0) {
+			best = i;
+		}
+	}
+	if (best < 0) {
+		sbm_cache_misses++;
+		IOLockUnlock(sbm_cache_lock);
+		return false;
+	}
+	*zeroed = sbm_cache[best].state == SBM_C_READY;
+	*mem = sbm_cache[best].mem;
+	*va = sbm_cache[best].va;
+	sbm_cache_pages -= pages;
+	sbm_cache_hits++;
+	sbm_cache_hits_dirty += !*zeroed;
+	bzero(&sbm_cache[best], sizeof(sbm_cache[best]));
+	IOLockUnlock(sbm_cache_lock);
+	return true;
+}
+
+/* the worker: frees what is to go, zeroes what waits */
+static void
+sbm_cache_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t max_age = 0, second = 0;
+	nanoseconds_to_absolutetime(3ull * NSEC_PER_SEC, &max_age);
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &second);
+	IOLockLock(sbm_cache_lock);
+	for (;;) {
+		uint64_t now = mach_absolute_time();
+		int pick = -1;
+		bool evict = false, any = false;
+		for (int i = 0; i < SBM_CACHE_SLOTS && pick < 0; i++) {
+			uint32_t st = sbm_cache[i].state;
+			if (st == SBM_C_EVICT) {
+				pick = i;
+				evict = true;
+			} else if ((st == SBM_C_DIRTY || st == SBM_C_READY) && now - sbm_cache[i].stamp > max_age) {
+				sbm_cache_pages -= sbm_cache[i].pages;
+				pick = i;
+				evict = true;
+			}
+			any = any || st != SBM_C_FREE;
+		}
+		for (int i = 0; i < SBM_CACHE_SLOTS && pick < 0; i++) {
+			if (sbm_cache[i].state == SBM_C_DIRTY) {
+				pick = i;
+			}
+		}
+		if (pick < 0) {
+			if (any) {
+				AbsoluteTime deadline;
+				deadline = now + second;
+				(void)IOLockSleepDeadline(sbm_cache_lock, &sbm_cache, deadline, THREAD_UNINT);
+			} else {
+				(void)IOLockSleep(sbm_cache_lock, &sbm_cache, THREAD_UNINT);
+			}
+			continue;
+		}
+		IOBufferMemoryDescriptor *mem = sbm_cache[pick].mem;
+		uint64_t va = sbm_cache[pick].va;
+		uint32_t pages = sbm_cache[pick].pages;
+		sbm_cache[pick].state = SBM_C_BUSY;
+		IOLockUnlock(sbm_cache_lock);
+		if (evict) {
+			sbm_free_buffer(mem, va, pages);
+		} else {
+			bzero(mem->getBytesNoCopy(), (size_t)pages * 0x1000);
+		}
+		IOLockLock(sbm_cache_lock);
+		if (evict) {
+			bzero(&sbm_cache[pick], sizeof(sbm_cache[pick]));
+			sbm_cache_evicted++;
+		} else {
+			sbm_cache[pick].state = SBM_C_READY;
+		}
+	}
+}
