+/*
+ * 0456: the on-screen keyboard (sweet_kbd.h). Drawn straight onto the panel, over its bottom rows; while it is
+ * shown scaledCopy() leaves those rows alone (sweet_kbd.top), the pointer is not drawn there, and when it hides
