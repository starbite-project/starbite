+/*
+ * 0456: the on-screen keyboard for macOS on the phone (the touch screen is a trackpad there, and macOS has no
+ * touch keyboard). SweetHID.cpp owns the logic: touches that begin on the shown keyboard are key presses, sent as
+ * USB HID keyboard events by the SweetHIDKeyboard service; a swipe up from the panel's bottom edge shows it, its
+ * "hide" key hides it. SweetFramebuffer.cpp draws it over the bottom of the panel (the desktop under it is not
+ * drawn while it is shown). The layout and the key-cap glyphs are generated: sweet_kbd_data.h
+ * (tools/macos/kbd/mk-kbd-data.py). Boot-args: sweetkbd=0 off, sweetkbdshow=1 shown from the start.
+ */
+#ifndef SWEET_KBD_H
+#define SWEET_KBD_H
+#include <stdint.h>
+#include "sweet_kbd_data.h"
+
+struct sweet_kbd_shared {
+	volatile uint32_t enabled;      /* the keyboard exists (a macOS boot) */
+	volatile uint32_t visible;      /* wanted: shown */
+	volatile uint32_t page;         /* 0 letters, 1 numbers, 2 symbols */
+	volatile uint32_t shift;        /* 0 off, 1 next key only, 2 locked */
+	volatile uint32_t mods;         /* latched for the next key: 1 control, 2 option, 4 command */
+	volatile uint64_t pressed;      /* keys of the page held down (bit = index in the page) */
+	volatile uint64_t dirty;        /* keys to draw again */
+	volatile uint32_t full;         /* draw everything again */
+	volatile int32_t  top;          /* first panel row the keyboard covers while drawn, else INT32_MAX */
+	uint32_t panel_w, panel_h;      /* set by the framebuffer */
+};
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern struct sweet_kbd_shared sweet_kbd;
+#ifdef __cplusplus
+}
+#endif
+
+static inline int32_t
+sweet_kbd_height(uint32_t pw)
+{
+	return (int32_t)((uint64_t)SWEET_KBD_REF_H * pw / SWEET_KBD_REF_W);
+}
+
+/* a key's cell in panel pixels */
+static inline void
+sweet_kbd_cell(const struct sweet_kbd_keydef *k, uint32_t pw, uint32_t ph, int32_t *x, int32_t *y, int32_t *w, int32_t *h)
+{
+	int32_t ry = SWEET_KBD_PAD_TOP + (k->row == 0 ? 0 : SWEET_KBD_FN_H + (k->row - 1) * SWEET_KBD_ROW_H);
+	int32_t rh = k->row == 0 ? SWEET_KBD_FN_H : SWEET_KBD_ROW_H;
+	*x = (int32_t)((uint64_t)k->x * pw / 1000);
+	*w = (int32_t)((uint64_t)(k->x + k->w) * pw / 1000) - *x;
+	*y = (int32_t)ph - sweet_kbd_height(pw) + (int32_t)((uint64_t)ry * pw / SWEET_KBD_REF_W);
+	*h = (int32_t)((uint64_t)rh * pw / SWEET_KBD_REF_W);
+}
+#endif
