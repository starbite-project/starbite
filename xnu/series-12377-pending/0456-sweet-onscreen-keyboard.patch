+void
+SweetHIDKeyboard::testFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	static const struct { uint8_t usage, flags; uint16_t wait_ms; } steps[] = {
+		{ 0xe1, SKF_SHIFTKEY, 1000 }, { 0xe3, SKF_MOD, 1000 }, { 0x11, 0, 6000 },       /* Shift, command, n */
+		{ 0x0b, 0, 1000 }, { 0x0c, 0, 1000 }, { 0x28, 0, 0 },                           /* h, i, return */
+	};
+	SweetHIDKeyboard *self = (SweetHIDKeyboard *)owner;
+	UInt32 step = self->fTestStep / 2;
+	bool press = (self->fTestStep & 1) == 0;
+	if (step >= sizeof(steps) / sizeof(steps[0])) {
+		return;
+	}
+	if (press && step == 0) {
+		sweet_kbd.page = 0;
+		sweet_kbd.full = 1;
+		sweet_kbd.visible = 1;
+	}
+	int32_t x = 0, y = 0, w = 0, h = 0;
+	for (int i = sweet_kbd_first[0]; i < sweet_kbd_first[1]; i++) {
+		const struct sweet_kbd_keydef *k = &sweet_kbd_keys[i];
+		if (k->usage == steps[step].usage && (k->flags & (SKF_SHIFTKEY | SKF_MOD | SKF_PAGE | SKF_HIDE)) == steps[step].flags) {
+			sweet_kbd_cell(k, sweet_kbd.panel_w, sweet_kbd.panel_h, &x, &y, &w, &h);
+			break;
+		}
+	}
+	if (w > 0) {
+		if (press) {
+			IOLog("SWEET KBD: test tap %u: key 0x%02x at %d,%d\n", step, steps[step].usage, x + w / 2, y + h / 2);
+		}
+		sweet_hid_touch(9, press, x + w / 2, y + h / 2);
+	}
+	self->fTestStep++;
+	if (press) {
+		sender->setTimeoutMS(80);
+	} else if (steps[step].wait_ms != 0) {
+		sender->setTimeoutMS(steps[step].wait_ms);
+	}
+}
