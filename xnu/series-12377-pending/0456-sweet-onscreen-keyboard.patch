+static uint32_t
+sweet_kbd_modbit(uint32_t usage)
+{
+	return usage == 0xe0 ? 1 : (usage == 0xe2 ? 2 : (usage == 0xe3 ? 4 : 0));
+}
+
+/* the key of the current page at a panel position: its cell, else the nearest key of that row */
+static int
+sweet_kbd_hit(int x, int y)
+{
+	uint32_t page = sweet_kbd.page < SWEET_KBD_PAGES ? sweet_kbd.page : 0;
+	int first = sweet_kbd_first[page], n = sweet_kbd_first[page + 1] - first, best = -1, bestd = 0x7fffffff;
+	int32_t kx, ky, kw, kh;
+	sweet_kbd_cell(&sweet_kbd_keys[first], sweet_kbd.panel_w, sweet_kbd.panel_h, &kx, &ky, &kw, &kh);
+	if (y < ky) {
+		y = ky;         /* the padding above the first row */
+	}
+	sweet_kbd_cell(&sweet_kbd_keys[first + n - 1], sweet_kbd.panel_w, sweet_kbd.panel_h, &kx, &ky, &kw, &kh);
+	if (y >= ky + kh) {
+		y = ky + kh - 1;        /* ... and below the last */
+	}
+	for (int i = 0; i < n; i++) {
+		sweet_kbd_cell(&sweet_kbd_keys[first + i], sweet_kbd.panel_w, sweet_kbd.panel_h, &kx, &ky, &kw, &kh);
+		if (y < ky || y >= ky + kh) {
+			continue;
+		}
+		if (x >= kx && x < kx + kw) {
+			return i;
+		}
+		int d = x < kx ? kx - x : x - (kx + kw - 1);
+		if (d < bestd) {
+			bestd = d;
+			best = i;
+		}
+	}
+	return best;
+}
+
+static void
+sweet_kbd_press(struct sweet_kbd_finger *f, int key)
+{
+	uint32_t page = sweet_kbd.page < SWEET_KBD_PAGES ? sweet_kbd.page : 0;
+	const struct sweet_kbd_keydef *k = &sweet_kbd_keys[sweet_kbd_first[page] + key];
+
+	f->key = (int8_t)key;
+	f->page = (uint8_t)page;
+	f->usage = k->usage;
+	f->flags = k->flags;
+	f->mods = 0;
+	f->shifted = false;
+	if (k->flags & SKF_PAGE) {
+		sweet_kbd.page = k->usage;
+		__atomic_store_n(&sweet_kbd.pressed, 0, __ATOMIC_RELEASE);
+		sweet_kbd.full = 1;
+		f->key = -1;
+		return;
+	}
+	__atomic_fetch_or(&sweet_kbd.pressed, 1ULL << key, __ATOMIC_RELEASE);
+	__atomic_fetch_or(&sweet_kbd.dirty, 1ULL << key, __ATOMIC_RELEASE);
+	if (k->flags & SKF_SHIFTKEY) {
+		/* a tap: the next key only; a second tap within 400 ms: locked; a tap while on: off */
+		static uint64_t last_ns;
+		uint64_t now_ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time(), &now_ns);
+		uint32_t s = sweet_kbd.shift;
+		sweet_kbd.shift = s == 0 ? 1 : (s == 1 && now_ns - last_ns < 400ULL * NSEC_PER_MSEC ? 2 : 0);
+		last_ns = now_ns;
+		sweet_kbd.full = 1;
+	} else if (k->flags & SKF_MOD) {
+		sweet_kbd.mods = sweet_kbd.mods ^ sweet_kbd_modbit(k->usage);
+	} else if (!(k->flags & SKF_HIDE) && gSweetKeyboard != NULL) {
+		uint32_t m = sweet_kbd.mods;
+		bool sh = (k->flags & SKF_SHIFT) != 0 || sweet_kbd.shift != 0;
+		if (m & 1) {
+			gSweetKeyboard->key(0xe0, true);
+		}
+		if (m & 2) {
+			gSweetKeyboard->key(0xe2, true);
+		}
+		if (m & 4) {
+			gSweetKeyboard->key(0xe3, true);
+		}
+		if (sh) {
+			gSweetKeyboard->key(0xe1, true);
+		}
+		gSweetKeyboard->key(k->usage, true);
+		f->mods = (uint8_t)m;
+		f->shifted = sh;
+		IOLog("SWEET KBD: key 0x%02x down%s mods %u\n", k->usage, sh ? " shift" : "", m);
+	}
+}
+
+static void
+sweet_kbd_release(struct sweet_kbd_finger *f)
+{
+	if (f->key < 0) {
+		return;
+	}
+	if (f->flags & SKF_HIDE) {
+		sweet_kbd.visible = 0;
+	} else if (!(f->flags & (SKF_SHIFTKEY | SKF_MOD)) && gSweetKeyboard != NULL) {
+		gSweetKeyboard->key(f->usage, false);
+		if (f->shifted) {
+			gSweetKeyboard->key(0xe1, false);
+		}
+		if (f->mods & 4) {
+			gSweetKeyboard->key(0xe3, false);
+		}
+		if (f->mods & 2) {
+			gSweetKeyboard->key(0xe2, false);
+		}
+		if (f->mods & 1) {
+			gSweetKeyboard->key(0xe0, false);
+		}
+		if (sweet_kbd.shift == 1) {
+			sweet_kbd.shift = 0;    /* Shift was for this key only */
+			sweet_kbd.full = 1;
+		}
+		if (f->mods != 0) {
+			sweet_kbd.mods = 0;     /* ... and so were the latched modifiers */
+			sweet_kbd.full = 1;
+		}
+	}
+	if (f->page == sweet_kbd.page) {
+		__atomic_fetch_and(&sweet_kbd.pressed, ~(1ULL << f->key), __ATOMIC_RELEASE);
+		__atomic_fetch_or(&sweet_kbd.dirty, 1ULL << f->key, __ATOMIC_RELEASE);
+	}
+	f->key = -1;
+}
+
+/* A touch sample in panel pixels. True: it belongs to the keyboard (the trackpad does not see it). */
+static bool
+sweet_kbd_touch(int finger, bool down, int x, int y)
+{
+	if (!sweet_kbd.enabled || sweet_kbd.panel_w == 0 || finger < 0 || finger >= SWEET_TOUCH_FINGERS) {
+		return false;
+	}
+	struct sweet_kbd_finger *f = &sweet_kbd_fingers[finger];
+	if (f->owner == 0) {
+		if (!down) {
+			return false;
+		}
+		int32_t ph = (int32_t)sweet_kbd.panel_h;
+		if (sweet_kbd.visible) {
+			if (y < ph - sweet_kbd_height(sweet_kbd.panel_w)) {
+				return false;
+			}
+			f->owner = 1;
+			f->key = -1;
+			int key = sweet_kbd_hit(x, y);
+			if (key >= 0) {
+				sweet_kbd_press(f, key);
+			}
+			return true;
+		}
+		if (y >= ph - SWEET_KBD_EDGE) {
+			f->owner = 2;
+			f->key = -1;
+			f->startY = y;
+			return true;
+		}
+		return false;
+	}
+	if (down) {
+		if (f->owner == 2 && f->startY - y >= SWEET_KBD_TRAVEL) {
+			f->owner = 3;
+			__atomic_store_n(&sweet_kbd.pressed, 0, __ATOMIC_RELEASE);
+			sweet_kbd.full = 1;
+			sweet_kbd.visible = 1;
+			IOLog("SWEET KBD: show (swipe up from the bottom edge)\n");
+		}
+		return true;
+	}
+	if (f->owner == 1) {
+		sweet_kbd_release(f);
+	}
+	f->owner = 0;
+	return true;
+}
