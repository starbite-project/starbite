+ */
+#define SWEET_KBD_BG       0xff1c1c1eu
+#define SWEET_KBD_KEY      0xff6a6a6eu
+#define SWEET_KBD_KEY_DOWN 0xffa6a6aau
+#define SWEET_KBD_DARK     0xff3e3e42u
+#define SWEET_KBD_DARK_DOWN 0xff707075u
