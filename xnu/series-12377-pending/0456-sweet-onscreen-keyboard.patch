+void
+AppleCLCD::kbdService(void)
+{
+	static bool shown;
+	static uint32_t dumpAt, dumped;
+	if (!sweet_kbd.enabled || !fScaled || fPixels == 0) {
+		return;
+	}
+	bool want = sweet_kbd.visible != 0;
+	int32_t top = (int32_t)fHeight - sweet_kbd_height(fWidth);
+	if (top <= 0) {
+		return;
+	}
+	if (want && !shown) {
+		if (sweet_su_have) {
+			sweetSaveUnder(false);          /* the pointer comes off before the rows are taken */
+			sweet_su_have = false;
+		}
+		sweet_kbd.top = top;
+		sweet_kbd.full = 1;
+		shown = true;
+		IOLog("SWEET KBD: shown on panel rows %d..%u\n", top, fHeight - 1);
+	} else if (!want && shown) {
+		int32_t from = top;
+		shown = false;
+		sweet_kbd.top = 0;
+		if (sweet_su_have) {
+			from = sweet_su_y < from ? sweet_su_y : from;   /* the pointer's rows too: drawn again with the next frame */
+			sweet_su_have = false;
+		}
+		kbdRepaint(from, (int32_t)fHeight);
+		IOLog("SWEET KBD: hidden\n");
+		return;
+	}
+	if (!shown) {
+		return;
+	}
+	uint32_t page = sweet_kbd.page < SWEET_KBD_PAGES ? sweet_kbd.page : 0;
+	uint32_t n = (uint32_t)sweet_kbd_first[page + 1] - sweet_kbd_first[page];
+	uint64_t dirty = __atomic_exchange_n(&sweet_kbd.dirty, 0, __ATOMIC_ACQ_REL);
+	if (__atomic_exchange_n(&sweet_kbd.full, 0, __ATOMIC_ACQ_REL) != 0) {
+		for (int32_t y = top; y < (int32_t)fHeight; y++) {
+			uint32_t *row = (uint32_t *)(fPixels + (uint64_t)y * fRowBytes);
+			for (uint32_t x = 0; x < fWidth; x++) {
+				row[x] = SWEET_KBD_BG;
+			}
+		}
+		dirty = ~0ULL;
+	}
+	for (uint32_t i = 0; i < n && dirty != 0; i++) {
+		if (dirty & (1ULL << i)) {
+			kbdDrawKey(page, i);
+		}
+	}
+	/* sweetkbddump=N: once after N s of uptime, the keyboard's panel rows at 1/4 scale, in the frame dump's
+	 * format under another name: "SWEET KBDUMP W H y x0 hex" (tools/macos/fbdump-png.py after s/KBDUMP/FBDUMP/) */
+	if (dumpAt == 0) {
+		dumpAt = 0xffffffffu;
+		PE_parse_boot_argn("sweetkbddump", &dumpAt, sizeof(dumpAt));
+	}
+	uint64_t up = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &up);
+	if (dumped < 2 && dumpAt != 0xffffffffu && up / NSEC_PER_SEC >= (uint64_t)dumpAt + 30ULL * dumped) {
+		dumped++;
+		uint32_t W = fWidth / 4, H = (fHeight - (uint32_t)top) / 4;
+		static const char hx[] = "0123456789abcdef";
+		char line[69 * 3 + 1];
+		for (uint32_t y = 0; y < H; y++) {
+			for (uint32_t x0 = 0; x0 < W; x0 += 69) {
+				uint32_t c = 0;
+				for (uint32_t x = x0; x < W && x < x0 + 69; x++) {
+					uint32_t v = *(const volatile uint32_t *)(fPixels + (uint64_t)((uint32_t)top + y * 4 + 2) * fRowBytes + (x * 4 + 2) * 4);
+					line[c++] = hx[(v >> 20) & 0xf];
+					line[c++] = hx[(v >> 12) & 0xf];
+					line[c++] = hx[(v >> 4) & 0xf];
+				}
+				line[c] = 0;
+				IOLog("SWEET KBDUMP %u %u %u %u %s\n", W, H, y, x0, line);
+			}
+		}
+		IOLog("SWEET KBDUMP end %u\n", dumped);
+	}
+}
