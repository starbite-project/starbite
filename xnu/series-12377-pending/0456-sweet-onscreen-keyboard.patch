+void
+AppleCLCD::kbdRepaint(int32_t py0, int32_t py1)
+{
+	int32_t lw = (int32_t)fLogicalW, lh = (int32_t)fLogicalH;
+	int32_t outW = (int32_t)((int64_t)lw * fHeight / lh), outH = (int32_t)fHeight;
+	if (outW > (int32_t)fWidth) {
+		outW = (int32_t)fWidth;
+		outH = (int32_t)((int64_t)lh * fWidth / lw);
+	}
+	int32_t barX = ((int32_t)fWidth - outW) / 2, barY = ((int32_t)fHeight - outH) / 2;
+	bool have = sweet_fb_prev != NULL && sweet_fb_prev_valid && sweet_fb_prev_size == (uint32_t)lw * 4 * (uint32_t)lh;
+	py0 = py0 < 0 ? 0 : py0;
+	py1 = py1 > (int32_t)fHeight ? (int32_t)fHeight : py1;
+	for (int32_t py = py0; py < py1; py++) {
+		uint32_t *out = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes);
+		if (!have || py < barY || py >= barY + outH) {
+			memset(out, 0, (size_t)fWidth * 4);
+			continue;
+		}
+		int32_t r = (int32_t)((int64_t)(py - barY) * lh / outH);
+		const uint32_t *in = (const uint32_t *)(sweet_fb_prev + (size_t)(r >= lh ? lh - 1 : r) * (size_t)lw * 4);
+		if (outW == lw) {
+			memcpy(out + barX, in, (size_t)lw * 4);
+		} else {
+			for (int32_t x = 0; x < outW; x++) {
+				out[barX + x] = in[(int32_t)((int64_t)x * lw / outW)];
+			}
+		}
+	}
+	if (!have) {
+		sweet_fb_prev_valid = false;    /* black until the next frame, which then draws every row */
+	}
+}
 
+void
+AppleCLCD::kbdDrawKey(uint32_t page, uint32_t i)
+{
+	const struct sweet_kbd_keydef *k = &sweet_kbd_keys[sweet_kbd_first[page] + i];
+	int32_t cx, cy, cw, ch;
+	sweet_kbd_cell(k, fWidth, fHeight, &cx, &cy, &cw, &ch);
+	if (cx < 0 || cy < 0 || cw <= 0 || ch <= 0 || cx + cw > (int32_t)fWidth || cy + ch > (int32_t)fHeight) {
+		return;
+	}
+	bool down = ((sweet_kbd.pressed >> i) & 1) != 0;
+	bool latched = (k->flags & SKF_SHIFTKEY) ? sweet_kbd.shift != 0 :
+	    ((k->flags & SKF_MOD) && (sweet_kbd.mods & (k->usage == 0xe0 ? 1u : (k->usage == 0xe2 ? 2u : 4u))) != 0);
+	uint32_t fill = latched ? 0xffffffffu : ((k->flags & SKF_DARK) ? (down ? SWEET_KBD_DARK_DOWN : SWEET_KBD_DARK) :
+	    (down ? SWEET_KBD_KEY_DOWN : SWEET_KBD_KEY));
+	uint32_t text = latched ? 0xff000000u : 0xffffffffu;
+	int32_t ix = (int32_t)(6 * fWidth / SWEET_KBD_REF_W), iy = (int32_t)(8 * fWidth / SWEET_KBD_REF_W);
+	int32_t rad = (int32_t)(16 * fWidth / SWEET_KBD_REF_W), kw = cw - 2 * ix, kh = ch - 2 * iy;
+	for (int32_t yy = 0; yy < ch; yy++) {
+		uint32_t *row = (uint32_t *)(fPixels + (uint64_t)(cy + yy) * fRowBytes + (uint64_t)cx * 4);
+		for (int32_t x = 0; x < cw; x++) {
+			row[x] = SWEET_KBD_BG;
+		}
+		int32_t ky = yy - iy;
+		if (ky < 0 || ky >= kh) {
+			continue;
+		}
+		/* rounded corners: how far this row is inside the corner circle's rows */
+		int32_t d = ky < rad ? rad - ky : (ky >= kh - rad ? ky - (kh - rad) + 1 : 0), inset = 0;
+		while (d > 0 && inset < rad && (rad - inset) * (rad - inset) + d * d > rad * rad + rad) {
+			inset++;
+		}
+		for (int32_t x = ix + inset; x < ix + kw - inset; x++) {
+			row[x] = fill;
+		}
+	}
+	uint32_t gi = (sweet_kbd.shift != 0 && k->glyph_shift != k->glyph) ? k->glyph_shift : k->glyph;
+	const struct sweet_kbd_glyphdef *g = &sweet_kbd_glyphs[gi];
+	int32_t gx = cx + (cw - (int32_t)g->w) / 2, gy = cy + ch / 2 + g->dy;
+	for (int32_t yy = 0; yy < (int32_t)g->h; yy++) {
+		int32_t py = gy + yy;
+		if (py < cy || py >= cy + ch) {
+			continue;
+		}
+		uint32_t *row = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes);
+		const uint8_t *al = &sweet_kbd_alpha[g->off + (uint32_t)yy * g->w];
+		for (int32_t xx = 0; xx < (int32_t)g->w; xx++) {
+			int32_t px = gx + xx;
+			uint32_t a = al[xx];
+			if (a == 0 || px < cx || px >= cx + cw) {
+				continue;
+			}
+			uint32_t res = 0xff000000u;
+			for (uint32_t sh = 0; sh < 24; sh += 8) {
+				res |= ((((fill >> sh) & 0xff) * (255 - a) + ((text >> sh) & 0xff) * a + 127) / 255) << sh;
+			}
+			row[px] = res;
+		}
+	}
+}
