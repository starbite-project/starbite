+#define SWEET_KBD_EDGE   70     /* a touch that begins this close to the bottom edge may be the summon swipe */
+#define SWEET_KBD_TRAVEL 220    /* ... once it has moved up this far (panel pixels) */
+struct sweet_kbd_finger {
+	uint8_t owner;          /* 0 not the keyboard's, 1 on a key, 2 the summon swipe, 3 ignored until it lifts */
+	int8_t  key;            /* index in the page, -1 none */
+	uint8_t page, usage, flags, mods;
