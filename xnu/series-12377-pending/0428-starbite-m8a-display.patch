@@ -0,0 +1,524 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * DECON_F scan-out control (see sbd_decon.h). Register facts and their sources: NOTES.md.
+ *
+ * How a flip works on this hardware. The window's DMA channel (an IDMA block) holds the buffer's physical
+ * address in IN_BASE_ADDR. Writes to it land in a shadow copy. SHADOW_REG_UPDATE_REQ asks the DECON to take
+ * the shadow registers at the start of its next frame, which in command mode is the panel's next TE pulse
+ * (HW trigger). The DECON clears the request when it has taken them. So: write the address, request the
+ * update, and the new buffer is read from the next refresh on, never in the middle of one.
+ */
+#include "sbd_decon.h"
+#include "sbd_regs.h"
+
+#define DECON   SBD_BLK_DECON
+#define IDMA    SBD_BLK_IDMA
+#define DPP     SBD_BLK_DPP
+
+/* DATA_PATH_CONTROL_1 channel number -> channel block (G0 G1 VG0 VG1 VGF0 VGF1), -1 = none */
+static const int sbd_type_of_channel[8] = { SBD_CH_VG0, SBD_CH_VGF0, SBD_CH_VGF1, SBD_CH_G1, SBD_CH_VG1, SBD_CH_G0, -1, -1 };
+
+static uint32_t
+idma_rd(const struct sbd_decon *d, unsigned type, uint32_t reg)
+{
+	return sbd_rd(&d->io, IDMA, IDMA_CH(type) + reg);
+}
+
+static void
+idma_wr(const struct sbd_decon *d, unsigned type, uint32_t reg, uint32_t val)
+{
+	sbd_wr(&d->io, IDMA, IDMA_CH(type) + reg, val);
+}
+
+static uint32_t
+dpp_rd(const struct sbd_decon *d, unsigned type, uint32_t reg)
+{
+	return sbd_rd(&d->io, DPP, DPP_CH(type) + reg);
+}
+
+static void
+dpp_wr(const struct sbd_decon *d, unsigned type, uint32_t reg, uint32_t val)
+{
+	sbd_wr(&d->io, DPP, DPP_CH(type) + reg, val);
+}
+
+void
+sbd_decon_init(struct sbd_decon *d, const struct sbd_io *io)
+{
+	unsigned char *p = (unsigned char *)d;
+
+	for (size_t i = 0; i < sizeof(*d); i++) {
+		p[i] = 0;
+	}
+	d->io = *io;
+	d->scan_limit = SBD_SCANOUT_LIMIT;
+}
+
+const char *
+sbd_decon_strerror(int err)
+{
+	switch (err) {
+	case SBD_OK:                  return "ok";
+	case SBD_ERR_NOT_PROBED:      return "the DECON was not probed as expected";
+	case SBD_ERR_GEOMETRY:        return "not the S9's 1440x2960x4 boot framebuffer";
+	case SBD_ERR_WINDOWS:         return "not exactly one window on";
+	case SBD_ERR_CHANNEL:         return "the window's channel cannot be used";
+	case SBD_ERR_NOT_BOOT_BUFFER: return "the channel does not read the boot framebuffer";
+	case SBD_ERR_NOT_RUNNING:     return "the DECON is not running in command mode";
+	case SBD_ERR_ADDRESS:         return "buffer address above the limit or misaligned";
+	case SBD_ERR_STRIDE:          return "row length not usable";
+	case SBD_ERR_MODE:            return "wrong mode for this call";
+	case SBD_ERR_BUSY:            return "a shadow update is pending or the channel is busy";
+	case SBD_ERR_SIZE:            return "size outside the scaler's limits";
+	case SBD_ERR_HW:              return "the hardware reported a configuration error";
+	default:                      return "unknown";
+	}
+}
+
+int
+sbd_decon_probe(struct sbd_decon *d, uint64_t fb_phys, uint32_t width, uint32_t height, uint32_t rowbytes)
+{
+	uint32_t gc, path0, path1, on = 0;
+	int type;
+
+	if (d->probed != 0) {
+		return d->probed > 0 ? SBD_OK : d->probe_err;
+	}
+	d->probed = -1;
+	if (fb_phys == 0 || (fb_phys >> 32) != 0 || width != 1440 || height != 2960 || rowbytes != width * 4) {
+		return d->probe_err = SBD_ERR_GEOMETRY;
+	}
+	gc = sbd_rd(&d->io, DECON, DECON_GLOBAL_CONTROL);
+	path0 = sbd_rd(&d->io, DECON, DECON_DATA_PATH_0);
+	path1 = sbd_rd(&d->io, DECON, DECON_DATA_PATH_1);
+	for (unsigned w = 0; w < DECON_WINDOWS; w++) {
+		if (path0 & (1u << (4 * w))) {
+			on++;
+			d->win = w;
+		}
+	}
+	if (on != 1) {
+		return d->probe_err = SBD_ERR_WINDOWS;
+	}
+	type = sbd_type_of_channel[(path1 >> (4 * d->win)) & 7];
+	if (type < 0) {
+		return d->probe_err = SBD_ERR_CHANNEL;
+	}
+	d->boot_type = (unsigned)type;
+	d->boot_base = idma_rd(d, d->boot_type, IDMA_BASE_Y);
+	d->boot_img_size = idma_rd(d, d->boot_type, IDMA_IMG_SIZE);
+	d->boot_src_size = idma_rd(d, d->boot_type, IDMA_SRC_SIZE);
+	d->boot_in_con = idma_rd(d, d->boot_type, IDMA_IN_CON);
+	if (d->boot_base != (uint32_t)fb_phys || d->boot_img_size != ((height << 16) | width) ||
+	    (d->boot_src_size & 0xffffu) * 4 != rowbytes) {
+		return d->probe_err = SBD_ERR_NOT_BOOT_BUFFER;
+	}
+	if (!(gc & DECON_GC_CMD_MODE) || !(gc & DECON_GC_RUN)) {
+		return d->probe_err = SBD_ERR_NOT_RUNNING;
+	}
+	d->boot_path1 = path1;
+	d->boot_win_start = sbd_rd(&d->io, DECON, DECON_WIN_START(d->win));
+	d->boot_win_end = sbd_rd(&d->io, DECON, DECON_WIN_END(d->win));
+	d->boot_trig = sbd_rd(&d->io, DECON, DECON_TRIG_CONTROL);
+	d->panel_w = width;
+	d->panel_h = height;
+	d->chan_type = d->boot_type;
+	d->stride_px = d->boot_src_size & 0xffffu;
+	d->src_w = width;
+	d->src_h = height;
+	d->shown_base = d->boot_base;
+	d->mode = SBD_MODE_BOOT;
+	d->probed = 1;
+	d->probe_err = SBD_OK;
+	return SBD_OK;
+}
+
+int
+sbd_decon_buffer_ok(const struct sbd_decon *d, uint64_t phys, uint64_t bytes, uint32_t rowbytes)
+{
+	if (phys == 0 || (phys >> 32) != 0 || (phys & 0xffu) != 0 || bytes == 0 || phys + bytes > d->scan_limit) {
+		return SBD_ERR_ADDRESS;
+	}
+	if ((rowbytes & 3u) != 0 || rowbytes / 4 < d->src_w || rowbytes / 4 > 0xffffu) {
+		return SBD_ERR_STRIDE;
+	}
+	return SBD_OK;
+}
+
+int
+sbd_decon_attach_flip(struct sbd_decon *d)
+{
+	if (d->probed <= 0) {
+		return SBD_ERR_NOT_PROBED;
+	}
+	if (d->mode != SBD_MODE_BOOT) {
+		return SBD_ERR_MODE;
+	}
+	d->mode = SBD_MODE_FLIP;
+	d->chan_type = d->boot_type;
+	d->src_w = d->panel_w;
+	d->src_h = d->panel_h;
+	return SBD_OK;
+}
+
+void
+sbd_decon_trigger(struct sbd_decon *d, bool on)
+{
+	/* HW trigger: enable = EN set and MASK clear; disable = MASK set and EN clear (the vendor's pairing) */
+	sbd_wr_mask(&d->io, DECON, DECON_TRIG_CONTROL, on ? DECON_HW_TRIG_EN : DECON_HW_TRIG_MASK,
+	    DECON_HW_TRIG_EN | DECON_HW_TRIG_MASK);
+}
+
+static void
+request_shadow_update(struct sbd_decon *d)
+{
+	sbd_wr(&d->io, DECON, DECON_SHADOW_REQ, sbd_rd(&d->io, DECON, DECON_SHADOW_REQ) | DECON_SHADOW_ALL);
+}
+
+int
+sbd_decon_flip(struct sbd_decon *d, uint64_t phys, uint32_t rowbytes)
+{
+	uint32_t trig;
+	int err;
+
+	if (d->probed <= 0) {
+		return SBD_ERR_NOT_PROBED;
+	}
+	if (d->mode == SBD_MODE_BOOT) {
+		return SBD_ERR_MODE;
+	}
+	err = sbd_decon_buffer_ok(d, phys, (uint64_t)rowbytes * d->src_h, rowbytes);
+	if (err != SBD_OK) {
+		return err;
+	}
+	/* a masked or disabled trigger would never take the update: frames must be running first */
+	trig = sbd_rd(&d->io, DECON, DECON_TRIG_CONTROL);
+	if ((trig & DECON_HW_TRIG_MASK) || !(trig & DECON_HW_TRIG_EN)) {
+		sbd_decon_trigger(d, true);
+	}
+	if (rowbytes / 4 != d->stride_px) {
+		idma_wr(d, d->chan_type, IDMA_SRC_SIZE,
+		    (idma_rd(d, d->chan_type, IDMA_SRC_SIZE) & 0xffff0000u) | (rowbytes / 4));
+		d->stride_px = rowbytes / 4;
+	}
+	idma_wr(d, d->chan_type, IDMA_BASE_Y, (uint32_t)phys);
+	idma_wr(d, d->chan_type, IDMA_BASE_C, (uint32_t)phys);
+	request_shadow_update(d);
+	if (d->pending) {
+		d->flips_replaced++;
+	}
+	d->pending = true;
+	d->pending_base = (uint32_t)phys;
+	d->flips_requested++;
+	return SBD_OK;
+}
+
+bool
+sbd_decon_latched(struct sbd_decon *d)
+{
+	return (sbd_rd(&d->io, DECON, DECON_SHADOW_REQ) & DECON_SHADOW_ALL) == 0;
+}
+
+/* the pending flip, if the DECON has taken it */
+static uint32_t
+account_latch(struct sbd_decon *d)
+{
+	if (d->pending && sbd_decon_latched(d)) {
+		d->pending = false;
+		d->shown_base = d->pending_base;
+		d->flips_latched++;
+		return SBD_EV_LATCHED;
+	}
+	return 0;
+}
+
+static int
+wait_latched(struct sbd_decon *d, unsigned ms)
+{
+	for (unsigned i = 0; i <= ms; i++) {
+		if (sbd_decon_latched(d)) {
+			return 0;
+		}
+		d->io.udelay(d->io.ctx, 1000);
+	}
+	return -1;
+}
+
+void
+sbd_decon_irq_enable(struct sbd_decon *d, bool on)
+{
+	/* clear what is pending, so the first interrupt is a new frame's */
+	sbd_wr(&d->io, DECON, DECON_INT_PENDING, DECON_INT_FRAME_DONE | DECON_INT_FRAME_START | DECON_INT_EXTRA);
+	sbd_wr(&d->io, DECON, DECON_EXTRA_INT_PENDING, DECON_XINT_CONFLICT | DECON_XINT_TIMEOUT);
+	if (on) {
+		sbd_wr_mask(&d->io, DECON, DECON_INT_ENABLE,
+		    DECON_INT_FRAME_DONE | DECON_INT_FRAME_START | DECON_INT_EXTRA | DECON_INT_EN, DECON_INT_ENABLE_MASK);
+		sbd_wr(&d->io, DECON, DECON_EXTRA_INT_ENABLE, DECON_XINT_CONFLICT | DECON_XINT_TIMEOUT);
+	} else {
+		sbd_wr_mask(&d->io, DECON, DECON_INT_ENABLE, 0, DECON_INT_EXTRA | DECON_INT_EN);
+	}
+}
+
+uint32_t
+sbd_decon_irq(struct sbd_decon *d)
+{
+	uint32_t pend = sbd_rd(&d->io, DECON, DECON_INT_PENDING), ev = 0;
+
+	if (pend & DECON_INT_FRAME_START) {
+		sbd_wr(&d->io, DECON, DECON_INT_PENDING, DECON_INT_FRAME_START);
+		d->vsync_irqs++;
+		ev |= SBD_EV_VSYNC | account_latch(d);
+	}
+	if (pend & DECON_INT_FRAME_DONE) {
+		sbd_wr(&d->io, DECON, DECON_INT_PENDING, DECON_INT_FRAME_DONE);
+		d->frame_done_irqs++;
+		ev |= SBD_EV_FRAME_DONE | account_latch(d);
+	}
+	if (pend & DECON_INT_EXTRA) {
+		uint32_t extra;
+
+		sbd_wr(&d->io, DECON, DECON_INT_PENDING, DECON_INT_EXTRA);
+		extra = sbd_rd(&d->io, DECON, DECON_EXTRA_INT_PENDING);
+		if (extra & DECON_XINT_CONFLICT) {
+			sbd_wr(&d->io, DECON, DECON_EXTRA_INT_PENDING, DECON_XINT_CONFLICT);
+			d->conflict_irqs++;
+			ev |= SBD_EV_CONFLICT;
+		}
+		if (extra & DECON_XINT_TIMEOUT) {
+			sbd_wr(&d->io, DECON, DECON_EXTRA_INT_PENDING, DECON_XINT_TIMEOUT);
+			d->timeout_irqs++;
+			ev |= SBD_EV_TIMEOUT;
+		}
+	}
+	return ev;
+}
+
+uint32_t
+sbd_decon_poll(struct sbd_decon *d, uint32_t *refreshes)
+{
+	uint32_t count = sbd_rd(&d->io, DECON, DECON_FRAME_COUNT), delta = 0;
+
+	if (d->have_frame_count) {
+		delta = count - d->last_frame_count;    /* wraps with the register */
+	}
+	d->have_frame_count = true;
+	d->last_frame_count = count;
+	d->refreshes_polled += delta;
+	if (refreshes != NULL) {
+		*refreshes = delta;
+	}
+	return account_latch(d) | (delta ? SBD_EV_VSYNC : 0);
+}
+
+void
+sbd_decon_fit(uint32_t src_w, uint32_t src_h, uint32_t panel_w, uint32_t panel_h, struct sbd_rect *out)
+{
+	uint32_t w, h;
+
+	if (src_w == 0 || src_h == 0) {
+		out->x = out->y = 0;
+		out->w = panel_w;
+		out->h = panel_h;
+		return;
+	}
+	w = (uint32_t)(((uint64_t)src_w * panel_h) / src_h);
+	h = panel_h;
+	if (w > panel_w) {
+		w = panel_w;
+		h = (uint32_t)(((uint64_t)src_h * panel_w) / src_w);
+	}
+	w &= ~1u;
+	h &= ~1u;
+	out->w = w;
+	out->h = h;
+	out->x = ((panel_w - w) / 2) & ~1u;
+	out->y = ((panel_h - h) / 2) & ~1u;
+}
+
+/* Catmull-Rom weight of pixel k (-1 .. 2) for a point t/16 past pixel 0, in 1/512 */
+static int
+cubic_weight(int k, int t)
+{
+	int x = k * 16 - t, a = x < 0 ? -x : x;
+	long long w;
+
+	/* in 1/(2 * 16^3): |x| <= 1: 3|x|^3 - 5|x|^2 + 2;  1 < |x| < 2: -|x|^3 + 5|x|^2 - 8|x| + 4 */
+	if (a <= 16) {
+		w = 3LL * a * a * a - 5LL * 16 * a * a + 2LL * 16 * 16 * 16;
+	} else if (a < 32) {
+		w = -1LL * a * a * a + 5LL * 16 * a * a - 8LL * 16 * 16 * a + 4LL * 16 * 16 * 16;
+	} else {
+		w = 0;
+	}
+	return (int)((w * 512 + (w >= 0 ? 4096 : -4096)) / 8192);
+}
+
+void
+sbd_decon_scaler_coefficients(int16_t table[9][4])
+{
+	for (int t = 0; t < 9; t++) {
+		int sum = 0;
+
+		for (int k = 0; k < 4; k++) {
+			table[t][k] = (int16_t)cubic_weight(k - 1, t);
+			sum += table[t][k];
+		}
+		/* the rounding remainder goes to the nearest pixel's tap */
+		table[t][t < 8 ? 1 : 2] = (int16_t)(table[t][t < 8 ? 1 : 2] + (512 - sum));
+	}
+}
+
+static void
+setup_scaler(struct sbd_decon *d, uint32_t sw, uint32_t sh, uint32_t dw, uint32_t dh)
+{
+	int16_t c[9][4];
+	uint32_t hpos, vpos;
+
+	sbd_decon_scaler_coefficients(c);
+	for (unsigned bank = 0; bank < 2; bank++) {     /* luma and chroma banks, both written */
+		for (unsigned phase = 0; phase < 9; phase++) {
+			/* 8 taps across: the four used are taps 2..5; 4 taps down */
+			for (unsigned tap = 0; tap < 8; tap++) {
+				int v = (tap >= 2 && tap <= 5) ? c[phase][tap - 2] : 0;
+
+				dpp_wr(d, SBD_CH_VGF0, DPP_H_COEF(phase, tap, bank), (uint32_t)v & 0x7ffu);
+			}
+			for (unsigned tap = 0; tap < 4; tap++) {
+				dpp_wr(d, SBD_CH_VGF0, DPP_V_COEF(phase, tap, bank), (uint32_t)c[phase][tap] & 0x7ffu);
+			}
+		}
+	}
+	dpp_wr(d, SBD_CH_VGF0, DPP_H_RATIO, (uint32_t)(((uint64_t)sw << 20) / dw));
+	dpp_wr(d, SBD_CH_VGF0, DPP_V_RATIO, (uint32_t)(((uint64_t)sh << 20) / dh));
+	/* start positions: (source - destination) / (2 destination), 12.20, two's complement */
+	hpos = (uint32_t)(int32_t)((((long long)sw - (long long)dw) * (1LL << 20)) / (2 * (long long)dw));
+	vpos = (uint32_t)(int32_t)((((long long)sh - (long long)dh) * (1LL << 20)) / (2 * (long long)dh));
+	dpp_wr(d, SBD_CH_VGF0, DPP_YH_POS, hpos);
+	dpp_wr(d, SBD_CH_VGF0, DPP_YV_POS, vpos);
+	dpp_wr(d, SBD_CH_VGF0, DPP_CH_POS, hpos);
+	dpp_wr(d, SBD_CH_VGF0, DPP_CV_POS, vpos);
+}
+
+void
+sbd_decon_detach(struct sbd_decon *d)
+{
+	if (d->probed <= 0 || d->mode == SBD_MODE_BOOT) {
+		return;
+	}
+	if (d->mode == SBD_MODE_SCALER) {
+		sbd_wr(&d->io, DECON, DECON_DATA_PATH_1, d->boot_path1);
+		sbd_wr(&d->io, DECON, DECON_WIN_START(d->win), d->boot_win_start);
+		sbd_wr(&d->io, DECON, DECON_WIN_END(d->win), d->boot_win_end);
+	}
+	idma_wr(d, d->boot_type, IDMA_SRC_SIZE, d->boot_src_size);
+	idma_wr(d, d->boot_type, IDMA_BASE_Y, d->boot_base);
+	idma_wr(d, d->boot_type, IDMA_BASE_C, d->boot_base);
+	sbd_decon_trigger(d, true);
+	request_shadow_update(d);
+	(void)wait_latched(d, 100);
+	d->mode = SBD_MODE_BOOT;
+	d->chan_type = d->boot_type;
+	d->stride_px = d->boot_src_size & 0xffffu;
+	d->src_w = d->panel_w;
+	d->src_h = d->panel_h;
+	d->pending = false;
+	d->shown_base = d->boot_base;
+}
+
+int
+sbd_decon_attach_scaler(struct sbd_decon *d, uint64_t phys, uint32_t src_w, uint32_t src_h, uint32_t rowbytes,
+    const struct sbd_rect *dst)
+{
+	uint32_t path1, frames, dpp_in;
+
+	if (d->probed <= 0) {
+		return SBD_ERR_NOT_PROBED;
+	}
+	if (d->mode != SBD_MODE_BOOT) {
+		return SBD_ERR_MODE;
+	}
+	path1 = d->boot_path1;
+	dpp_in = dpp_rd(d, d->boot_type, DPP_IN_CON);
+	for (unsigned w = 0; w < DECON_WINDOWS; w++) {
+		if (((path1 >> (4 * w)) & 7) == SBD_PATH_CH_VGF0 &&
+		    (sbd_rd(&d->io, DECON, DECON_DATA_PATH_0) & (1u << (4 * w)))) {
+			return SBD_ERR_CHANNEL;
+		}
+	}
+	if (d->boot_type == SBD_CH_VGF0 ||
+	    (d->boot_in_con & (IDMA_IN_ROT_FLIP_MASK | IDMA_IN_AFBC_MASK | IDMA_IN_BLOCK_EN)) || (dpp_in & 7u) != 0) {
+		return SBD_ERR_CHANNEL;
+	}
+	/* the boot window must be the whole panel, with inclusive end coordinates (what the rectangle maths assumes) */
+	if (d->boot_win_start != 0 || d->boot_win_end != (((d->panel_h - 1) << 16) | (d->panel_w - 1))) {
+		return SBD_ERR_CHANNEL;
+	}
+	if (dst->w < 16 || dst->h < 16 || src_w < 16 || src_h < 16 || src_w > 4096 || src_h > 4096 ||
+	    dst->x + dst->w > d->panel_w || dst->y + dst->h > d->panel_h ||
+	    src_w > 2 * dst->w || src_h > 2 * dst->h || dst->w > 8 * src_w || dst->h > 8 * src_h) {
+		return SBD_ERR_SIZE;
+	}
+	if ((phys >> 32) != 0 || (phys & 0xffu) != 0 || phys == 0 || phys + (uint64_t)rowbytes * src_h > d->scan_limit) {
+		return SBD_ERR_ADDRESS;
+	}
+	if ((rowbytes & 3u) != 0 || rowbytes / 4 < src_w || rowbytes / 4 > 0xffffu) {
+		return SBD_ERR_STRIDE;
+	}
+	if (idma_rd(d, SBD_CH_VGF0, IDMA_ENABLE) & IDMA_OP_BUSY) {
+		return SBD_ERR_BUSY;
+	}
+
+	/* VGF0's IDMA: the boot channel's format and bus settings, this buffer and its sizes */
+	idma_wr(d, SBD_CH_VGF0, IDMA_IN_CON, d->boot_in_con & (IDMA_IN_IC_MAX_MASK | IDMA_IN_FORMAT_MASK));
+	idma_wr(d, SBD_CH_VGF0, IDMA_OUT_CON, idma_rd(d, d->boot_type, IDMA_OUT_CON));
+	idma_wr(d, SBD_CH_VGF0, IDMA_SRC_SIZE, (src_h << 16) | (rowbytes / 4));
+	idma_wr(d, SBD_CH_VGF0, IDMA_SRC_OFFSET, 0);
+	idma_wr(d, SBD_CH_VGF0, IDMA_IMG_SIZE, (src_h << 16) | src_w);
+	idma_wr(d, SBD_CH_VGF0, IDMA_BASE_Y, (uint32_t)phys);
+	idma_wr(d, SBD_CH_VGF0, IDMA_BASE_C, (uint32_t)phys);
+	idma_wr(d, SBD_CH_VGF0, IDMA_DEADLOCK_NUM, idma_rd(d, d->boot_type, IDMA_DEADLOCK_NUM));
+	idma_wr(d, SBD_CH_VGF0, IDMA_BUS_CON, idma_rd(d, d->boot_type, IDMA_BUS_CON));
+	idma_wr(d, SBD_CH_VGF0, IDMA_DYN_GATING, idma_rd(d, d->boot_type, IDMA_DYN_GATING));
+	idma_wr(d, SBD_CH_VGF0, IDMA_REQ_DEST, idma_rd(d, d->boot_type, IDMA_REQ_DEST));
+	/* VGF0's DPP: the boot channel's input format, the sizes, the scaler */
+	dpp_wr(d, SBD_CH_VGF0, DPP_IN_CON, (dpp_rd(d, SBD_CH_VGF0, DPP_IN_CON) & ~DPP_IN_KEEP) | (dpp_in & DPP_IN_KEEP));
+	dpp_wr(d, SBD_CH_VGF0, DPP_IMG_SIZE, (src_h << 16) | src_w);
+	dpp_wr(d, SBD_CH_VGF0, DPP_SCALED_SIZE, (dst->h << 16) | dst->w);
+	setup_scaler(d, src_w, src_h, dst->w, dst->h);
+	dpp_wr(d, SBD_CH_VGF0, DPP_DYN_GATING, dpp_rd(d, d->boot_type, DPP_DYN_GATING));
+	/* VGF0 is idle, so its registers are forced in now rather than at a frame of its own */
+	idma_wr(d, SBD_CH_VGF0, IDMA_ENABLE, idma_rd(d, SBD_CH_VGF0, IDMA_ENABLE) | IDMA_SFR_UPDATE_FORCE);
+	dpp_wr(d, SBD_CH_VGF0, DPP_ENABLE, dpp_rd(d, SBD_CH_VGF0, DPP_ENABLE) | DPP_SFR_UPDATE_FORCE);
+	if (wait_latched(d, 100) != 0) {
+		return SBD_ERR_BUSY;            /* nothing of the window was changed yet */
+	}
+
+	/* move the window: its rectangle, then its channel, taken together at the next frame */
+	frames = sbd_rd(&d->io, DECON, DECON_FRAME_COUNT);
+	d->mode = SBD_MODE_SCALER;
+	d->chan_type = SBD_CH_VGF0;
+	d->stride_px = rowbytes / 4;
+	d->src_w = src_w;
+	d->src_h = src_h;
+	sbd_decon_trigger(d, true);
+	sbd_wr(&d->io, DECON, DECON_WIN_START(d->win), (dst->y << 16) | dst->x);
+	sbd_wr(&d->io, DECON, DECON_WIN_END(d->win), ((dst->y + dst->h - 1) << 16) | (dst->x + dst->w - 1));
+	sbd_wr(&d->io, DECON, DECON_DATA_PATH_1,
+	    (path1 & ~(7u << (4 * d->win))) | ((uint32_t)SBD_PATH_CH_VGF0 << (4 * d->win)));
+	request_shadow_update(d);
+	if (wait_latched(d, 100) != 0) {
+		sbd_decon_detach(d);
+		return SBD_ERR_BUSY;
+	}
+	/* three refreshes on the new channel, then its error state */
+	for (unsigned ms = 0; ms < 100 && sbd_rd(&d->io, DECON, DECON_FRAME_COUNT) - frames < 3; ms++) {
+		d->io.udelay(d->io.ctx, 1000);
+	}
+	if ((idma_rd(d, SBD_CH_VGF0, IDMA_CFG_ERR) & 0x7ffu) || (dpp_rd(d, SBD_CH_VGF0, DPP_CFG_ERR) & 0x1fu) ||
+	    (idma_rd(d, SBD_CH_VGF0, IDMA_IRQ) & IDMA_IRQ_ERRORS) || (dpp_rd(d, SBD_CH_VGF0, DPP_IRQ) & DPP_IRQ_CONFIG_ERROR)) {
+		sbd_decon_detach(d);
+		return SBD_ERR_HW;
+	}
+	d->shown_base = (uint32_t)phys;
+	return SBD_OK;
+}
diff --git a/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_decon.h b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_decon.h
new file mode 100644
index 00000000..50bbc265
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_decon.h
@@ -0,0 +1,143 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * DECON_F scan-out control for the Galaxy S9 (Exynos 9810): address flips on the window S-Boot left on,
+ * an optional move of that window to the VGF0 channel (hardware scaler), the frame interrupt model and
+ * refresh accounting. Plain C, no IOKit: shared by StarbiteDisplay.cpp and test/.
+ *
+ * The flip and scaler sequences follow what an earlier port's public driver does on this phone
+ * (refport-kernel drivers/display/dpu/exynos_dpu.c, APSL-2.0, an earlier port; credited in NOTES.md).
+ * This file is written anew around a testable register back end.
+ */
+#ifndef SBD_DECON_H
+#define SBD_DECON_H
+
+#include "sbd_io.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum sbd_decon_mode {
+	SBD_MODE_BOOT   = 0,    /* S-Boot's window and buffer: nothing of ours written */
+	SBD_MODE_FLIP   = 1,    /* address flips on S-Boot's channel, buffers of the panel's size */
+	SBD_MODE_SCALER = 2     /* window on VGF0: smaller buffers scaled to a rectangle of the panel */
+};
+
+/* why a call was refused (negative returns) */
+enum sbd_decon_err {
+	SBD_OK                  = 0,
+	SBD_ERR_NOT_PROBED      = -1,
+	SBD_ERR_GEOMETRY        = -2,   /* not the 1440 x 2960 x 4 boot buffer we know */
+	SBD_ERR_WINDOWS         = -3,   /* not exactly one window on */
+	SBD_ERR_CHANNEL         = -4,   /* the window's channel is no IDMA's, or VGF0 is taken */
+	SBD_ERR_NOT_BOOT_BUFFER = -5,   /* the channel does not read the boot framebuffer */
+	SBD_ERR_NOT_RUNNING     = -6,   /* not command mode, or not running */
+	SBD_ERR_ADDRESS         = -7,   /* above 4 GiB, above the scan-out limit, or misaligned */
+	SBD_ERR_STRIDE          = -8,
+	SBD_ERR_MODE            = -9,
+	SBD_ERR_BUSY            = -10,  /* a shadow update is still pending, or the channel is busy */
+	SBD_ERR_SIZE            = -11,  /* outside the scaler's limits */
+	SBD_ERR_HW              = -12   /* the hardware reported a configuration error */
+};
+
+/* events returned by sbd_decon_irq() / sbd_decon_poll() */
+#define SBD_EV_VSYNC            (1u << 0)       /* a frame started (one refresh) */
+#define SBD_EV_FRAME_DONE       (1u << 1)
+#define SBD_EV_LATCHED          (1u << 2)       /* the pending flip was taken: shown_base changed */
+#define SBD_EV_TIMEOUT          (1u << 3)
+#define SBD_EV_CONFLICT         (1u << 4)
+
+/* an earlier port's observation on this phone: nothing drawn from 0xE0000000 up reaches the panel ([S], NOTES.md). */
+#define SBD_SCANOUT_LIMIT       0xe0000000ull
+
+struct sbd_rect {
+	uint32_t x, y, w, h;
+};
+
+struct sbd_decon {
+	struct sbd_io io;
+	int      probed;                /* 0 not yet, 1 as expected, -1 refused (nothing was written) */
+	int      probe_err;
+	enum sbd_decon_mode mode;
+	uint32_t panel_w, panel_h;
+	uint64_t scan_limit;
+
+	/* what S-Boot left, read at probe and put back by sbd_decon_detach() */
+	unsigned win;                   /* the one window that is on */
+	unsigned boot_type;             /* its channel block */
+	uint32_t boot_base, boot_path1, boot_src_size, boot_img_size, boot_in_con;
+	uint32_t boot_win_start, boot_win_end, boot_trig;
+
+	/* the channel flips go to now */
+	unsigned chan_type;
+	uint32_t stride_px;             /* what IDMA_SRC_SIZE holds */
+	uint32_t src_w, src_h;          /* the buffers' size in this mode */
+
+	/* flips */
+	bool     pending;               /* a base was written and its shadow update not yet seen taken */
+	uint32_t pending_base;
+	uint32_t shown_base;            /* what the DECON reads now */
+	uint64_t flips_requested;
+	uint64_t flips_latched;         /* "frame flips by address" */
+	uint64_t flips_replaced;        /* a newer flip overwrote one the DECON had not taken */
+
+	/* refresh accounting */
+	uint64_t vsync_irqs;            /* frame-start interrupts: "vsync IRQ counted" */
+	uint64_t frame_done_irqs;
+	uint64_t timeout_irqs, conflict_irqs;
+	uint64_t refreshes_polled;      /* from FRAME_COUNT, the timer's path */
+	uint32_t last_frame_count;
+	bool     have_frame_count;
+};
+
+void sbd_decon_init(struct sbd_decon *d, const struct sbd_io *io);
+
+/* Reads only. 0 when the DECON is in the state S-Boot and our loader leave it in. */
+int  sbd_decon_probe(struct sbd_decon *d, uint64_t fb_phys, uint32_t width, uint32_t height, uint32_t rowbytes);
+
+/* Is this buffer one the IDMA can read? (physical, contiguous is the caller's check) */
+int  sbd_decon_buffer_ok(const struct sbd_decon *d, uint64_t phys, uint64_t bytes, uint32_t rowbytes);
+
+/* Mode 1: flips on S-Boot's channel. Writes nothing by itself. */
+int  sbd_decon_attach_flip(struct sbd_decon *d);
+
+/*
+ * Mode 2: the window moves to VGF0, which reads src_w x src_h (rowbytes a row) at phys and scales it to
+ * `dst` on the panel. Sleeps (io.udelay). On any error the boot window is put back.
+ */
+int  sbd_decon_attach_scaler(struct sbd_decon *d, uint64_t phys, uint32_t src_w, uint32_t src_h,
+    uint32_t rowbytes, const struct sbd_rect *dst);
+
+/* Show `phys` from the next refresh on. May be called again before the last flip was taken. */
+int  sbd_decon_flip(struct sbd_decon *d, uint64_t phys, uint32_t rowbytes);
+
+/* Has every requested shadow update been taken? */
+bool sbd_decon_latched(struct sbd_decon *d);
+
+/* Back to S-Boot's channel, window and buffer (the kernel console and a panic draw there). */
+void sbd_decon_detach(struct sbd_decon *d);
+
+/* The TE trigger: on = a frame at every TE; off = masked, the panel shows its own memory. */
+void sbd_decon_trigger(struct sbd_decon *d, bool on);
+
+/* Frame-start, frame-done and extra interrupts on or off (pending ones are cleared first). */
+void sbd_decon_irq_enable(struct sbd_decon *d, bool on);
+
+/* The interrupt handler's register work: read, clear, count. Returns SBD_EV_*. No sleeping. */
+uint32_t sbd_decon_irq(struct sbd_decon *d);
+
+/* Without interrupts: refreshes since the last call from FRAME_COUNT (`*refreshes`), and SBD_EV_LATCHED. */
+uint32_t sbd_decon_poll(struct sbd_decon *d, uint32_t *refreshes);
+
+/* The letterbox: src scaled to the largest rectangle of the panel with its aspect, centred, even sizes. */
+void sbd_decon_fit(uint32_t src_w, uint32_t src_h, uint32_t panel_w, uint32_t panel_h, struct sbd_rect *out);
+
+/* Catmull-Rom weight table for the scaler (nine phases, four taps, units of 1/512; each row sums to 512). */
+void sbd_decon_scaler_coefficients(int16_t table[9][4]);
+
+const char *sbd_decon_strerror(int err);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* SBD_DECON_H */
diff --git a/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_dsim.c b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_dsim.c
new file mode 100644
index 00000000..8ce43832
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_dsim.c
@@ -0,0 +1,168 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * MIPI DSIM0 command FIFO (see sbd_dsim.h). Register facts: NOTES.md (build/em-research-brightness.md holds the
+ * derivation; the loader's EngineerMode sends the same packets on this phone). Written for this driver.
+ */
+#include "sbd_dsim.h"
+#include "sbd_regs.h"
+
+#define DSIM    SBD_BLK_DSIM
+
+bool
+sbd_dsim_ready(const struct sbd_io *io)
+{
+	return (sbd_rd(io, DSIM, DSIM_CLK_CTRL) & DSIM_TX_REQUEST_HSCLK) != 0 &&
+	       (sbd_rd(io, DSIM, DSIM_CONFIG) & DSIM_VIDEO_MODE) == 0;
+}
+
+/* The packet has left when the header FIFO is empty: the interrupt bit, or the FIFO's own state. */
+static int
+wait_header_sent(const struct sbd_io *io, uint32_t timeout_us)
+{
+	for (uint32_t t = 0; ; t += SBD_DSIM_POLL_US) {
+		uint32_t src = sbd_rd(io, DSIM, DSIM_INTSRC), fifo = sbd_rd(io, DSIM, DSIM_FIFOCTRL);
+
+		if ((src & DSIM_INT_PH_EMPTY) || ((fifo & DSIM_FIFO_PH_EMPTY) && DSIM_FIFO_PH_COUNT(fifo) == 0)) {
+			sbd_wr(io, DSIM, DSIM_INTSRC, DSIM_INT_PH_EMPTY);
+			return SBD_DSIM_OK;
+		}
+		if (t >= timeout_us) {
+			return SBD_DSIM_TIMEOUT;        /* no reset of the DSIM: the caller retries later */
+		}
+		io->udelay(io->ctx, SBD_DSIM_POLL_US);
+	}
+}
+
+static void
+write_header(const struct sbd_io *io, uint32_t type, uint32_t d0, uint32_t d1, bool bta)
+{
+	uint32_t keep = sbd_rd(io, DSIM, DSIM_PKTHDR) & DSIM_PKTHDR_KEEP;
+
+	sbd_wr(io, DSIM, DSIM_PKTHDR, keep | (bta ? DSIM_PKTHDR_BTA : 0) | ((d1 & 0xffu) << 16) | ((d0 & 0xffu) << 8) |
+	    (type & 0xffu));
+}
+
+int
+sbd_dsim_dcs_write(const struct sbd_io *io, const uint8_t *bytes, uint32_t n, struct sbd_dsim_stats *st)
+{
+	int err;
+
+	if (bytes == NULL || n == 0 || n > SBD_DSIM_MAX_PAYLOAD) {
+		return SBD_DSIM_BAD_ARG;
+	}
+	if (!sbd_dsim_ready(io)) {
+		return SBD_DSIM_NOT_READY;
+	}
+	/* a header still queued (a frame in flight holds commands back): let it go first */
+	if (DSIM_FIFO_PH_COUNT(sbd_rd(io, DSIM, DSIM_FIFOCTRL)) != 0 &&
+	    wait_header_sent(io, SBD_DSIM_TX_TIMEOUT_US) != SBD_DSIM_OK) {
+		if (st != NULL) {
+			st->timeouts++;
+		}
+		return SBD_DSIM_TIMEOUT;
+	}
+	sbd_wr(io, DSIM, DSIM_INTSRC, DSIM_INT_PH_EMPTY);       /* clear a stale one */
+	if (n == 1) {
+		write_header(io, DSI_DCS_SHORT, bytes[0], 0, false);
+	} else {
+		for (uint32_t i = 0; i < n; i += 4) {
+			uint32_t word = 0;
+
+			for (uint32_t k = 0; k < 4 && i + k < n; k++) {
+				word |= (uint32_t)bytes[i + k] << (8 * k);
+			}
+			sbd_wr(io, DSIM, DSIM_PAYLOAD, word);
+		}
+		write_header(io, DSI_DCS_LONG, n & 0xffu, n >> 8, false);
+	}
+	err = wait_header_sent(io, SBD_DSIM_TX_TIMEOUT_US);
+	if (st != NULL) {
+		st->packets++;
+		if (err != SBD_DSIM_OK) {
+			st->timeouts++;
+		}
+	}
+	return err;
+}
+
+static void
+drain_rx(const struct sbd_io *io)
+{
+	for (int i = 0; i < SBD_DSIM_RX_WORDS && !(sbd_rd(io, DSIM, DSIM_FIFOCTRL) & DSIM_FIFO_RX_EMPTY); i++) {
+		(void)sbd_rd(io, DSIM, DSIM_RXFIFO);
+	}
+}
+
+int
+sbd_dsim_dcs_read(const struct sbd_io *io, uint8_t reg, uint8_t *out, uint32_t n, struct sbd_dsim_stats *st)
+{
+	if (out == NULL || n == 0 || n > 16) {
+		return SBD_DSIM_BAD_ARG;
+	}
+	if (!sbd_dsim_ready(io)) {
+		return SBD_DSIM_NOT_READY;
+	}
+	drain_rx(io);
+	sbd_wr(io, DSIM, DSIM_INTSRC, DSIM_INT_RX_DONE | DSIM_INT_PH_EMPTY);
+	/* the panel answers with at most n bytes */
+	write_header(io, DSI_SET_MAX_RETURN, n, 0, false);
+	if (wait_header_sent(io, SBD_DSIM_TX_TIMEOUT_US) != SBD_DSIM_OK) {
+		goto timeout;
+	}
+	sbd_wr(io, DSIM, DSIM_INTSRC, DSIM_INT_RX_DONE);
+	write_header(io, DSI_DCS_READ, reg, 0, true);           /* the bus is turned round for the answer */
+	for (uint32_t t = 0; !(sbd_rd(io, DSIM, DSIM_INTSRC) & DSIM_INT_RX_DONE); t += SBD_DSIM_POLL_US) {
+		if (t >= SBD_DSIM_RX_TIMEOUT_US) {
+			goto timeout;
+		}
+		io->udelay(io->ctx, SBD_DSIM_POLL_US);
+	}
+	sbd_wr(io, DSIM, DSIM_INTSRC, DSIM_INT_RX_DONE | DSIM_INT_PH_EMPTY);
+	if (st != NULL) {
+		st->packets++;
+	}
+	for (int i = 0; i < SBD_DSIM_RX_WORDS && !(sbd_rd(io, DSIM, DSIM_FIFOCTRL) & DSIM_FIFO_RX_EMPTY); i++) {
+		uint32_t word = sbd_rd(io, DSIM, DSIM_RXFIFO);
+
+		switch (word & 0xffu) {
+		case DSI_RX_DCS_LONG:
+		case DSI_RX_GEN_LONG: {
+			uint32_t count = (word >> 8) & 0xffffu, got = 0;
+
+			for (uint32_t off = 0; off < count; off += 4) {
+				uint32_t data = sbd_rd(io, DSIM, DSIM_RXFIFO);
+
+				for (uint32_t k = 0; k < 4 && off + k < count; k++) {
+					if (got < n) {
+						out[got++] = (uint8_t)(data >> (8 * k));
+					}
+				}
+			}
+			return (int)got;
+		}
+		case DSI_RX_DCS_SHORT_1:
+		case DSI_RX_GEN_SHORT_1:
+			out[0] = (uint8_t)(word >> 8);
+			return 1;
+		case DSI_RX_DCS_SHORT_2:
+		case DSI_RX_GEN_SHORT_2:
+			out[0] = (uint8_t)(word >> 8);
+			if (n > 1) {
+				out[1] = (uint8_t)(word >> 16);
+			}
+			return n > 1 ? 2 : 1;
+		case DSI_RX_ACK_ERROR:
+			if (st != NULL) {
+				st->rx_errors++;
+			}
+			return SBD_DSIM_RX_ERROR;
+		default:                /* end of transmission and the like */
+			break;
+		}
+	}
+timeout:
+	if (st != NULL) {
+		st->timeouts++;
+	}
+	return SBD_DSIM_TIMEOUT;
+}
diff --git a/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_dsim.h b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_dsim.h
new file mode 100644
index 00000000..eca4f500
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_dsim.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * MIPI DSIM0 command FIFO (Exynos 9810), command mode: DCS writes and reads while the DECON keeps sending
+ * frames. Only the packet FIFO registers are touched; the link (PLL, clocks, escape mode, FIFOCTRL, resets)
+ * stays as S-Boot left it. Plain C, shared by the kext and the host tests.
+ */
+#ifndef SBD_DSIM_H
+#define SBD_DSIM_H
+
+#include "sbd_io.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SBD_DSIM_TX_TIMEOUT_US  50000u          /* the vendor's 50 ms: a frame holds commands back ~10 ms */
+#define SBD_DSIM_RX_TIMEOUT_US  100000u
+#define SBD_DSIM_POLL_US        100u
+#define SBD_DSIM_RX_WORDS       64
+#define SBD_DSIM_MAX_PAYLOAD    512u
+
+enum sbd_dsim_err {
+	SBD_DSIM_OK        = 0,
+	SBD_DSIM_NOT_READY = -1,        /* the link is not in HS command mode */
+	SBD_DSIM_TIMEOUT   = -2,        /* the header FIFO did not drain / no answer */
+	SBD_DSIM_BAD_ARG   = -3,
+	SBD_DSIM_RX_ERROR  = -4         /* the panel answered with an error report */
+};
+
+struct sbd_dsim_stats {
+	uint32_t packets, timeouts, rx_errors;
+};
+
+/* Did the loader leave the link usable (HS clock requested, command mode)? Reads only. */
+bool sbd_dsim_ready(const struct sbd_io *io);
+
+/*
+ * One DCS write. n == 1: a short write (0x05, the command alone). n >= 2: a long write (0x39), which is how
+ * the vendor driver and S-Boot send every command with parameters on this panel, two-byte ones included.
+ * Payload words go into the FIFO first, then the header; then the header FIFO is waited empty.
+ */
+int sbd_dsim_dcs_write(const struct sbd_io *io, const uint8_t *bytes, uint32_t n, struct sbd_dsim_stats *st);
+
+/* DCS read of `n` bytes (1..16) of register `reg` from offset 0. Returns the count read or an error. */
+int sbd_dsim_dcs_read(const struct sbd_io *io, uint8_t reg, uint8_t *out, uint32_t n, struct sbd_dsim_stats *st);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* SBD_DSIM_H */
diff --git a/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_io.h b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_io.h
new file mode 100644
index 00000000..6023d012
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_io.h
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * StarbiteDisplay register access: one small back end shared by the kext (real MMIO from the ADT nubs)
+ * and the host tests (a mock register file). No IOKit, no libc.
+ */
+#ifndef SBD_IO_H
+#define SBD_IO_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Register blocks. The kext maps each from a "reg" entry of the decon / dsim nub (INTEGRATION.md). */
+enum sbd_block {
+	SBD_BLK_DECON = 0,      /* DECON_F, 0x16030000 */
+	SBD_BLK_IDMA  = 1,      /* DPU_DMA, 0x16070000: channel block k at 0x1000 * (k + 1) */
+	SBD_BLK_DPP   = 2,      /* DPP, 0x16020000: channel block k at 0x1000 * (k + 1) */
+	SBD_BLK_DSIM  = 3,      /* MIPI DSIM0, 0x16080000 */
+	SBD_BLK_COUNT = 4
+};
+
+struct sbd_io {
+	uint32_t (*rd)(void *ctx, unsigned block, uint32_t off);
+	void     (*wr)(void *ctx, unsigned block, uint32_t off, uint32_t val);
+	void     (*udelay)(void *ctx, uint32_t us);     /* may sleep; never called from the interrupt path */
+	void     *ctx;
+};
+
+static inline uint32_t
+sbd_rd(const struct sbd_io *io, unsigned block, uint32_t off)
+{
+	return io->rd(io->ctx, block, off);
+}
+
+static inline void
+sbd_wr(const struct sbd_io *io, unsigned block, uint32_t off, uint32_t val)
+{
+	io->wr(io->ctx, block, off, val);
+}
+
+/* read-modify-write: bits in mask become those of val */
+static inline void
+sbd_wr_mask(const struct sbd_io *io, unsigned block, uint32_t off, uint32_t val, uint32_t mask)
+{
+	uint32_t old = io->rd(io->ctx, block, off);
+	io->wr(io->ctx, block, off, (old & ~mask) | (val & mask));
+}
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* SBD_IO_H */
diff --git a/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_panel.c b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_panel.c
new file mode 100644
index 00000000..e6b7b206
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_panel.c
@@ -0,0 +1,178 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/* S6E3HA8 panel commands (see sbd_panel.h). Command facts and their sources: NOTES.md. */
+#include "sbd_panel.h"
+
+void
+sbd_panel_init(struct sbd_panel *p, const struct sbd_io *io)
+{
+	unsigned char *b = (unsigned char *)p;
+
+	for (size_t i = 0; i < sizeof(*p); i++) {
+		b[i] = 0;
+	}
+	p->io = *io;
+	p->level = -1;
+}
+
+bool
+sbd_panel_cmd_allowed(uint8_t cmd)
+{
+	switch (cmd) {
+	case 0xf0:      /* level-2 key */
+	case 0x9f:      /* level-1 key */
+	case 0xb1:      /* AOR (only at offset 0: this driver never sends the B0 offset command) */
+	case 0xf7:      /* take gamma / AOR */
+	case 0x28:      /* display off */
+	case 0x29:      /* display on */
+	case 0x10:      /* sleep in */
+	case 0x11:      /* sleep out */
+		return true;
+	default:
+		/* never: C0/C1 (the panel's flash), C8/B3/A1 (calibration), B5/F4/FC (supply voltages), CA (gamma
+		 * without the calibration maths), 01 (reset), 34 (TE off: the DECON's trigger would stop), 53 (AOD),
+		 * B0 (offset: turns a harmless register write into another one) */
+		return false;
+	}
+}
+
+static int
+panel_send(struct sbd_panel *p, const uint8_t *bytes, uint32_t n)
+{
+	if (n == 0 || !sbd_panel_cmd_allowed(bytes[0])) {
+		p->refused++;
+		return SBD_DSIM_BAD_ARG;
+	}
+	return sbd_dsim_dcs_write(&p->io, bytes, n, &p->stats);
+}
+
+uint32_t
+sbd_panel_aor_for_level(int level)
+{
+	uint32_t l, on_min, on_max, on;
+
+	if (level < 0) {
+		level = 0;
+	}
+	if (level > 255) {
+		level = 255;
+	}
+	l = (uint32_t)level;
+	/* lit lines of the frame: light is about proportional to them; the square makes steps look even */
+	on_min = SBD_PANEL_LINES - SBD_PANEL_AOR_DIMMEST;
+	on_max = SBD_PANEL_LINES - SBD_PANEL_AOR_MIN;
+	on = on_min + ((on_max - on_min) * l * l + (255u * 255u) / 2) / (255u * 255u);
+	return SBD_PANEL_LINES - on;
+}
+
+int
+sbd_panel_set_aor(struct sbd_panel *p, uint32_t aor)
+{
+	static const uint8_t key_on[3] = { 0xf0, 0x5a, 0x5a }, commit[2] = { 0xf7, 0x03 }, key_off[3] = { 0xf0, 0xa5, 0xa5 };
+	uint8_t b1[3];
+	int err = SBD_DSIM_OK;
+
+	if (aor < SBD_PANEL_AOR_MIN) {
+		aor = SBD_PANEL_AOR_MIN;
+	}
+	if (aor > SBD_PANEL_AOR_MAX) {
+		aor = SBD_PANEL_AOR_MAX;
+	}
+	b1[0] = 0xb1;
+	b1[1] = (uint8_t)(aor >> 8);
+	b1[2] = (uint8_t)aor;
+	if (!sbd_dsim_ready(&p->io)) {
+		return SBD_DSIM_NOT_READY;
+	}
+	for (int attempt = 0; attempt < 2; attempt++) {
+		err = panel_send(p, key_on, sizeof(key_on));
+		if (err == SBD_DSIM_OK) {
+			err = panel_send(p, b1, sizeof(b1));
+		}
+		if (err == SBD_DSIM_OK) {
+			err = panel_send(p, commit, sizeof(commit));
+		}
+		(void)panel_send(p, key_off, sizeof(key_off));          /* never leave the key open */
+		if (err == SBD_DSIM_OK) {
+			p->aor = aor;
+			break;
+		}
+		p->io.udelay(p->io.ctx, 20000);
+	}
+	return err;
+}
+
+int
+sbd_panel_set_brightness(struct sbd_panel *p, int level)
+{
+	int err;
+
+	level = level < 0 ? 0 : (level > 255 ? 255 : level);
+	err = sbd_panel_set_aor(p, sbd_panel_aor_for_level(level));
+	if (err == SBD_DSIM_OK) {
+		p->level = level;
+	}
+	return err;
+}
+
+/* one command between the level-1 key, the key closed again whatever happened */
+static int
+keyed(struct sbd_panel *p, uint8_t cmd)
+{
+	static const uint8_t key1_on[3] = { 0x9f, 0xa5, 0xa5 }, key1_off[3] = { 0x9f, 0x5a, 0x5a };
+	int err = panel_send(p, key1_on, sizeof(key1_on));
+
+	if (err == SBD_DSIM_OK) {
+		err = panel_send(p, &cmd, 1);
+	}
+	(void)panel_send(p, key1_off, sizeof(key1_off));
+	return err;
+}
+
+int
+sbd_panel_display(struct sbd_panel *p, bool on)
+{
+	int err = keyed(p, on ? 0x29 : 0x28);
+
+	if (err == SBD_DSIM_OK) {
+		p->display_off = !on;
+	}
+	return err;
+}
+
+int
+sbd_panel_sleep(struct sbd_panel *p, bool in)
+{
+	int err;
+
+	if (in) {
+		err = sbd_panel_display(p, false);
+		p->io.udelay(p->io.ctx, 20000);                 /* a frame and more */
+		if (err == SBD_DSIM_OK) {
+			err = keyed(p, 0x10);
+		}
+		p->io.udelay(p->io.ctx, 100000);                /* the vendor's wait after sleep-in */
+		if (err == SBD_DSIM_OK) {
+			p->asleep = true;
+		}
+		return err;
+	}
+	err = keyed(p, 0x11);
+	p->io.udelay(p->io.ctx, 30000);                         /* the vendor's 10 ms and a frame more */
+	if (err != SBD_DSIM_OK) {
+		return err;
+	}
+	p->asleep = false;
+	if (p->level >= 0) {
+		(void)sbd_panel_set_brightness(p, p->level);
+	}
+	p->io.udelay(p->io.ctx, 20000);
+	return sbd_panel_display(p, true);
+}
+
+int
+sbd_panel_read_id(struct sbd_panel *p, uint8_t id[3])
+{
+	int n = sbd_dsim_dcs_read(&p->io, 0x04, id, 3, &p->stats);
+
+	return n == 3 ? SBD_DSIM_OK : (n < 0 ? n : SBD_DSIM_RX_ERROR);
+}
diff --git a/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_panel.h b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_panel.h
new file mode 100644
index 00000000..fb1d2cb7
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_panel.h
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * Samsung S6E3HA8 (Galaxy S9, 1440 x 2960 AMOLED, MIPI command mode, DSC) through sbd_dsim: brightness by AOR
+ * (the method S-Boot itself uses on this phone), display on/off, sleep in/out, panel ID.
+ *
+ * Every command goes through one allow-list. Registers that write the panel's flash, its calibration or its
+ * supply voltages can never be sent from this driver.
+ */
+#ifndef SBD_PANEL_H
+#define SBD_PANEL_H
+
+#include "sbd_dsim.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SBD_PANEL_AOR_MIN       0x000cu         /* brightest: the vendor's 400-nit AOR */
+#define SBD_PANEL_AOR_DIMMEST   0x0b76u         /* the vendor's 2-nit AOR: level 0 */
+#define SBD_PANEL_AOR_MAX       0x0ba3u         /* S-Boot's darkest; never above (the frame is 2979 lines) */
+#define SBD_PANEL_LINES         2979u           /* vertical total: AOR counts dark lines of it */
+
+struct sbd_panel {
+	struct sbd_io io;
+	struct sbd_dsim_stats stats;
+	int      level;                 /* last brightness set, 0-255; -1 never */
+	uint32_t aor;                   /* last AOR sent */
+	bool     display_off, asleep;
+	uint32_t refused;               /* commands the allow-list stopped */
+};
+
+void sbd_panel_init(struct sbd_panel *p, const struct sbd_io *io);
+
+/* May this DCS command byte be sent at all? */
+bool sbd_panel_cmd_allowed(uint8_t cmd);
+
+/* Brightness level 0-255 -> AOR (0x0b76 .. 0x000c), monotonic, light roughly with the square of the level. */
+uint32_t sbd_panel_aor_for_level(int level);
+
+/* F0 5A 5A, B1 hi lo, F7 03, F0 A5 A5. One retry of the whole sequence; the key is always locked again. */
+int sbd_panel_set_aor(struct sbd_panel *p, uint32_t aor);
+int sbd_panel_set_brightness(struct sbd_panel *p, int level);
+
+/* Display off (28) / on (29) between the level-1 key. The panel keeps its memory and its link. */
+int sbd_panel_display(struct sbd_panel *p, bool on);
+
+/* Sleep in (10) / out (11) between the level-1 key, with the vendor's waits. Off unless asked (NOTES.md). */
+int sbd_panel_sleep(struct sbd_panel *p, bool in);
+
+/* DCS 04, three bytes. This phone's panel answers 91 04 44. */
+int sbd_panel_read_id(struct sbd_panel *p, uint8_t id[3]);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* SBD_PANEL_H */
diff --git a/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_regs.h b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_regs.h
new file mode 100644
index 00000000..e0835489
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_regs.h
@@ -0,0 +1,150 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * Exynos 9810 display registers used by StarbiteDisplay. Offsets and bit positions are hardware facts;
+ * NOTES.md lists the source of each ([V] verified in a source we hold, [S] stated by an earlier port's public driver,
+ * [I] inferred). No code was taken from the GPL sources that document them.
+ */
+#ifndef SBD_REGS_H
+#define SBD_REGS_H
+
+/* ---- DECON_F (SBD_BLK_DECON) ---- */
+#define DECON_GLOBAL_CONTROL            0x0000
+#define  DECON_GC_CMD_MODE              (1u << 8)       /* MIPI command mode */
+#define  DECON_GC_IDLE                  (1u << 5)
+#define  DECON_GC_RUN                   (1u << 4)
+#define DECON_INT_ENABLE                0x0040
+#define  DECON_INT_FRAME_DONE           (1u << 13)
+#define  DECON_INT_FRAME_START          (1u << 12)
+#define  DECON_INT_EXTRA                (1u << 4)
+#define  DECON_INT_EN                   (1u << 0)
+#define  DECON_INT_ENABLE_MASK          0x3111u
+#define DECON_EXTRA_INT_ENABLE          0x0044
+#define  DECON_XINT_CONFLICT            (1u << 8)       /* resource conflict */
+#define  DECON_XINT_TIMEOUT             (1u << 4)
+#define DECON_INT_PENDING               0x004c          /* write 1 to clear */
+#define DECON_EXTRA_INT_PENDING         0x0050          /* write 1 to clear */
+#define DECON_SHADOW_REQ                0x0060          /* cleared by hardware when the update is taken */
+#define  DECON_SHADOW_GLOBAL            (1u << 31)
+#define  DECON_SHADOW_WINS              0x3fu
+#define  DECON_SHADOW_ALL               (DECON_SHADOW_GLOBAL | DECON_SHADOW_WINS)
+#define DECON_TRIG_CONTROL              0x0070
+#define  DECON_HW_TRIG_ACTIVE_VALUE     (1u << 13)
+#define  DECON_HW_TRIG_EDGE_POLARITY    (1u << 12)
+#define  DECON_SW_TRIG_EN               (1u << 8)
+#define  DECON_HW_TRIG_MASK             (1u << 4)       /* TE ignored: the panel shows its own memory */
+#define  DECON_HW_TRIG_EN               (1u << 0)
+#define DECON_DATA_PATH_0               0x0214          /* bit 4w: window w on */
+#define DECON_DATA_PATH_1               0x0218          /* bits 4w..4w+2: window w's DMA channel */
+#define DECON_FRAME_COUNT               0x02a0
+#define DECON_WIN_START(w)              (0x1008u + 0x30u * (w)) /* y << 16 | x */
+#define DECON_WIN_END(w)                (0x100cu + 0x30u * (w)) /* last line << 16 | last column */
+#define DECON_WINDOWS                   6
+
+/* ---- DPU_DMA (SBD_BLK_IDMA), per channel block ---- */
+#define IDMA_CH(type)                   (0x1000u * ((type) + 1u))
+#define IDMA_ENABLE                     0x0000
+#define  IDMA_SFR_UPDATE_FORCE          (1u << 4)
+#define  IDMA_OP_BUSY                   (1u << 2)
+#define IDMA_IRQ                        0x0004
+#define  IDMA_IRQ_CONFIG_ERROR          (1u << 21)
+#define  IDMA_IRQ_READ_SLAVE_ERROR      (1u << 19)
+#define  IDMA_IRQ_DEADLOCK              (1u << 17)
+#define  IDMA_IRQ_ERRORS                (IDMA_IRQ_CONFIG_ERROR | IDMA_IRQ_READ_SLAVE_ERROR | IDMA_IRQ_DEADLOCK)
+#define IDMA_IN_CON                     0x0008
+#define  IDMA_IN_IC_MAX_MASK            (0xffu << 19)
+#define  IDMA_IN_FORMAT_SHIFT           11
+#define  IDMA_IN_FORMAT_MASK            (0x1fu << 11)
+#define  IDMA_IN_ROT_FLIP_MASK          (7u << 8)
+#define  IDMA_IN_AFBC_MASK              (3u << 6)
+#define  IDMA_IN_BLOCK_EN               (1u << 3)
+#define IDMA_OUT_CON                    0x000c
+#define IDMA_SRC_SIZE                   0x0010          /* height << 16 | stride in pixels */
+#define IDMA_SRC_OFFSET                 0x0014
+#define IDMA_IMG_SIZE                   0x0018          /* height << 16 | width */
+#define IDMA_BASE_Y                     0x0040          /* 32-bit physical address */
+#define IDMA_BASE_C                     0x0044
+#define IDMA_DEADLOCK_NUM               0x0050
+#define IDMA_BUS_CON                    0x0054
+#define IDMA_DYN_GATING                 0x0058
+#define IDMA_REQ_DEST                   0x0068
+#define IDMA_CFG_ERR                    0x0870          /* 11 bits */
+
+/* IDMA_IN_CON format codes */
+#define IDMA_FMT_ARGB8888               0
+#define IDMA_FMT_ABGR8888               1
+#define IDMA_FMT_RGBA8888               2
+#define IDMA_FMT_BGRA8888               3
+#define IDMA_FMT_XRGB8888               4
+#define IDMA_FMT_ARGB2101010            16
+#define IDMA_FMT_ABGR2101010            17
+#define IDMA_FMT_RGBA2101010            18
+#define IDMA_FMT_BGRA2101010            19
+
+/* ---- DPP (SBD_BLK_DPP), per channel block ---- */
+#define DPP_CH(type)                    (0x1000u * ((type) + 1u))
+#define DPP_ENABLE                      0x0000
+#define  DPP_SFR_UPDATE_FORCE           (1u << 4)
+#define DPP_IRQ                         0x0004
+#define  DPP_IRQ_CONFIG_ERROR           (1u << 21)
+#define DPP_IN_CON                      0x0008
+#define  DPP_IN_KEEP                    ((1u << 3) | 7u)        /* per-pixel alpha select, format */
+#define DPP_IMG_SIZE                    0x0018
+#define DPP_SCALED_SIZE                 0x002c
+#define DPP_H_RATIO                     0x0044          /* source / destination, 12.20 */
+#define DPP_V_RATIO                     0x0048
+#define DPP_V_COEF(phase, tap, bank)    (0x200u + 4u * (phase) + 0x24u * (tap) + 0x200u * (bank))
+#define DPP_H_COEF(phase, tap, bank)    (0x290u + 4u * (phase) + 0x24u * (tap) + 0x200u * (bank))
+#define DPP_YH_POS                      0x05b0
+#define DPP_YV_POS                      0x05b4
+#define DPP_CH_POS                      0x05b8
+#define DPP_CV_POS                      0x05bc
+#define DPP_DYN_GATING                  0x0a54
+#define DPP_CFG_ERR                     0x0d08          /* 5 bits */
+
+/* Channel blocks in address order, and DATA_PATH_CONTROL_1's channel number for each. */
+#define SBD_CH_G0                       0
+#define SBD_CH_G1                       1
+#define SBD_CH_VG0                      2
+#define SBD_CH_VG1                      3
+#define SBD_CH_VGF0                     4       /* has a scaler */
+#define SBD_CH_VGF1                     5       /* scaler + HDR */
+#define SBD_PATH_CH_VGF0                1       /* DATA_PATH_CONTROL_1 value for VGF0 */
+
+/* ---- MIPI DSIM0 (SBD_BLK_DSIM) ---- */
+#define DSIM_CLK_CTRL                   0x0020
+#define  DSIM_TX_REQUEST_HSCLK          (1u << 20)      /* the loader left the link in HS */
+#define DSIM_CONFIG                     0x004c
+#define  DSIM_VIDEO_MODE                (1u << 18)
+#define DSIM_INTSRC                     0x0050          /* write 1 to clear */
+#define  DSIM_INT_PH_EMPTY              (1u << 28)      /* header FIFO drained: the packet went out */
+#define  DSIM_INT_LPRX_TIMEOUT          (1u << 21)
+#define  DSIM_INT_BTA_TIMEOUT           (1u << 20)
+#define  DSIM_INT_RX_DONE               (1u << 18)
+#define DSIM_PKTHDR                     0x0058
+#define  DSIM_PKTHDR_KEEP               0xfe000000u     /* bits the vendor and S-Boot preserve */
+#define  DSIM_PKTHDR_BTA                (1u << 24)
+#define DSIM_PAYLOAD                    0x005c
+#define DSIM_RXFIFO                     0x0060
+#define DSIM_FIFOCTRL                   0x0068          /* read only here: never written */
+#define  DSIM_FIFO_PH_COUNT(v)          (((v) >> 16) & 0x3fu)
+#define  DSIM_FIFO_RX_EMPTY             (1u << 12)
+#define  DSIM_FIFO_PH_FULL              (1u << 11)
+#define  DSIM_FIFO_PH_EMPTY             (1u << 10)
+#define  DSIM_FIFO_PL_FULL              (1u << 9)
+
+/* MIPI DSI data types */
+#define DSI_DCS_SHORT                   0x05
+#define DSI_DCS_SHORT_PARAM             0x15
+#define DSI_DCS_READ                    0x06
+#define DSI_SET_MAX_RETURN              0x37
+#define DSI_DCS_LONG                    0x39
+#define DSI_RX_ACK_ERROR                0x02
+#define DSI_RX_EOT                      0x08
+#define DSI_RX_GEN_SHORT_1              0x11
+#define DSI_RX_GEN_SHORT_2              0x12
+#define DSI_RX_GEN_LONG                 0x1a
+#define DSI_RX_DCS_LONG                 0x1c
+#define DSI_RX_DCS_SHORT_1              0x21
+#define DSI_RX_DCS_SHORT_2              0x22
+
+#endif /* SBD_REGS_H */
diff --git a/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_swap.c b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_swap.c
new file mode 100644
index 00000000..f0b084b5
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_swap.c
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/* Swap record decoding (see sbd_swap.h); the layout knowledge is SweetFramebuffer.cpp's (ours, 0046..0398). */
+#include "sbd_swap.h"
+
+static uint32_t
+get32(const uint8_t *p, uint32_t off)
+{
+	return (uint32_t)p[off] | ((uint32_t)p[off + 1] << 8) | ((uint32_t)p[off + 2] << 16) | ((uint32_t)p[off + 3] << 24);
+}
+
+bool
+sbd_swap_parse(const uint8_t *rec, uint32_t size, struct sbd_swap *out)
+{
+	uint32_t sh;
+
+	if (rec == 0 || out == 0 || size < SBD_SWAP_REC_MIN) {
+		return false;
+	}
+	sh = (get32(rec, 0x98) != 0 && get32(rec, 0x50) == 0) ? 0x48 : 0;
+	out->shift = sh;
+	out->swap_id = get32(rec, 0x50 + sh);
+	out->mask = get32(rec, 0x104 + sh);
+	out->enabled = 0;
+	for (uint32_t l = 0; l < SBD_SWAP_LAYERS; l++) {
+		struct sbd_swap_layer *y = &out->layer[l];
+		uint32_t a = 0x64 + sh + 16 * l, b = 0xc4 + sh + 16 * l;
+
+		y->surface = get32(rec, 0x54 + sh + 4 * l);
+		y->sx = (int32_t)get32(rec, a);
+		y->sy = (int32_t)get32(rec, a + 4);
+		y->sw = (int32_t)get32(rec, a + 8);
+		y->sh = (int32_t)get32(rec, a + 12);
+		y->dx = (int32_t)get32(rec, b);
+		y->dy = (int32_t)get32(rec, b + 4);
+		y->dw = (int32_t)get32(rec, b + 8);
+		y->dh = (int32_t)get32(rec, b + 12);
+		y->enabled = (out->mask & (1u << l)) != 0 && y->surface != 0;
+		out->enabled += y->enabled ? 1 : 0;
+	}
+	return true;
+}
+
+bool
+sbd_swap_single_full_layer(const struct sbd_swap *s, uint32_t canvas_w, uint32_t canvas_h, uint32_t surface_w,
+    uint32_t surface_h)
+{
+	const struct sbd_swap_layer *y = &s->layer[0];
+	int32_t w, h;
+
+	if (s->enabled != 1 || !y->enabled) {
+		return false;
+	}
+	if (surface_w != canvas_w || surface_h != canvas_h) {
+		return false;
+	}
+	/* an empty destination rectangle means "the whole surface" (SweetFramebuffer's reading) */
+	w = y->dw > 0 ? y->dw : (int32_t)surface_w;
+	h = y->dh > 0 ? y->dh : (int32_t)surface_h;
+	if (y->sx > 0 || y->sy > 0 || y->dx > 0 || y->dy > 0) {
+		return false;
+	}
+	return w == (int32_t)canvas_w && h == (int32_t)canvas_h;
+}
diff --git a/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_swap.h b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_swap.h
new file mode 100644
index 00000000..b9f5a880
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteDisplay/hw/sbd_swap.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * The IOMobileFramebuffer swap record (selector 5, SwapEnd / swap_submit) as AppleCLCD has decoded it since
+ * patch 0046: the fields CoreAnimation fills that this driver uses. Two layouts are known:
+ *   iOS 16 (0x46c bytes), macOS 13 (0x468):   swap id 0x50, surfaces 0x54, rects 0x64 / 0xc4, layer mask 0x104
+ *   iPadOS 18 (0x514), iOS 26 and macOS 26.5 (0x588): the same fields 0x48 further in
+ * The second is told from the first by the swap id: 0x98 set and 0x50 zero.
+ */
+#ifndef SBD_SWAP_H
+#define SBD_SWAP_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SBD_SWAP_REC_MIN        0x400u          /* the shortest record taken */
+#define SBD_SWAP_REC_MAX        0x600u
+#define SBD_SWAP_LAYERS         4
+
+struct sbd_swap_layer {
+	bool     enabled;               /* in the mask and a surface named */
+	uint32_t surface;               /* IOSurface id */
+	int32_t  sx, sy, sw, sh;        /* rect a: source */
+	int32_t  dx, dy, dw, dh;        /* rect b: destination on the canvas */
+};
+
+struct sbd_swap {
+	uint32_t swap_id;
+	uint32_t mask;
+	uint32_t shift;                 /* 0 or 0x48 */
+	uint32_t enabled;               /* number of enabled layers */
+	struct sbd_swap_layer layer[SBD_SWAP_LAYERS];
+};
+
+/* rec must hold SBD_SWAP_REC_MAX bytes (zero-filled past what the client sent). False: size too small. */
+bool sbd_swap_parse(const uint8_t *rec, uint32_t size, struct sbd_swap *out);
+
+/* Is this swap one full-canvas layer 0 and nothing else (the case a DECON window can show by address)? */
+bool sbd_swap_single_full_layer(const struct sbd_swap *s, uint32_t canvas_w, uint32_t canvas_h,
+    uint32_t surface_w, uint32_t surface_h);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* SBD_SWAP_H */
