From be9bfe940c03029e2499f8a5bdb008edfc6df553 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Thu, 12 Nov 2026 06:29:03 +0200
Subject: [PATCH] patch: 0437-starlte-deadman-flush.patch - when the 0421
 dead-man fires (sweetreboot + 60 s, or no frame on the panel at sbnoui=) a
 thread saves what the sweetreboot reset would (the kernel log to the card
 with sdlog=1, the console tail to pmsg) and resets into TWRP; the unfed
 watchdog still backs it up (S1e 2026-11-12: the no-frame dead-man let the
 watchdog reset with nothing saved)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/dev/herolte_ufs.c | 33 +++++++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/bsd/dev/herolte_ufs.c b/bsd/dev/herolte_ufs.c
index dda3eed6..c1d9a81a 100644
--- a/bsd/dev/herolte_ufs.c
+++ b/bsd/dev/herolte_ufs.c
@@ -1378,6 +1378,37 @@ starlte_sbstop_now(const char *stage)
 }
 STARTUP(KMEM, STARTUP_RANK_FIRST, starlte_reboot_early);
 
+/*
+ * 0437 (S1e 2026-11-12: the no-frame dead-man stopped feeding at 300 s and the watchdog reset ~53 s later with
+ * nothing saved: no sdlog, pmsg only the loader's next boot): when the dead-man fires, a thread does what the
+ * sweetreboot reset does (the kernel log to the card with sdlog=1, the console tail to pmsg, TWRP), the stopped
+ * watchdog still backing it up if the system is too far gone. No file dump: it can block on the card queue.
+ */
+static void
+starlte_deadman_flush_thread(void *arg, __unused wait_result_t wr)
+{
+	extern struct msgbuf *msgbufp;
+	extern int starlte_sd_dump_log(const void *, uint32_t, uint32_t);
+	extern void starlte_sd_park(void);
+
+	printf("STARBITE HEALTH: dead-man (%s): kernel log to the card, console tail to pmsg, reset to recovery (0437)\n",
+	    (const char *)arg);
+	int lr = starlte_sd_dump_log(msgbufp->msg_bufc, (uint32_t)msgbufp->msg_size, (uint32_t)msgbufp->msg_bufx);
+	printf("HEROLTE LOG: kernel log to card: %d\n", lr);
+	starlte_sd_park();
+	starlte_pmsg_save("STARBITE: dead-man (no panic), console tail:\n", NULL, false);
+	starlte_reset_to_recovery();
+}
+
+static void
+starlte_deadman_flush(const char *why)
+{
+	thread_t th;
+	if (kernel_thread_start(starlte_deadman_flush_thread, (void *)(uintptr_t)why, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
+
 static void
 starlte_wdt_tick(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
 {
@@ -1403,6 +1434,7 @@ starlte_wdt_tick(__unused thread_call_param_t p0, __unused thread_call_param_t p
 		starlte_wdt_stop = true;
 		printf("STARBITE HEALTH: dead-man: sweetreboot=%u + 60 s passed without the reset, feeding stopped\n",
 		    starlte_sweetreboot_s);
+		starlte_deadman_flush("sweetreboot + 60 s");
 		return;
 	}
 	if (starlte_noui_abs != 0 && mach_absolute_time() >= starlte_noui_abs) {
@@ -1410,6 +1442,7 @@ starlte_wdt_tick(__unused thread_call_param_t p0, __unused thread_call_param_t p
 		if (sweet_fb_first_present == 0) {
 			starlte_wdt_stop = true;
 			printf("STARBITE HEALTH: dead-man: no frame on the panel after sbnoui, feeding stopped\n");
+			starlte_deadman_flush("no frame after sbnoui");
 			return;
 		}
 		starlte_noui_abs = 0;
-- 
