+		/* 0462: up the interrupted thread's kernel stack by frame pointers (only inside that stack) */
+		uint64_t fp = get_saved_state_fp(st), ret[5] = { 0, 0, 0, 0, 0 };
+		vm_offset_t lo = th->kernel_stack, hi = lo + kernel_stack_size;
