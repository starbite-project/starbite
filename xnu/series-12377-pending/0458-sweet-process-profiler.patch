+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+/*
+ * 0458: a sampling profiler for one process. S5v 2026-11-15: the display path is fast now, yet window drags,
+ * scrolling and animations stay slow; S5a's numbers say WindowServer burns ~150 ms of CPU a frame, and nothing
+ * on the phone can say where. Boot-arg sweetprof=NAME (e.g. WindowServer): a kernel thread interrupts the other
+ * cores 500 times a second (cross-call); on each, if the interrupted thread belongs to NAME, the interrupted pc
+ * and lr are counted (16-byte buckets), user and kernel apart. Every 10 s with enough samples (STARLTE TOP's
+ * loop calls sweet_prof_report):
+ *   SWEET PROF name[pid]: N samples (user U kernel K; other O idle I; dropped D) slide 0x.. mh 0x.. kslide 0x..
+ *   SWEET PROF t: tid:count:name ...            the busiest threads
+ *   SWEET PROF u: pc:lr:count ...               user buckets, busiest first (shared cache addresses include the slide)
+ *   SWEET PROF k: pc:lr:count ...               kernel buckets (unslid)
+ *   SWEET PROF img 0x<load address> <path>      once: the images outside the shared cache
+ * tools/macos/prof-report.py turns the lines into functions.
+ */
+#include <arm/cpu_data_internal.h>
+#include <arm/machine_routines.h>
+#include <arm/cpu_internal.h>
+#include <kern/clock.h>
+
+#define SWEET_PROF_USLOTS 16384
+#define SWEET_PROF_KSLOTS 4096
+#define SWEET_PROF_TIDS   64
+struct sweet_prof_slot { uint64_t key; uint32_t count; };
+static struct sweet_prof_slot sweet_prof_u[SWEET_PROF_USLOTS], sweet_prof_k[SWEET_PROF_KSLOTS], sweet_prof_t[SWEET_PROF_TIDS];
+static task_t sweet_prof_task;                  /* compared only, never followed */
+static char sweet_prof_name[32];
+static uint32_t sweet_prof_user, sweet_prof_kern, sweet_prof_other, sweet_prof_idle, sweet_prof_dropped;
+static uint32_t sweet_prof_paused, sweet_prof_started;
+static int sweet_prof_chan;
+
+static void
+sweet_prof_add(struct sweet_prof_slot *table, uint32_t slots, uint64_t key)
+{
+	uint32_t i = (uint32_t)((key * 0x9E3779B97F4A7C15ULL) >> 40) & (slots - 1);
+	for (uint32_t probe = 0; probe < 48; probe++, i = (i + 1) & (slots - 1)) {
+		uint64_t k = os_atomic_load(&table[i].key, relaxed);
+		if (k == 0) {
+			if (os_atomic_cmpxchgv(&table[i].key, 0, key, &k, relaxed)) {
+				k = key;
+			}
+		}
+		if (k == key) {
+			os_atomic_inc(&table[i].count, relaxed);
+			return;
+		}
+	}
+	os_atomic_inc(&sweet_prof_dropped, relaxed);
+}
+
+/* on every other core, in its interrupt: what did the interrupt stop? */
+static void
+sweet_prof_xcall(__unused void *arg)
+{
+	arm_saved_state_t *st = (arm_saved_state_t *)getCpuDatap()->cpu_int_state;
+	thread_t th = current_thread();
+	if (st == NULL || th == THREAD_NULL || os_atomic_load(&sweet_prof_paused, relaxed)) {
+		return;
+	}
+	if (get_threadtask(th) != sweet_prof_task || sweet_prof_task == TASK_NULL) {
+		if (th->state & TH_IDLE) {
+			os_atomic_inc(&sweet_prof_idle, relaxed);
+		} else {
+			os_atomic_inc(&sweet_prof_other, relaxed);
+		}
+		return;
+	}
+	uint64_t pc = get_saved_state_pc(st), lr = get_saved_state_lr(st);
+	if (PSR64_IS_USER(get_saved_state_cpsr(st))) {
+		os_atomic_inc(&sweet_prof_user, relaxed);
+		sweet_prof_add(sweet_prof_u, SWEET_PROF_USLOTS, ((pc >> 4) & 0xffffffffULL) | (((lr >> 4) & 0xffffffffULL) << 32) | 1ULL << 63);
+	} else {
+		os_atomic_inc(&sweet_prof_kern, relaxed);
+		pc = VM_KERNEL_UNSLIDE(pc) - 0xfffffff000000000ULL;
+		lr = VM_KERNEL_UNSLIDE(lr) - 0xfffffff000000000ULL;
+		sweet_prof_add(sweet_prof_k, SWEET_PROF_KSLOTS, ((pc >> 4) & 0xffffffffULL) | (((lr >> 4) & 0xffffffffULL) << 32) | 1ULL << 63);
+	}
+	sweet_prof_add(sweet_prof_t, SWEET_PROF_TIDS, thread_tid(th) | 1ULL << 63);
 }
 
+static void
+sweet_prof_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t interval = 0;
+	static int parm;
+	nanoseconds_to_absolutetime(2 * NSEC_PER_MSEC, &interval);
+	for (;;) {
+		assert_wait_deadline((event_t)&sweet_prof_chan, THREAD_UNINT, mach_absolute_time() + interval);
+		thread_block(THREAD_CONTINUE_NULL);
+		if (sweet_prof_task == TASK_NULL || os_atomic_load(&sweet_prof_paused, relaxed)) {
+			continue;
+		}
+		/* each started core but this one; never wait for one (a core that still has a cross-call pending or
+		 * takes none is skipped: cpu_signal would spin for it with interrupts off) */
+		disable_preemption();
+		int self = cpu_number(), max = ml_get_max_cpu_number();
+		for (int c = 0; c <= max; c++) {
+			cpu_data_t *t = (cpu_data_t *)CpuDataEntries[c].cpu_data_vaddr;
+			if (c == self || t == NULL || (os_atomic_load(&t->cpu_signal, relaxed) & (SIGPdisabled | SIGPxcall)) != 0) {
+				continue;
+			}
+			kern_return_t kr = cpu_xcall(c, sweet_prof_xcall, &parm);
+			(void)kr;
+		}
+		enable_preemption();
+	}
+}
+
+/* the busiest buckets of a table as "pc:lr:count", ten a line; the table is emptied */
+static void
+sweet_prof_dump(const char *tag, struct sweet_prof_slot *table, uint32_t slots, unsigned max, uint64_t base, uint32_t least)
+{
+	char line[420];
+	int n = 0;
+	for (unsigned k = 0; k < max; k++) {
+		uint32_t best = slots;
+		for (uint32_t i = 0; i < slots; i++) {
+			if (table[i].count != 0 && (best == slots || table[i].count > table[best].count)) {
+				best = i;
+			}
+		}
+		if (best == slots || table[best].count < least) {
+			break;
+		}
+		uint64_t key = table[best].key;
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " %llx:%llx:%u", base + ((key & 0xffffffffULL) << 4),
+		    base + (((key >> 32) & 0x7fffffffULL) << 4), table[best].count);
+		table[best].count = 0;
+		if (n > (int)sizeof(line) - 44) {
+			printf("SWEET PROF %s:%s\n", tag, line);
+			n = 0;
+		}
+	}
+	if (n != 0) {
+		printf("SWEET PROF %s:%s\n", tag, line);
+	}
+	bzero(table, sizeof(table[0]) * slots);
+}
+
+extern void bsd_getthreadname(void *uth, char *buffer);
+
+/* STARLTE TOP's loop (bsd/dev/starlte_smp.c), every 10 s for each process: name is the boot-arg's process? */
+void sweet_prof_report(const char *name, int pid, task_t task);
+void
+sweet_prof_report(const char *name, int pid, task_t task)
+{
+	static int state;               /* 0 not looked, 1 off, 2 on */
+	static int imgs_pid = -1;
+	if (state == 0) {
+		state = PE_parse_boot_argn("sweetprof", sweet_prof_name, sizeof(sweet_prof_name)) && sweet_prof_name[0] ? 2 : 1;
+	}
+	if (state != 2 || strncmp(name, sweet_prof_name, sizeof(sweet_prof_name)) != 0) {
+		return;
+	}
+	if (!sweet_prof_started) {
+		thread_t th;
+		sweet_prof_started = 1;
+		sweet_prof_task = task;
+		if (kernel_thread_start_priority(sweet_prof_thread, NULL, MAXPRI_KERNEL, &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+			printf("SWEET PROF: sampling %s[%d] 500 times a second on every core\n", name, pid);
+		}
+		return;
+	}
+	os_atomic_store(&sweet_prof_paused, 1, relaxed);
+	uint32_t user = os_atomic_xchg(&sweet_prof_user, 0, relaxed), kern = os_atomic_xchg(&sweet_prof_kern, 0, relaxed);
+	uint32_t other = os_atomic_xchg(&sweet_prof_other, 0, relaxed), idle = os_atomic_xchg(&sweet_prof_idle, 0, relaxed);
+	uint32_t dropped = os_atomic_xchg(&sweet_prof_dropped, 0, relaxed);
+	if (task != sweet_prof_task) {
+		sweet_prof_task = task;         /* the process was started again */
+		imgs_pid = -1;
+		user = kern = 0;
+	}
+	if (user + kern >= 250) {
+		uint64_t slide = 0;
+		vm_shared_region_t sr = vm_shared_region_get(task);
+		if (sr != NULL) {
+			slide = sr->sr_slide;
+			vm_shared_region_deallocate(sr);
+		}
+		extern vm_offset_t vm_kernel_slide;
+		printf("SWEET PROF %s[%d]: %u samples (user %u kernel %u; other %u idle %u; dropped %u) slide 0x%llx mh 0x%llx kslide 0x%lx\n",
+		    name, pid, user + kern, user, kern, other, idle, dropped, slide, task->mach_header_vm_address,
+		    (unsigned long)vm_kernel_slide);
+		/* the busiest threads, with their names */
+		char line[420];
+		int n = 0;
+		for (unsigned k = 0; k < 8; k++) {
+			uint32_t best = SWEET_PROF_TIDS;
+			for (uint32_t i = 0; i < SWEET_PROF_TIDS; i++) {
+				if (sweet_prof_t[i].count != 0 && (best == SWEET_PROF_TIDS || sweet_prof_t[i].count > sweet_prof_t[best].count)) {
+					best = i;
+				}
+			}
+			if (best == SWEET_PROF_TIDS) {
+				break;
+			}
+			uint64_t tid = sweet_prof_t[best].key & ~(1ULL << 63);
+			char tname[64] = "";
+			thread_t thread;
+			task_lock(task);
+			queue_iterate(&task->threads, thread, thread_t, task_threads) {
+				if (thread_tid(thread) == tid && get_bsdthread_info(thread) != NULL) {
+					bsd_getthreadname(get_bsdthread_info(thread), tname);
+					break;
+				}
+			}
+			task_unlock(task);
+			tname[40] = 0;
+			for (char *c = tname; *c; c++) {
+				if (*c == ' ' || *c == ':') {
+					*c = '_';
+				}
+			}
+			n += snprintf(line + n, sizeof(line) - (size_t)n, " %llx:%u:%s", tid, sweet_prof_t[best].count, tname[0] ? tname : "-");
+			sweet_prof_t[best].count = 0;
+			if (n > (int)sizeof(line) - 80) {
+				break;
+			}
+		}
+		printf("SWEET PROF t:%s\n", line);
+		sweet_prof_dump("u", sweet_prof_u, SWEET_PROF_USLOTS, 260, 0, 2);
+		sweet_prof_dump("k", sweet_prof_k, SWEET_PROF_KSLOTS, 80, 0xfffffff000000000ULL, 2);
+		/* once per process: where its images outside the shared cache are (dyld's all_image_infos) */
+		if (imgs_pid != pid && task->all_image_info_addr != 0) {
+			vm_map_t map = get_task_map(task);
+			struct { uint32_t version, count; uint64_t array; } hdr;
+			imgs_pid = pid;
+			if (vm_map_read_user(map, task->all_image_info_addr, &hdr, sizeof(hdr)) == KERN_SUCCESS && hdr.array != 0) {
+				uint32_t shown = 0;
+				for (uint32_t i = 0; i < hdr.count && i < 4096 && shown < 40; i++) {
+					uint64_t e[3];
+					char path[128];
+					if (vm_map_read_user(map, hdr.array + 24ULL * i, e, sizeof(e)) != KERN_SUCCESS) {
+						break;
+					}
+					if (e[0] >= 0x180000000ULL + slide || e[1] == 0) {
+						continue;       /* in the shared cache */
+					}
+					bzero(path, sizeof(path));
+					/* (the path may end before 127 bytes at a page end: then read what is there) */
+					uint64_t room = 0x4000 - (e[1] & 0x3fff);
+					if (vm_map_read_user(map, e[1], path, room < sizeof(path) - 1 ? room : sizeof(path) - 1) != KERN_SUCCESS) {
+						continue;
+					}
+					printf("SWEET PROF img 0x%llx %s\n", e[0], path);
+					shown++;
+				}
+			}
+		}
+	}
+	bzero(sweet_prof_t, sizeof(sweet_prof_t));
+	if (user + kern < 250) {
+		bzero(sweet_prof_u, sizeof(sweet_prof_u));
+		bzero(sweet_prof_k, sizeof(sweet_prof_k));
+	}
+	os_atomic_store(&sweet_prof_paused, 0, relaxed);
+}
