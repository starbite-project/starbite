+		uint32_t us = 0;
+		PE_parse_boot_argn("sgspin", &us, sizeof(us));
+		nanoseconds_to_absolutetime((uint64_t)(us > 5000 ? 5000 : us) * NSEC_PER_USEC, &spin_abs);
+	}
 	for (unsigned i = 0; i < sg_run_polls; i++) {
 		jirq = sg_rd(sg_gpu, JOB_IRQ_RAWSTAT);
 		mirq = sg_rd(sg_gpu, MMU_IRQ_RAWSTAT);
 		girq = sg_rd(sg_gpu, GPU_IRQ_RAWSTAT);
 		if ((jirq & ((1u << js) | (1u << (js + 16)))) || mirq || (girq & 0x81)) {
 			break;
+		}
+		if (spin_abs != 0 && mach_absolute_time() - t0 < spin_abs) {
+			i--;                    /* spinning: these reads do not count against the poll bound */
+			continue;
 		}
 		delay(10);
 	}
