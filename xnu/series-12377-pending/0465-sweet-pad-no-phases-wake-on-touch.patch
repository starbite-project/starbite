 /*
+ * 0465: the scripted gestures of sweetpadtest. Fingers start at y 1700 (above the on-screen keyboard and the
+ * summon zone): a two-finger scroll up, one down, 20 s (S6i: AppKit's abort came 10-25 s after a scroll), two
+ * three-finger swipes up (Mission Control in and out), a scroll up, 25 s, a scroll down; then once more after 30 s,
+ * and a third time 700 s after boot.
+ */
+void
+SweetHIDTouch::padTestFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	static const struct { int fingers, moves, dy, wait_ms; } segs[] = {
+		{ 2, 30, -25, 3000 }, { 2, 30, 25, 20000 }, { 3, 12, -30, 4000 }, { 3, 12, -30, 5000 },
+		{ 2, 30, -25, 25000 }, { 2, 30, 25, 30000 },
+	};
+	const int nsegs = (int)(sizeof(segs) / sizeof(segs[0]));
+	SweetHIDTouch *self = (SweetHIDTouch *)owner;
+	int seg = self->fPadTestSeg % nsegs, i = self->fTouchTestStep++;
+	int n = segs[seg].moves;
+	if (i == 0) {
+		IOLog("SWEET HID: pad test %d: %s\n", self->fPadTestSeg, segs[seg].fingers == 2 ? "two-finger scroll" : "three-finger swipe");
+	}
+	if (i <= n) {
+		for (int f = 0; f < segs[seg].fingers; f++) {
+			self->touch(f, true, 420 + 300 * f, 1700 + segs[seg].dy * i);
+		}
+		sender->setTimeoutMS(16);
+		return;
+	}
+	for (int f = segs[seg].fingers - 1; f >= 0; f--) {
+		self->touch(f, false, 420 + 300 * f, 1700 + segs[seg].dy * n);
+	}
+	self->fTouchTestStep = 0;
+	self->fPadTestSeg++;
+	if (self->fPadTestSeg == 2 * nsegs) {
+		/* a third round 700 s after boot: macOS's 10-minute display sleep has come by then, so its first touch
+		 * must wake the display (0465) and the first GPU jobs after the idle time are seen (S6i: one hung 5.7 s) */
+		uint64_t up = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time(), &up);
+		if (up / NSEC_PER_MSEC < 700000ULL) {
+			sender->setTimeoutMS((uint32_t)(700000ULL - up / NSEC_PER_MSEC));
+			IOLog("SWEET HID: pad test: a third round at 700 s\n");
+		} else {
+			IOLog("SWEET HID: pad test done\n");
+		}
+	} else if (self->fPadTestSeg < 3 * nsegs) {
+		sender->setTimeoutMS((uint32_t)segs[seg].wait_ms);
+	} else {
+		IOLog("SWEET HID: pad test done\n");
+	}
+}
