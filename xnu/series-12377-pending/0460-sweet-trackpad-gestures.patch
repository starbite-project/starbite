+#define SWEET_PAD_SCROLL_START  40      /* panel pixels of two-finger movement before it is a scroll (a tap's jitter is less) */
+#define SWEET_PAD_SWIPE3        150     /* panel pixels of three-finger movement that make a swipe */
+#define SWEET_PAD_MOM_MIN       13107   /* 0.2 points/ms (16.16): slower lifts leave no momentum */
+#define SWEET_PAD_MOM_STOP      1966    /* 0.03 points/ms: momentum ends */
+#define SWEET_PAD_OPT_PIXELS    kIOHIDEventOptionIsPixelUnits
+#define SWEET_PAD_PHASE(p)      ((IOOptionBits)(p) << kIOHIDEventEventOptionPhaseShift)
+#define SWEET_PAD_MOMENTUM(m)   ((IOOptionBits)(m) << kIOHIDEventScrollMomentumShift)
 
+/* the scroll gesture ends (lock held): the Ended event, and momentum if the fingers left fast */
+static IOHIDEvent *
+sweet_pad_scroll_end(uint64_t now)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(now - pad.lastMoveAt, &ns);
+	int64_t ax = pad.velX < 0 ? -pad.velX : pad.velX, ay = pad.velY < 0 ? -pad.velY : pad.velY;
+	pad.scrolling = false;
+	pad.scAccX = pad.scAccY = 0;
+	if (ns < 80ULL * NSEC_PER_MSEC && ax + ay >= SWEET_PAD_MOM_MIN) {
+		pad.momentum = 1;
+		pad.momX = pad.velX;
+		pad.momY = pad.velY;
+	}
+	return IOHIDEvent::scrollEventWithFixed(now, 0, 0, 0, SWEET_PAD_OPT_PIXELS | SWEET_PAD_PHASE(kIOHIDEventPhaseEnded));
+}
