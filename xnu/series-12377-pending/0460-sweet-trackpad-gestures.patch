+/*
+ * 0460: the trackpad's gestures as a Mac trackpad has them (boot-arg sweetpad=1; 0, the default for now, keeps
+ * 0445's line scrolling):
+ *   two fingers: scrolling in points, 1:1 with the fingers, as scroll events with pixel units and gesture
+ *     phases (Began / Changed / Ended) and, after a quick lift, momentum events that die away (the timer);
+ *     AppKit then scrolls smoothly and rubber-bands instead of jumping three lines at a time;
+ *   three fingers: one swipe a gesture: up = Mission Control (control-up), down = the app's windows
+ *     (control-down), left / right = the next / previous Space or full-screen app (control-right / -left),
+ *     sent as keys of the on-screen keyboard's HID service.
+ * sweetuiscale=N: canvas pixels a point (default 2 for a canvas 1200 or more wide, else 1).
+ */
+static int
+sweet_pad_gestures(void)
+{
+	static int on = -1;
+	if (on < 0) {
+		on = 0;
+		PE_parse_boot_argn("sweetpad", &on, sizeof(on));
+	}
+	return on;
+}
+
+static int
+sweet_ui_scale(int canvas_w)
+{
+	static int scale = -1;
+	if (scale < 0) {
+		scale = 0;
+		PE_parse_boot_argn("sweetuiscale", &scale, sizeof(scale));
+		if (scale < 1 || scale > 4) {
+			scale = canvas_w >= 1200 ? 2 : 1;
+		}
+	}
+	return scale;
+}
