diff --git a/bsd/dev/herolte_ufs.c b/bsd/dev/herolte_ufs.c
index cd61177b..dda3eed6 100644
--- a/bsd/dev/herolte_ufs.c
+++ b/bsd/dev/herolte_ufs.c
@@ -1324,6 +1324,49 @@ starlte_sbstop_no_root(void)
 	return 1;
 }
 
+/*
+ * 0427: sbstop_s=S, a stage's time limit. A test whose stage depends on something outside the phone (M11a: a host
+ * that pings) may never reach it; the loader's watchdog still resets it, but leaves no log. At S s of uptime the
+ * boot stops anyway, with the console tail in pmsg, and the line says the stage was not reached. Armed by the
+ * platform expert's start (thread calls are up by then); keep S well inside the dead-man's budget.
+ */
+static thread_call_t starlte_sbstop_tc;
+static uint32_t starlte_sbstop_limit_s;
+
+static void
+starlte_sbstop_deadline(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	starlte_crumb(4, 1);
+	printf("STARBITE: sbstop=%s: STAGE NOT REACHED in sbstop_s=%u s, resetting into TWRP\n", starlte_sbstop,
+	    starlte_sbstop_limit_s);
+	delay(300 * 1000);
+	starlte_pmsg_save("STARBITE: sbstop time limit (no panic), console tail:\n", NULL, false);
+	starlte_reset(SBH_INFORM3_RECOVERY);
+}
+
+void starlte_sbstop_arm_limit(void);
+void
+starlte_sbstop_arm_limit(void)
+{
+	uint64_t now_ns = 0, deadline;
+	if (starlte_sbstop[0] == '\0' || starlte_sbstop_tc != NULL ||
+	    !PE_parse_boot_argn("sbstop_s", &starlte_sbstop_limit_s, sizeof(starlte_sbstop_limit_s)) ||
+	    starlte_sbstop_limit_s == 0) {
+		return;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time(), &now_ns);
+	uint64_t left_ms = (uint64_t)starlte_sbstop_limit_s * 1000 > now_ns / NSEC_PER_MSEC ?
+	    (uint64_t)starlte_sbstop_limit_s * 1000 - now_ns / NSEC_PER_MSEC : 1;
+	starlte_sbstop_tc = thread_call_allocate_with_priority(starlte_sbstop_deadline, NULL, THREAD_CALL_PRIORITY_HIGH);
+	if (starlte_sbstop_tc == NULL) {
+		return;
+	}
+	clock_interval_to_deadline((uint32_t)left_ms, (uint32_t)NSEC_PER_MSEC, &deadline);
+	(void)thread_call_enter_delayed(starlte_sbstop_tc, deadline);
+	printf("STARBITE: sbstop=%s: time limit sbstop_s=%u (stops in %llu ms if the stage is not reached)\n",
+	    starlte_sbstop, starlte_sbstop_limit_s, left_ms);
+}
+
 void
 starlte_sbstop_now(const char *stage)
 {
