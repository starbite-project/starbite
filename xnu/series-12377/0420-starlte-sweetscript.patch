From c83e5f5747971b5d2a68639a347f008b3b6ee61f Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Tue, 10 Nov 2026 07:29:53 +0200
Subject: [PATCH] patch: 0420-starlte-sweetscript.patch - sweetswipe=9 walks a
 UI path given in boot-arg sweetscript= (Home / tap / swipe steps at seconds
 after the first frame)

---
 bsd/dev/starlte_touch.c | 72 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 72 insertions(+)

diff --git a/bsd/dev/starlte_touch.c b/bsd/dev/starlte_touch.c
index fa05bd74..49476736 100644
--- a/bsd/dev/starlte_touch.c
+++ b/bsd/dev/starlte_touch.c
@@ -943,6 +943,77 @@ static const struct st_step st_script_tour[] = {
 	{ 335, 1, 0, 0, 0, 0 },                 /* home (shot 360) */
 };
 
+/*
+ * 0420: sweetswipe=9 takes its steps from boot-arg sweetscript=, so a test boot can walk any UI path without a
+ * kernel rebuild. Steps separated by commas, seconds after the first frame, panel pixels:
+ *   50h                Home press
+ *   60t556:1406        tap
+ *   90s720:2300:720:900  swipe x0:y0:x1:y1
+ * e.g. sweetscript=50h,60t556:1406,90s720:2300:720:900 (at most 24 steps).
+ */
+static struct st_step st_script_custom[24];
+
+static unsigned
+st_parse_num(const char **pp)
+{
+	unsigned v = 0;
+	while (**pp >= '0' && **pp <= '9') {
+		v = v * 10 + (unsigned)(**pp - '0');
+		(*pp)++;
+	}
+	return v;
+}
+
+static unsigned
+st_parse_script(void)
+{
+	char buf[256];
+	if (!PE_parse_boot_arg_str("sweetscript", buf, sizeof(buf))) {
+		return 0;
+	}
+	unsigned n = 0;
+	const char *p = buf;
+	while (*p && n < sizeof(st_script_custom) / sizeof(st_script_custom[0])) {
+		struct st_step *st = &st_script_custom[n];
+		bzero(st, sizeof(*st));
+		st->at_s = st_parse_num(&p);
+		char kind = *p ? *p++ : 0;
+		if (kind == 'h') {
+			st->home = 1;
+		} else if (kind == 't' || kind == 's') {
+			st->x0 = (int)st_parse_num(&p);
+			if (*p == ':') {
+				p++;
+			}
+			st->y0 = (int)st_parse_num(&p);
+			st->x1 = st->x0;
+			st->y1 = st->y0;
+			if (kind == 's') {
+				if (*p == ':') {
+					p++;
+				}
+				st->x1 = (int)st_parse_num(&p);
+				if (*p == ':') {
+					p++;
+				}
+				st->y1 = (int)st_parse_num(&p);
+			}
+		} else {
+			printf("STARLTE TOUCH: sweetscript: bad step %u, stopped\n", n);
+			break;
+		}
+		n++;
+		while (*p && *p != ',') {
+			p++;
+		}
+		if (*p == ',') {
+			p++;
+		}
+	}
+	printf("STARLTE TOUCH: sweetscript: %u steps\n", n);
+	return n;
+}
+
 static void
 st_script_thread(void *arg, __unused wait_result_t wr)
 {
@@ -962,6 +1033,7 @@ st_script_thread(void *arg, __unused wait_result_t wr)
 	case 2: script = (const struct st_step *)st_script_phone; count = sizeof(st_script_phone) / sizeof(st_script_phone[0]); break;
 	case 3: script = st_script_home; count = sizeof(st_script_home) / sizeof(st_script_home[0]); break;
 	case 4: script = st_script_tour; count = sizeof(st_script_tour) / sizeof(st_script_tour[0]); break;
+	case 9: script = st_script_custom; count = st_parse_script(); break;
 	default: script = (const struct st_step *)st_script; count = sizeof(st_script) / sizeof(st_script[0]); break;
 	}
 	for (unsigned i = 0; i < count; i++) {
-- 
