+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * Build unit for a Starbite S9 platform driver (docs/APPLE-S9-DRIVERS.md), STARLTE only. The driver source under
+ * StarbiteRTC/ is a verbatim copy of the main repository's starbite/apple-drivers/StarbiteRTC/
+ * (commit 4a7ec17); edit it there and copy it here again. Other boards get an empty translation unit.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+#include "StarbiteRTC/StarbiteRTC.cpp"
+#endif
diff --git a/iokit/Kernel/arm/starbite/StarbiteRTC/StarbiteRTC.cpp b/iokit/Kernel/arm/starbite/StarbiteRTC/StarbiteRTC.cpp
new file mode 100644
index 00000000..b9ff95fa
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteRTC/StarbiteRTC.cpp
@@ -0,0 +1,187 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/* StarbiteRTC (docs/APPLE-S9-DRIVERS.md Part 3 row 8): see StarbiteRTC.h, hw/s2mps18_rtc.c, NOTES.md. */
+#include "StarbiteRTC.h"
+#include "../StarbiteACPM/StarbiteACPM.h"
+#include <IOKit/IOLib.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+extern "C" int starlte_sbstop_at(const char *stage);
+extern "C" void starlte_sbstop_now(const char *stage);
+#endif
+
+#define super IORTC
+OSDefineMetaClassAndStructors(StarbiteRTC, IORTC);
+
+static StarbiteRTC *gStarbiteRTC;
+
+StarbiteRTC *
+StarbiteRTC::shared(void)
+{
+	return gStarbiteRTC;
+}
+
+int
+StarbiteRTC::opRd(void *ctx, uint8_t reg, uint8_t *v)
+{
+	StarbiteRTC *me = (StarbiteRTC *)ctx;
+	return me->fACPM->pmicRead(ACPM_PMIC_RTC, reg, v) == kIOReturnSuccess ? 0 : -1;
+}
+
+/* Policy-gated in StarbiteACPM: only UPDATE (+RUDR / +WUDR) and SEC..YEAR are writable. */
+int
+StarbiteRTC::opWr(void *ctx, uint8_t reg, uint8_t v)
+{
+	StarbiteRTC *me = (StarbiteRTC *)ctx;
+	return me->fACPM->pmicWrite(ACPM_PMIC_RTC, reg, v) == kIOReturnSuccess ? 0 : -1;
+}
+
+void
+StarbiteRTC::opDelay(void *, uint32_t us)
+{
+	IODelay(us);
+}
+
+static void
+fmt_date(uint64_t t, char *out, size_t n)
+{
+	struct s2m_tm tm;
+	s2m_unix_to_tm(t, &tm);
+	snprintf(out, n, "%04u-%02u-%02u %02u:%02u:%02u UTC", tm.year, tm.month, tm.day, tm.hour, tm.min, tm.sec);
+}
+
+static uint64_t
+uptime_s(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_SEC;
+}
+
+int
+StarbiteRTC::readNow(uint64_t *secs, const char **why)
+{
+	uint8_t r[S2M_RTC_NREGS];
+	int e = s2m_rtc_read(&fOps, secs, r, why);
+	if (e == S2M_E_IO) {
+		fReadFails++;
+	}
+	return e;
+}
+
+bool
+StarbiteRTC::start(IOService *provider)
+{
+	uint32_t on = 1, wr = 0, setTo = 0;
+	char date[40];
+	uint8_t r[S2M_RTC_NREGS] = { 0 };
+	uint64_t t = 0;
+	const char *why = "?";
+
+	if (PE_parse_boot_argn("sbrtc", &on, sizeof(on)) && on == 0) {
+		IOLog("StarbiteRTC: sbrtc=0: not started\n");
+		return false;
+	}
+	fACPM = OSDynamicCast(StarbiteACPM, provider);
+	if (fACPM == NULL || !super::start(provider)) {
+		return false;
+	}
+	fOps.ctx = this;
+	fOps.rd = opRd;
+	fOps.wr = opWr;
+	fOps.delay_us = opDelay;
+	(void)PE_parse_boot_argn("sbrtcwrite", &wr, sizeof(wr));
+	fWrite = wr != 0;
+
+	int e = s2m_rtc_read(&fOps, &t, r, &why);
+	IOLog("StarbiteRTC: S2MPS18 RTC CTRL %#x UPDATE %#x CAPSEL %#x MSEC %#x SEC %#x MIN %#x HOUR %#x WEEK %#x "
+	    "DAY %#x MONTH %#x YEAR %#x\n", r[0], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9], r[10], r[11]);
+	fValid = e == S2M_OK;
+	if (fValid) {
+		fmt_date(t, date, sizeof(date));
+		IOLog("StarbiteRTC: clock %s (%llu), %s; writes %s\n", date, t, why, fWrite ? "on" : "off (sbrtcwrite=1)");
+	} else {
+		IOLog("StarbiteRTC: clock not used: %s (%s); writes %s\n", s2m_strerror(e), why,
+		    fWrite ? "on" : "off (sbrtcwrite=1)");
+	}
+	setProperty("RTCValid", fValid);
+	setProperty("RTCWrites", fWrite);
+
+	if (PE_parse_boot_argn("sbrtcset", &setTo, sizeof(setTo)) && setTo != 0) {
+		uint64_t want = (uint64_t)setTo + uptime_s();
+		if (!fWrite) {
+			IOLog("StarbiteRTC: sbrtcset=%u ignored: needs sbrtcwrite=1\n", setTo);
+		} else {
+			e = s2m_rtc_write(&fOps, want, &why);
+			uint64_t back = 0;
+			const char *rwhy = "?";
+			int re = s2m_rtc_read(&fOps, &back, r, &rwhy);
+			fmt_date(want, date, sizeof(date));
+			IOLog("StarbiteRTC: sbrtcset: wrote %s (%llu): %s (%s); reads back %llu (%s)\n", date, want,
+			    s2m_strerror(e), why, re == S2M_OK ? back : 0ULL, rwhy);
+			fValid = re == S2M_OK;
+		}
+	}
+	gStarbiteRTC = this;
+	registerService();
+	publishResource("IORTC", this);
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+	if (starlte_sbstop_at("rtc")) {
+		starlte_sbstop_now("rtc");
+	}
+#endif
+	return true;
+}
+
+void
+StarbiteRTC::stop(IOService *provider)
+{
+	if (gStarbiteRTC == this) {
+		gStarbiteRTC = NULL;
+	}
+	super::stop(provider);
+}
+
+/* 0 when the clock cannot be read or was never set: the calendar then starts as it does today (card clock). */
+long
+StarbiteRTC::getGMTTimeOfDay(void)
+{
+	uint64_t t = 0;
+	const char *why = "?";
+	int e = readNow(&t, &why);
+	if (e != S2M_OK) {
+		static uint32_t said;
+		if (said++ < 4) {
+			IOLog("StarbiteRTC: getGMTTimeOfDay: %s (%s): 0\n", s2m_strerror(e), why);
+		}
+		return 0;
+	}
+	return (long)t;
+}
+
+void
+StarbiteRTC::setGMTTimeOfDay(long secs)
+{
+	const char *why = "?";
+	char date[40];
+	if (!fWrite || secs <= 0) {
+		return;
+	}
+	int e = s2m_rtc_write(&fOps, (uint64_t)secs, &why);
+	fmt_date((uint64_t)secs, date, sizeof(date));
+	if (e == S2M_OK) {
+		if (fWrites++ < 4) {
+			IOLog("StarbiteRTC: set to %s (%ld)\n", date, secs);
+		}
+		fValid = true;
+	} else if (fWriteFails++ < 8) {
+		IOLog("StarbiteRTC: set to %s FAILED: %s (%s)\n", date, s2m_strerror(e), why);
+	}
+}
+
+void
+StarbiteRTC::setAlarmEnable(IOOptionBits)
+{
+	/* no alarms: the alarm registers (0x0c..) are never written */
+}
diff --git a/iokit/Kernel/arm/starbite/StarbiteRTC/StarbiteRTC.h b/iokit/Kernel/arm/starbite/StarbiteRTC/StarbiteRTC.h
new file mode 100644
index 00000000..d046ecb2
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteRTC/StarbiteRTC.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * StarbiteRTC: an IORTC (public iokit/Kernel/IORTC.cpp) on the S2MPS18's RTC block, reached through StarbiteACPM
+ * (ACPM PMIC type 2). Publishes the "IORTC" resource that IOKitInitializeTime waits for; the platform expert
+ * forwards getGMTTimeOfDay / setGMTTimeOfDay here (INTEGRATION.md), as Apple's AppleARMPE does with its RTC.
+ *
+ * Boot-args:
+ *   sbrtc=0          not started (the card clock, 0393, stays the only source)
+ *   sbrtcwrite=1     setGMTTimeOfDay writes the RTC (off by default until PHONE-TEST.md M5b passed)
+ *   sbrtcset=SECS    test: write SECS + uptime once at start (needs sbrtcwrite=1), read back, log
+ *   sbstop=rtc       0423 self-stop after the first read (and after sbrtcset)
+ */
+#ifndef STARBITE_RTC_H
+#define STARBITE_RTC_H
+
+#include <IOKit/rtc/IORTCController.h>
+#include "hw/s2mps18_rtc.h"
+
+class StarbiteACPM;
+
+class StarbiteRTC : public IORTC {
+	OSDeclareDefaultStructors(StarbiteRTC);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+
+	long getGMTTimeOfDay(void) APPLE_KEXT_OVERRIDE;
+	void setGMTTimeOfDay(long secs) APPLE_KEXT_OVERRIDE;
+	void setAlarmEnable(IOOptionBits message) APPLE_KEXT_OVERRIDE;
+
+	static StarbiteRTC *shared(void);       /* the started instance, or NULL (for the platform expert) */
+
+private:
+	StarbiteACPM *fACPM;
+	struct s2m_rtc_ops fOps;
+	bool fWrite;
+	bool fValid;
+	uint32_t fWrites, fWriteFails, fReadFails;
+
+	int readNow(uint64_t *secs, const char **why);
+	static int opRd(void *ctx, uint8_t reg, uint8_t *v);
+	static int opWr(void *ctx, uint8_t reg, uint8_t v);
+	static void opDelay(void *ctx, uint32_t us);
+};
+
+#endif
diff --git a/iokit/Kernel/arm/starbite/StarbiteRTC/hw/s2mps18_rtc.c b/iokit/Kernel/arm/starbite/StarbiteRTC/hw/s2mps18_rtc.c
new file mode 100644
index 00000000..34eebaee
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteRTC/hw/s2mps18_rtc.c
@@ -0,0 +1,276 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * S2MPS18 RTC: decode/encode, the RUDR latch before a read, the WUDR update after a write. See s2mps18_rtc.h and
+ * ../NOTES.md. The read-only decode follows the facts in an earlier port's drivers/power/s2mps18_rtc.c (APSL-2.0,
+ * an earlier port; credited in NOTES.md); the latch and the write are new.
+ */
+#include "s2mps18_rtc.h"
+
+const char *
+s2m_strerror(int e)
+{
+	switch (e) {
+	case S2M_OK: return "ok";
+	case S2M_E_IO: return "ACPM access failed";
+	case S2M_E_NOTSET: return "clock not set";
+	case S2M_E_RANGE: return "field out of range";
+	case S2M_E_VERIFY: return "read-back differs";
+	case S2M_E_MODE: return "not in 24-hour mode";
+	default: return "?";
+	}
+}
+
+/* days since 1970-01-01 of a civil date (y >= 1970) */
+static int64_t
+days_from_civil(int64_t y, uint32_t m, uint32_t d)
+{
+	y -= m <= 2;
+	int64_t era = y / 400;
+	int64_t yoe = y - era * 400;
+	int64_t doy = (153 * ((int64_t)m + (m > 2 ? -3 : 9)) + 2) / 5 + (int64_t)d - 1;
+	int64_t doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+	return era * 146097 + doe - 719468;
+}
+
+uint64_t
+s2m_tm_to_unix(const struct s2m_tm *tm)
+{
+	int64_t days = days_from_civil((int64_t)tm->year, tm->month, tm->day);
+	return (uint64_t)days * 86400u + tm->hour * 3600u + tm->min * 60u + tm->sec;
+}
+
+void
+s2m_unix_to_tm(uint64_t t, struct s2m_tm *tm)
+{
+	int64_t z = (int64_t)(t / 86400u) + 719468;
+	uint64_t rem = t % 86400u;
+	int64_t era = z / 146097;
+	int64_t doe = z - era * 146097;
+	int64_t yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+	int64_t y = yoe + era * 400;
+	int64_t doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+	int64_t mp = (5 * doy + 2) / 153;
+	uint32_t d = (uint32_t)(doy - (153 * mp + 2) / 5 + 1);
+	uint32_t m = (uint32_t)(mp < 10 ? mp + 3 : mp - 9);
+	tm->year = (uint32_t)(y + (m <= 2));
+	tm->month = m;
+	tm->day = d;
+	tm->hour = (uint32_t)(rem / 3600u);
+	tm->min = (uint32_t)(rem / 60u % 60u);
+	tm->sec = (uint32_t)(rem % 60u);
+	tm->wday = (uint32_t)(((t / 86400u) + 4u) % 7u);    /* 1970-01-01 was a Thursday */
+}
+
+static uint32_t
+days_in_month(uint32_t y, uint32_t m)
+{
+	static const uint8_t n[12] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };
+	bool leap = (y % 4 == 0 && y % 100 != 0) || y % 400 == 0;
+	return m == 2 && leap ? 29u : n[(m - 1) % 12];
+}
+
+/* a field: binary, or BCD (both nibbles must be digits; bad -> 0xff) */
+static uint32_t
+field(uint8_t v, uint8_t mask, bool bcd)
+{
+	v &= mask;
+	if (!bcd) {
+		return v;
+	}
+	if ((v & 0xfu) > 9u || (v >> 4) > 9u) {
+		return 0xffu;
+	}
+	return (uint32_t)(v >> 4) * 10u + (v & 0xfu);
+}
+
+static uint8_t
+to_bcd(uint32_t v)
+{
+	return (uint8_t)((v / 10u) << 4 | (v % 10u));
+}
+
+int
+s2m_rtc_decode(const uint8_t r[S2M_RTC_NREGS], struct s2m_tm *tm, const char **why)
+{
+	uint8_t ctrl = r[S2M_RTC_CTRL];
+	bool bcd = (ctrl & S2M_CTRL_BCD) != 0, h24 = (ctrl & S2M_CTRL_24H) != 0;
+	const char *dummy;
+
+	if (why == 0) {
+		why = &dummy;
+	}
+	*why = "ok";
+	tm->sec = field(r[S2M_RTC_SEC], 0x7f, bcd);
+	tm->min = field(r[S2M_RTC_MIN], 0x7f, bcd);
+	if (h24) {
+		tm->hour = field(r[S2M_RTC_HOUR], bcd ? 0x3f : 0x1f, bcd);
+	} else {
+		uint32_t h = field(r[S2M_RTC_HOUR], 0x1f, bcd);
+		bool pm = (r[S2M_RTC_HOUR] & S2M_HOUR_PM) != 0;
+		tm->hour = (h >= 1 && h <= 12) ? h % 12u + (pm ? 12u : 0u) : 0xffu;
+	}
+	tm->day = field(r[S2M_RTC_DAY], bcd ? 0x3f : 0x1f, bcd);
+	tm->month = field(r[S2M_RTC_MONTH], bcd ? 0x1f : 0x0f, bcd);
+	uint32_t y = field(r[S2M_RTC_YEAR], bcd ? 0xff : 0x7f, bcd);
+	tm->year = y == 0xffu ? 0 : 2000u + y;
+	tm->wday = 0;
+	if (tm->sec > 59 || tm->min > 59 || tm->hour > 23 || tm->month < 1 || tm->month > 12 || tm->day < 1 ||
+	    tm->year == 0 || tm->day > days_in_month(tm->year, tm->month)) {
+		*why = "a field out of range";
+		return S2M_E_RANGE;
+	}
+	struct s2m_tm t2;
+	s2m_unix_to_tm(s2m_tm_to_unix(tm), &t2);
+	tm->wday = t2.wday;
+	if (!h24 || (r[S2M_RTC_CAPSEL] & 0xf0u) != 0xf0u) {
+		*why = "CTRL not 24-hour or CAPSEL[7:4] != 0xF: the RTC was reset";
+		return S2M_E_NOTSET;
+	}
+	if (tm->year < S2M_YEAR_MIN || tm->year > S2M_YEAR_MAX) {
+		*why = "the year is not 2024-2099: the clock was never set";
+		return S2M_E_NOTSET;
+	}
+	return S2M_OK;
+}
+
+int
+s2m_rtc_encode(const struct s2m_tm *tm, uint8_t ctrl, uint8_t out[7])
+{
+	bool bcd = (ctrl & S2M_CTRL_BCD) != 0;
+	if (!(ctrl & S2M_CTRL_24H)) {
+		return S2M_E_MODE;
+	}
+	if (tm->year < 2000u || tm->year > 2099u || tm->month < 1 || tm->month > 12 || tm->day < 1 ||
+	    tm->day > days_in_month(tm->year, tm->month) || tm->hour > 23 || tm->min > 59 || tm->sec > 59 ||
+	    tm->wday > 6) {
+		return S2M_E_RANGE;
+	}
+	uint32_t f[6] = { tm->sec, tm->min, tm->hour, tm->day, tm->month, tm->year - 2000u };
+	uint8_t e[6];
+	for (unsigned i = 0; i < 6; i++) {
+		e[i] = bcd ? to_bcd(f[i]) : (uint8_t)f[i];
+	}
+	out[0] = e[0];                                          /* SEC */
+	out[1] = e[1];                                          /* MIN */
+	out[2] = (uint8_t)(e[2] | (tm->hour >= 12 ? S2M_HOUR_PM : 0));   /* HOUR (+PM, as the vendor driver) */
+	out[3] = (uint8_t)(1u << tm->wday);                     /* WEEK */
+	out[4] = e[3];                                          /* DAY */
+	out[5] = e[4];                                          /* MONTH */
+	out[6] = e[5];                                          /* YEAR */
+	return S2M_OK;
+}
+
+/* Set one UPDATE bit (the register read first, nothing else changed) and wait for it to clear. */
+static int
+update_bit(const struct s2m_rtc_ops *ops, uint8_t bit, bool *cleared)
+{
+	uint8_t u = 0;
+	*cleared = false;
+	if (ops->rd(ops->ctx, S2M_RTC_UPDATE, &u) != 0) {
+		return S2M_E_IO;
+	}
+	if (ops->wr(ops->ctx, S2M_RTC_UPDATE, (uint8_t)(u | bit)) != 0) {
+		return S2M_E_IO;
+	}
+	for (unsigned i = 0; i < S2M_UPDATE_POLLS; i++) {
+		ops->delay_us(ops->ctx, S2M_UPDATE_POLL_US);
+		if (ops->rd(ops->ctx, S2M_RTC_UPDATE, &u) != 0) {
+			return S2M_E_IO;
+		}
+		if (!(u & bit)) {
+			*cleared = true;
+			break;
+		}
+	}
+	return S2M_OK;
+}
+
+int
+s2m_rtc_read_raw(const struct s2m_rtc_ops *ops, uint8_t r[S2M_RTC_NREGS], bool *latched)
+{
+	bool l = false;
+	int e = update_bit(ops, S2M_UPDATE_RUDR, &l);
+	if (latched) {
+		*latched = l;
+	}
+	if (e != S2M_OK) {
+		return e;
+	}
+	for (uint8_t i = 0; i < S2M_RTC_NREGS; i++) {
+		if (ops->rd(ops->ctx, i, &r[i]) != 0) {
+			return S2M_E_IO;
+		}
+	}
+	return S2M_OK;
+}
+
+int
+s2m_rtc_read(const struct s2m_rtc_ops *ops, uint64_t *unix_secs, uint8_t r[S2M_RTC_NREGS], const char **why)
+{
+	struct s2m_tm tm;
+	bool latched = false;
+	const char *dummy;
+	if (why == 0) {
+		why = &dummy;
+	}
+	int e = s2m_rtc_read_raw(ops, r, &latched);
+	if (e != S2M_OK) {
+		*why = "ACPM access failed";
+		return e;
+	}
+	e = s2m_rtc_decode(r, &tm, why);
+	if (e == S2M_OK) {
+		*unix_secs = s2m_tm_to_unix(&tm);
+		if (!latched) {
+			*why = "ok, but RUDR did not clear within 50 ms (the value may be an older latch)";
+		}
+	}
+	return e;
+}
+
+int
+s2m_rtc_write(const struct s2m_rtc_ops *ops, uint64_t unix_secs, const char **why)
+{
+	struct s2m_tm tm;
+	uint8_t ctrl = 0, out[7], r[S2M_RTC_NREGS];
+	bool cleared = false;
+	const char *dummy;
+	if (why == 0) {
+		why = &dummy;
+	}
+	*why = "ok";
+	if (ops->rd(ops->ctx, S2M_RTC_CTRL, &ctrl) != 0) {
+		*why = "CTRL unreadable";
+		return S2M_E_IO;
+	}
+	s2m_unix_to_tm(unix_secs, &tm);
+	if (tm.year < S2M_YEAR_MIN || tm.year > S2M_YEAR_MAX) {
+		*why = "refusing to write a year outside 2024-2099";
+		return S2M_E_RANGE;
+	}
+	int e = s2m_rtc_encode(&tm, ctrl, out);
+	if (e != S2M_OK) {
+		*why = e == S2M_E_MODE ? "CTRL is not 24-hour (and CTRL is never written)" : "encode failed";
+		return e;
+	}
+	for (uint8_t i = 0; i < 7; i++) {
+		if (ops->wr(ops->ctx, (uint8_t)(S2M_RTC_SEC + i), out[i]) != 0) {
+			*why = "a time register write failed";
+			return S2M_E_IO;
+		}
+	}
+	e = update_bit(ops, S2M_UPDATE_WUDR, &cleared);
+	if (e != S2M_OK) {
+		*why = "UPDATE (WUDR) failed";
+		return e;
+	}
+	uint64_t back = 0;
+	const char *rwhy = 0;
+	e = s2m_rtc_read(ops, &back, r, &rwhy);
+	if (e != S2M_OK || back < unix_secs || back > unix_secs + 3u) {
+		*why = cleared ? "read-back differs from what was written" :
+		    "read-back differs (and WUDR did not clear within 50 ms)";
+		return S2M_E_VERIFY;
+	}
+	return S2M_OK;
+}
diff --git a/iokit/Kernel/arm/starbite/StarbiteRTC/hw/s2mps18_rtc.h b/iokit/Kernel/arm/starbite/StarbiteRTC/hw/s2mps18_rtc.h
new file mode 100644
index 00000000..ff2bd417
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteRTC/hw/s2mps18_rtc.h
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * The S2MPS18 RTC block (ACPM PMIC type 2), plain C. Register facts: ../NOTES.md.
+ *   0x00 CTRL       bit 0 BCD_EN (0 = binary), bit 1 MODEL24 (1 = 24 h)
+ *   0x01 WTSR_SMPL  never touched
+ *   0x02 UPDATE     bit 0 RUDR (latch the counters into 0x04..0x0b), bit 1 WUDR (move 0x05..0x0b into the
+ *                   counters), bit 2 FREEZE, bit 4 AUDR (alarms): only RUDR and WUDR are ever set here
+ *   0x03 CAPSEL     [7:4] = 0xF once the clock has been set up (Linux's test); never written
+ *   0x04 MSEC       0x05 SEC  0x06 MIN  0x07 HOUR (bit 6 PM)  0x08 WEEK (one bit a day)
+ *   0x09 DAY        0x0a MONTH (1-12)   0x0b YEAR (since 2000)
+ * All access goes through struct s2m_rtc_ops (StarbiteACPM on the phone, a model in the tests).
+ */
+#ifndef STARBITE_S2MPS18_RTC_H
+#define STARBITE_S2MPS18_RTC_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define S2M_RTC_CTRL            0x00u
+#define S2M_RTC_UPDATE          0x02u
+#define S2M_RTC_CAPSEL          0x03u
+#define S2M_RTC_MSEC            0x04u
+#define S2M_RTC_SEC             0x05u
+#define S2M_RTC_MIN             0x06u
+#define S2M_RTC_HOUR            0x07u
+#define S2M_RTC_WEEK            0x08u
+#define S2M_RTC_DAY             0x09u
+#define S2M_RTC_MONTH           0x0au
+#define S2M_RTC_YEAR            0x0bu
+#define S2M_RTC_NREGS           12u
+
+#define S2M_CTRL_BCD            0x01u
+#define S2M_CTRL_24H            0x02u
+#define S2M_UPDATE_RUDR         0x01u
+#define S2M_UPDATE_WUDR         0x02u
+#define S2M_HOUR_PM             0x40u
+
+/* trusted years; outside: "never set" (the phone read 2018-01-01 when nothing had set it) */
+#define S2M_YEAR_MIN            2024u
+#define S2M_YEAR_MAX            2099u
+
+/* latch / write-update waits */
+#define S2M_UPDATE_POLLS        50u
+#define S2M_UPDATE_POLL_US      1000u
+
+struct s2m_rtc_ops {
+	void *ctx;
+	int (*rd)(void *ctx, uint8_t reg, uint8_t *v);  /* 0 = ok */
+	int (*wr)(void *ctx, uint8_t reg, uint8_t v);
+	void (*delay_us)(void *ctx, uint32_t us);
+};
+
+struct s2m_tm {
+	uint32_t year;          /* 2000.. */
+	uint32_t month;         /* 1..12 */
+	uint32_t day;           /* 1..31 */
+	uint32_t hour, min, sec;
+	uint32_t wday;          /* 0 = Sunday */
+};
+
+/* results */
+#define S2M_OK                  0
+#define S2M_E_IO                (-1)    /* an ACPM read/write failed */
+#define S2M_E_NOTSET            (-2)    /* CTRL / CAPSEL say the clock was reset, or the year is not plausible */
+#define S2M_E_RANGE             (-3)    /* a field out of range */
+#define S2M_E_VERIFY            (-4)    /* the read-back after a write disagrees */
+#define S2M_E_MODE              (-5)    /* not 24-hour mode: we never write CTRL, so no writes */
+
+/* Days-from-civil (proleptic Gregorian), Unix seconds of a date from 1970 on; the inverse. */
+uint64_t s2m_tm_to_unix(const struct s2m_tm *tm);
+void s2m_unix_to_tm(uint64_t t, struct s2m_tm *tm);
+
+/* Decode registers 0x00..0x0b (r[0] = CTRL). Fields decoded per CTRL's BCD and 24 h bits. */
+int s2m_rtc_decode(const uint8_t r[S2M_RTC_NREGS], struct s2m_tm *tm, const char **why);
+
+/* Encode SEC..YEAR (7 bytes for 0x05..0x0b) in the coding CTRL says. 24-hour mode only. */
+int s2m_rtc_encode(const struct s2m_tm *tm, uint8_t ctrl, uint8_t out[7]);
+
+/* Latch (RUDR, wait for it to clear) and read 0x00..0x0b. latched: whether RUDR cleared in time. */
+int s2m_rtc_read_raw(const struct s2m_rtc_ops *ops, uint8_t r[S2M_RTC_NREGS], bool *latched);
+
+/* Read and decode: Unix seconds, or an error (why says which check). */
+int s2m_rtc_read(const struct s2m_rtc_ops *ops, uint64_t *unix_secs, uint8_t r[S2M_RTC_NREGS], const char **why);
+
+/* Set the clock: SEC..YEAR written, then WUDR, its clearing waited for, then read back (within 2 s). */
+int s2m_rtc_write(const struct s2m_rtc_ops *ops, uint64_t unix_secs, const char **why);
+
+const char *s2m_strerror(int e);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/starbite/StarbiteWatchdog.cpp b/iokit/Kernel/arm/starbite/StarbiteWatchdog.cpp
