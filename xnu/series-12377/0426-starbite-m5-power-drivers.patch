diff --git a/iokit/Kernel/arm/starbite/StarbiteBattery/StarbiteBattery.cpp b/iokit/Kernel/arm/starbite/StarbiteBattery/StarbiteBattery.cpp
new file mode 100644
index 00000000..321a7829
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteBattery/StarbiteBattery.cpp
@@ -0,0 +1,495 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * StarbiteBattery (docs/APPLE-S9-DRIVERS.md Part 3 row 22): see StarbiteBattery.h, hw/, NOTES.md.
+ * The published key set follows what SweetBattery (xnu/series-12377 0220/0221) publishes for powerd, written
+ * anew here; capacities are in percent (MaxCapacity 100) as Apple's own batteries publish them, mAh in the
+ * AppleRaw* keys. Every bus access happens on the work loop (timers), never in start's caller beyond the first.
+ * One register write only: the MAX77705 charger watchdog clear (CNFG_06 WDTCLR = 01, allowed 2026-11-11).
+ */
+#include "StarbiteBattery.h"
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSSymbol.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+extern "C" int starlte_sbstop_at(const char *stage);
+extern "C" void starlte_sbstop_now(const char *stage);
+#endif
+
+#define super IOPMPowerSource
+OSDefineMetaClassAndStructors(StarbiteBattery, IOPMPowerSource);
+
+/* ---- MMIO for hw/ ---- */
+
+uint32_t
+StarbiteBattery::ioRd(void *ctx, uint32_t off)
+{
+	StarbiteBattery *me = (StarbiteBattery *)ctx;
+	uint32_t v = *(volatile uint32_t *)(me->fBase + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+void
+StarbiteBattery::ioWr(void *ctx, uint32_t off, uint32_t v)
+{
+	StarbiteBattery *me = (StarbiteBattery *)ctx;
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(me->fBase + off) = v;
+}
+
+void
+StarbiteBattery::ioDelay(void *, uint32_t us)
+{
+	IODelay(us);
+}
+
+int
+StarbiteBattery::gaugeRead(void *ctx, uint8_t addr7, uint8_t reg, uint8_t *buf, unsigned len)
+{
+	StarbiteBattery *me = (StarbiteBattery *)ctx;
+	return hsi2c_read_reg(&me->fBus, addr7, reg, buf, len);
+}
+
+/* The one write (0x69:0xbd, checked again in hsi2c_write_reg and max77705_wdt_kick). */
+int
+StarbiteBattery::gaugeWrite(void *ctx, uint8_t addr7, uint8_t reg, uint8_t value)
+{
+	StarbiteBattery *me = (StarbiteBattery *)ctx;
+	return hsi2c_write_reg(&me->fBus, addr7, reg, value);
+}
+
+static uint64_t
+uptime_s(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_SEC;
+}
+
+/* ---- the M11 load: one busy kernel thread per CPU until the deadline ---- */
+
+static uint64_t gLoadUntil;     /* absolute time */
+static volatile uint64_t gLoadSink;
+
+static void
+load_thread(void *, wait_result_t)
+{
+	uint64_t x = 0;
+	while (mach_absolute_time() < gLoadUntil) {
+		for (uint32_t i = 0; i < 100000; i++) {
+			x = x * 6364136223846793005ULL + i;
+		}
+		gLoadSink = x;
+	}
+	thread_terminate(current_thread());
+}
+
+static void
+load_start(uint32_t secs)
+{
+	unsigned n = ml_wait_max_cpus();
+	uint64_t interval = 0;
+	nanoseconds_to_absolutetime((uint64_t)secs * NSEC_PER_SEC, &interval);
+	gLoadUntil = mach_absolute_time() + interval;
+	for (unsigned i = 0; i < n; i++) {
+		thread_t th;
+		if (kernel_thread_start(load_thread, NULL, &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+		}
+	}
+	IOLog("StarbiteBattery: M11 load: %u busy threads for %u s\n", n, secs);
+}
+
+/* ---- init / properties ---- */
+
+bool
+StarbiteBattery::init(OSDictionary *dictionary)
+{
+	/* This XNU's IOPMPowerSource has only init(void): run it, then keep the personality's keys. */
+	if (!super::init()) {
+		return false;
+	}
+	if (dictionary) {
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(dictionary);
+		if (it == NULL) {
+			return false;
+		}
+		const OSSymbol *key;
+		while ((key = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL) {
+			setProperty(key, dictionary->getObject(key));
+		}
+		it->release();
+	}
+	return true;
+}
+
+void
+StarbiteBattery::putNumber(const char *key, int64_t value)
+{
+	const OSSymbol *k = OSSymbol::withCString(key);
+	OSNumber *n = OSNumber::withNumber((unsigned long long)value, 64);
+	if (k && n) {
+		setPSProperty(k, n);
+	}
+	OSSafeReleaseNULL(n);
+	OSSafeReleaseNULL(k);
+}
+
+void
+StarbiteBattery::putBool(const char *key, bool value)
+{
+	const OSSymbol *k = OSSymbol::withCString(key);
+	if (k) {
+		setPSProperty(k, value ? kOSBooleanTrue : kOSBooleanFalse);
+		k->release();
+	}
+}
+
+void
+StarbiteBattery::putString(const char *key, const char *value)
+{
+	const OSSymbol *k = OSSymbol::withCString(key);
+	OSString *s = OSString::withCString(value ? value : "");
+	if (k && s) {
+		setPSProperty(k, s);
+	}
+	OSSafeReleaseNULL(s);
+	OSSafeReleaseNULL(k);
+}
+
+void
+StarbiteBattery::publish(const struct battery_state *st)
+{
+	setBatteryInstalled(st->present);
+	setMaxCapacity(100);
+	setCurrentCapacity(st->percent);
+	setExternalConnected(st->external);
+	setExternalChargeCapable(st->charge_capable);
+	setIsCharging(st->charging);
+	setAtWarnLevel(st->warn);
+	setAtCriticalLevel(st->critical);
+	setVoltage(st->mv);
+	setAmperage(st->ma);
+	setTimeRemaining(st->charging ? st->minutes_to_full : st->minutes_to_empty);
+	setCycleCount(st->cycles);
+	putBool("FullyCharged", st->full);
+	putNumber("DesignCapacity", st->design_mah);
+	putNumber("NominalChargeCapacity", st->max_mah);
+	putNumber("AppleRawCurrentCapacity", st->cur_mah);
+	putNumber("AppleRawMaxCapacity", st->max_mah);
+	putBool("AppleRawExternalConnected", st->external);
+	putNumber("AppleRawBatteryVoltage", st->mv);
+	putNumber("InstantAmperage", st->ma);
+	putNumber("AvgTimeToEmpty", st->minutes_to_empty >= 0 ? st->minutes_to_empty : 65535);
+	putNumber("AvgTimeToFull", st->minutes_to_full >= 0 ? st->minutes_to_full : 65535);
+	putNumber("Temperature", st->temp_c10 * 10);   /* centi-degrees C */
+	putBool("StarbiteBatteryMeasured", st->measured);
+	putString("StarbiteBatteryNote", st->why);
+	putNumber("StarbiteBatterySOCx10", st->soc_x10);
+	putBool("StarbiteBatteryTemperatureEstimated", true);
+	putBool("ChargerWatchdogExpired", st->charger_wdt_expired);
+	putNumber("ChargerDetails", st->chg_dtls);
+
+	OSDictionary *legacy = OSDictionary::withCapacity(6);
+	if (legacy) {
+		const char *keys[] = { kIOBatteryCurrentChargeKey, kIOBatteryCapacityKey, kIOBatteryVoltageKey,
+			               kIOBatteryAmperageKey, kIOBatteryCycleCountKey, kIOBatteryFlagsKey };
+		UInt32 values[] = { st->cur_mah, st->max_mah, st->mv, (UInt32)st->ma, st->cycles,
+			            (UInt32)(kIOBatteryInstalled | (st->external ? kIOBatteryChargerConnect : 0) |
+			            (st->charging ? kIOBatteryCharge : 0)) };
+		for (unsigned i = 0; i < sizeof(values) / sizeof(values[0]); i++) {
+			OSNumber *n = OSNumber::withNumber(values[i], 32);
+			if (n) {
+				legacy->setObject(keys[i], n);
+				n->release();
+			}
+		}
+		setLegacyIOBatteryInfo(legacy);
+		legacy->release();
+	}
+	updateStatus();
+}
+
+/* ---- sampling ---- */
+
+void
+StarbiteBattery::poll(void)
+{
+	struct max77705_raw raw;
+	struct battery_state st;
+
+	bzero(&raw, sizeof(raw));
+	if (fReal) {
+		(void)max77705_sample(&fGauge, &raw);
+		max77705_state(&raw, &st, &fLow);
+	} else {
+		battery_fallback(&st, "sbbattery=0: static");
+	}
+	fSamples++;
+	bool modeChanged = fSamples == 1 || st.measured != (fLastMeasured != 0);
+	fLastMeasured = st.measured;
+	if (modeChanged || fTestLog || fSamples % 20 == 0) {
+		IOLog("StarbiteBattery: t=%llu s %s: %d.%d %% (%u%%) %u mV %d mA (avg %d) %d.%d C %u/%u mAh cycles %u "
+		    "ext %d chg %d full %d dtls %d/%d/%d%s; bus errors %u fallbacks %u; %s\n", uptime_s(),
+		    st.measured ? "MAX77705" : "fallback", st.soc_x10 / 10, st.soc_x10 % 10, st.percent, st.mv, st.ma,
+		    st.avg_ma, st.temp_c10 / 10, (st.temp_c10 < 0 ? -st.temp_c10 : st.temp_c10) % 10, st.cur_mah,
+		    st.max_mah, st.cycles, st.external, st.charging, st.full, st.chg_dtls, st.bat_dtls, st.chgin_dtls,
+		    st.charger_wdt_expired ? " CHARGER WATCHDOG EXPIRED" : "", fBus.errors, fBus.fallbacks, st.why);
+	}
+	fState = st;
+	publish(&st);
+}
+
+/* PHONE-TEST.md M11: baseline 10 s, load fLoadS s, then the verdict. */
+void
+StarbiteBattery::testStep(uint64_t now_s)
+{
+	uint64_t t = now_s - fT0;
+	if (fPhase == 2) {
+		return;
+	}
+	fAllMeasured = fAllMeasured && fState.measured;
+	if (fState.soc_x10 < fMinSoc) {
+		fMinSoc = fState.soc_x10;
+	}
+	if (fState.soc_x10 > fMaxSoc) {
+		fMaxSoc = fState.soc_x10;
+	}
+	if (fPhase == 0) {
+		fBaseSoc = fState.soc_x10;
+		fBaseMa = fState.ma;
+		if (t >= 10) {
+			fPhase = 1;
+			fMinSoc = fMaxSoc = fState.soc_x10;
+			fLoadMa = 0;
+			load_start(fLoadS);
+		}
+		return;
+	}
+	if (fState.ma < fLoadMa) {
+		fLoadMa = fState.ma;            /* the most negative: the heaviest discharge */
+	}
+	if (t < 10 + (uint64_t)fLoadS + 2) {
+		return;
+	}
+	fPhase = 2;
+	bool socMoved = fMinSoc != fMaxSoc || fState.soc_x10 != fBaseSoc;
+	bool currentRose = fLoadMa <= fBaseMa - 200;
+	bool pass = fAllMeasured && socMoved && currentRose;
+	IOLog("StarbiteBattery: M11 %s: measured %s, SOC %d.%d %% -> %d.%d %% (range %d..%d x0.1 %%), current %d mA "
+	    "idle -> %d mA under load (%s), percent shown %u%%\n", pass ? "PASS" : "FAIL", fAllMeasured ? "yes" : "NO",
+	    fBaseSoc / 10, fBaseSoc % 10, fState.soc_x10 / 10, fState.soc_x10 % 10, fMinSoc, fMaxSoc, fBaseMa,
+	    fLoadMa, currentRose ? "rose" : "did not rise 200 mA", fState.percent);
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+	if (starlte_sbstop_at("battery")) {
+		starlte_sbstop_now("battery");
+	}
+#endif
+}
+
+void
+StarbiteBattery::timerFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	StarbiteBattery *me = OSDynamicCast(StarbiteBattery, owner);
+	if (me == NULL || !me->fRunning) {
+		return;
+	}
+	me->poll();
+	if (me->fChgTestS) {
+		me->chgTestStep(uptime_s());
+	}
+	if (me->fLoadS) {
+		me->testStep(uptime_s());
+	}
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+	else if (me->fSamples == 1 && starlte_sbstop_at("battery")) {
+		starlte_sbstop_now("battery");
+	}
+#endif
+	sender->setTimeoutMS(me->fPollMs);
+}
+
+/* The charger watchdog clear, every MAX77705_WDT_KICK_S s on the work loop (serialised with the sampling). */
+void
+StarbiteBattery::kickFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	StarbiteBattery *me = OSDynamicCast(StarbiteBattery, owner);
+	if (me == NULL || !me->fRunning || !me->fKick) {
+		return;
+	}
+	uint8_t w = 0;
+	int r = max77705_wdt_kick(&me->fGauge, &w);
+	if (r == MAX77705_KICK_OK) {
+		me->fKicks++;
+		if (!me->fKickLogged) {
+			me->fKickLogged = true;
+			IOLog("StarbiteBattery: charger watchdog: cleared every %u s (CNFG_06 0xbd = %#x: WDTCLR 01, CHGPROT kept)\n",
+			    MAX77705_WDT_KICK_S, w);
+		}
+	} else if (r == MAX77705_KICK_OFF) {
+		if (!me->fKickLogged) {
+			me->fKickLogged = true;
+			IOLog("StarbiteBattery: charger watchdog: not enabled (CNFG_00 WDTEN 0): nothing written\n");
+		}
+	} else if (me->fKickFails++ < 4) {
+		IOLog("StarbiteBattery: charger watchdog clear failed (%d)\n", r);
+	}
+	me->setProperty("ChargerWatchdogClears", me->fKicks, 32);
+	sender->setTimeoutMS(MAX77705_WDT_KICK_S * 1000u);
+}
+
+/* PHONE-TEST.md M11b: on the cable for fChgTestS s, did charging hold (no CHG_DTLS 0x0b, charging or full)? */
+void
+StarbiteBattery::chgTestStep(uint64_t now_s)
+{
+	uint64_t t = now_s - fT0;
+	if (fChgDone) {
+		return;
+	}
+	bool ok = fState.measured && fState.external && !fState.charger_wdt_expired && (fState.charging || fState.full);
+	if (!ok && fChgHeld) {
+		fChgHeld = false;
+		fChgBadT = t;
+		fChgBadDtls = fState.chg_dtls;
+	}
+	if (t < fChgTestS) {
+		return;
+	}
+	fChgDone = true;
+	if (fChgHeld) {
+		IOLog("StarbiteBattery: M11b PASS: on the cable %llu s, charging throughout, %u watchdog clears, never expired\n",
+		    t, fKicks);
+	} else {
+		IOLog("StarbiteBattery: M11b FAIL: charging lost at %llu s (CHG_DTLS %d), %u watchdog clears (clear %s)\n",
+		    fChgBadT, fChgBadDtls, fKicks, fKick ? "on" : "off: sbchgwdt=0");
+	}
+}
+
+/* ---- start / stop ---- */
+
+bool
+StarbiteBattery::start(IOService *provider)
+{
+	uint32_t on = 1, poll_s = 30, test = 0, load = 0, kick = 1, chgtest = 0;
+
+	if (!super::start(provider)) {
+		return false;
+	}
+	(void)PE_parse_boot_argn("sbbattery", &on, sizeof(on));
+	(void)PE_parse_boot_argn("sbbatpoll", &poll_s, sizeof(poll_s));
+	(void)PE_parse_boot_argn("sbbattest", &test, sizeof(test));
+	(void)PE_parse_boot_argn("sbbatload", &load, sizeof(load));
+	(void)PE_parse_boot_argn("sbchgwdt", &kick, sizeof(kick));
+	(void)PE_parse_boot_argn("sbchgtest", &chgtest, sizeof(chgtest));
+	fChgTestS = chgtest;
+	fChgHeld = true;
+	fTestLog = fTestLog || chgtest != 0;
+	poll_s = poll_s < 2 ? 2 : poll_s > 300 ? 300 : poll_s;
+	fPollMs = poll_s * 1000u;
+	fTestLog = test != 0 || load != 0;
+	fLoadS = load > 60 ? 60 : load;
+	fT0 = uptime_s();
+	fAllMeasured = true;
+	fMinSoc = 1000;
+	fMaxSoc = 0;
+
+	fReal = false;
+	if (on) {
+		fMap = provider->mapDeviceMemoryWithIndex(0);
+		if (fMap && fMap->getLength() >= 0x100) {
+			fBase = fMap->getVirtualAddress();
+			fIo.ctx = this;
+			fIo.rd = ioRd;
+			fIo.wr = ioWr;
+			fIo.delay_us = ioDelay;
+			hsi2c_init(&fBus, &fIo);
+			fGauge.ctx = this;
+			fGauge.read = gaugeRead;
+			fGauge.write = kick ? gaugeWrite : NULL;
+			fKick = kick != 0;
+			uint8_t id = 0;
+			bool pmic = hsi2c_read_reg(&fBus, MAX77705_PMIC_ADDR, 0x00, &id, 1) == 0;
+			IOLog("StarbiteBattery: HSI2C %#llx, timing FS1 %#x FS2 %#x FS3 %#x (S-Boot's), MAX77705 PMICID %s%#x\n",
+			    (unsigned long long)fMap->getPhysicalAddress(), fBus.fs1, fBus.fs2, fBus.fs3,
+			    pmic ? "" : "unreadable ", id);
+			fReal = true;
+		} else {
+			IOLog("StarbiteBattery: no reg 0 on the nub: static fallback\n");
+		}
+	} else {
+		IOLog("StarbiteBattery: sbbattery=0: static fallback, no bus access\n");
+	}
+	/* A complete source before registerService wakes powerd. */
+	poll();
+	fLoop = IOWorkLoop::workLoop();
+	fTimer = IOTimerEventSource::timerEventSource(this, &StarbiteBattery::timerFired);
+	if (fLoop && fTimer && fLoop->addEventSource(fTimer) == kIOReturnSuccess) {
+		fTimerAdded = true;
+		fRunning = true;
+		fTimer->setTimeoutMS(fPollMs);
+		if (fKick) {
+			fKickTimer = IOTimerEventSource::timerEventSource(this, &StarbiteBattery::kickFired);
+			if (fKickTimer && fLoop->addEventSource(fKickTimer) == kIOReturnSuccess) {
+				fKickAdded = true;
+				fKickTimer->setTimeoutMS(1);    /* the first clear at once, then every 30 s */
+			} else {
+				IOLog("StarbiteBattery: charger watchdog: no timer, not cleared\n");
+			}
+		} else if (fReal) {
+			IOLog("StarbiteBattery: charger watchdog: sbchgwdt=0, not cleared (read only)\n");
+		}
+	} else {
+		IOLog("StarbiteBattery: no timer: the first sample stays\n");
+	}
+	registerService();
+	return true;
+}
+
+IOReturn
+StarbiteBattery::stopPolling(OSObject *owner, void *, void *, void *, void *)
+{
+	StarbiteBattery *me = OSDynamicCast(StarbiteBattery, owner);
+	if (me == NULL) {
+		return kIOReturnBadArgument;
+	}
+	me->fRunning = false;
+	me->fTimer->cancelTimeout();
+	me->fTimer->disable();
+	if (me->fKickTimer) {
+		me->fKickTimer->cancelTimeout();
+		me->fKickTimer->disable();
+	}
+	return kIOReturnSuccess;
+}
+
+void
+StarbiteBattery::stop(IOService *provider)
+{
+	if (fLoop && fTimerAdded) {
+		(void)fLoop->runAction(&StarbiteBattery::stopPolling, this);
+		fLoop->removeEventSource(fTimer);
+		fTimerAdded = false;
+		if (fKickAdded) {
+			fLoop->removeEventSource(fKickTimer);
+			fKickAdded = false;
+		}
+	}
+	super::stop(provider);
+}
+
+void
+StarbiteBattery::free(void)
+{
+	OSSafeReleaseNULL(fTimer);
+	OSSafeReleaseNULL(fKickTimer);
+	OSSafeReleaseNULL(fLoop);
+	OSSafeReleaseNULL(fMap);
+	super::free();
+}
diff --git a/iokit/Kernel/arm/starbite/StarbiteBattery/StarbiteBattery.h b/iokit/Kernel/arm/starbite/StarbiteBattery/StarbiteBattery.h
new file mode 100644
index 00000000..6ecd8900
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteBattery/StarbiteBattery.h
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * StarbiteBattery: IOPMPowerSource for the S9's MAX77705 (fuel gauge 0x36, charger 0x69) on HSI2C 0x14360000,
+ * read only. Matching: IONameMatch "hsi2c-pmic" (the arm-io node name; tools/board/starlte.board) with its own
+ * IOMatchCategory, so StarbiteHSI2C can sit on the same nub later. Address: the nub's reg 0.
+ *
+ * Boot-args:
+ *   sbbattery=0       no bus access: SweetBattery's static 100 % on AC (as today)
+ *   sbbatpoll=S       poll period in seconds (default 30; 2..300)
+ *   sbbattest=1       log every sample (PHONE-TEST.md M11)
+ *   sbbatload=S       test: after a 10 s baseline, busy every CPU for S s (max 60), then the M11 verdict line
+ *   sbstop=battery    0423 self-stop after the verdict (or after the first sample without sbbatload)
+ *   sbchgwdt=0        do not clear the charger watchdog (default: cleared every 30 s, the driver's ONE write)
+ *   sbchgtest=S       M11b: after S s log whether charging held on the cable the whole time (no self-stop)
+ */
+#ifndef STARBITE_BATTERY_H
+#define STARBITE_BATTERY_H
+
+#include <IOKit/pwr_mgt/IOPMPowerSource.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include "hw/exynos_hsi2c.h"
+#include "hw/max77705.h"
+
+class StarbiteBattery : public IOPMPowerSource {
+	OSDeclareDefaultStructors(StarbiteBattery);
+
+public:
+	bool init(OSDictionary *dictionary = NULL) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+
+private:
+	IOMemoryMap *fMap;
+	vm_address_t fBase;
+	IOWorkLoop *fLoop;
+	IOTimerEventSource *fTimer;
+	IOTimerEventSource *fKickTimer;
+	bool fTimerAdded, fKickAdded, fRunning, fReal, fTestLog, fKick, fKickLogged;
+	uint32_t fKicks, fKickFails;
+	/* M11b */
+	uint32_t fChgTestS;
+	bool fChgHeld, fChgDone;
+	uint64_t fChgBadT;
+	int32_t fChgBadDtls;
+	struct hsi2c fBus;
+	struct hsi2c_io fIo;
+	struct max77705_bus fGauge;
+	struct battery_state fState;
+	uint32_t fLow, fPollMs, fSamples, fLastMeasured;
+	/* M11 test */
+	uint32_t fLoadS;
+	uint64_t fT0;
+	int fPhase;                     /* 0 baseline, 1 load, 2 done */
+	int32_t fBaseSoc, fBaseMa, fMinSoc, fMaxSoc, fLoadMa;
+	bool fAllMeasured;
+
+	void putNumber(const char *key, int64_t value);
+	void putBool(const char *key, bool value);
+	void putString(const char *key, const char *value);
+	void publish(const struct battery_state *st);
+	void poll(void);
+	void testStep(uint64_t now_s);
+	static void timerFired(OSObject *owner, IOTimerEventSource *sender);
+	static void kickFired(OSObject *owner, IOTimerEventSource *sender);
+	void chgTestStep(uint64_t now_s);
+	static int gaugeWrite(void *ctx, uint8_t addr7, uint8_t reg, uint8_t value);
+	static IOReturn stopPolling(OSObject *owner, void *, void *, void *, void *);
+
+	static uint32_t ioRd(void *ctx, uint32_t off);
+	static void ioWr(void *ctx, uint32_t off, uint32_t v);
+	static void ioDelay(void *ctx, uint32_t us);
+	static int gaugeRead(void *ctx, uint8_t addr7, uint8_t reg, uint8_t *buf, unsigned len);
+};
+
+#endif
diff --git a/iokit/Kernel/arm/starbite/StarbiteBattery/hw/exynos_hsi2c.c b/iokit/Kernel/arm/starbite/StarbiteBattery/hw/exynos_hsi2c.c
new file mode 100644
index 00000000..c868106a
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteBattery/hw/exynos_hsi2c.c
@@ -0,0 +1,152 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/* Polled read-only Exynos USI HSI2C master (see exynos_hsi2c.h). */
+#include "exynos_hsi2c.h"
+
+static uint32_t
+R(struct hsi2c *h, uint32_t off)
+{
+	return h->io->rd(h->io->ctx, off);
+}
+
+static void
+W(struct hsi2c *h, uint32_t off, uint32_t v)
+{
+	h->io->wr(h->io->ctx, off, v);
+}
+
+void
+hsi2c_init(struct hsi2c *h, const struct hsi2c_io *io)
+{
+	h->io = io;
+	h->errors = h->resets = h->fallbacks = 0;
+	if (!h->saved) {
+		h->fs1 = R(h, HSI2C_TIMING_FS1);
+		h->fs2 = R(h, HSI2C_TIMING_FS2);
+		h->fs3 = R(h, HSI2C_TIMING_FS3);
+		if (((h->fs3 >> 16) & 0xffu) == 0) {
+			/* nothing from S-Boot: 400 kHz from a 200 MHz IPCLK, as the touch bus (exynos9810-woa) */
+			h->fs3 = (h->fs3 & ~0x00ff0000u) | (0x21u << 16);
+			h->fs2 = (h->fs2 & ~0x000000ffu) | 0xe0u;
+			h->fs1 = (h->fs1 & ~0x00ff0000u) | (0xf0u << 16);
+		}
+		h->saved = true;
+	}
+	hsi2c_reset(h);
+}
+
+void
+hsi2c_reset(struct hsi2c *h)
+{
+	h->resets++;
+	W(h, HSI2C_INT_EN, 0);
+	W(h, HSI2C_USI_CON, 0);                 /* USI reset released */
+	W(h, HSI2C_CTL, R(h, HSI2C_CTL) | 0x80000000u);
+	W(h, HSI2C_CTL, R(h, HSI2C_CTL) & ~0x80000000u);
+	W(h, HSI2C_TIMING_FS3, h->fs3);
+	W(h, HSI2C_TIMING_FS2, h->fs2);
+	W(h, HSI2C_TIMING_FS1, h->fs1);
+	W(h, HSI2C_CTL, 0x8u);                  /* master */
+	W(h, HSI2C_TRAILING_CTL, 0x00ffffffu);
+	W(h, HSI2C_TIMEOUT, R(h, HSI2C_TIMEOUT) & ~0x80000000u);
+	W(h, HSI2C_CONF, R(h, HSI2C_CONF) | 0x80000000u);      /* AUTO mode */
+	W(h, HSI2C_INT_STAT, R(h, HSI2C_INT_STAT) & 0xfffu);
+}
+
+int
+hsi2c_msg(struct hsi2c *h, uint8_t addr7, bool receive, uint8_t *buf, unsigned count, bool stop)
+{
+	uint32_t last = 0;
+	unsigned done = 0, tx_idle = 0;
+	bool xfer_done = false;
+
+	if (count == 0 || count > 32 || addr7 > 0x7fu) {
+		return -1;
+	}
+	unsigned trig = count < 8 ? count : 8;
+	W(h, HSI2C_FIFO_CTL, 3u | (trig << 4) | (trig << 16));
+	W(h, HSI2C_ADDR, (uint32_t)addr7 << 10);
+	W(h, HSI2C_CTL, 0x8u | (receive ? 0x40u : 0x80u));
+	W(h, HSI2C_INT_EN, HSI2C_INT_XFER_DONE);
+	W(h, HSI2C_AUTO_CONF, count | (receive ? 0x10000u : 0) | (stop ? 0x20000u : 0));
+	W(h, HSI2C_AUTO_CONF, R(h, HSI2C_AUTO_CONF) | 0x80000000u);
+	for (unsigned us = 0; us < HSI2C_POLLS; us++) {
+		uint32_t irq = R(h, HSI2C_INT_STAT);
+		if (irq) {
+			last |= irq;
+			W(h, HSI2C_INT_STAT, irq);
+		}
+		if (irq & HSI2C_INT_ERRORS) {
+			break;
+		}
+		if (irq & HSI2C_INT_XFER_DONE) {
+			xfer_done = true;
+		}
+		if (receive) {
+			while (done < count && !(R(h, HSI2C_FIFO_STAT) & HSI2C_FIFO_RX_EMPTY)) {
+				buf[done++] = (uint8_t)R(h, HSI2C_RX_DATA);
+			}
+		} else {
+			while (done < count && !(R(h, HSI2C_FIFO_STAT) & HSI2C_FIFO_TX_FULL)) {
+				W(h, HSI2C_TX_DATA, buf[done++]);
+			}
+			if (!stop && done == count && (R(h, HSI2C_FIFO_STAT) & HSI2C_FIFO_TX_EMPTY)) {
+				tx_idle++;
+			}
+		}
+		if (done == count && (xfer_done || (receive && stop) || tx_idle > HSI2C_TX_IDLE_POLLS)) {
+			W(h, HSI2C_INT_EN, 0);
+			if (!stop) {
+				return 0;
+			}
+			for (unsigned n = 0; n < 10000; n++) {
+				if (!(R(h, HSI2C_TRANS_STATUS) & (1u << 17))) {
+					return 0;
+				}
+				h->io->delay_us(h->io->ctx, 1);
+			}
+			break;
+		}
+		h->io->delay_us(h->io->ctx, 1);
+	}
+	h->errors++;
+	h->last_int = last;
+	h->last_fifo = R(h, HSI2C_FIFO_STAT);
+	h->last_trans = R(h, HSI2C_TRANS_STATUS);
+	W(h, HSI2C_INT_EN, 0);
+	hsi2c_reset(h);
+	return -1;
+}
+
+int
+hsi2c_read_reg(struct hsi2c *h, uint8_t addr7, uint8_t reg, uint8_t *buf, unsigned len)
+{
+	for (unsigned attempt = 0; attempt < 2; attempt++) {
+		if (hsi2c_msg(h, addr7, false, &reg, 1, false) == 0 && hsi2c_msg(h, addr7, true, buf, len, true) == 0) {
+			return 0;
+		}
+		hsi2c_reset(h);
+		h->fallbacks++;
+		if (hsi2c_msg(h, addr7, false, &reg, 1, true) == 0 && hsi2c_msg(h, addr7, true, buf, len, true) == 0) {
+			return 0;
+		}
+		hsi2c_reset(h);
+		h->io->delay_us(h->io->ctx, 300);
+	}
+	return -1;
+}
+
+int
+hsi2c_write_reg(struct hsi2c *h, uint8_t addr7, uint8_t reg, uint8_t value)
+{
+	uint8_t m[2] = { reg, value };
+	if (addr7 != HSI2C_WRITE_ADDR || reg != HSI2C_WRITE_REG) {
+		return -1;
+	}
+	for (unsigned attempt = 0; attempt < 2; attempt++) {
+		if (hsi2c_msg(h, addr7, false, m, 2, true) == 0) {
+			return 0;
+		}
+		hsi2c_reset(h);
+	}
+	return -1;
+}
diff --git a/iokit/Kernel/arm/starbite/StarbiteBattery/hw/exynos_hsi2c.h b/iokit/Kernel/arm/starbite/StarbiteBattery/hw/exynos_hsi2c.h
new file mode 100644
index 00000000..4e5cec82
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteBattery/hw/exynos_hsi2c.h
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * A polled, read-only Exynos 9810 USI HSI2C master in AUTO mode, for the MAX77705 on HSI2C 0x14360000 (USI_CMGP03).
+ * Re-implemented from our own build/xnu-12377/bsd/dev/starlte_touch.c (st_bus_init / st_message) and
+ * herolte_battery.c (fg_message, repeated start). Facts: ../NOTES.md.
+ *
+ * Towards the devices: one-byte register pointers before a read, and ONE register write, the MAX77705 charger
+ * watchdog clear (0x69:0xbd, value (cur & 0x0c) | 1; allowed 2026-11-11). hsi2c_write_reg refuses anything else
+ * itself, before any bus traffic. Clear-on-read registers are refused (max77705.h lists them).
+ * When StarbiteHSI2C (row 13) exists this file is replaced by its provider API (INTEGRATION.md).
+ */
+#ifndef STARBITE_EXYNOS_HSI2C_H
+#define STARBITE_EXYNOS_HSI2C_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define HSI2C_CTL               0x00u   /* [31] soft reset, [7] TXCHON, [6] RXCHON, [3] master */
+#define HSI2C_FIFO_CTL          0x04u   /* [0] RX FIFO en, [1] TX FIFO en, [10:4] RX trigger, [22:16] TX trigger */
+#define HSI2C_TRAILING_CTL      0x08u
+#define HSI2C_INT_EN            0x20u
+#define HSI2C_INT_STAT          0x24u   /* [7] TRANSFER_DONE (auto), [11:8] errors (NACKs, timeout) */
+#define HSI2C_FIFO_STAT         0x30u   /* [7] TX full, [8] TX empty, [22:16] RX level, [24] RX empty */
+#define HSI2C_TX_DATA           0x34u
+#define HSI2C_RX_DATA           0x38u
+#define HSI2C_CONF              0x40u   /* [31] AUTO mode */
+#define HSI2C_AUTO_CONF         0x44u   /* [15:0] count, [16] read, [17] STOP after, [31] MASTER_RUN */
+#define HSI2C_TIMEOUT           0x48u   /* [31] timeout enable */
+#define HSI2C_TRANS_STATUS      0x50u   /* [17] master busy */
+#define HSI2C_TIMING_FS1        0x60u
+#define HSI2C_TIMING_FS2        0x64u
+#define HSI2C_TIMING_FS3        0x68u
+#define HSI2C_ADDR              0x70u   /* [16:10] slave address (master) */
+#define HSI2C_USI_CON           0xc4u   /* [0] USI reset, active high */
+
+#define HSI2C_INT_XFER_DONE     0x80u
+#define HSI2C_INT_ERRORS        0xf00u
+#define HSI2C_FIFO_TX_FULL      (1u << 7)
+#define HSI2C_FIFO_TX_EMPTY     (1u << 8)
+#define HSI2C_FIFO_RX_EMPTY     (1u << 24)
+
+#define HSI2C_POLLS             50000u  /* x 1 us per message */
+#define HSI2C_TX_IDLE_POLLS      200u    /* TX empty this long without TRANSFER_DONE: a no-STOP write is out */
+
+struct hsi2c_io {
+	void *ctx;
+	uint32_t (*rd)(void *ctx, uint32_t off);
+	void (*wr)(void *ctx, uint32_t off, uint32_t v);
+	void (*delay_us)(void *ctx, uint32_t us);
+};
+
+struct hsi2c {
+	const struct hsi2c_io *io;
+	uint32_t fs1, fs2, fs3;         /* S-Boot's timing, saved before the first reset */
+	bool saved;
+	uint32_t errors, resets, fallbacks;
+	uint32_t last_int, last_fifo, last_trans;
+};
+
+/* Save S-Boot's timing (0x21 / 0xe0 / 0xf0 for 400 kHz from 200 MHz if it left none), then reset the controller. */
+void hsi2c_init(struct hsi2c *h, const struct hsi2c_io *io);
+void hsi2c_reset(struct hsi2c *h);
+
+/* One AUTO-mode message; stop = false leaves the bus for a repeated START. 1..32 bytes. 0 = ok. */
+int hsi2c_msg(struct hsi2c *h, uint8_t addr7, bool receive, uint8_t *buf, unsigned count, bool stop);
+
+/* Register read: pointer byte without STOP, then a read with STOP (repeated start); if that fails, the same
+ * with a STOP between the halves. 0 = ok. */
+int hsi2c_read_reg(struct hsi2c *h, uint8_t addr7, uint8_t reg, uint8_t *buf, unsigned len);
+
+/* The one write: (0x69, 0xbd) only; any other address or register returns -1 without touching the bus. The
+ * caller checks the value with max77705_write_allowed. 0 = ok. */
+#define HSI2C_WRITE_ADDR        0x69u
+#define HSI2C_WRITE_REG         0xbdu
+int hsi2c_write_reg(struct hsi2c *h, uint8_t addr7, uint8_t reg, uint8_t value);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/starbite/StarbiteBattery/hw/max77705.c b/iokit/Kernel/arm/starbite/StarbiteBattery/hw/max77705.c
new file mode 100644
index 00000000..dc95ff52
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteBattery/hw/max77705.c
@@ -0,0 +1,209 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/* MAX77705 fuel gauge and charger, read only (see max77705.h and ../NOTES.md). */
+#include "max77705.h"
+
+bool
+max77705_read_allowed(uint8_t addr7, uint8_t reg)
+{
+	switch (addr7) {
+	case MAX77705_FG_ADDR:
+		return true;
+	case MAX77705_CHG_ADDR:
+		return reg != CHG_INT;                  /* CHG_INT clears on read */
+	case MAX77705_PMIC_ADDR:
+		return reg != 0x22u && reg != 0x24u;    /* INTSRC, SYSTEM_INT clear on read */
+	case 0x25u:                                     /* USB-C: UIC/CC/PD/VDM_INT clear on read */
+		return reg < 0x02u || reg > 0x05u;
+	default:
+		return false;                           /* 0x62 debug and anything else */
+	}
+}
+
+bool
+max77705_write_allowed(uint8_t addr7, uint8_t reg, uint8_t value, uint8_t cur)
+{
+	return addr7 == MAX77705_CHG_ADDR && reg == CHG_CNFG_06 &&
+	    value == (uint8_t)((cur & CHG_CNFG_06_CHGPROT) | CHG_CNFG_06_WDTCLR_KICK);
+}
+
+static int
+rd(const struct max77705_bus *bus, uint8_t addr7, uint8_t reg, uint8_t *buf, unsigned len)
+{
+	if (!max77705_read_allowed(addr7, reg)) {
+		return -1;
+	}
+	return bus->read(bus->ctx, addr7, reg, buf, len);
+}
+
+/* A gauge word, up to three reads; with lo < hi a value outside [lo, hi] is read again, then rejected. */
+static bool
+fg_word(const struct max77705_bus *bus, uint8_t reg, uint16_t *v, uint32_t lo, uint32_t hi, uint32_t *retries)
+{
+	for (unsigned a = 0; a < 3; a++) {
+		uint8_t b[2];
+		if (a) {
+			(*retries)++;
+		}
+		if (rd(bus, MAX77705_FG_ADDR, reg, b, 2) != 0) {
+			continue;
+		}
+		uint16_t w = (uint16_t)(b[0] | (uint32_t)b[1] << 8);
+		if (lo < hi && (w < lo || w > hi)) {
+			continue;
+		}
+		*v = w;
+		return true;
+	}
+	return false;
+}
+
+int
+max77705_sample(const struct max77705_bus *bus, struct max77705_raw *raw)
+{
+	uint32_t *rt = &raw->fg_retries;
+	raw->fg_retries = 0;
+	/* RepSOC <= 101 %, VCELL 2.5..4.7 V: a failed or impossible read never becomes 0 % / 0 mV */
+	raw->fg_ok = fg_word(bus, FG_REPSOC, &raw->repsoc, 0, 0x6500, rt) &&
+	    fg_word(bus, FG_VCELL, &raw->vcell, 32000, 60160, rt);
+	if (raw->fg_ok) {
+		if (!fg_word(bus, FG_AVGVCELL, &raw->avgvcell, 32000, 60160, rt)) {
+			raw->avgvcell = raw->vcell;
+		}
+		if (!fg_word(bus, FG_CURRENT, &raw->current, 0, 0, rt)) {
+			raw->current = 0;
+		}
+		if (!fg_word(bus, FG_AVGCURRENT, &raw->avgcurrent, 0, 0, rt)) {
+			raw->avgcurrent = raw->current;
+		}
+		raw->fg_ok = fg_word(bus, FG_DESIGNCAP, &raw->designcap, 0, 0, rt) &&
+		    fg_word(bus, FG_STATUS, &raw->status, 0, 0, rt) &&
+		    fg_word(bus, FG_INIT_RESULT, &raw->init_result, 0, 0, rt) &&
+		    fg_word(bus, FG_REPCAP, &raw->repcap, 0, 6000, rt) &&
+		    fg_word(bus, FG_FULLCAPREP, &raw->fullcaprep, 0, 6000, rt);
+		if (!fg_word(bus, FG_TEMP, &raw->temp, 0, 0, rt)) {
+			raw->temp = 25u << 8;
+		}
+		if (!fg_word(bus, FG_CYCLES, &raw->cycles, 0, 0, rt)) {
+			raw->cycles = 0;
+		}
+	}
+	raw->chg_ok = rd(bus, MAX77705_CHG_ADDR, CHG_INT_OK, &raw->int_ok, 1) == 0 &&
+	    rd(bus, MAX77705_CHG_ADDR, CHG_DETAILS_00, &raw->dtls00, 1) == 0 &&
+	    rd(bus, MAX77705_CHG_ADDR, CHG_DETAILS_01, &raw->dtls01, 1) == 0;
+	if (raw->chg_ok) {
+		(void)rd(bus, MAX77705_CHG_ADDR, CHG_DETAILS_02, &raw->dtls02, 1);
+		(void)rd(bus, MAX77705_CHG_ADDR, CHG_CNFG_00, &raw->cnfg00, 1);
+	}
+	return raw->fg_ok ? 0 : -1;
+}
+
+void
+battery_fallback(struct battery_state *st, const char *why)
+{
+	struct battery_state z = { 0 };
+	*st = z;
+	st->measured = false;
+	st->why = why;
+	st->percent = 100;
+	st->soc_x10 = 1000;
+	st->mv = st->avg_mv = 4200;
+	st->temp_c10 = 250;
+	st->cur_mah = st->max_mah = st->design_mah = S9_FULL_CAPACITY_MAH;
+	st->external = st->charge_capable = true;
+	st->full = true;
+	st->present = true;
+	st->chg_dtls = st->bat_dtls = st->chgin_dtls = -1;
+	st->minutes_to_empty = st->minutes_to_full = -1;
+}
+
+void
+max77705_state(const struct max77705_raw *raw, struct battery_state *st, uint32_t *low_count)
+{
+	if (!raw->fg_ok) {
+		battery_fallback(st, "fuel gauge not answering (or an implausible RepSOC / VCELL)");
+		*low_count = 0;
+		return;
+	}
+	if (raw->designcap != S9_DESIGN_RAW || (raw->init_result >> 8) == 0xffu) {
+		battery_fallback(st, "fuel gauge model not loaded (DesignCap != 0x0b97 or init result 0xff)");
+		*low_count = 0;
+		return;
+	}
+	if (raw->status & 0x0008u) {
+		battery_fallback(st, "fuel gauge says no battery (Status.Bst)");
+		*low_count = 0;
+		return;
+	}
+	struct battery_state z = { 0 };
+	*st = z;
+	st->measured = true;
+	st->why = raw->chg_ok ? "measured; temperature is S-Boot's last write (not live)" :
+	    "measured; charger not answering: cable from the current's sign";
+	st->present = true;
+	st->soc_x10 = max77705_soc_x10(raw->repsoc) * 1000 / (int32_t)S9_CAPACITY_MAX;
+	if (st->soc_x10 > 1000) {
+		st->soc_x10 = 1000;
+	}
+	st->percent = (uint32_t)(st->soc_x10 + 5) / 10u;
+	st->mv = (uint32_t)max77705_mv(raw->vcell);
+	st->avg_mv = (uint32_t)max77705_mv(raw->avgvcell);
+	st->ma = max77705_ma(raw->current);
+	st->avg_ma = max77705_ma(raw->avgcurrent);
+	st->temp_c10 = max77705_temp_c10(raw->temp);
+	st->cur_mah = (uint32_t)max77705_mah(raw->repcap);
+	st->max_mah = (uint32_t)max77705_mah(raw->fullcaprep);
+	st->design_mah = (uint32_t)max77705_mah(raw->designcap);
+	st->cycles = max77705_cycles(raw->cycles);
+	if (raw->chg_ok) {
+		st->wireless = (raw->int_ok & CHG_INT_OK_WCIN) != 0;
+		st->external = st->wireless || (raw->int_ok & CHG_INT_OK_CHGIN) != 0;
+		st->chgin_dtls = (raw->dtls00 >> 5) & 3;
+		st->chg_dtls = raw->dtls01 & 0xf;
+		st->bat_dtls = (raw->dtls01 >> 4) & 7;
+		st->charge_capable = st->external && (st->wireless || st->chgin_dtls == 3);
+		st->charging = st->external && st->chg_dtls <= 2;
+		st->full = st->external && (st->chg_dtls == 3 || st->chg_dtls == 4);
+		st->charger_wdt_expired = st->chg_dtls == 0x0b;
+	} else {
+		st->chg_dtls = st->bat_dtls = st->chgin_dtls = -1;
+		st->charging = st->external = st->charge_capable = st->avg_ma > 20;
+	}
+	st->minutes_to_empty = st->minutes_to_full = -1;
+	if (st->avg_ma < -20) {
+		st->minutes_to_empty = (int32_t)(st->cur_mah * 60u / (uint32_t)(-st->avg_ma));
+	} else if (st->charging && st->avg_ma > 20 && st->max_mah > st->cur_mah) {
+		st->minutes_to_full = (int32_t)((st->max_mah - st->cur_mah) * 60u / (uint32_t)st->avg_ma);
+	}
+	/* low: three samples in a row at <= 2 % and <= 3.45 V on battery before AtCriticalLevel */
+	bool low = !st->external && st->soc_x10 <= 20 && st->mv <= 3450;
+	*low_count = low ? *low_count + 1 : 0;
+	st->critical = *low_count >= 3;
+	st->warn = !st->external && st->soc_x10 <= 100;
+}
+
+int
+max77705_wdt_kick(const struct max77705_bus *bus, uint8_t *written)
+{
+	uint8_t cnfg00 = 0, cnfg06 = 0;
+	if (bus->write == 0) {
+		return MAX77705_KICK_EREFUSED;
+	}
+	if (rd(bus, MAX77705_CHG_ADDR, CHG_CNFG_00, &cnfg00, 1) != 0 ||
+	    rd(bus, MAX77705_CHG_ADDR, CHG_CNFG_06, &cnfg06, 1) != 0) {
+		return MAX77705_KICK_EREAD;
+	}
+	if (!(cnfg00 & CHG_CNFG_00_WDTEN)) {
+		return MAX77705_KICK_OFF;
+	}
+	uint8_t v = (uint8_t)((cnfg06 & CHG_CNFG_06_CHGPROT) | CHG_CNFG_06_WDTCLR_KICK);
+	if (!max77705_write_allowed(MAX77705_CHG_ADDR, CHG_CNFG_06, v, cnfg06)) {
+		return MAX77705_KICK_EREFUSED;
+	}
+	if (bus->write(bus->ctx, MAX77705_CHG_ADDR, CHG_CNFG_06, v) != 0) {
+		return MAX77705_KICK_EWRITE;
+	}
+	if (written) {
+		*written = v;
+	}
+	return MAX77705_KICK_OK;
+}
diff --git a/iokit/Kernel/arm/starbite/StarbiteBattery/hw/max77705.h b/iokit/Kernel/arm/starbite/StarbiteBattery/hw/max77705.h
new file mode 100644
index 00000000..8b89725f
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteBattery/hw/max77705.h
@@ -0,0 +1,139 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * MAX77705 fuel gauge (I2C 0x36) and charger (0x69) on the S9, plain C. Read only, except the one allowed write:
+ * the charger watchdog clear (CNFG_06 WDTCLR = 01, max77705_wdt_kick). Register facts with sources:
+ * ../NOTES.md (build/em-research-battery.md, the vendor DTB). Fixed-point conversions for the S9's
+ * fg_resistor = 2 (5 mOhm sense):
+ *   VCELL / AvgVCELL      mV  = raw * 78.125 uV          = raw * 5 / 64
+ *   Current / AvgCurrent  mA  = s16 * 0.3125 (+ = into the battery)  = s * 5 / 16
+ *   RepSOC                %   = raw / 256 (0.1 %: hi * 10 + lo * 10 / 256)
+ *   RepCap / FullCapRep / DesignCap  mAh = raw (fg_resistor / 2 = 1)
+ *   Temperature           C   = s16 / 256 (host-written on the S9: S-Boot's ADC reading, stale)
+ *   Cycles                cycles = raw / 100 [inferred: ModelGauge m5 1 % LSB; not confirmed for the MAX77705]
+ */
+#ifndef STARBITE_MAX77705_H
+#define STARBITE_MAX77705_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define MAX77705_PMIC_ADDR      0x66u
+#define MAX77705_FG_ADDR        0x36u
+#define MAX77705_CHG_ADDR       0x69u
+
+/* fuel gauge (16 bit, little endian) */
+#define FG_STATUS               0x00u
+#define FG_REPCAP               0x05u
+#define FG_REPSOC               0x06u
+#define FG_TEMP                 0x08u
+#define FG_VCELL                0x09u
+#define FG_CURRENT              0x0au
+#define FG_AVGCURRENT           0x0bu
+#define FG_FULLCAP              0x10u
+#define FG_CYCLES               0x17u
+#define FG_DESIGNCAP            0x18u
+#define FG_AVGVCELL             0x19u
+#define FG_FULLCAPREP           0x35u
+#define FG_INIT_RESULT          0xb2u   /* hi byte 0xff: S-Boot's model load failed */
+
+/* charger (8 bit) */
+#define CHG_INT                 0xb0u   /* clear on read: NEVER read */
+#define CHG_INT_OK              0xb2u
+#define CHG_DETAILS_00          0xb3u
+#define CHG_DETAILS_01          0xb4u
+#define CHG_DETAILS_02          0xb5u
+#define CHG_CNFG_00             0xb7u
+
+#define CHG_CNFG_06             0xbdu   /* [3:2] CHGPROT, [1:0] WDTCLR: the ONE register ever written */
+#define CHG_CNFG_00_WDTEN       0x10u
+#define CHG_CNFG_06_CHGPROT     0x0cu
+#define CHG_CNFG_06_WDTCLR_KICK 0x01u
+#define MAX77705_WDT_KICK_S     30u     /* clear interval (s): Engineer OS's feed; Linux clears on every health poll */
+
+#define CHG_INT_OK_WCIN         0x20u
+#define CHG_INT_OK_CHGIN        0x40u
+
+/* S9 calibration (device/dtb/starlte.dts battery / fuelgauge nodes) */
+#define S9_FG_RESISTOR          2u      /* fuelgauge,fg_resistor */
+#define S9_DESIGN_RAW           0x0b97u /* fuelgauge,capacity: S-Boot's "initialized" marker, 2967 mAh */
+#define S9_CAPACITY_MAX         1000u   /* fuelgauge,capacity_max (0.1 %): no rescaling */
+#define S9_FULL_CAPACITY_MAH    3000u   /* battery,battery_full_capacity */
+#define S9_FLOAT_MV             4350u   /* battery,chg_float_voltage */
+
+/* Is this (addr, reg) safe to read? (no clear-on-read interrupt registers; no debug slave) */
+bool max77705_read_allowed(uint8_t addr7, uint8_t reg);
+
+/*
+ * The only write the driver may make (your decision, 2026-11-11 19:12): the charger watchdog clear, CNFG_06
+ * WDTCLR = 01 with CHGPROT kept as read, i.e. value == (cur & 0x0c) | 0x01 at 0x69:0xbd. Everything else: false.
+ */
+bool max77705_write_allowed(uint8_t addr7, uint8_t reg, uint8_t value, uint8_t cur);
+
+/* fixed-point conversions */
+static inline int32_t max77705_mv(uint16_t raw) { return (int32_t)((uint32_t)raw * 5u / 64u); }
+static inline int32_t max77705_ma(uint16_t raw) { return (int32_t)(int16_t)raw * 5 / 16; }
+static inline int32_t max77705_soc_x10(uint16_t raw) { return (int32_t)(raw >> 8) * 10 + (int32_t)((raw & 0xffu) * 10u / 256u); }
+static inline int32_t max77705_mah(uint16_t raw) { return (int32_t)((uint32_t)raw * S9_FG_RESISTOR / 2u); }
+static inline int32_t max77705_temp_c10(uint16_t raw) { return (int32_t)(int16_t)raw * 10 / 256; }
+static inline uint32_t max77705_cycles(uint16_t raw) { return raw / 100u; }
+
+/* A register reader: 0 = ok. On the phone hsi2c_read_reg, in the tests a model. */
+struct max77705_bus {
+	void *ctx;
+	int (*read)(void *ctx, uint8_t addr7, uint8_t reg, uint8_t *buf, unsigned len);
+	int (*write)(void *ctx, uint8_t addr7, uint8_t reg, uint8_t value);     /* may be NULL: read only */
+};
+
+/* The charger watchdog clear. Reads CNFG_00 (WDTEN) and CNFG_06; writes (CNFG_06 & 0x0c) | 0x01 when the watchdog
+ * is enabled. Results: */
+#define MAX77705_KICK_OK        0
+#define MAX77705_KICK_OFF       1       /* WDTEN clear: nothing to do, nothing written */
+#define MAX77705_KICK_EREAD     (-1)
+#define MAX77705_KICK_EWRITE    (-2)
+#define MAX77705_KICK_EREFUSED  (-3)
+int max77705_wdt_kick(const struct max77705_bus *bus, uint8_t *written);
+
+struct max77705_raw {
+	uint16_t repsoc, vcell, avgvcell, current, avgcurrent, temp, repcap, fullcaprep, designcap, cycles, status,
+	    init_result;
+	uint8_t int_ok, dtls00, dtls01, dtls02, cnfg00;
+	bool fg_ok, chg_ok;
+	uint32_t fg_retries;
+};
+
+/* What the IOPMPowerSource publishes. */
+struct battery_state {
+	bool measured;                  /* false: the safe static fallback (100 %, on AC), never 0 % */
+	const char *why;                /* why not measured / what is estimated */
+	uint32_t percent;               /* 0..100 */
+	int32_t soc_x10;
+	uint32_t mv, avg_mv;
+	int32_t ma, avg_ma;             /* + = charging */
+	int32_t temp_c10;
+	uint32_t cur_mah, max_mah, design_mah;
+	uint32_t cycles;
+	bool external, wireless, charge_capable, charging, full, present;
+	bool charger_wdt_expired;       /* CHG_DTLS 0x0b: S-Boot's charger watchdog ran out (nobody kicks it) */
+	int32_t chg_dtls, bat_dtls, chgin_dtls;
+	int32_t minutes_to_empty, minutes_to_full;      /* -1 unknown */
+	bool critical, warn;
+};
+
+/* Read one sample (fuel gauge words checked against plausible ranges, retried; charger bytes). 0 = gauge ok. */
+int max77705_sample(const struct max77705_bus *bus, struct max77705_raw *raw);
+
+/* Turn a sample into the published state. low_count: consecutive low samples so far (in/out), for the critical
+ * flag, which needs three in a row (one bad sample must never shut the phone down). */
+void max77705_state(const struct max77705_raw *raw, struct battery_state *st, uint32_t *low_count);
+
+/* The fallback SweetBattery has always published: 100 %, 4200 mV, on AC, not charging. */
+void battery_fallback(struct battery_state *st, const char *why);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
