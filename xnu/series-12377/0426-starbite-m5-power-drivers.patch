+
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+#include "StarbiteWatchdog/StarbiteWatchdog.cpp"
+#endif
diff --git a/iokit/Kernel/arm/starbite/StarbiteWatchdog/StarbiteWatchdog.cpp b/iokit/Kernel/arm/starbite/StarbiteWatchdog/StarbiteWatchdog.cpp
new file mode 100644
index 00000000..78a3d9a6
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteWatchdog/StarbiteWatchdog.cpp
@@ -0,0 +1,258 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * StarbiteWatchdog (docs/APPLE-S9-DRIVERS.md Part 3 row 9): see StarbiteWatchdog.h, hw/sbwdt.c, NOTES.md.
+ * The IOWatchdog front end answers watchdogd as SweetWatchdog (0040/0045) did: every selector accepted with zeroed
+ * outputs, IOPMUPrimary = 1; selector 1 counts as a check-in [inferred, NOTES.md].
+ */
+#include "StarbiteWatchdog.h"
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <kern/clock.h>
+#include <kern/debug.h>
+#include <pexpert/pexpert.h>
+#include <sys/proc.h>
+
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+extern "C" uint64_t sweet_fb_first_present;     /* SweetFramebuffer: first frame on the panel (0421) */
+#endif
+#if defined(STARBITE_WDT_VETO_HOOK)
+extern "C" void starlte_wdt_veto(const char *why);      /* herolte_ufs.c, added by integration */
+#endif
+
+/* ---- IOWatchdog (Apple's name, for watchdogd) ---- */
+
+OSDefineMetaClassAndStructors(IOWatchdog, IOService);
+
+bool
+IOWatchdog::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IOWatchdogUserClient");
+	setProperty("IOPMUPrimary", 1ULL, 32);     /* watchdogd writes the boot stage to the IOPMUPrimary service */
+	if (getMetaClass() == IOWatchdog::metaClass) {
+		registerService();              /* the plain front end (IOResources fallback); subclasses register later */
+		IOLog("StarbiteWatchdog: plain IOWatchdog (check-ins only, no hardware)\n");
+	}
+	return true;
+}
+
+IOReturn
+IOWatchdog::setProperties(OSObject *)
+{
+	return kIOReturnSuccess;
+}
+
+void
+IOWatchdog::userCheckIn(void)
+{
+}
+
+/* ---- the user client ---- */
+
+OSDefineMetaClassAndStructors(IOWatchdogUserClient, IOUserClient);
+
+bool
+IOWatchdogUserClient::start(IOService *provider)
+{
+	if (!IOUserClient::start(provider)) {
+		return false;
+	}
+	fOwner = OSDynamicCast(IOWatchdog, provider);
+	return fOwner != NULL;
+}
+
+IOReturn
+IOWatchdogUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+static uint64_t gWdtLogged;
+
+IOReturn
+IOWatchdogUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args, IOExternalMethodDispatch *,
+    OSObject *, void *)
+{
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutputDescriptor != NULL) {
+		static const uint64_t zero = 0;
+		IOByteCount len = args->structureOutputDescriptor->getLength();
+		for (IOByteCount off = 0; off < len; off += 8) {
+			args->structureOutputDescriptor->writeBytes(off, &zero, len - off < 8 ? len - off : 8);
+		}
+	} else if (args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	if (selector == 1 && fOwner) {
+		fOwner->userCheckIn();
+	}
+	if (selector < 64 && !(gWdtLogged & (1ULL << selector))) {
+		gWdtLogged |= 1ULL << selector;
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("StarbiteWatchdog: %s selector %u (in %u/%u, out %u/%u) -> ok\n", name, selector,
+		    args->scalarInputCount, args->structureInputSize, args->scalarOutputCount, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+
+/* ---- StarbiteWatchdog ---- */
+
+OSDefineMetaClassAndStructors(StarbiteWatchdog, IOWatchdog);
+
+static uint64_t
+uptime_ms(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+bool
+StarbiteWatchdog::start(IOService *provider)
+{
+	struct sbwdt_cfg c;
+	char stop[16] = "";
+	uint32_t own = 0;
+
+	if (!IOWatchdog::start(provider)) {
+		return false;
+	}
+	bzero(&c, sizeof(c));
+	fLock = IOLockAlloc();
+	fMap = provider->mapDeviceMemoryWithIndex(0);
+	if (fLock == NULL || fMap == NULL || fMap->getLength() < 0x10) {
+		IOLog("StarbiteWatchdog: no reg 0 on the nub: check-ins only\n");
+		registerService();
+		return true;
+	}
+	fBase = fMap->getVirtualAddress();
+	c.wtcon = *(volatile uint32_t *)(fBase + SBWDT_WTCON);
+	c.wtdat = *(volatile uint32_t *)(fBase + SBWDT_WTDAT);
+	uint32_t cnt = *(volatile uint32_t *)(fBase + SBWDT_WTCNT);
+	c.sbwdt_found = PE_parse_boot_argn("sbwdt", &c.sbwdt_s, sizeof(c.sbwdt_s));
+	c.test_boot = PE_parse_boot_argn("sbstop", stop, sizeof(stop) - 1) && stop[0] != '\0';
+	(void)PE_parse_boot_argn("sweetreboot", &c.sweetreboot_s, sizeof(c.sweetreboot_s));
+	c.noui_s = 300;
+	(void)PE_parse_boot_argn("sbnoui", &c.noui_s, sizeof(c.noui_s));
+	(void)PE_parse_boot_argn("sbwdtuser", &c.user_timeout_s, sizeof(c.user_timeout_s));
+	/* The PMU's mask words are not in this nub: treat the reset as masked, so without sbwdt= nothing is fed. */
+	c.pmu_mask = 1u << SBWDT_PMU_BIT;
+	sbwdt_plan(&c, &fW);
+#if defined(STARBITE_WDT_OWNER)
+	(void)PE_parse_boot_argn("sbwdtown", &own, sizeof(own));
+#endif
+	fOwner = own != 0 && fW.may_feed;
+	IOLog("StarbiteWatchdog: cluster 1 WTCON %#x WTDAT %u WTCNT %u (%u ms); %s; mode %s, period %u ms, userspace "
+	    "timeout %u s\n", c.wtcon, c.wtdat, cnt, fW.hw_ms, fW.why, fOwner ? "OWNER (feeds)" : "observer (never writes)",
+	    fW.period_ms, c.user_timeout_s);
+	setProperty("StarbiteWatchdogMode", fOwner ? "owner" : "observer");
+	setProperty("StarbiteWatchdogPlan", fW.why);
+	if (fW.may_feed) {
+		fLoop = IOWorkLoop::workLoop();
+		fTimer = IOTimerEventSource::timerEventSource(this, &StarbiteWatchdog::timerFired);
+		if (fLoop && fTimer && fLoop->addEventSource(fTimer) == kIOReturnSuccess) {
+			fTimerAdded = fRunning = true;
+			fTimer->setTimeoutMS(fOwner ? fW.period_ms : 1000);
+		}
+	}
+	registerService();
+	return true;
+}
+
+void
+StarbiteWatchdog::userCheckIn(void)
+{
+	if (fLock) {
+		IOLockLock(fLock);
+		sbwdt_checkin(&fW, uptime_ms());
+		IOLockUnlock(fLock);
+	}
+}
+
+void
+StarbiteWatchdog::tick(void)
+{
+	bool frame = true;
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+	frame = sweet_fb_first_present != 0;
+#endif
+	IOLockLock(fLock);
+	int was = fW.stopped;
+	bool feed = sbwdt_tick(&fW, uptime_ms(), panic_active() != 0, frame);
+	int now = fW.stopped;
+	IOLockUnlock(fLock);
+	if (feed && fOwner) {
+		__asm__ volatile ("dmb oshst" ::: "memory");
+		*(volatile uint32_t *)(fBase + SBWDT_WTCNT) = fW.reload;
+	}
+	if (now != was) {
+		IOLog("StarbiteWatchdog: %s after %llu feeds, %llu check-ins; the watchdog resets the phone\n",
+		    sbwdt_stop_name(now), fW.feeds, fW.checkins);
+		fRunning = false;
+		if (!fOwner && !fVetoSent) {
+			fVetoSent = true;
+#if defined(STARBITE_WDT_VETO_HOOK)
+			starlte_wdt_veto(sbwdt_stop_name(now));         /* today's feeder stops for good */
+#else
+			IOLog("StarbiteWatchdog: observer without the veto hook: today's feeder keeps feeding\n");
+#endif
+		}
+	}
+}
+
+void
+StarbiteWatchdog::timerFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	StarbiteWatchdog *me = OSDynamicCast(StarbiteWatchdog, owner);
+	if (me == NULL || !me->fRunning) {
+		return;
+	}
+	me->tick();
+	if (me->fRunning) {
+		sender->setTimeoutMS(me->fOwner ? me->fW.period_ms : 1000);
+	}
+}
+
+IOReturn
+StarbiteWatchdog::stopPolling(OSObject *owner, void *, void *, void *, void *)
+{
+	StarbiteWatchdog *me = OSDynamicCast(StarbiteWatchdog, owner);
+	if (me == NULL) {
+		return kIOReturnBadArgument;
+	}
+	me->fRunning = false;
+	me->fTimer->cancelTimeout();
+	me->fTimer->disable();
+	return kIOReturnSuccess;
+}
+
+void
+StarbiteWatchdog::stop(IOService *provider)
+{
+	/* Stopping the driver stops feeding: the watchdog then resets the phone (fail-safe). */
+	if (fLoop && fTimerAdded) {
+		(void)fLoop->runAction(&StarbiteWatchdog::stopPolling, this);
+		fLoop->removeEventSource(fTimer);
+		fTimerAdded = false;
+	}
+	IOWatchdog::stop(provider);
+}
+
+void
+StarbiteWatchdog::free(void)
+{
+	OSSafeReleaseNULL(fTimer);
+	OSSafeReleaseNULL(fLoop);
+	OSSafeReleaseNULL(fMap);
+	if (fLock) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOWatchdog::free();
+}
diff --git a/iokit/Kernel/arm/starbite/StarbiteWatchdog/StarbiteWatchdog.h b/iokit/Kernel/arm/starbite/StarbiteWatchdog/StarbiteWatchdog.h
new file mode 100644
index 00000000..7a0aeffb
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteWatchdog/StarbiteWatchdog.h
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * StarbiteWatchdog: Apple's IOWatchdog interface for watchdogd (IOServiceMatching("IOWatchdog"), a user client,
+ * IOPMUPrimary) on cluster 1's Exynos watchdog (0x10060000), keeping the loader's dead-man contract (hw/sbwdt.h).
+ *
+ * Two modes:
+ *   observer (default)  the watchdog is never written. Today's feeder in herolte_ufs.c (0399/0421/0423) keeps the
+ *                       contract. With sbwdtuser=T and the integration hook (STARBITE_WDT_VETO_HOOK), a watchdogd
+ *                       that stops checking in for T s stops that feeder for good (starlte_wdt_veto), so a userspace
+ *                       hang resets the phone where INFORM3 says.
+ *   owner (sbwdtown=1, only when built with STARBITE_WDT_OWNER, i.e. after integration removed the herolte_ufs.c
+ *                       feeder): this driver writes WTCNT = WTDAT itself, under the same contract.
+ * Never arms or re-programs the watchdog (WTCON / WTDAT are only read).
+ *
+ * IOWatchdog / IOWatchdogUserClient are defined here; SweetWatchdog.cpp (0040/0045), which defines the same
+ * classes, must not be built alongside (INTEGRATION.md).
+ */
+#ifndef STARBITE_WATCHDOG_H
+#define STARBITE_WATCHDOG_H
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include "hw/sbwdt.h"
+
+class IOWatchdog : public IOService {
+	OSDeclareDefaultStructors(IOWatchdog);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	virtual void userCheckIn(void);
+};
+
+class StarbiteWatchdog : public IOWatchdog {
+	OSDeclareDefaultStructors(StarbiteWatchdog);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	void userCheckIn(void) APPLE_KEXT_OVERRIDE;
+
+private:
+	IOMemoryMap *fMap;
+	vm_address_t fBase;
+	IOWorkLoop *fLoop;
+	IOTimerEventSource *fTimer;
+	bool fTimerAdded, fRunning, fOwner, fVetoSent;
+	IOLock *fLock;
+	struct sbwdt fW;
+
+	void tick(void);
+	static void timerFired(OSObject *owner, IOTimerEventSource *sender);
+	static IOReturn stopPolling(OSObject *owner, void *, void *, void *, void *);
+};
+
+class IOWatchdogUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOWatchdogUserClient);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args, IOExternalMethodDispatch *dispatch,
+	    OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+
+private:
+	IOWatchdog *fOwner;
+};
+
+#endif
diff --git a/iokit/Kernel/arm/starbite/StarbiteWatchdog/hw/sbwdt.c b/iokit/Kernel/arm/starbite/StarbiteWatchdog/hw/sbwdt.c
new file mode 100644
index 00000000..6115a166
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteWatchdog/hw/sbwdt.c
@@ -0,0 +1,127 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/* Cluster 1 watchdog maths and the dead-man contract (see sbwdt.h). */
+#include "sbwdt.h"
+
+uint32_t
+sbwdt_hw_ms(uint32_t wtcon, uint32_t wtdat)
+{
+	uint64_t pre = ((wtcon >> 8) & 0xffu) + 1u;
+	uint64_t div = 16u << ((wtcon >> 3) & 3u);
+	if (!(wtcon & SBWDT_WTCON_ENABLE) || !(wtcon & SBWDT_WTCON_RSTEN) || (wtdat & 0xffffu) == 0) {
+		return 0;
+	}
+	return (uint32_t)((uint64_t)(wtdat & 0xffffu) * pre * div * 1000u / SBWDT_CLK_HZ);
+}
+
+uint32_t
+sbwdt_period_ms(uint32_t secs, uint32_t hw_ms)
+{
+	uint64_t t = (uint64_t)secs * 1000u;
+	if (secs == 0 || hw_ms == 0) {
+		return 0;
+	}
+	if (hw_ms < t) {
+		t = hw_ms;
+	}
+	t /= 3u;
+	if (t < SBWDT_PERIOD_MIN_MS) {
+		t = SBWDT_PERIOD_MIN_MS;
+	}
+	if (t > SBWDT_PERIOD_MAX_MS) {
+		t = SBWDT_PERIOD_MAX_MS;
+	}
+	return (uint32_t)t;
+}
+
+const char *
+sbwdt_stop_name(int stopped)
+{
+	switch (stopped) {
+	case SBWDT_STOP_NONE: return "feeding";
+	case SBWDT_STOP_PANIC: return "stopped: panic";
+	case SBWDT_STOP_DEADMAN: return "stopped: sweetreboot + 60 s dead-man (0421)";
+	case SBWDT_STOP_NOUI: return "stopped: no frame on the panel by sbnoui (0421)";
+	case SBWDT_STOP_USERSPACE: return "stopped: watchdogd missed its check-ins";
+	default: return "?";
+	}
+}
+
+void
+sbwdt_plan(const struct sbwdt_cfg *cfg, struct sbwdt *w)
+{
+	struct sbwdt z = { 0 };
+	*w = z;
+	w->hw_ms = sbwdt_hw_ms(cfg->wtcon, cfg->wtdat);
+	w->reload = cfg->wtdat & 0xffffu;
+	if (cfg->test_boot) {
+		w->why = "sbstop= test boot (0423): XNU never feeds; the loader's watchdog resets the phone";
+		return;
+	}
+	if (cfg->sbwdt_found && cfg->sbwdt_s == 0) {
+		w->why = "sbwdt=0: never fed";
+		return;
+	}
+	if (w->hw_ms == 0) {
+		w->why = "the watchdog is not armed (left off; never armed here)";
+		return;
+	}
+	if (cfg->sbwdt_found) {
+		w->feed_s = cfg->sbwdt_s;
+	} else if ((cfg->pmu_dis | cfg->pmu_mask) & (1u << SBWDT_PMU_BIT)) {
+		w->why = "no sbwdt= and the PMU masks its reset: not the loader's, not fed";
+		return;
+	} else {
+		w->feed_s = (w->hw_ms + 999u) / 1000u;
+	}
+	w->period_ms = sbwdt_period_ms(w->feed_s, w->hw_ms);
+	if (w->period_ms == 0) {
+		w->why = "no feed period";
+		return;
+	}
+	if (cfg->sweetreboot_s) {
+		w->deadman_ms = ((uint64_t)cfg->sweetreboot_s + 60u) * 1000u;
+		w->noui_ms = (uint64_t)cfg->noui_s * 1000u;
+	}
+	w->user_timeout_ms = cfg->user_timeout_s * 1000u;
+	w->may_feed = true;
+	w->why = cfg->sbwdt_found ? "sbwdt=N: fed until a panic, a dead-man or a userspace stop" :
+	    "armed by the loader without sbwdt=: fed for its own timeout";
+}
+
+void
+sbwdt_checkin(struct sbwdt *w, uint64_t now_ms)
+{
+	w->checkins++;
+	w->last_checkin_ms = now_ms;
+	w->user_armed = true;
+}
+
+bool
+sbwdt_tick(struct sbwdt *w, uint64_t now_ms, bool panic, bool first_frame)
+{
+	if (!w->may_feed || w->stopped != SBWDT_STOP_NONE) {
+		return false;
+	}
+	if (panic) {
+		w->stopped = SBWDT_STOP_PANIC;
+		return false;
+	}
+	if (w->deadman_ms && now_ms >= w->deadman_ms) {
+		w->stopped = SBWDT_STOP_DEADMAN;
+		return false;
+	}
+	if (w->noui_ms) {
+		if (first_frame) {
+			w->noui_ms = 0;
+		} else if (now_ms >= w->noui_ms) {
+			w->stopped = SBWDT_STOP_NOUI;
+			return false;
+		}
+	}
+	if (w->user_timeout_ms && w->user_armed && now_ms - w->last_checkin_ms > w->user_timeout_ms) {
+		w->stopped = SBWDT_STOP_USERSPACE;
+		return false;
+	}
+	w->feeds++;
+	return true;
+}
diff --git a/iokit/Kernel/arm/starbite/StarbiteWatchdog/hw/sbwdt.h b/iokit/Kernel/arm/starbite/StarbiteWatchdog/hw/sbwdt.h
new file mode 100644
index 00000000..a0d1d936
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteWatchdog/hw/sbwdt.h
@@ -0,0 +1,85 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * Cluster 1's Exynos watchdog (0x10060000, samsung,exynos7-wdt, OSCCLK 26 MHz) and the loader's dead-man contract,
+ * plain C. The register maths and the "may XNU feed it" rule are the same as our build/xnu-12377/bsd/dev/
+ * starlte_health.h (0399, host-tested in tools/xnu-health-test against the loader); re-stated here so the driver and
+ * its tests stand alone. Facts and the contract: ../NOTES.md.
+ *
+ * The contract (never broken here):
+ *   1. sbstop=<stage> (0423): a test boot. XNU NEVER feeds; the loader's watchdog resets the phone in wdt s.
+ *   2. sbwdt=0: never fed.
+ *   3. Never armed, never re-programmed: WTCON / WTDAT are only read. A watchdog the loader did not arm stays off.
+ *   4. Once a panic starts: never fed again.
+ *   5. 0421 dead-man: with sweetreboot=S, feeding stops at S + 60 s, and at sbnoui= s (default 300) if no frame
+ *      reached the panel.
+ *   6. Userspace monitoring (new): once watchdogd has checked in and sbwdtuser=T is set, a gap of T s between
+ *      check-ins stops feeding for good (the phone then resets where INFORM3 says).
+ *   Stopping is one-way: nothing here ever resumes feeding.
+ */
+#ifndef STARBITE_SBWDT_H
+#define STARBITE_SBWDT_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SBWDT_WTCON             0x00u
+#define SBWDT_WTDAT             0x04u
+#define SBWDT_WTCNT             0x08u
+#define SBWDT_WTCON_RSTEN       (1u << 0)
+#define SBWDT_WTCON_ENABLE      (1u << 5)
+#define SBWDT_CLK_HZ            26000000u
+#define SBWDT_PMU_BIT           23u     /* cluster 1 in AUTOMATIC_WDT_RESET_DISABLE / MASK_WDT_RESET_REQUEST */
+#define SBWDT_PERIOD_MIN_MS     1000u
+#define SBWDT_PERIOD_MAX_MS     27500u
+
+/* What the boot gives: boot-args and the registers as found (read only). */
+struct sbwdt_cfg {
+	bool sbwdt_found;
+	uint32_t sbwdt_s;
+	bool test_boot;                 /* sbstop= present */
+	uint32_t sweetreboot_s;         /* 0 = none */
+	uint32_t noui_s;                /* sbnoui (default 300), 0 = off; only with sweetreboot */
+	uint32_t user_timeout_s;        /* sbwdtuser, 0 = no userspace monitoring */
+	uint32_t wtcon, wtdat, pmu_dis, pmu_mask;
+};
+
+#define SBWDT_STOP_NONE         0
+#define SBWDT_STOP_PANIC        1
+#define SBWDT_STOP_DEADMAN      2
+#define SBWDT_STOP_NOUI         3
+#define SBWDT_STOP_USERSPACE    4
+
+struct sbwdt {
+	bool may_feed;                  /* decided once at start */
+	const char *why;                /* why (not) */
+	uint32_t hw_ms, feed_s, period_ms, reload;
+	uint64_t deadman_ms, noui_ms;   /* uptime limits, 0 = none */
+	uint32_t user_timeout_ms;
+	bool user_armed;                /* watchdogd checked in at least once */
+	uint64_t last_checkin_ms;
+	uint64_t checkins, feeds;
+	int stopped;                    /* SBWDT_STOP_* */
+};
+
+uint32_t sbwdt_hw_ms(uint32_t wtcon, uint32_t wtdat);
+uint32_t sbwdt_period_ms(uint32_t secs, uint32_t hw_ms);
+
+/* Decide at start whether this boot's watchdog may be fed at all, and how often. */
+void sbwdt_plan(const struct sbwdt_cfg *cfg, struct sbwdt *w);
+
+/* At each timer tick: true = write WTCNT = reload now. first_frame: a frame has reached the panel. */
+bool sbwdt_tick(struct sbwdt *w, uint64_t now_ms, bool panic, bool first_frame);
+
+/* watchdogd checked in. */
+void sbwdt_checkin(struct sbwdt *w, uint64_t now_ms);
+
+const char *sbwdt_stop_name(int stopped);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
