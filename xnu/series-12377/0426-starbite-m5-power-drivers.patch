--- a/bsd/dev/herolte_ufs.c
+++ b/bsd/dev/herolte_ufs.c
@@ -1301,6 +1301,29 @@ starlte_sbstop_at(const char *stage)
 	return starlte_sbstop[0] != '\0' && strcmp(starlte_sbstop, stage) == 0;
 }
 
+/*
+ * 0426: an sbstop test boot never looks for its root (IOFindBSDRoot asks this first): the stages are driver stages
+ * that IOKit matching reaches, and the root search on STARLTE starts this file's ACPM, touch, GPU and microSD
+ * users, which must not run beside the Starbite drivers under test (ACPM hazard H1) or mount anything. The
+ * bootstrap thread then waits for the stop or the loader's watchdog. sbstoproot=1 looks for the root anyway.
+ */
+int starlte_sbstop_no_root(void);
+int
+starlte_sbstop_no_root(void)
+{
+	uint32_t root = 0;
+	if (starlte_sbstop[0] == '\0') {
+		return 0;
+	}
+	(void)PE_parse_boot_argn("sbstoproot", &root, sizeof(root));
+	if (root) {
+		return 0;
+	}
+	printf("STARBITE: sbstop=%s: test boot, no root search (sbstoproot=1 to search); waiting for the stop\n",
+	    starlte_sbstop);
+	return 1;
+}
+
 void
 starlte_sbstop_now(const char *stage)
 {
diff --git a/bsd/dev/starlte_touch.c b/bsd/dev/starlte_touch.c
index 49476736..f751d057 100644
--- a/bsd/dev/starlte_touch.c
+++ b/bsd/dev/starlte_touch.c
@@ -29,6 +29,7 @@
 #include <kern/locks.h>
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern void sweet_hid_touch(int finger, int down, int x, int y);
@@ -372,9 +373,39 @@ pmic_write(uint32_t type, uint32_t reg, uint8_t val)
 bool starlte_pmic_read(uint32_t type, uint32_t reg, uint8_t *val);
 bool starlte_pmic_write(uint32_t type, uint32_t reg, uint8_t val);
 
+/*
+ * 0426: one owner per ACPM channel (StarbiteACPM/INTEGRATION.md hazard H1). With the board ADT's acpm-ipc node
+ * (and sbacpm not 0) StarbiteACPM owns the APM mailbox: this file's own client stays off (no touch rails, no CPU
+ * DVFS, no governor) and starlte_pmic_read / _write / starlte_acpm_dvfs go through StarbiteACPM's C entry points,
+ * under its lock, sequence numbers and write policy. They return false until StarbiteACPM has started.
+ */
+extern bool starbite_acpm_pmic_read(uint32_t type, uint32_t reg, uint8_t *val);
+extern bool starbite_acpm_pmic_write(uint32_t type, uint32_t reg, uint8_t val);
+extern bool starbite_acpm_dvfs(uint32_t domain, uint32_t khz);
+
+static bool
+acpm_owned_by_iokit(void)
+{
+	static int owner = -1;          /* -1 not decided, 0 this file, 1 StarbiteACPM */
+	if (owner < 0) {
+		DTEntry node;
+		uint32_t on = 1;
+		(void)PE_parse_boot_argn("sbacpm", &on, sizeof(on));
+		owner = on != 0 && SecureDTLookupEntry(NULL, "/arm-io/acpm-ipc", &node) == kSuccess;
+		if (owner) {
+			printf("STARLTE ACPM: the board ADT has acpm-ipc: StarbiteACPM owns the APM channel; this file's "
+			    "client is off (touch rails, CPU DVFS, governor), PMIC and DVFS calls go through StarbiteACPM\n");
+		}
+	}
+	return owner == 1;
+}
+
 static bool
 acpm_ready(void)
 {
+	if (acpm_owned_by_iokit()) {
+		return false;
+	}
 	lck_mtx_lock(&acpm_lock);
 	bool ok = acpm_ch || acpm_init();
 	lck_mtx_unlock(&acpm_lock);
@@ -384,12 +415,18 @@ acpm_ready(void)
 bool
 starlte_pmic_read(uint32_t type, uint32_t reg, uint8_t *val)
 {
+	if (acpm_owned_by_iokit()) {
+		return starbite_acpm_pmic_read(type, reg, val);
+	}
 	return acpm_ready() && pmic_read(type, reg, val);
 }
 
 bool
 starlte_pmic_write(uint32_t type, uint32_t reg, uint8_t val)
 {
+	if (acpm_owned_by_iokit()) {
+		return starbite_acpm_pmic_write(type, reg, val);
+	}
 	return acpm_ready() && pmic_write(type, reg, val);
 }
 
@@ -402,6 +439,9 @@ bool starlte_acpm_dvfs(uint32_t domain, uint32_t khz);
 bool
 starlte_acpm_dvfs(uint32_t domain, uint32_t khz)
 {
+	if (acpm_owned_by_iokit()) {
+		return starbite_acpm_dvfs(domain, khz);
+	}
 	if (!acpm_ready() || acpm_chans == 0) {
 		return false;
 	}
