 OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
 
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+static unsigned starbiteCountChildren(const char *path, unsigned *withProp, const char *prop);
+static void starbiteM5Start(void);
+#endif
+
 bool
 SweetPlatformExpert::start(IOService *provider)
 {
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+	/*
+	 * 0426: the Starbite S9 drivers (KernelConfigTables) match arm-io nodes only the board ADT has. Without
+	 * them (today's ADTs) the old IOResources services IOWatchdog and SweetBattery stay as they were: they
+	 * wait for this resource. With them, StarbiteWatchdog and StarbiteBattery take those roles.
+	 */
+	unsigned boardNodes = 0;
+	(void)starbiteCountChildren("/arm-io", &boardNodes, "starbite,driver");
+	if (boardNodes == 0) {
+		publishResource("StarbiteLegacyBoard");
+	} else {
+		IOLog("StarbitePE: board ADT (%u arm-io nodes with drivers): Starbite drivers, no IOResources "
+		    "IOWatchdog / SweetBattery\n", boardNodes);
+	}
+	if (starlte_sbstop_at("m5")) {
+		starbiteM5Start();
+	}
+#endif
 #if defined(A5XELTE)
 	IOLog("A5XELTE: starting device-tree platform expert\n");
 #else
@@ -120,6 +148,103 @@ SweetPlatformExpert::starbiteReport(IOService *provider)
 		starlte_sbstop_now("pe");
 	}
 }
+
+/*
+ * 0426: XNU's calendar (PEGetUTCTimeOfDay) and settimeofday (PESetUTCTimeOfDay) through StarbiteRTC, as Apple's
+ * AppleARMPE does with its RTC (StarbiteRTC/INTEGRATION.md 3). 0 (as before) until StarbiteRTC has started;
+ * StarbiteRTC writes only with sbrtcwrite=1.
+ */
+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	StarbiteRTC *rtc = StarbiteRTC::shared();
+	return rtc ? rtc->getGMTTimeOfDay() : 0;
+}
+
+void
+SweetPlatformExpert::setGMTTimeOfDay(long secs)
+{
+	StarbiteRTC *rtc = StarbiteRTC::shared();
+	if (rtc) {
+		rtc->setGMTTimeOfDay(secs);
+	}
+}
+
+/*
+ * 0426, sbstop=m5 (docs/APPLE-S9-DRIVERS.md M5, one boot for four drivers): wait until StarbiteACPM, StarbiteRTC,
+ * StarbiteWatchdog and StarbiteBattery are registered (each has logged its own report by then), let StarbiteBattery
+ * take one timed sample (sbbatpoll=2 sbbattest=1 log it), print one summary line and stop into TWRP. Bounded: at
+ * most 50 s of waiting from the platform expert's start, then the summary says what is missing and the boot stops
+ * anyway, well before the loader's watchdog (never fed on sbstop boots, 0423).
+ */
+static uint64_t
+starbiteUptimeNs(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns;
+}
+
+static unsigned
+starbiteNumberProp(IOService *s, const char *key, bool *found)
+{
+	OSNumber *n = s ? OSDynamicCast(OSNumber, s->getProperty(key)) : NULL;
+	if (found) {
+		*found = n != NULL;
+	}
+	return n ? n->unsigned32BitValue() : 0;
+}
+
+static void
+starbiteM5Thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static const char *const names[] = { "StarbiteACPM", "StarbiteRTC", "StarbiteWatchdog", "StarbiteBattery" };
+	IOService *svc[4] = { };
+	uint64_t t0 = starbiteUptimeNs(), deadline = t0 + 50ULL * NSEC_PER_SEC;
+	unsigned up = 0;
+
+	IOLog("StarbiteM5: waiting up to 50 s for StarbiteACPM, StarbiteRTC, StarbiteWatchdog, StarbiteBattery\n");
+	for (unsigned i = 0; i < 4; i++) {
+		uint64_t now = starbiteUptimeNs();
+		OSDictionary *m = IOService::serviceMatching(names[i]);
+		if (m != NULL) {
+			svc[i] = IOService::waitForMatchingService(m, now < deadline ? deadline - now : 1);
+			m->release();
+		}
+		up += svc[i] != NULL;
+		IOLog("StarbiteM5: %s %s at %llu ms\n", names[i], svc[i] ? "registered" : "MISSING",
+		    starbiteUptimeNs() / NSEC_PER_MSEC);
+	}
+	if (svc[3] != NULL) {
+		IOSleep(3000);          /* one timed battery sample (sbbatpoll=2) */
+	}
+	StarbiteRTC *rtc = StarbiteRTC::shared();
+	long secs = rtc ? rtc->getGMTTimeOfDay() : 0;
+	bool haveCap = false, haveMv = false;
+	unsigned cap = starbiteNumberProp(svc[3], "CurrentCapacity", &haveCap);
+	unsigned mv = starbiteNumberProp(svc[3], "Voltage", &haveMv);
+	int ma = (int)starbiteNumberProp(svc[3], "Amperage", NULL);
+	bool iortc = IOService::getResourceService()->getProperty("IORTC") != NULL;
+	IOLog("StarbiteM5: %u/4 up: ACPM %s, RTC %s (IORTC %s, clock %ld), Watchdog %s, Battery %s (%s%u %%, %s%u mV, "
+	    "%d mA): %s\n", up, svc[0] ? "up" : "MISSING", svc[1] ? "up" : "MISSING", iortc ? "published" : "not published",
+	    secs, svc[2] ? "up" : "MISSING", svc[3] ? "up" : "MISSING", haveCap ? "" : "no ", cap, haveMv ? "" : "no ", mv,
+	    ma, up == 4 ? "M5 drivers PASS" : "M5 drivers FAIL");
+	for (unsigned i = 0; i < 4; i++) {
+		OSSafeReleaseNULL(svc[i]);
+	}
+	starlte_sbstop_now("m5");
+}
+
+static void
+starbiteM5Start(void)
+{
+	thread_t th;
+	if (kernel_thread_start(starbiteM5Thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	} else {
+		IOLog("StarbiteM5: no thread: the loader's watchdog ends this boot\n");
+	}
+}
 #endif
 
