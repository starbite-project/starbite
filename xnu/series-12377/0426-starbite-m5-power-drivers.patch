diff --git a/iokit/Kernel/arm/starbite/StarbiteACPM/StarbiteACPM.cpp b/iokit/Kernel/arm/starbite/StarbiteACPM/StarbiteACPM.cpp
new file mode 100644
index 00000000..89592a19
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteACPM/StarbiteACPM.cpp
@@ -0,0 +1,402 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * StarbiteACPM (docs/APPLE-S9-DRIVERS.md Part 3 row 7): see StarbiteACPM.h, hw/acpm_ipc.c, NOTES.md.
+ * Polled, one request at a time under fLock (as starlte_touch.c 0302); the IPC interrupt (SPI 0x44) is not used
+ * and the mailbox's INTMR1 is left as found.
+ */
+#include "StarbiteACPM.h"
+#include <IOKit/IOLib.h>
+#include <IOKit/IODeviceMemory.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/libkern.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <stdarg.h>
+
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+extern "C" int starlte_sbstop_at(const char *stage);
+extern "C" void starlte_sbstop_now(const char *stage);
+#endif
+
+#define super IOService
+OSDefineMetaClassAndStructors(StarbiteACPM, IOService);
+
+static StarbiteACPM *gStarbiteACPM;
+
+StarbiteACPM *
+StarbiteACPM::shared(void)
+{
+	return gStarbiteACPM;
+}
+
+/* ---- MMIO for hw/ ---- */
+
+uint32_t
+StarbiteACPM::ioSramRd(void *ctx, uint32_t off)
+{
+	StarbiteACPM *me = (StarbiteACPM *)ctx;
+	uint32_t v = *(volatile uint32_t *)(me->fSram + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+void
+StarbiteACPM::ioSramWr(void *ctx, uint32_t off, uint32_t v)
+{
+	StarbiteACPM *me = (StarbiteACPM *)ctx;
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(me->fSram + off) = v;
+}
+
+uint32_t
+StarbiteACPM::ioMboxRd(void *ctx, uint32_t off)
+{
+	StarbiteACPM *me = (StarbiteACPM *)ctx;
+	uint32_t v = *(volatile uint32_t *)(me->fMbox + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+void
+StarbiteACPM::ioMboxWr(void *ctx, uint32_t off, uint32_t v)
+{
+	StarbiteACPM *me = (StarbiteACPM *)ctx;
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(me->fMbox + off) = v;
+}
+
+void
+StarbiteACPM::ioBarrier(void *)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+void
+StarbiteACPM::ioDelay(void *, uint32_t us)
+{
+	IODelay(us);
+}
+
+uint64_t
+StarbiteACPM::ioNow(void *)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000u;
+}
+
+void
+StarbiteACPM::ioLog(void *, const char *fmt, ...)
+{
+	char line[256];
+	va_list ap;
+	va_start(ap, fmt);
+	vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	IOLog("StarbiteACPM: %s", line);
+}
+
+/* ---- start ---- */
+
+static bool
+u64pair(OSData *d, uint64_t *a, uint64_t *b)
+{
+	if (d == NULL || d->getLength() < 16) {
+		return false;
+	}
+	const uint8_t *p = (const uint8_t *)d->getBytesNoCopy();
+	memcpy(a, p, 8);
+	memcpy(b, p + 8, 8);
+	return true;
+}
+
+bool
+StarbiteACPM::mapRegions(IOService *provider, uint32_t *sramSize, uint32_t *initdata)
+{
+	fMboxMap = provider->mapDeviceMemoryWithIndex(0);
+	if (fMboxMap == NULL || fMboxMap->getLength() < 0x100) {
+		IOLog("StarbiteACPM: no mailbox (reg 0) on the nub\n");
+		return false;
+	}
+	if (provider->getDeviceMemoryCount() >= 2) {
+		fSramMap = provider->mapDeviceMemoryWithIndex(1);
+	} else {
+		uint64_t pa = 0, size = 0;
+		OSData *d = OSDynamicCast(OSData, provider->getProperty("sram"));
+		if (u64pair(d, &pa, &size) && size >= 0x1000 && size <= 0x100000) {
+			fSramMem = IODeviceMemory::withRange((IOPhysicalAddress)pa, (IOPhysicalLength)size);
+			if (fSramMem) {
+				fSramMap = fSramMem->map(kIOMapInhibitCache);
+			}
+		}
+	}
+	if (fSramMap == NULL) {
+		IOLog("StarbiteACPM: no APM SRAM (reg 1 or \"sram\") on the nub; see INTEGRATION.md\n");
+		return false;
+	}
+	*sramSize = (uint32_t)fSramMap->getLength();
+	*initdata = ACPM_S9_INITDATA;
+	OSData *id = OSDynamicCast(OSData, provider->getProperty("initdata-base"));
+	if (id && id->getLength() >= 4) {
+		memcpy(initdata, id->getBytesNoCopy(), 4);
+	}
+	fMbox = fMboxMap->getVirtualAddress();
+	fSram = fSramMap->getVirtualAddress();
+	IOLog("StarbiteACPM: mailbox %#llx, SRAM %#llx + %#x, initdata-base %#x\n",
+	    (unsigned long long)fMboxMap->getPhysicalAddress(), (unsigned long long)fSramMap->getPhysicalAddress(),
+	    *sramSize, *initdata);
+	return true;
+}
+
+/* One read-only look at the PMIC: the line PHONE-TEST.md's pass checks. No write. */
+void
+StarbiteACPM::report(void)
+{
+	static const struct {
+		uint8_t type, reg;
+		const char *name;
+	} regs[] = {
+		{ 0, 0x00, "PMICID" }, { 1, 0x6c, "LDO35" }, { 1, 0x74, "LDO43" }, { 1, 0x2b, "BUCK6" },
+		{ 1, 0x68, "LDO31" }, { 1, 0x4a, "LDO2" }, { 2, 0x00, "RTC_CTRL" }, { 2, 0x03, "RTC_CAPSEL" },
+	};
+	char line[200];
+	size_t o = 0;
+	unsigned ok = 0;
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		uint8_t v = 0;
+		IOReturn r = pmicRead(regs[i].type, regs[i].reg, &v);
+		ok += r == kIOReturnSuccess;
+		o += (size_t)snprintf(line + o, sizeof(line) - o, "%s%s=%s%02x", i ? " " : "", regs[i].name,
+		    r == kIOReturnSuccess ? "0x" : "ERR", r == kIOReturnSuccess ? v : 0);
+		if (o >= sizeof(line)) {
+			o = sizeof(line) - 1;
+		}
+	}
+	IOLog("StarbiteACPM: firmware \"%s\", PMIC channel %u: %s (%u/%u reads), %u timeouts, %u stale drained, "
+	    "INTMR1 %#x INTSR1 %#x\n", fAcpm.version, ACPM_CH_PMIC, line, ok, (unsigned)(sizeof(regs) / sizeof(regs[0])),
+	    fAcpm.st.timeouts, fAcpm.st.stale_drained, ioMboxRd(this, ACPM_MB_INTMR1), ioMboxRd(this, ACPM_MB_INTSR1));
+}
+
+void
+StarbiteACPM::publishStats(void)
+{
+	setProperty("ACPMFirmware", fAcpm.version);
+	setProperty("ACPMRequests", fAcpm.st.requests, 32);
+	setProperty("ACPMTimeouts", fAcpm.st.timeouts, 32);
+	setProperty("ACPMResends", fAcpm.st.resends, 32);
+	setProperty("ACPMStatusErrors", fAcpm.st.status_errors, 32);
+	setProperty("ACPMRefused", fAcpm.st.refused, 32);
+}
+
+bool
+StarbiteACPM::start(IOService *provider)
+{
+	uint32_t sramSize = 0, initdata = 0;
+	uint32_t off = 0;
+
+	if (!super::start(provider)) {
+		return false;
+	}
+	if (PE_parse_boot_argn("sbacpm", &off, sizeof(off)) && off == 0) {
+		IOLog("StarbiteACPM: sbacpm=0: not started\n");
+		return false;
+	}
+	fLock = IOLockAlloc();
+	if (fLock == NULL || !mapRegions(provider, &sramSize, &initdata)) {
+		return false;
+	}
+	fIo.ctx = this;
+	fIo.sram_rd = ioSramRd;
+	fIo.sram_wr = ioSramWr;
+	fIo.mbox_rd = ioMboxRd;
+	fIo.mbox_wr = ioMboxWr;
+	fIo.barrier = ioBarrier;
+	fIo.delay_us = ioDelay;
+	fIo.now_us = ioNow;
+	fIo.log = ioLog;
+	IOLockLock(fLock);
+	int e = acpm_setup(&fAcpm, &fIo, sramSize, ACPM_S9_SRAM_FIRST, initdata);
+	IOLockUnlock(fLock);
+	if (e != ACPM_OK) {
+		IOLog("StarbiteACPM: setup failed: %s\n", acpm_strerror(e));
+		return false;
+	}
+	fReady = true;
+	gStarbiteACPM = this;
+	report();
+	publishStats();
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+	if (starlte_sbstop_at("acpm")) {
+		starlte_sbstop_now("acpm");
+	}
+#endif
+	registerService();
+	return true;
+}
+
+void
+StarbiteACPM::stop(IOService *provider)
+{
+	if (gStarbiteACPM == this) {
+		gStarbiteACPM = NULL;
+	}
+	if (fLock) {
+		IOLockLock(fLock);
+		fReady = false;
+		IOLockUnlock(fLock);
+	}
+	super::stop(provider);
+}
+
+void
+StarbiteACPM::free(void)
+{
+	OSSafeReleaseNULL(fMboxMap);
+	OSSafeReleaseNULL(fSramMap);
+	OSSafeReleaseNULL(fSramMem);
+	if (fLock) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	super::free();
+}
+
+/* ---- client API ---- */
+
+static IOReturn
+toIOReturn(int e)
+{
+	switch (e) {
+	case ACPM_OK: return kIOReturnSuccess;
+	case ACPM_E_TIMEOUT: return kIOReturnTimeout;
+	case ACPM_E_STATUS: return kIOReturnIOError;
+	case ACPM_E_REFUSED: return kIOReturnNotPermitted;
+	case ACPM_E_ARG: return kIOReturnBadArgument;
+	default: return kIOReturnNotReady;
+	}
+}
+
+IOReturn
+StarbiteACPM::pmicRead(uint32_t type, uint32_t reg, uint8_t *value)
+{
+	if (value == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (!s2mps18_read_allowed(type, reg)) {
+		return kIOReturnNotPermitted;
+	}
+	IOLockLock(fLock);
+	int e = fReady ? acpm_pmic_read(&fAcpm, type, reg, value) : ACPM_E_NODEV;
+	if (e == ACPM_OK) {
+		s2mps18_note_read(&fPolicy, type, reg, *value);
+	}
+	IOLockUnlock(fLock);
+	return toIOReturn(e);
+}
+
+IOReturn
+StarbiteACPM::pmicWrite(uint32_t type, uint32_t reg, uint8_t value)
+{
+	const char *why = NULL;
+	uint8_t cur = 0;
+
+	IOLockLock(fLock);
+	int e = fReady ? acpm_pmic_read(&fAcpm, type, reg, &cur) : ACPM_E_NODEV;
+	if (e == ACPM_OK) {
+		s2mps18_note_read(&fPolicy, type, reg, cur);
+		if (s2mps18_write_allowed(&fPolicy, type, reg, value, cur, &why)) {
+			e = acpm_pmic_write_raw(&fAcpm, type, reg, value);
+		} else {
+			fAcpm.st.refused++;
+			e = ACPM_E_REFUSED;
+		}
+	}
+	IOLockUnlock(fLock);
+	if (e == ACPM_E_REFUSED) {
+		IOLog("StarbiteACPM: write %u:%#x = %#x (now %#x) REFUSED: %s\n", type, reg, value, cur, why);
+	} else if (e != ACPM_OK) {
+		IOLog("StarbiteACPM: write %u:%#x = %#x failed: %s\n", type, reg, value, acpm_strerror(e));
+	}
+	return toIOReturn(e);
+}
+
+IOReturn
+StarbiteACPM::dvfsSet(uint32_t domain, uint32_t khz)
+{
+	const char *why = NULL;
+	IOLockLock(fLock);
+	int e = ACPM_E_NODEV;
+	if (fReady) {
+		e = acpm_dvfs_allowed(domain, khz, fGovernor, &why) ? acpm_dvfs_request(&fAcpm, domain, khz, false, NULL) :
+		    ACPM_E_REFUSED;
+	}
+	if (e == ACPM_E_REFUSED) {
+		fAcpm.st.refused++;
+	}
+	IOLockUnlock(fLock);
+	if (e == ACPM_E_REFUSED) {
+		IOLog("StarbiteACPM: DVFS domain %u %u kHz REFUSED: %s\n", domain, khz, why);
+	}
+	return toIOReturn(e);
+}
+
+IOReturn
+StarbiteACPM::dvfsGet(uint32_t domain, uint32_t *khz)
+{
+	IOLockLock(fLock);
+	int e = fReady ? acpm_dvfs_request(&fAcpm, domain, 0, true, khz) : ACPM_E_NODEV;
+	IOLockUnlock(fLock);
+	return toIOReturn(e);
+}
+
+void
+StarbiteACPM::setThermalGovernor(bool active)
+{
+	IOLockLock(fLock);
+	fGovernor = active;
+	IOLockUnlock(fLock);
+	IOLog("StarbiteACPM: thermal governor %s: cpucl1 limit %u kHz\n", active ? "on" : "off",
+	    active ? 2704000u : 1794000u);
+}
+
+/* callPlatformFunction("starbite-acpm-pmic-read", false, type, reg, uint8_t *val, NULL) and
+ * "starbite-acpm-pmic-write" (type, reg, (void *)(uintptr_t)val), "starbite-acpm-dvfs" (domain, khz):
+ * for clients that only hold an IOService *. */
+IOReturn
+StarbiteACPM::callPlatformFunction(const OSSymbol *functionName, bool waitForFunction, void *p1, void *p2, void *p3,
+    void *p4)
+{
+	if (functionName->isEqualTo("starbite-acpm-pmic-read")) {
+		return pmicRead((uint32_t)(uintptr_t)p1, (uint32_t)(uintptr_t)p2, (uint8_t *)p3);
+	}
+	if (functionName->isEqualTo("starbite-acpm-pmic-write")) {
+		return pmicWrite((uint32_t)(uintptr_t)p1, (uint32_t)(uintptr_t)p2, (uint8_t)(uintptr_t)p3);
+	}
+	if (functionName->isEqualTo("starbite-acpm-dvfs")) {
+		return dvfsSet((uint32_t)(uintptr_t)p1, (uint32_t)(uintptr_t)p2);
+	}
+	return super::callPlatformFunction(functionName, waitForFunction, p1, p2, p3, p4);
+}
+
+extern "C" bool
+starbite_acpm_pmic_read(uint32_t type, uint32_t reg, uint8_t *val)
+{
+	StarbiteACPM *a = gStarbiteACPM;
+	return a != NULL && a->pmicRead(type, reg, val) == kIOReturnSuccess;
+}
+
+extern "C" bool
+starbite_acpm_pmic_write(uint32_t type, uint32_t reg, uint8_t val)
+{
+	StarbiteACPM *a = gStarbiteACPM;
+	return a != NULL && a->pmicWrite(type, reg, val) == kIOReturnSuccess;
+}
+
+extern "C" bool
+starbite_acpm_dvfs(uint32_t domain, uint32_t khz)
+{
+	StarbiteACPM *a = gStarbiteACPM;
+	return a != NULL && a->dvfsSet(domain, khz) == kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/starbite/StarbiteACPM/StarbiteACPM.h b/iokit/Kernel/arm/starbite/StarbiteACPM/StarbiteACPM.h
new file mode 100644
index 00000000..fdddb8f5
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteACPM/StarbiteACPM.h
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * StarbiteACPM: the provider service for the Exynos 9810 APM mailbox (ACPM IPC). Clients (StarbiteRTC, and later
+ * StarbiteTouch / StarbiteSD / StarbiteMali / StarbiteTMU) reach the S2MPS18 PMIC and the DVFS domains through it.
+ * Every PMIC write passes hw/s2mps18_policy.c; every DVFS request passes the clock limits below.
+ *
+ * Matching: IONameMatch "starbite,acpm-ipc" on the arm-io nub (tools/board/starlte.board block "acpm-ipc").
+ * Addresses: the nub's reg 0 (mailbox), reg 1 or the property "sram" <u64 pa, u64 size> (the APM SRAM),
+ * "initdata-base" (u32, default 0x7f00 as device/dtb/starlte.dts). Nothing is hard-coded.
+ */
+#ifndef STARBITE_ACPM_H
+#define STARBITE_ACPM_H
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include "hw/acpm_ipc.h"
+#include "hw/s2mps18_policy.h"
+
+class StarbiteACPM : public IOService {
+	OSDeclareDefaultStructors(StarbiteACPM);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	IOReturn callPlatformFunction(const OSSymbol *functionName, bool waitForFunction, void *param1, void *param2,
+	    void *param3, void *param4) APPLE_KEXT_OVERRIDE;
+
+	/* S2MPS18 access. type: 0 TOP, 1 PMIC, 2 RTC. Reads of clear-on-read interrupt registers are refused. */
+	virtual IOReturn pmicRead(uint32_t type, uint32_t reg, uint8_t *value);
+	/* Read-check-write: the current value is read, the policy decides, then the write. */
+	virtual IOReturn pmicWrite(uint32_t type, uint32_t reg, uint8_t value);
+	/* DVFS (channel at table index 0). Limits: cpucl0/cpucl1 <= 1794000 kHz; cpucl1 up to 2704000 only while a
+	 * thermal governor has registered (setThermalGovernor); g3d only the six levels of starlte_gpu.c; no other
+	 * domain (MIF/INT froze the phone, boot69). */
+	virtual IOReturn dvfsSet(uint32_t domain, uint32_t khz);
+	virtual IOReturn dvfsGet(uint32_t domain, uint32_t *khz);
+	virtual void setThermalGovernor(bool active);
+
+	static StarbiteACPM *shared(void);      /* the started instance, or NULL */
+
+private:
+	IOMemoryMap *fMboxMap;
+	IOMemoryMap *fSramMap;
+	IODeviceMemory *fSramMem;               /* when it came from the "sram" property */
+	IOLock *fLock;
+	struct acpm fAcpm;
+	struct acpm_io fIo;
+	struct s2mps18_policy fPolicy;
+	vm_address_t fMbox;
+	vm_address_t fSram;
+	bool fGovernor;
+	bool fReady;
+
+	bool mapRegions(IOService *provider, uint32_t *sramSize, uint32_t *initdata);
+	void report(void);
+	void publishStats(void);
+
+	static uint32_t ioSramRd(void *ctx, uint32_t off);
+	static void ioSramWr(void *ctx, uint32_t off, uint32_t v);
+	static uint32_t ioMboxRd(void *ctx, uint32_t off);
+	static void ioMboxWr(void *ctx, uint32_t off, uint32_t v);
+	static void ioBarrier(void *ctx);
+	static void ioDelay(void *ctx, uint32_t us);
+	static uint64_t ioNow(void *ctx);
+	static void ioLog(void *ctx, const char *fmt, ...) __printflike(2, 3);
+};
+
+/* C entry points for today's bsd/dev drivers (starlte_touch.c, starlte_gpu.c, starlte_sd.c) once integration
+ * routes starlte_pmic_read / starlte_pmic_write / starlte_acpm_dvfs here (INTEGRATION.md). false until
+ * StarbiteACPM has started. Same policy and limits as the methods. */
+extern "C" {
+bool starbite_acpm_pmic_read(uint32_t type, uint32_t reg, uint8_t *val);
+bool starbite_acpm_pmic_write(uint32_t type, uint32_t reg, uint8_t val);
+bool starbite_acpm_dvfs(uint32_t domain, uint32_t khz);
+}
+
+#endif
diff --git a/iokit/Kernel/arm/starbite/StarbiteACPM/hw/acpm_ipc.c b/iokit/Kernel/arm/starbite/StarbiteACPM/hw/acpm_ipc.c
new file mode 100644
index 00000000..e6e80ef6
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteACPM/hw/acpm_ipc.c
@@ -0,0 +1,319 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * Exynos 9810 ACPM IPC, AP side (see acpm_ipc.h and ../NOTES.md). Written from our own
+ * build/xnu-12377/bsd/dev/starlte_touch.c (0302, run on the phone) and the facts in an earlier port's
+ * drivers/soc/exynos/exynos_acpm.c (APSL-2.0, an earlier port; credited in ../NOTES.md): the faulting first SRAM
+ * pages, 32-bit-only access, stale answers drained before each request, 600 ms per answer, three sends.
+ */
+#include "acpm_ipc.h"
+
+#define LOG(a, ...) do { if ((a)->io->log) (a)->io->log((a)->io->ctx, __VA_ARGS__); } while (0)
+
+static bool
+sram_ok(const struct acpm *a, uint32_t off, uint32_t bytes)
+{
+	return off >= a->sram_first && off <= a->sram_size && bytes <= a->sram_size - off && (off & 3u) == 0;
+}
+
+/* Reads outside the usable SRAM read as 0 (never touched); the setup checks every offset first. */
+static uint32_t
+srd(const struct acpm *a, uint32_t off)
+{
+	if (!sram_ok(a, off, 4)) {
+		return 0;
+	}
+	return a->io->sram_rd(a->io->ctx, off);
+}
+
+static void
+swr(const struct acpm *a, uint32_t off, uint32_t v)
+{
+	if (sram_ok(a, off, 4)) {
+		a->io->sram_wr(a->io->ctx, off, v);
+	}
+}
+
+static void
+barrier(const struct acpm *a)
+{
+	if (a->io->barrier) {
+		a->io->barrier(a->io->ctx);
+	}
+}
+
+const char *
+acpm_strerror(int e)
+{
+	switch (e) {
+	case ACPM_OK: return "ok";
+	case ACPM_E_NODEV: return "no such channel";
+	case ACPM_E_TIMEOUT: return "no answer";
+	case ACPM_E_STATUS: return "APM status error (SPEEDY)";
+	case ACPM_E_REFUSED: return "refused by the write policy";
+	case ACPM_E_TABLE: return "firmware table unusable";
+	case ACPM_E_ARG: return "bad argument";
+	default: return "?";
+	}
+}
+
+/* Every answer in a queue channel's answer queue taken out of the way, and its interrupt cleared. */
+static void
+drain(struct acpm *a, struct acpm_chan *c, uint32_t id)
+{
+	uint32_t front = srd(a, c->out_front), rear = srd(a, c->out_rear);
+	if (front < c->len && rear != front) {
+		swr(a, c->out_rear, front);
+		a->st.stale_drained++;
+	}
+	a->io->mbox_wr(a->io->ctx, ACPM_MB_INTCR1, 1u << id);
+}
+
+int
+acpm_setup(struct acpm *a, const struct acpm_io *io, uint32_t sram_size, uint32_t sram_first, uint32_t initdata)
+{
+	uint32_t i;
+
+	for (i = 0; i < sizeof(*a); i++) {
+		((uint8_t *)a)[i] = 0;
+	}
+	a->io = io;
+	a->sram_size = sram_size;
+	a->sram_first = sram_first;
+	a->initdata = initdata;
+	a->room_us = ACPM_ROOM_US;
+	a->answer_us = ACPM_ANSWER_US;
+	a->buffer_us = ACPM_BUFFER_US;
+	a->poll_us = ACPM_POLL_US;
+	a->sends = ACPM_SENDS;
+	if (!sram_ok(a, initdata, 0x80)) {
+		LOG(a, "acpm: initdata-base %#x not in usable SRAM (%#x..%#x)\n", initdata, sram_first, sram_size);
+		return ACPM_E_TABLE;
+	}
+	for (i = 0; i < 24; i += 4) {
+		uint32_t w = srd(a, initdata + ACPM_ID_STRINGS + i);
+		for (uint32_t b = 0; b < 4; b++) {
+			char ch = (char)(w >> (8 * b));
+			a->version[i + b] = (ch >= 32 && ch < 127) ? ch : '.';
+		}
+	}
+	a->version[24] = 0;
+	a->table = srd(a, initdata + ACPM_ID_CHANNELS);
+	a->nchannels = srd(a, initdata + ACPM_ID_NCHANNELS);
+	a->ap_max = srd(a, initdata + ACPM_ID_AP_MAX);
+	LOG(a, "acpm: firmware \"%s\", channel table at %#x, %u channels, %u the AP's\n", a->version, a->table,
+	    a->nchannels, a->ap_max);
+	if (a->ap_max == 0 || a->ap_max > ACPM_AP_MAX_LIMIT || !sram_ok(a, a->table, a->ap_max * ACPM_CH_SIZE)) {
+		LOG(a, "acpm: the channel table is not where it may be read: not used\n");
+		return ACPM_E_TABLE;
+	}
+	for (i = 0; i < a->ap_max; i++) {
+		uint32_t d = a->table + i * ACPM_CH_SIZE;
+		uint32_t id = srd(a, d + ACPM_CH_ID) & 0xffu;
+		struct acpm_chan n;
+		for (uint32_t k = 0; k < sizeof(n); k++) {
+			((uint8_t *)&n)[k] = 0;
+		}
+		n.desc = d;
+		n.owner = srd(a, d + ACPM_CH_OWNER);
+		n.type = srd(a, d + ACPM_CH_TYPE);
+		n.ap_poll = srd(a, d + ACPM_CH_AP_POLL);
+		n.in_rear = srd(a, d + ACPM_CH_IN_REAR);
+		n.in_front = srd(a, d + ACPM_CH_IN_FRONT);
+		n.in_base = srd(a, d + ACPM_CH_IN_BASE);
+		n.out_rear = srd(a, d + ACPM_CH_OUT_REAR);
+		n.out_front = srd(a, d + ACPM_CH_OUT_FRONT);
+		n.out_base = srd(a, d + ACPM_CH_OUT_BASE);
+		n.len = srd(a, d + ACPM_CH_QLEN);
+		n.elem = srd(a, d + ACPM_CH_ELEM);
+		n.buffer = n.len <= 1;
+		if (i == 0) {
+			a->index0_id = id;
+		}
+		if (n.buffer) {
+			n.usable = sram_ok(a, n.in_base, 16) && sram_ok(a, n.out_base, 16);
+		} else {
+			n.usable = n.len <= 64 && n.elem >= 16 && n.elem <= 256 && (n.elem & 3u) == 0 &&
+			    sram_ok(a, n.in_rear, 4) && sram_ok(a, n.in_front, 4) && sram_ok(a, n.out_rear, 4) &&
+			    sram_ok(a, n.out_front, 4) && sram_ok(a, n.in_base, n.len * n.elem) &&
+			    sram_ok(a, n.out_base, n.len * n.elem);
+		}
+		LOG(a, "acpm: channel %u (index %u): owner %u type %u, %s %u x %u, %s, %s\n", id, i, n.owner, n.type,
+		    n.buffer ? "buffer" : "queue", n.len, n.elem, n.ap_poll ? "polled" : "irq",
+		    n.usable ? "usable" : "NOT usable (offsets outside the SRAM)");
+		if (id >= ACPM_MAX_ID || a->ch[id].usable || !n.usable) {
+			continue;
+		}
+		a->ch[id] = n;
+		if (!n.buffer) {
+			drain(a, &a->ch[id], id);
+		}
+	}
+	a->ready = a->ch[ACPM_CH_PMIC].usable;
+	if (!a->ready) {
+		LOG(a, "acpm: no usable channel %u (PMIC)\n", ACPM_CH_PMIC);
+		return ACPM_E_NODEV;
+	}
+	return ACPM_OK;
+}
+
+/* The answer with our sequence number, if it has come: copied out, and the answer queue emptied. */
+static bool
+take_answer(struct acpm *a, struct acpm_chan *c, uint32_t id, uint32_t seq, uint32_t cmd[4])
+{
+	uint32_t rear = srd(a, c->out_rear), front = srd(a, c->out_front);
+	bool found = false;
+
+	if (rear >= c->len || front >= c->len || rear == front) {
+		return false;
+	}
+	for (uint32_t i = rear; i != front; i = (i + 1) % c->len) {
+		uint32_t slot = c->out_base + i * c->elem;
+		if (((srd(a, slot) & ACPM_SEQ_MASK) >> ACPM_SEQ_SHIFT) == seq) {
+			for (uint32_t w = 0; w < 4; w++) {
+				cmd[w] = srd(a, slot + 4 * w);
+			}
+			found = true;
+		}
+	}
+	drain(a, c, id);
+	return found;
+}
+
+static int
+request_queue(struct acpm *a, struct acpm_chan *c, uint32_t id, uint32_t cmd[4])
+{
+	uint32_t sent[4];
+
+	for (uint32_t w = 0; w < 4; w++) {
+		sent[w] = cmd[w];
+	}
+	for (uint32_t send = 0; send < a->sends; send++) {
+		if (send) {
+			a->st.resends++;
+		}
+		drain(a, c, id);                /* never into a queue with stale answers in it */
+		uint32_t front = srd(a, c->in_front);
+		if (front >= c->len) {
+			return ACPM_E_TABLE;
+		}
+		uint32_t next = (front + 1) % c->len;
+		uint64_t t0 = a->io->now_us(a->io->ctx);
+		while (srd(a, c->in_rear) == next && a->io->now_us(a->io->ctx) - t0 < a->room_us) {
+			a->io->delay_us(a->io->ctx, a->poll_us);
+		}
+		if (srd(a, c->in_rear) == next) {
+			continue;               /* the APM has not taken our earlier requests */
+		}
+		c->seq = c->seq % 63u + 1u;
+		sent[0] = (sent[0] & ~ACPM_SEQ_MASK) | c->seq << ACPM_SEQ_SHIFT;
+		uint32_t slot = c->in_base + front * c->elem;
+		for (uint32_t w = 0; w < c->elem / 4; w++) {
+			swr(a, slot + 4 * w, w < 4 ? sent[w] : 0);
+		}
+		barrier(a);                     /* the words before the index, the index before the doorbell */
+		swr(a, c->in_front, next);
+		barrier(a);
+		a->io->mbox_wr(a->io->ctx, ACPM_MB_INTGR0, 1u << (16 + id));
+		t0 = a->io->now_us(a->io->ctx);
+		for (;;) {
+			if (take_answer(a, c, id, c->seq, cmd)) {
+				return ACPM_OK;
+			}
+			if (a->io->now_us(a->io->ctx) - t0 >= a->answer_us) {
+				break;
+			}
+			a->io->delay_us(a->io->ctx, a->poll_us);
+		}
+	}
+	a->st.timeouts++;
+	LOG(a, "acpm: channel %u: no answer after %u sends (w0 %#x)\n", id, a->sends, cmd[0]);
+	return ACPM_E_TIMEOUT;
+}
+
+static int
+request_buffer(struct acpm *a, struct acpm_chan *c, uint32_t id, uint32_t cmd[4])
+{
+	c->seq = c->seq % 63u + 1u;
+	cmd[0] = (cmd[0] & ~ACPM_SEQ_MASK) | c->seq << ACPM_SEQ_SHIFT;
+	a->io->mbox_wr(a->io->ctx, ACPM_MB_INTCR1, 1u << id);
+	for (uint32_t w = 0; w < 4; w++) {
+		swr(a, c->in_base + 4 * w, cmd[w]);
+	}
+	barrier(a);
+	a->io->mbox_wr(a->io->ctx, ACPM_MB_INTGR0, 1u << (16 + id));
+	uint64_t t0 = a->io->now_us(a->io->ctx);
+	while (!(a->io->mbox_rd(a->io->ctx, ACPM_MB_INTSR1) & (1u << id))) {
+		if (a->io->now_us(a->io->ctx) - t0 >= a->buffer_us) {
+			a->st.timeouts++;
+			return ACPM_E_TIMEOUT;
+		}
+		a->io->delay_us(a->io->ctx, a->poll_us);
+	}
+	for (uint32_t w = 0; w < 4; w++) {
+		cmd[w] = srd(a, c->out_base + 4 * w);
+	}
+	a->io->mbox_wr(a->io->ctx, ACPM_MB_INTCR1, 1u << id);
+	return ACPM_OK;
+}
+
+int
+acpm_request(struct acpm *a, uint32_t id, uint32_t cmd[4])
+{
+	if (a == 0 || !a->ready || id >= ACPM_MAX_ID || !a->ch[id].usable) {
+		return ACPM_E_NODEV;
+	}
+	a->st.requests++;
+	struct acpm_chan *c = &a->ch[id];
+	return c->buffer ? request_buffer(a, c, id, cmd) : request_queue(a, c, id, cmd);
+}
+
+int
+acpm_pmic_read(struct acpm *a, uint32_t type, uint32_t reg, uint8_t *value)
+{
+	uint32_t cmd[4] = { acpm_pmic_w0(type, reg), acpm_pmic_w1(ACPM_FUNC_READ, 0, 0), 0, 0 };
+	if (type > 0xfu || reg > 0xffu || value == 0) {
+		return ACPM_E_ARG;
+	}
+	int e = acpm_request(a, ACPM_CH_PMIC, cmd);
+	if (e != ACPM_OK) {
+		return e;
+	}
+	if (cmd[1] >> 24) {
+		a->st.status_errors++;
+		return ACPM_E_STATUS;
+	}
+	*value = (uint8_t)(cmd[1] >> 8);
+	return ACPM_OK;
+}
+
+int
+acpm_pmic_write_raw(struct acpm *a, uint32_t type, uint32_t reg, uint8_t value)
+{
+	uint32_t cmd[4] = { acpm_pmic_w0(type, reg), acpm_pmic_w1(ACPM_FUNC_WRITE, value, 0), 0, 0 };
+	if (type > 0xfu || reg > 0xffu) {
+		return ACPM_E_ARG;
+	}
+	int e = acpm_request(a, ACPM_CH_PMIC, cmd);
+	if (e != ACPM_OK) {
+		return e;
+	}
+	if (cmd[1] >> 24) {
+		a->st.status_errors++;
+		return ACPM_E_STATUS;
+	}
+	return ACPM_OK;
+}
+
+int
+acpm_dvfs_request(struct acpm *a, uint32_t domain, uint32_t khz, bool get, uint32_t *answer_khz)
+{
+	uint32_t cmd[4] = { domain, get ? 0u : khz, get ? 1u : 0u, 0 };
+	if (a == 0 || !a->ready) {
+		return ACPM_E_NODEV;
+	}
+	int e = acpm_request(a, a->index0_id, cmd);
+	if (e == ACPM_OK && answer_khz) {
+		*answer_khz = cmd[1];
+	}
+	return e;
+}
diff --git a/iokit/Kernel/arm/starbite/StarbiteACPM/hw/acpm_ipc.h b/iokit/Kernel/arm/starbite/StarbiteACPM/hw/acpm_ipc.h
new file mode 100644
index 00000000..0fc504aa
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteACPM/hw/acpm_ipc.h
@@ -0,0 +1,153 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * Exynos 9810 ACPM IPC: the AP's side of the APM mailbox (0x14100000) and the APM's SRAM (0x02039000), plain C,
+ * no IOKit. Shared by StarbiteACPM.cpp and the host tests (test/). Register facts and sources: ../NOTES.md.
+ *
+ * All MMIO goes through struct acpm_io, so the same code runs against a mock APM on the Mac. Every SRAM access is
+ * 32 bits wide and at or above sram_first (the pages below it fault on the phone).
+ */
+#ifndef STARBITE_ACPM_IPC_H
+#define STARBITE_ACPM_IPC_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* mailbox registers (offsets in the 0x14100000 block) */
+#define ACPM_MB_INTGR0          0x08u   /* AP -> APM doorbell: bit 16 + channel id */
+#define ACPM_MB_INTCR1          0x20u   /* APM -> AP clear: bit = channel id */
+#define ACPM_MB_INTMR1          0x24u   /* APM -> AP mask (read only here) */
+#define ACPM_MB_INTSR1          0x28u   /* APM -> AP status: bit = channel id */
+
+/* firmware "initdata" (offsets from initdata-base) */
+#define ACPM_ID_CHANNELS        0x08u   /* SRAM offset of the channel table */
+#define ACPM_ID_NCHANNELS       0x0cu
+#define ACPM_ID_AP_MAX          0x18u   /* how many of them are the AP's */
+#define ACPM_ID_STRINGS         0x60u   /* version / build text (24 bytes logged) */
+
+/* one channel descriptor, 0x48 bytes */
+#define ACPM_CH_SIZE            0x48u
+#define ACPM_CH_ID              0x00u   /* low byte */
+#define ACPM_CH_OWNER           0x08u
+#define ACPM_CH_TYPE            0x0cu
+#define ACPM_CH_IN_REAR         0x10u   /* AP -> APM: where the APM reads (SRAM offset of an index word) */
+#define ACPM_CH_IN_FRONT        0x14u   /* AP -> APM: where we write */
+#define ACPM_CH_IN_BASE         0x18u   /* AP -> APM: queue base */
+#define ACPM_CH_OUT_REAR        0x28u   /* APM -> AP: where we read */
+#define ACPM_CH_OUT_FRONT       0x2cu   /* APM -> AP: where the APM writes */
+#define ACPM_CH_OUT_BASE        0x30u
+#define ACPM_CH_QLEN            0x34u
+#define ACPM_CH_ELEM            0x38u
+#define ACPM_CH_AP_POLL         0x44u
+
+#define ACPM_SEQ_SHIFT          16u
+#define ACPM_SEQ_MASK           (0x3fu << ACPM_SEQ_SHIFT)
+#define ACPM_MAX_ID             16u     /* channel ids we keep (the S9 uses 0..11) */
+#define ACPM_AP_MAX_LIMIT       32u
+
+/* S9 values (device/dtb/starlte.dts acpm_ipc, s2mps18mfd; an earlier port exynos9810_soc.h) */
+#define ACPM_S9_SRAM_SIZE       0x30000u
+#define ACPM_S9_SRAM_FIRST      0x3000u
+#define ACPM_S9_INITDATA        0x7f00u
+#define ACPM_CH_PMIC            2u      /* s2mps18mfd acpm-ipc-channel */
+
+/* timing (us) */
+#define ACPM_ROOM_US            20000u  /* a place in the request queue */
+#define ACPM_ANSWER_US          600000u /* an answer, per send */
+#define ACPM_BUFFER_US          1000000u
+#define ACPM_POLL_US            50u
+#define ACPM_SENDS              3u
+
+/* results */
+#define ACPM_OK                 0
+#define ACPM_E_NODEV            (-1)    /* no such channel, or not set up */
+#define ACPM_E_TIMEOUT          (-2)    /* no answer / no room */
+#define ACPM_E_STATUS           (-3)    /* the APM answered with a non-zero status (SPEEDY failed) */
+#define ACPM_E_REFUSED          (-4)    /* the write policy said no */
+#define ACPM_E_TABLE            (-5)    /* the firmware's table makes no sense */
+#define ACPM_E_ARG              (-6)
+
+struct acpm_io {
+	void *ctx;
+	uint32_t (*sram_rd)(void *ctx, uint32_t off);           /* off: from the SRAM's start, 4-aligned */
+	void (*sram_wr)(void *ctx, uint32_t off, uint32_t v);
+	uint32_t (*mbox_rd)(void *ctx, uint32_t off);
+	void (*mbox_wr)(void *ctx, uint32_t off, uint32_t v);
+	void (*barrier)(void *ctx);                             /* DSB SY */
+	void (*delay_us)(void *ctx, uint32_t us);
+	uint64_t (*now_us)(void *ctx);                          /* monotonic */
+	void (*log)(void *ctx, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+};
+
+struct acpm_chan {
+	bool usable, buffer;
+	uint32_t desc;                                          /* SRAM offset of the descriptor */
+	uint32_t owner, type, ap_poll;
+	uint32_t in_rear, in_front, in_base, out_rear, out_front, out_base, len, elem;
+	uint32_t seq;
+};
+
+struct acpm_stats {
+	uint32_t requests, resends, timeouts, status_errors, stale_drained, refused;
+};
+
+struct acpm {
+	const struct acpm_io *io;
+	uint32_t sram_size, sram_first, initdata;
+	uint32_t table, nchannels, ap_max;
+	uint32_t index0_id;                                     /* id of the channel at table index 0 (DVFS) */
+	bool ready;
+	char version[25];
+	struct acpm_chan ch[ACPM_MAX_ID];
+	struct acpm_stats st;
+	/* timing, settable by the tests */
+	uint32_t room_us, answer_us, buffer_us, poll_us, sends;
+};
+
+/* Parse the firmware's table. Returns ACPM_OK when the PMIC channel (2) is usable. Reads, plus a drain of stale
+ * answers (the answer queue's read index set to its write index, INTCR1) on each queue channel. */
+int acpm_setup(struct acpm *a, const struct acpm_io *io, uint32_t sram_size, uint32_t sram_first, uint32_t initdata);
+
+/* One request on channel id; cmd[4] in, the answer's four words out. Caller serialises (one at a time). */
+int acpm_request(struct acpm *a, uint32_t id, uint32_t cmd[4]);
+
+/* PMIC framing (channel 2): w0 = type << 8 | reg; w1 = func | value << 8 | mask << 16; answer w1 [15:8] value,
+ * [31:24] status (0 = good). type: 0 TOP, 1 PMIC, 2 RTC (the S2MPS18's blocks). */
+#define ACPM_PMIC_TOP           0u
+#define ACPM_PMIC_PMIC          1u
+#define ACPM_PMIC_RTC           2u
+#define ACPM_FUNC_READ          0u
+#define ACPM_FUNC_WRITE         1u
+#define ACPM_FUNC_UPDATE        2u
+
+static inline uint32_t
+acpm_pmic_w0(uint32_t type, uint32_t reg)
+{
+	return (type & 0xfu) << 8 | (reg & 0xffu);
+}
+
+static inline uint32_t
+acpm_pmic_w1(uint32_t func, uint8_t value, uint8_t mask)
+{
+	return (func & 0xffu) | (uint32_t)value << 8 | (uint32_t)mask << 16;
+}
+
+/* Unchecked PMIC access (no policy): StarbiteACPM.cpp applies s2mps18_policy first. */
+int acpm_pmic_read(struct acpm *a, uint32_t type, uint32_t reg, uint8_t *value);
+int acpm_pmic_write_raw(struct acpm *a, uint32_t type, uint32_t reg, uint8_t value);
+
+/* DVFS framing (channel at table index 0, as Linux): { domain, kHz, 0 = set | 1 = get, 0 }. */
+#define ACPM_DVFS_CPUCL0        2u      /* Cortex-A55 */
+#define ACPM_DVFS_CPUCL1        3u      /* Exynos M3 */
+#define ACPM_DVFS_G3D           4u
+int acpm_dvfs_request(struct acpm *a, uint32_t domain, uint32_t khz, bool get, uint32_t *answer_khz);
+
+const char *acpm_strerror(int e);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* STARBITE_ACPM_IPC_H */
diff --git a/iokit/Kernel/arm/starbite/StarbiteACPM/hw/s2mps18_policy.c b/iokit/Kernel/arm/starbite/StarbiteACPM/hw/s2mps18_policy.c
new file mode 100644
index 00000000..2bf2b384
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteACPM/hw/s2mps18_policy.c
@@ -0,0 +1,140 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/* The S2MPS18 access policy of StarbiteACPM: see s2mps18_policy.h for the table and its sources. */
+#include "s2mps18_policy.h"
+#include "acpm_ipc.h"
+
+bool
+s2mps18_read_allowed(uint32_t type, uint32_t reg)
+{
+	if (type > ACPM_PMIC_RTC || reg > 0xffu) {
+		return false;
+	}
+	/* INT1..INT7 of the PMIC block clear when read (s2mps18-private.h); the TOP block's INTSRC does not. */
+	return !(type == ACPM_PMIC_PMIC && reg <= 0x06u);
+}
+
+void
+s2mps18_note_read(struct s2mps18_policy *p, uint32_t type, uint32_t reg, uint8_t value)
+{
+	if (type == ACPM_PMIC_PMIC && reg == S2MPS18_B6OUT && !p->b6_seen) {
+		p->b6_seen = true;
+		p->b6_boot = value;
+	}
+}
+
+static bool
+deny(const char **why, const char *s)
+{
+	if (why) {
+		*why = s;
+	}
+	return false;
+}
+
+static bool
+rtc_field_ok(uint32_t reg, uint8_t v)
+{
+	/* binary or BCD: the largest legal byte of each field in either coding */
+	switch (reg) {
+	case 0x05: return v <= 0x59u;          /* SEC  (binary 59 = 0x3b < 0x59) */
+	case 0x06: return v <= 0x59u;          /* MIN */
+	case 0x07: return (v & 0x3fu) <= 0x23u && !(v & 0x80u);        /* HOUR [5:0], bit 6 PM */
+	case 0x08: return v != 0 && v <= 0x40u && !(v & (v - 1u));      /* WEEK: one bit a day */
+	case 0x09: return v >= 1u && v <= 0x31u;                        /* DAY */
+	case 0x0a: return v >= 1u && v <= 0x12u;                        /* MONTH */
+	case 0x0b: return v <= 0x99u;                                   /* YEAR since 2000 */
+	default: return false;
+	}
+}
+
+bool
+s2mps18_write_allowed(const struct s2mps18_policy *p, uint32_t type, uint32_t reg, uint8_t value, uint8_t cur,
+    const char **why)
+{
+	uint8_t vs = cur & S2MPS18_LDO_VSEL;
+
+	if (why) {
+		*why = "ok";
+	}
+	if (type == ACPM_PMIC_RTC) {
+		if (reg == S2MPS18_RTC_UPDATE) {
+			if (value == (cur | S2MPS18_RTC_RUDR) || value == (cur | S2MPS18_RTC_WUDR)) {
+				return true;
+			}
+			return deny(why, "RTC UPDATE: only RUDR or WUDR may be added");
+		}
+		if (reg >= S2MPS18_RTC_SEC && reg <= S2MPS18_RTC_YEAR) {
+			return rtc_field_ok(reg, value) ? true : deny(why, "RTC time field out of range");
+		}
+		return deny(why, "RTC register not writable (CTRL, WTSR/SMPL, CAPSEL, MSEC, alarms, OSCCTRL)");
+	}
+	if (type != ACPM_PMIC_PMIC) {
+		return deny(why, "only the PMIC and RTC blocks are writable");
+	}
+	switch (reg) {
+	case S2MPS18_L35CTRL:
+		if (value != 0xecu) {
+			return deny(why, "LDO35: only 0xec (on, 1.8 V)");
+		}
+		return (vs == 0x2cu || vs == 0) ? true : deny(why, "LDO35: programmed vsel unexpected");
+	case S2MPS18_L43CTRL:
+		if (value != 0xf0u) {
+			return deny(why, "LDO43: only 0xf0 (on, 3.0 V)");
+		}
+		return (vs == 0 || (vs >= 0x28u && vs <= 0x3cu)) ? true : deny(why, "LDO43: programmed vsel unexpected");
+	case S2MPS18_B6OUT:
+		if (value == 0x68u) {
+			return true;
+		}
+		if (p && p->b6_seen && value == p->b6_boot && value >= 0x20u && value <= 0x70u) {
+			return true;
+		}
+		return deny(why, "BUCK6: only 0x68 (950 mV) or its boot value");
+	case S2MPS18_L31CTRL:
+		if (value != 0x28u && value != 0xe8u) {
+			return deny(why, "LDO31: only 0x28 / 0xe8 (2.8 V off / on)");
+		}
+		return (vs == 0 || (vs >= 0x24u && vs <= 0x3cu)) ? true : deny(why, "LDO31: programmed vsel unexpected");
+	case S2MPS18_L2CTRL1:
+		if (value == 0xc0u || value == 0xfcu || value == 0x3cu || value == vs) {
+			return true;
+		}
+		return deny(why, "LDO2: only 0xc0 / 0xfc / 0x3c or off at its vsel");
+	default:
+		return deny(why, "PMIC register not on the write list");
+	}
+}
+
+bool
+acpm_dvfs_allowed(uint32_t domain, uint32_t khz, bool governor, const char **why)
+{
+	static const uint32_t g3d[] = { 572000, 546000, 455000, 338000, 299000, 260000 };
+
+	if (why) {
+		*why = "ok";
+	}
+	if (khz == 0) {
+		return deny(why, "0 kHz");
+	}
+	switch (domain) {
+	case ACPM_DVFS_CPUCL0:
+		return khz <= 1794000u ? true : deny(why, "cpucl0 above 1794000 kHz");
+	case ACPM_DVFS_CPUCL1:
+		if (khz <= 1794000u) {
+			return true;
+		}
+		if (!governor) {
+			return deny(why, "cpucl1 above 1794000 kHz without a thermal governor");
+		}
+		return khz <= 2704000u ? true : deny(why, "cpucl1 above 2704000 kHz");
+	case ACPM_DVFS_G3D:
+		for (unsigned i = 0; i < sizeof(g3d) / sizeof(g3d[0]); i++) {
+			if (khz == g3d[i]) {
+				return true;
+			}
+		}
+		return deny(why, "g3d: not one of starlte_gpu.c's levels");
+	default:
+		return deny(why, "domain not allowed (MIF/INT froze the phone)");
+	}
+}
diff --git a/iokit/Kernel/arm/starbite/StarbiteACPM/hw/s2mps18_policy.h b/iokit/Kernel/arm/starbite/StarbiteACPM/hw/s2mps18_policy.h
new file mode 100644
index 00000000..d9fac997
--- /dev/null
+++ b/iokit/Kernel/arm/starbite/StarbiteACPM/hw/s2mps18_policy.h
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * What StarbiteACPM lets its clients do to the S2MPS18 through ACPM. The rule (docs/APPLE-S9-DRIVERS.md row 7,
+ * task brief): no regulator write beyond what today's kernel already does on the phone. Every allowed write is
+ * listed here with the patch that does it today; anything else is refused before it reaches the APM.
+ *
+ * Reads: everything except the PMIC block's clear-on-read interrupt registers INT1..INT7 (type 1, 0x00..0x06).
+ * Writes (type 1 = PMIC block):
+ *   0x6c L35CTRL tsp_io      0xec (on, 1.8 V)              starlte_touch.c st_power_on (0302); only if the
+ *                                                          programmed vsel is 0x2c or 0
+ *   0x74 L43CTRL tsp_avdd    0xf0 (on, 3.0 V)              same; only if vsel is 0 or 0x28..0x3c
+ *   0x2b B6OUT   vdd_g3d     0x68 (950 mV), or the value read first this boot when that was in 0x20..0x70
+ *                                                          starlte_gpu.c stage 2 (0301 / 0412)
+ *   0x68 L31CTRL vmmc (SD)   0x28 (off, 2.8 V), 0xe8 (on, 2.8 V); only if vsel is 0 or 0x24..0x3c
+ *                                                          starlte_sd.c rails / park (0345, 0400, 4aeec8f)
+ *   0x4a L2CTRL1 vqmmc (SD)  0xc0 (on 1.8 V), 0xfc (on 3.3 V), 0x3c (off 3.3 V), or off at the vsel it has
+ *                                                          starlte_sd.c (0345, 0353)
+ * Writes (type 2 = RTC block), for StarbiteRTC only:
+ *   0x02 UPDATE              the value read + RUDR (bit 0) or + WUDR (bit 1), nothing else changed
+ *   0x05..0x0b SEC..YEAR     a value in its field's range
+ * Never: type 0 (TOP), any other PMIC register (bucks, LDOs, OCP, SMPL/WTSR, ramp), RTC CTRL 0x00, WTSR_SMPL 0x01,
+ * CAPSEL 0x03 (the 32 kHz oscillator's load), MSEC 0x04, the alarms 0x0c.. and OSCCTRL 0x1a.
+ */
+#ifndef STARBITE_S2MPS18_POLICY_H
+#define STARBITE_S2MPS18_POLICY_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define S2MPS18_B6OUT           0x2bu
+#define S2MPS18_L2CTRL1         0x4au
+#define S2MPS18_L31CTRL         0x68u
+#define S2MPS18_L35CTRL         0x6cu
+#define S2MPS18_L43CTRL         0x74u
+
+#define S2MPS18_RTC_CTRL        0x00u
+#define S2MPS18_RTC_WTSR_SMPL   0x01u
+#define S2MPS18_RTC_UPDATE      0x02u
+#define S2MPS18_RTC_CAPSEL      0x03u
+#define S2MPS18_RTC_MSEC        0x04u
+#define S2MPS18_RTC_SEC         0x05u
+#define S2MPS18_RTC_YEAR        0x0bu
+#define S2MPS18_RTC_RUDR        0x01u
+#define S2MPS18_RTC_WUDR        0x02u
+
+/* LDO control: [7:6] enable (3 = on), [5:0] vsel */
+#define S2MPS18_LDO_ON          0xc0u
+#define S2MPS18_LDO_VSEL        0x3fu
+
+struct s2mps18_policy {
+	bool b6_seen;                   /* B6OUT read once: its boot value kept for the restore rule */
+	uint8_t b6_boot;
+};
+
+/* May (type, reg) be read? (false: a clear-on-read interrupt register) */
+bool s2mps18_read_allowed(uint32_t type, uint32_t reg);
+
+/* Record a value read (the policy remembers B6OUT's first value). */
+void s2mps18_note_read(struct s2mps18_policy *p, uint32_t type, uint32_t reg, uint8_t value);
+
+/* May value be written to (type, reg) whose current content is cur? why: the reason when not. */
+bool s2mps18_write_allowed(const struct s2mps18_policy *p, uint32_t type, uint32_t reg, uint8_t value, uint8_t cur,
+    const char **why);
+
+/*
+ * DVFS limits (the clocks today's kernel asks for): cpucl0 (2) and cpucl1 (3) at most 1794000 kHz
+ * (starlte_touch.c st_cpu_dvfs, "not without thermal control"); cpucl1 up to 2704000 kHz only with a thermal
+ * governor running (0411 starcpugov); g3d (4) only 572000 546000 455000 338000 299000 260000 (starlte_gpu.c);
+ * every other domain refused (MIF 2093000 / INT 667000 froze the phone at once, boot69). 0 kHz is refused.
+ */
+bool acpm_dvfs_allowed(uint32_t domain, uint32_t khz, bool governor, const char **why);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
