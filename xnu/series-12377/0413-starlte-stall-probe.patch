From 8d17da14b5af69061a095f395ba85d0110f49d3a Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Mon, 9 Nov 2026 19:41:16 +0200
Subject: [PATCH] patch: 0413-starlte-stall-probe.patch - a touch with no
 present for 1.5 s logs what backboardd's and SpringBoard's threads, and every
 blocked main thread, wait on (block hint, owner, turnstile inheritor); on
 with sweetreboot= or starstall=1

---
 bsd/dev/starlte_touch.c               |  47 ++++++
 iokit/Kernel/arm/SweetFramebuffer.cpp |   2 +
 iokit/Kernel/arm/hid/SweetHID.cpp     |  11 ++
 osfmk/kern/kern_stackshot.c           | 211 ++++++++++++++++++++++++++
 4 files changed, 271 insertions(+)

diff --git a/bsd/dev/starlte_touch.c b/bsd/dev/starlte_touch.c
index 6b425320..fa05bd74 100644
--- a/bsd/dev/starlte_touch.c
+++ b/bsd/dev/starlte_touch.c
@@ -737,6 +737,52 @@ st_event(void)
 	return true;
 }
 
+/*
+ * 0413: the stall probe. A touch (press or release, real or scripted) that is followed by no present for
+ * 1.5 s: who are backboardd's and SpringBoard's threads, and every process's main thread, waiting on
+ * (osfmk/kern/kern_stackshot.c, starlte_stall_dump). At most 30 per boot, 5 s apart. On with sweetreboot=
+ * (the timed/logged boots) or starstall=1; starstall=0 off.
+ */
+extern uint64_t sweet_last_input_abs, sweet_last_present_abs;
+extern void starlte_stall_dump(uint64_t input_abs, uint64_t present_abs);
+static int st_stall_on = -1;
+
+static void
+st_stall_check(void)
+{
+	static uint64_t handled, last_dump;
+	static unsigned dumps;
+	if (st_stall_on < 0) {
+		uint32_t v = 0, r = 0;
+		st_stall_on = PE_parse_boot_argn("starstall", &v, sizeof(v)) ? (v != 0) :
+		    (PE_parse_boot_argn("sweetreboot", &r, sizeof(r)) && r != 0);
+		if (st_stall_on) {
+			printf("STARLTE STALL: probe on (a touch with no present for 1.5 s)\n");
+		}
+	}
+	uint64_t in = sweet_last_input_abs, now = mach_absolute_time(), ns = 0, gap = 0;
+	if (!st_stall_on || in == 0 || in == handled || dumps >= 30) {
+		return;
+	}
+	absolutetime_to_nanoseconds(now - in, &ns);
+	if (ns < 1500000000ULL) {
+		return;
+	}
+	handled = in;
+	if (sweet_last_present_abs > in) {
+		return;                 /* the screen changed after the touch */
+	}
+	if (last_dump != 0) {
+		absolutetime_to_nanoseconds(now - last_dump, &gap);
+		if (gap < 5000000000ULL) {
+			return;
+		}
+	}
+	last_dump = now;
+	dumps++;
+	starlte_stall_dump(in, sweet_last_present_abs);
+}
+
 static void
 st_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -805,6 +851,7 @@ st_thread(__unused void *arg, __unused wait_result_t wr)
 		if (tick % 6000 == 5999) {
 			printf("STARLTE TOUCH: %u events, %u retries, %u lost\n", st_events, st_retries, st_lost);
 		}
+		st_stall_check();
 		st_msleep(5);
 	}
 }
