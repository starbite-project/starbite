+ * 0400: the strategy queues and returns; one worker thread does the transfers. Before this every
+ * buf ran synchronously in the thread that issued it, so the cluster layer's read-ahead and every
+ * write-behind (B_ASYNC) stalled the app or daemon that triggered it for the whole PIO transfer
+ * (writes run at about 5 MB/s). Order, highest first:
+ *   1. the oldest write if someone waits on it (not B_ASYNC), a DKIOCSYNCHRONIZE waits, or it has
+ *      waited 200 ms (writes never starve);
+ *   2. the oldest synchronous read (a page fault, a metadata read: a thread is blocked on it);
+ *   3. the oldest read-ahead (B_ASYNC read);
+ *   4. the oldest write.
+ * A read that overlaps a queued write is never taken before it: writes drain first (FIFO among
+ * writes, so the file system's write order is kept). A buf issued from the worker itself (a
+ * biodone callback starting I/O) runs inline. sdq=0 restores the synchronous strategy.
+ */
+#define SDQ_MAX 1024u
+struct sdq_ent {
+	buf_t bp;
+	uint64_t t;             /* mach_absolute_time at queueing */
+	uint64_t lba, n;        /* sectors, relative to the range */
+};
+struct sdq_ring {
+	struct sdq_ent e[SDQ_MAX];
+	unsigned head, len;
+};
