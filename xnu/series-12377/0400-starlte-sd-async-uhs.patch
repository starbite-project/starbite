+static LCK_MTX_DECLARE(sdq_lock, &starlte_sd_grp);
+static thread_t sdq_thread;
+static int sdq_on = -1;                         /* -1 not decided, 0 off (sdq=0), 1 on */
+static unsigned sdq_syncwait, sdq_active_w, sdq_maxlen;
+static uint64_t sdq_200ms;
+static char sdq_event, sdq_space, sdq_idle;
+extern boolean_t set_vm_privilege(boolean_t privileged);
+extern kern_return_t kernel_thread_start_priority(thread_continue_t, void *, integer_t, thread_t *);
+#define SDQ_PRI 81              /* BASEPRI_KERNEL */
