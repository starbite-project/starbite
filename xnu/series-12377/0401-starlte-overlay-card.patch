From 153b5a699759e79c8e9ae3e16517fd5dba6f6550 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Sun, 8 Nov 2026 13:48:04 +0200
Subject: [PATCH] patch: 0401-starlte-overlay-card.patch - the iOS overlay
 installer also reads an overlay from the microSD card (sector 249933824, the
 upper half of the sdlog range); a 1.8 V card is parked before the timed
 reset; SDR50's data check reads 32 KiB of the iOS 26 root

starlte_overlay_install (before launchd) first looks for "SBOVL001" (tools/overlay/sboverlay.py format)
in the card area through starlte_sd_overlay_read (only with the root on the 128 GB card); its size is
the end of the last file, its stamp the CRC32 of the header (/private/var/db/starbite-overlay-sd).
Then the UFS store copy as before; reads in so_apply are relative to the card area or the store.
tools/overlay/card-overlay.sh writes / clears the area, HFS_CARD=1 tools/overlay/hfs-read.py reads files
(and --ls folders) from the card root.

starlte_sd_park (sweetreboot timer, not panics: ACPM takes a mutex): a card switched to 1.8 V gets LDO31
off and LDO2 at 3.3 V off before the reset, so TWRP / the loader find a card that starts at 3.3 V.
The SDR50 data check compares 64 sectors at iOS 26's root start (the volume header and allocation
bitmap) on the 128 GB card instead of the mostly empty first 8 sectors.
---
 bsd/dev/herolte_ufs.c     |  4 ++
 bsd/dev/starlte_overlay.c | 94 +++++++++++++++++++++++++++++++++------
 bsd/dev/starlte_sd.c      | 52 +++++++++++++++++++---
 3 files changed, 132 insertions(+), 18 deletions(-)

diff --git a/bsd/dev/herolte_ufs.c b/bsd/dev/herolte_ufs.c
index 0d91ef92..73b8207d 100644
--- a/bsd/dev/herolte_ufs.c
+++ b/bsd/dev/herolte_ufs.c
@@ -1280,6 +1280,10 @@ starlte_reboot_timer_thread(__unused void *arg, __unused wait_result_t wr)
 		printf("HEROLTE LOG: kernel log to card: %d\n", lr);
 	}
 	starlte_dump_file();
+	{
+		extern void starlte_sd_park(void);      /* 0401: a 1.8 V card powered off for TWRP */
+		starlte_sd_park();
+	}
 	/* no panic: the timer's own header (the loader: HANG (OS TIMER)), the console tail */
 	starlte_pmsg_save(SBH_HDR_TIMER, NULL, false);
 	starlte_reset_to_recovery();
diff --git a/bsd/dev/starlte_overlay.c b/bsd/dev/starlte_overlay.c
index 3b52e2b5..74586d04 100644
--- a/bsd/dev/starlte_overlay.c
+++ b/bsd/dev/starlte_overlay.c
@@ -14,6 +14,11 @@
  * entry's CRC is kept in /private/var/db/starbite-overlay: an unchanged
  * overlay is not written again. Needs the root mounted read-write by the
  * kernel (rootrw=1, vfs_subr.c). Boot-arg sboverlay=0 skips it.
+ *
+ * 0401: the same overlay format is also read from the microSD card when the root is on it (starlte_sd.c,
+ * sector 249933824 = the upper half of the card's sdlog range on the 128 GB card): the host writes it
+ * from TWRP with dd (tools/overlay/sboverlay.py --card). Its own stamp: /private/var/db/starbite-overlay-sd.
+ * The UFS store copy is tried first; a missing UFS store is no longer fatal.
  */
 #if defined(ARM64_BOARD_CONFIG_STARLTE)
 #include <sys/param.h>
@@ -62,10 +67,16 @@ so_crc32(uint32_t crc, const uint8_t *p, size_t n)
 	return ~crc;
 }
 
+extern int starlte_sd_overlay_read(uint64_t off, void *buf, uint32_t len);
+static bool so_card;                    /* 0401: so_read reads the card area, not the raw UFS device */
+
 /* Read len bytes (rounded up to 4 KiB) at byte offset off of the raw device. */
 static int
 so_read(vnode_t dev, vfs_context_t ctx, void *buf, uint32_t len, uint64_t off)
 {
+	if (so_card) {
+		return starlte_sd_overlay_read(off, buf, (len + SO_BLOCK - 1) & ~(SO_BLOCK - 1));
+	}
 	int resid = 0;
 	uint32_t whole = (len + SO_BLOCK - 1) & ~(SO_BLOCK - 1);
 	int err = vn_rdwr(UIO_READ, dev, (caddr_t)buf, (int)whole, (off_t)off, UIO_SYSSPACE, 0,
@@ -101,6 +112,8 @@ so_write_file(const char *path, uint32_t mode, const void *data, uint32_t size,
 	return err;
 }
 
+#define SO_STAMP_SD     "/private/var/db/starbite-overlay-sd"
+
 /* The overlay CRC from the last install, or 0. */
 static uint32_t
 so_stamp(vfs_context_t ctx)
@@ -108,7 +121,7 @@ so_stamp(vfs_context_t ctx)
 	vnode_t vp = NULLVP;
 	char text[16] = { 0 };
 	int resid = 0;
-	if (vnode_open(SO_STAMP, FREAD, 0, 0, &vp, ctx)) {
+	if (vnode_open(so_card ? SO_STAMP_SD : SO_STAMP, FREAD, 0, 0, &vp, ctx)) {
 		return 0;
 	}
 	int err = vn_rdwr(UIO_READ, vp, text, sizeof(text) - 1, 0, UIO_SYSSPACE, IO_NOAUTH,
@@ -122,6 +135,46 @@ so_stamp(vfs_context_t ctx)
 	return err ? 0 : v;
 }
 
+static void so_apply(vnode_t dev, vfs_context_t ctx, uint64_t ov_off, uint64_t ov_size, uint32_t ov_crc);
+
+/* 0401: the card area (no store directory): the size is the end of the last file, the stamp the CRC32
+ * of the whole header (each entry carries its file's CRC32, so the header names the content) */
+static void
+so_install_card(vfs_context_t ctx)
+{
+	uint8_t *blk = kalloc_data(SO_BLOCK, Z_WAITOK | Z_ZERO);
+	if (blk == NULL) {
+		return;
+	}
+	so_card = true;
+	if (starlte_sd_overlay_read(0, blk, SO_BLOCK) == 0 && memcmp(blk, "SBOVL001", 8) == 0) {
+		uint32_t files = *(uint32_t *)(blk + 8);
+		uint32_t hdr_len = (16 + files * (uint32_t)sizeof(struct so_entry) + SO_BLOCK - 1) & ~(SO_BLOCK - 1);
+		uint8_t *hdr = (files && files <= SO_MAX_FILES) ? kalloc_data(hdr_len, Z_WAITOK | Z_ZERO) : NULL;
+		if (hdr && starlte_sd_overlay_read(0, hdr, hdr_len) == 0) {
+			uint64_t ov_total = hdr_len;
+			for (uint32_t i = 0; i < files; i++) {
+				const struct so_entry *e = (const struct so_entry *)(hdr + 16 + i * sizeof(*e));
+				uint64_t fend = (uint64_t)e->offset + e->size;
+				ov_total = fend > ov_total ? fend : ov_total;
+			}
+			ov_total = (ov_total + SO_BLOCK - 1) & ~(uint64_t)(SO_BLOCK - 1);
+			if (ov_total <= 65535ull * 512ull) {
+				so_apply(NULLVP, ctx, 0, ov_total, so_crc32(0, hdr, hdr_len));
+			} else {
+				printf("STARLTE OVERLAY: card overlay too big (%llu bytes)\n", ov_total);
+			}
+		} else {
+			printf("STARLTE OVERLAY: card overlay header unreadable (%u files)\n", files);
+		}
+		if (hdr) {
+			kfree_data(hdr, hdr_len);
+		}
+	}
+	so_card = false;
+	kfree_data(blk, SO_BLOCK);
+}
+
 void
 starlte_overlay_install(void)
 {
@@ -135,6 +188,7 @@ starlte_overlay_install(void)
 		printf("STARLTE OVERLAY: root is read-only, not installing\n");
 		return;
 	}
+	so_install_card(ctx);
 	vnode_t dev = NULLVP;
 	int err = vnode_open(SO_DEV, FREAD, 0, 0, &dev, ctx);
 	if (err) {
@@ -142,8 +196,6 @@ starlte_overlay_install(void)
 		return;
 	}
 	uint8_t *blk = kalloc_data(SO_BLOCK, Z_WAITOK | Z_ZERO);
-	uint8_t *hdr = NULL, *data = NULL;
-	uint32_t hdr_len = 0, data_len = 0;
 	if (blk == NULL || so_read(dev, ctx, blk, SO_BLOCK, SO_STORE_OFF)) {
 		printf("STARLTE OVERLAY: store unreadable\n");
 		goto out;
@@ -167,12 +219,30 @@ starlte_overlay_install(void)
 		printf("STARLTE OVERLAY: no ios.overlay in the store\n");
 		goto out;
 	}
+	so_apply(dev, ctx, ov_off, ov_size, ov_crc);
+out:
+	if (blk) {
+		kfree_data(blk, SO_BLOCK);
+	}
+	(void)vnode_close(dev, FREAD, ctx);
+}
+
+static void
+so_apply(vnode_t dev, vfs_context_t ctx, uint64_t ov_off, uint64_t ov_size, uint32_t ov_crc)
+{
+	int err;
+	uint8_t *blk = kalloc_data(SO_BLOCK, Z_WAITOK | Z_ZERO);
+	uint8_t *hdr = NULL, *data = NULL;
+	uint32_t hdr_len = 0, data_len = 0;
+	if (blk == NULL) {
+		return;
+	}
 	if (so_stamp(ctx) == ov_crc) {
-		printf("STARLTE OVERLAY: overlay %08x already installed\n", ov_crc);
+		printf("STARLTE OVERLAY: %s overlay %08x already installed\n", so_card ? "card" : "store", ov_crc);
 		goto out;
 	}
 	/* Header: magic, count, version, then 256-byte entries. */
-	if (so_read(dev, ctx, blk, SO_BLOCK, SO_STORE_OFF + ov_off) || memcmp(blk, "SBOVL001", 8)) {
+	if (so_read(dev, ctx, blk, SO_BLOCK, (so_card ? 0 : SO_STORE_OFF) + ov_off) || memcmp(blk, "SBOVL001", 8)) {
 		printf("STARLTE OVERLAY: bad overlay header\n");
 		goto out;
 	}
@@ -184,7 +254,7 @@ starlte_overlay_install(void)
 	hdr_len = 16 + files * (uint32_t)sizeof(struct so_entry);
 	hdr_len = (hdr_len + SO_BLOCK - 1) & ~(SO_BLOCK - 1);
 	hdr = kalloc_data(hdr_len, Z_WAITOK | Z_ZERO);
-	if (hdr == NULL || so_read(dev, ctx, hdr, hdr_len, SO_STORE_OFF + ov_off)) {
+	if (hdr == NULL || so_read(dev, ctx, hdr, hdr_len, (so_card ? 0 : SO_STORE_OFF) + ov_off)) {
 		printf("STARLTE OVERLAY: header unreadable\n");
 		goto out;
 	}
@@ -213,7 +283,7 @@ starlte_overlay_install(void)
 				break;
 			}
 		}
-		err = e->size ? so_read(dev, ctx, data, e->size, SO_STORE_OFF + ov_off + e->offset) : 0;
+		err = e->size ? so_read(dev, ctx, data, e->size, (so_card ? 0 : SO_STORE_OFF) + ov_off + e->offset) : 0;
 		uint32_t crc = err ? 0 : so_crc32(0, data, e->size);
 		if (err || crc != e->crc) {
 			printf("STARLTE OVERLAY: %s: read error %d or CRC %08x != %08x, skipped\n", path, err,
@@ -233,9 +303,10 @@ starlte_overlay_install(void)
 	if (failed == 0) {
 		char text[9];
 		snprintf(text, sizeof(text), "%08x", ov_crc);
-		(void)so_write_file(SO_STAMP, 0644, text, 8, ctx);
+		(void)so_write_file(so_card ? SO_STAMP_SD : SO_STAMP, 0644, text, 8, ctx);
 	}
-	printf("STARLTE OVERLAY: overlay %08x: %u files written, %u failed\n", ov_crc, written, failed);
+	printf("STARLTE OVERLAY: %s overlay %08x: %u files written, %u failed\n", so_card ? "card" : "store", ov_crc,
+	    written, failed);
 out:
 	if (data) {
 		kfree_data(data, data_len);
@@ -243,9 +314,6 @@ out:
 	if (hdr) {
 		kfree_data(hdr, hdr_len);
 	}
-	if (blk) {
-		kfree_data(blk, SO_BLOCK);
-	}
-	(void)vnode_close(dev, FREAD, ctx);
+	kfree_data(blk, SO_BLOCK);
 }
 #endif /* ARM64_BOARD_CONFIG_STARLTE */
diff --git a/bsd/dev/starlte_sd.c b/bsd/dev/starlte_sd.c
index f2bdc0db..6fdc6d99 100644
--- a/bsd/dev/starlte_sd.c
+++ b/bsd/dev/starlte_sd.c
@@ -1093,7 +1093,13 @@ sd_mode_50(void)
 	return sd_clock_raw(2, 2, 0);
 }
 
-static uint64_t sd_check_a[8 * SECTOR / 8], sd_check_b[8 * SECTOR / 8];
+#define SD_CHECK_N 64u                  /* 32 KiB: the HFS volume header and the allocation bitmap on the 128 GB card */
+static uint64_t sd_check_a[SD_CHECK_N * SECTOR / 8], sd_check_b[SD_CHECK_N * SECTOR / 8];
+static uint64_t
+sd_check_lba(void)
+{
+	return sd.card_sectors == 249999360ULL ? 182888448ULL : 0;    /* iOS 26's root (cardlayout.py), else the MBR */
+}
 
 static const uint8_t sd_tuning_4bit[64] = {    /* SD 3.0 tuning block (Linux tuning_blk_pattern_4bit) */
 	0xff, 0x0f, 0xff, 0x00, 0xff, 0xcc, 0xc3, 0xcc, 0xc3, 0x3c, 0xcc, 0xff, 0xfe, 0xff, 0xfe, 0xef,
@@ -1116,14 +1122,14 @@ sd_downshift(const char *why)
 static void
 sd_uhs_mode(void)
 {
-	/* the reference: 8 sectors at the card's start, read at 50 MHz SDR25 first */
+	/* the reference: SD_CHECK_N sectors read at 50 MHz SDR25 first */
 	if (sd_switch_fn(1) || sd_mode_50()) {
 		printf("STARBITE SD: SDR25 switch failed: staying at %llu kHz\n", sd.card_hz / 1000);
 		return;
 	}
 	sd_mode = 2;
 	sd_hs = 1;
-	if (sd_read_sectors(0, 8, sd_check_a)) {
+	if (sd_read_sectors(sd_check_lba(), SD_CHECK_N, sd_check_a)) {
 		printf("STARBITE SD: SDR25 reference read failed\n");
 		return;
 	}
@@ -1181,8 +1187,8 @@ sd_uhs_mode(void)
 	wr(CLKSEL64, (rd(CLKSEL64) & ~7U) | best);
 	sd.clksel = rd(CLKSEL64);
 	sd_mode = 3;
-	/* the same 8 sectors again, now at SDR50 */
-	int rr = sd_read_sectors(0, 8, sd_check_b);
+	/* the same sectors again, now at SDR50 */
+	int rr = sd_read_sectors(sd_check_lba(), SD_CHECK_N, sd_check_b);
 	if (rr || memcmp(sd_check_a, sd_check_b, sizeof(sd_check_a))) {
 		printf("STARBITE SD: SDR50 data check failed (%d)\n", rr);
 		sd_downshift("data check");
@@ -1308,6 +1314,42 @@ sd_read(uint64_t sector, uint32_t count, void *dst)
 	return r;
 }
 
+/*
+ * 0401: before a kernel reset (the sweetreboot timer, not a panic: ACPM takes a mutex), a card switched to
+ * 1.8 V is powered off with LDO2 left at 3.3 V (the loader's own "off" values): a warm reset keeps the PMIC
+ * as it is, and TWRP / the loader / Android must find a card that starts at 3.3 V, not one still in 1.8 V
+ * mode on a 1.8 V rail.
+ */
+void starlte_sd_park(void);
+void
+starlte_sd_park(void)
+{
+	if (!sd_v18) {
+		return;
+	}
+	bool ok = starlte_pmic_write(1, 0x68, 0x28) && starlte_pmic_write(1, 0x4a, 0x3c);
+	printf("STARBITE SD: card parked for the reset (LDO31 off, LDO2 3.3 V off)%s\n", ok ? "" : ": ACPM write failed");
+}
+
+/*
+ * 0401: the card overlay area for starlte_overlay.c: the upper half of the sdlog range (the 128 GB card's
+ * last 64 MiB; the log ring uses at most the first 8 MiB + 1 sector, the clock the very last sector), so the
+ * host can queue root files with one dd from TWRP. off / len in bytes from the area start, both multiples
+ * of 512; buf 8-byte aligned. Only on the 128 GB card with the root on it.
+ */
+#define SD_OVL_FIRST 249933824ULL
+#define SD_OVL_COUNT 65535ULL               /* up to the clock sector 249999359, exclusive */
+int starlte_sd_overlay_read(uint64_t off, void *buf, uint32_t len);
+int
+starlte_sd_overlay_read(uint64_t off, void *buf, uint32_t len)
+{
+	if (!sd.ready || sd.card_sectors != 249999360ULL || (off % SECTOR) || (len % SECTOR) ||
+	    ((uintptr_t)buf & 7) || off / SECTOR + len / SECTOR > SD_OVL_COUNT) {
+		return EINVAL;
+	}
+	return sd_read(SD_OVL_FIRST + off / SECTOR, len / SECTOR, buf) ? EIO : 0;
+}
+
 /* ---- MBR and the sdroot= range (docs/XNU-MICROSD.md 6) ---- */
 
 struct sd_part {
