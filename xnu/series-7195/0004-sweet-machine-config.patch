 osfmk/arm/proc_reg.h                 | 10 +++-
 osfmk/arm64/sleh.c                   | 38 ++++++++++++++
 osfmk/arm64/start.s                  |  2 +
 pexpert/arm/pe_fiq.c                 | 30 +++++++++++
 pexpert/pexpert/arm64/Makefile       |  1 +
