Subject: [PATCH] patch: 0008-sweet-fill-closed-lib-gaps-kpc-stub.patch

---
 config/MASTER.arm64.sweet | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/config/MASTER.arm64.sweet b/config/MASTER.arm64.sweet
index 347efee..4c384ed 100644
--- a/config/MASTER.arm64.sweet
+++ b/config/MASTER.arm64.sweet
@@ -2,8 +2,8 @@
 # sweet (Redmi Note 10 Pro, SM7150): MASTER.arm64.MacOSX plus the open-source
 # arm64 assembly and pmap (nos_arm_asm, nos_arm_pmap). Apple's own SoC configs
 # link those from the KDK's closed lib<SOC>.os.<CONFIG>.a instead, which is
-# arm64e and Apple-silicon specific. kpc is dropped: it programs Apple's PMU
-# (and kperf does not build without it).
+# arm64e and Apple-silicon specific. kperf/kpc stay (xnu does not build without
+# kperf); osfmk/arm64/kpc.c is a stub with no hardware counters.
 #
 #
 # Mach Operating System
@@ -60,7 +60,7 @@
 #  LIBKERN_RELEASE =[ LIBKERN_BASE zlib ]
 #  LIBKERN_DEV =    [ LIBKERN_BASE zlib iotracking ]
 #  LIBKERN_DEBUG =  [ LIBKERN_BASE zlib iotracking ]
-#  PERF_DBG_BASE =  [ config_dtrace mach_kdp config_serial_kdp kdp_interactive_debugging config_kdp_coredump_encryption config_pervasive_energy PERFMON_BASE ]
+#  PERF_DBG_BASE =  [ config_dtrace mach_kdp config_serial_kdp kdp_interactive_debugging config_kdp_coredump_encryption config_pervasive_energy PERFMON_BASE kperf kpc ]
 #  PERF_DBG_RELEASE=[ PERF_DBG_BASE ist_kdebug ]
 #  PERF_DBG_DEV =   [ PERF_DBG_BASE lock_stats zleaks alternate_debugger sched_hygiene_debug config_debug_syscall_rejection config_iotrace ]
 #  PERF_DBG_DEBUG = [ PERF_DBG_BASE lock_stats zleaks alternate_debugger sched_hygiene_debug config_debug_syscall_rejection config_iotrace ]
