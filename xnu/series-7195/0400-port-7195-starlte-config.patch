diff --git a/osfmk/arm64/amcc_rorgn.c b/osfmk/arm64/amcc_rorgn.c
new file mode 100644
index 0000000..f30034c
--- /dev/null
+++ b/osfmk/arm64/amcc_rorgn.c
@@ -0,0 +1,9 @@
+/*
+ * starlte (xnu-7195): files.arm64 builds this for nos_arm_asm, but the public
+ * xnu-7195 source does not ship it. It implements the AMCC read-only region
+ * (KTRR/CTRR kernel text lockdown), which needs Apple memory controller
+ * hardware; nothing references it without KERNEL_INTEGRITY_KTRR/CTRR.
+ */
+#include <stdint.h>
+
+static const uint8_t starlte_no_amcc_rorgn __attribute__((unused)) = 0;
