From 3976d26afe98737626742b1327380aaaab127292 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:32:42 +0200
Subject: [PATCH] patch: 0091-a5xelte-assembly-screen-stages.patch

port: after APPLY_TUNABLES; the following guard is now HAS_CLUSTER && !NO_CPU_OVRD
---
 osfmk/arm64/start.s | 57 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 57 insertions(+)

diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 1c6efb1..9dfa409 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -925,6 +925,25 @@ La5_mmu_pixel:
 	msr		CPACR_EL1, x0
 #endif
 
+#if defined(A5XELTE)
+	/* fp_enabled: write directly to the DECON scanout alias. */
+	MOV64	x10, 0x670a08c0
+	MOV64	x11, 0xff00ffff
+	mov	x12, #21
+	mov	x15, #4320
+La5_fp_enabled_row:
+	mov	x14, x10
+	mov	x13, #36
+La5_fp_enabled_pixel:
+	str	w11, [x14], #4
+	subs	x13, x13, #1
+	b.ne	La5_fp_enabled_pixel
+	add	x10, x10, x15
+	subs	x12, x12, #1
+	b.ne	La5_fp_enabled_row
+	dsb	sy
+#endif
+
 	// Clear thread pointer
 	msr		TPIDR_EL1, xzr						// Set thread register
 
@@ -941,6 +960,25 @@ La5_mmu_pixel:
 
 	APPLY_TUNABLES x12, x13, x14
 
+#if defined(A5XELTE)
+	/* tunables_done: write directly to the DECON scanout alias. */
+	MOV64	x10, 0x670c24c0
+	MOV64	x11, 0xffff00ff
+	mov	x12, #21
+	mov	x15, #4320
+La5_tunables_done_row:
+	mov	x14, x10
+	mov	x13, #36
+La5_tunables_done_pixel:
+	str	w11, [x14], #4
+	subs	x13, x13, #1
+	b.ne	La5_tunables_done_pixel
+	add	x10, x10, x15
+	subs	x12, x12, #1
+	b.ne	La5_tunables_done_row
+	dsb	sy
+#endif
+
 #if HAS_CLUSTER && !NO_CPU_OVRD
 	// Unmask external IRQs if we're restarting from non-retention WFI
 	mrs		x9, CPU_OVRD
@@ -968,6 +1006,25 @@ La5_mmu_pixel:
 	mov	lr, x21
 #endif
 
+#if defined(A5XELTE)
+	/* arm_init_jump: write directly to the DECON scanout alias. */
+	MOV64	x10, 0x670e40c0
+	MOV64	x11, 0xffffff00
+	mov	x12, #21
+	mov	x15, #4320
+La5_arm_init_jump_row:
+	mov	x14, x10
+	mov	x13, #36
+La5_arm_init_jump_pixel:
+	str	w11, [x14], #4
+	subs	x13, x13, #1
+	b.ne	La5_arm_init_jump_pixel
+	add	x10, x10, x15
+	subs	x12, x12, #1
+	b.ne	La5_arm_init_jump_row
+	dsb	sy
+#endif
+
 	// Return to arm_init()
 	ret
 
