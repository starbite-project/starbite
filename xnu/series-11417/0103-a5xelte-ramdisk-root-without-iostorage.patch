From 15bff3aec3d2bdf69127b7a3a7af46b3b16384b0 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:33:26 +0200
Subject: [PATCH] patch: 0103-a5xelte-ramdisk-root-without-iostorage.patch

---
 iokit/Kernel/IOService.cpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index 875058b..596c233 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -5245,7 +5245,7 @@ IOService::publishHiddenMedia(IOService * parent)
 	bool                wasHiding;
 
 	iomediaClass = OSMetaClass::getMetaClassWithName(gIOMediaKey);
-#if !defined(ARM64_BOARD_CONFIG_SWEET)
+#if !defined(ARM64_BOARD_CONFIG_SWEET) && !defined(ARM64_BOARD_CONFIG_A5XELTE)
 	assert(iomediaClass);
 #endif
 
@@ -5256,7 +5256,7 @@ IOService::publishHiddenMedia(IOService * parent)
 	}
 	UNLOCKNOTIFY();
 
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 	/* SWEET has no IOStorageFamily: without the IOMedia class no media exists to unhide. */
 	if (!iomediaClass) {
 		wasHiding = false;
@@ -5307,7 +5307,7 @@ IOService::setRootMedia(IOService * root)
 	bool unhide;
 
 	ioblockstoragedriverClass = OSMetaClass::getMetaClassWithName(gIOBlockStorageDriverKey);
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 	/*
 	 * SWEET has no IOStorageFamily, so no service can be a block storage
 	 * driver: the root (e.g. a RAM disk) is not block media, as for image boot.
