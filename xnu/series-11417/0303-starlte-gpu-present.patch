From 8ab6e91be19eb90dc3e8954700cd86e7b5014afa Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:35:14 +0200
Subject: [PATCH] patch: 0303-starlte-gpu-present.patch

---
 bsd/dev/starlte_touch.c               | 50 +++++++++++++++++-------
 iokit/Kernel/arm/SweetFramebuffer.cpp | 56 ++++++++++++++++++++-------
 iokit/Kernel/arm/SweetSurface.cpp     | 31 +++++++++++++++
 iokit/Kernel/arm/SweetSurface.h       |  3 ++
 4 files changed, 110 insertions(+), 30 deletions(-)

diff --git a/bsd/dev/starlte_touch.c b/bsd/dev/starlte_touch.c
index 9e89b19..9c59d2e 100644
--- a/bsd/dev/starlte_touch.c
+++ b/bsd/dev/starlte_touch.c
@@ -22,6 +22,7 @@
 #if defined(ARM64_BOARD_CONFIG_STARLTE)
 #include <sys/param.h>
 #include <sys/systm.h>
+#include <sys/sysctl.h>
 #include <kern/clock.h>
 #include <kern/thread.h>
 #include <kern/sched_prim.h>
@@ -694,35 +695,52 @@ st_thread(__unused void *arg, __unused wait_result_t wr)
 
 /*
  * Boot-arg sweetswipe=1: scripted input for unattended test boots (screenshots of what is past the
- * lock screen). The phone UI is the home-button iPhone's (8 Plus canvas): a swipe up from the
- * bottom edge opens Control Center (on the home screen it did not, boot54), Home closes it and
- * unlocks (single presses 5 s apart, not a double press), a swipe left shows the applications'
- * page, a tap opens Settings. Times are since boot. Swipes use finger 9 in panel pixels through
- * sweet_hid_touch(), 24 steps of 12 ms, like the real ones; Home goes through sweet_hid_key().
+ * lock screen). Control Center opens with a swipe down from the top right corner, as on the iPhone X
+ * (a swipe up from the bottom edge does nothing, boot57; the user's own swipe down worked, boot58),
+ * Home closes it and unlocks (single presses 5 s apart, not a double press), a swipe left shows the
+ * applications' page, a tap opens Settings, Home and the swipe down give Control Center over the
+ * home screen. Times count from the first frame on the panel
+ * (sweet_fb_first_present, SweetFramebuffer.cpp: 70-85 s after boot in boot55-56, when absolute
+ * times had most of the script run before there was a UI). Swipes use finger 9 in panel pixels
+ * through sweet_hid_touch(), like the real ones; Home goes through sweet_hid_key().
  */
 extern void sweet_hid_key(int key, int down);
+extern uint64_t sweet_fb_first_present;
+/* for sbca (backboardd), whose screenshots are to be timed like this script */
+SYSCTL_QUAD(_kern, OID_AUTO, sweet_first_present, CTLFLAG_RD | CTLFLAG_LOCKED, &sweet_fb_first_present,
+    "mach_absolute_time() of the first frame on the panel, 0 before");
 
 static const struct {
 	unsigned at_s;
 	int home;                       /* 1: press Home; 0: swipe x0,y0 -> x1,y1 */
 	int x0, y0, x1, y1;
 } st_script[] = {
-	{ 50, 0, 720, 2950, 720, 1300 },        /* Control Center over the lock screen (sbca shot at 62 s) */
-	{ 66, 1, 0, 0, 0, 0 },                  /* closes it */
-	{ 71, 1, 0, 0, 0, 0 },                  /* unlocks */
-	{ 80, 0, 1300, 1500, 150, 1500 },       /* home screen page 2, the applications (shot at 95 s) */
-	{ 100, 0, 534, 1790, 534, 1790 },       /* a tap on Settings (shot at 135 s) */
+	{ 15, 0, 1380, 6, 1380, 1500 },         /* Control Center over the lock screen (sbca shots at 17-25 s) */
+	{ 30, 1, 0, 0, 0, 0 },                  /* closes it */
+	{ 35, 1, 0, 0, 0, 0 },                  /* unlocks */
+	{ 45, 0, 1300, 1500, 150, 1500 },       /* home screen page 2, the applications (shot at 55 s) */
+	{ 60, 0, 534, 1790, 534, 1790 },        /* a tap on Settings (shot at 80 s) */
+	{ 72, 1, 0, 0, 0, 0 },                  /* back to the home screen */
+	{ 88, 0, 1380, 6, 1380, 1500 },         /* Control Center over the home screen (shots at 97, 103 s) */
 };
 
 static void
 st_script_thread(__unused void *arg, __unused wait_result_t wr)
 {
-	const int f = ST_FINGERS - 1, steps = 24;
+	/* 50 samples 6 ms apart, eased in and out (smoothstep): 24 even steps of 60 px were not taken
+	 * for a swipe from the top edge (boot59), where the user's own swipe was */
+	const int f = ST_FINGERS - 1, steps = 50;
 
+	while (sweet_fb_first_present == 0) {
+		st_msleep(250);
+	}
+	uint64_t start_ns;
+	absolutetime_to_nanoseconds(sweet_fb_first_present, &start_ns);
+	printf("STARLTE TOUCH: first frame on the panel; scripted input starts\n");
 	for (unsigned i = 0; i < sizeof(st_script) / sizeof(st_script[0]); i++) {
 		uint64_t now_ns;
 		absolutetime_to_nanoseconds(mach_absolute_time(), &now_ns);
-		uint64_t at_ns = (uint64_t)st_script[i].at_s * NSEC_PER_SEC;
+		uint64_t at_ns = start_ns + (uint64_t)st_script[i].at_s * NSEC_PER_SEC;
 		if (now_ns < at_ns) {
 			st_msleep((unsigned)((at_ns - now_ns) / NSEC_PER_MSEC));
 		}
@@ -736,10 +754,12 @@ st_script_thread(__unused void *arg, __unused wait_result_t wr)
 		printf("STARLTE TOUCH: scripted swipe %u: %d,%d -> %d,%d\n", i, st_script[i].x0, st_script[i].y0,
 		    st_script[i].x1, st_script[i].y1);
 		for (int k = 0; k <= steps; k++) {
-			int x = st_script[i].x0 + (st_script[i].x1 - st_script[i].x0) * k / steps;
-			int y = st_script[i].y0 + (st_script[i].y1 - st_script[i].y0) * k / steps;
+			int t = k * 1000 / steps;                       /* 0..1000 */
+			int e = t * t / 1000 * (3000 - 2 * t) / 1000;   /* smoothstep, 0..1000 */
+			int x = st_script[i].x0 + (st_script[i].x1 - st_script[i].x0) * e / 1000;
+			int y = st_script[i].y0 + (st_script[i].y1 - st_script[i].y0) * e / 1000;
 			sweet_hid_touch(f, 1, x, y);
-			st_msleep(12);
+			st_msleep(6);
 		}
 		sweet_hid_touch(f, 0, st_script[i].x1, st_script[i].y1);
 	}
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index b6537c0..2163ad6 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -63,13 +63,26 @@ extern "C" uint64_t sweet_fb_hold_until;
 uint64_t sweet_fb_hold_until;
 /* Last surface copied full-screen to the panel (GPU copy test). */
 static uint32_t sweet_fb_last_surface_id;
+/* mach_absolute_time() of the first swap that put pixels on the panel (0: none yet), for scripted
+ * test input (starlte_touch.c, sweetswipe=1) */
+extern "C" uint64_t sweet_fb_first_present;
+uint64_t sweet_fb_first_present;
 extern "C" bool sweet_fb_last_surface(uint64_t *pages, unsigned max_pages, unsigned *npages,
     uint32_t *offset, uint32_t *stride, uint32_t *width, uint32_t *height, uintptr_t *kva);
-/* bsd/dev/herolte_gpu.c: the Mali scales a surface to the whole panel. */
+/* bsd/dev/herolte_gpu.c: the Mali scales a surface to the whole panel. On
+ * STARLTE (whose board config also defines HEROLTE) the S9's Mali-G72 does
+ * it instead: bsd/dev/starlte_gpu.c, ready once its boot-time GPU tests
+ * have passed. */
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+#define herolte_gpu_present_slot starlte_gpu_present_slot
+#define herolte_gpu_present_map starlte_gpu_present_map
+#define herolte_gpu_present_draw starlte_gpu_present_draw
+extern "C" int starlte_gpu_present_ready(void);
+#endif
 extern "C" int herolte_gpu_present_slot(uint32_t id, uint64_t first_pa);
 extern "C" int herolte_gpu_present_map(uint32_t id, const uint64_t *pages, unsigned n);
 extern "C" bool herolte_gpu_present_draw(int s, uint32_t off, uint32_t stride, uint32_t w, uint32_t h);
-#define SWEET_FB_GPU_MAX_PAGES 2048     /* one 8 MiB GPU slot */
+#define SWEET_FB_GPU_MAX_PAGES 3072     /* one 12 MiB GPU slot (starlte_gpu.c): 1242x2208 x 5120 B */
 #endif
 
 enum {
@@ -264,22 +277,24 @@ AppleCLCD::start(IOService *provider)
 	fLock = IOLockAlloc();
 	fClients = OSArray::withCapacity(4);
 	/* The default surface must have the presented size (a mismatch left
-	 * every swap layer empty); scaled, it is the panel's top-left part. */
-	fSurface = sweet_surface_create_physical(fPhys, fScaled ? fLogicalW : fWidth,
-	    fScaled ? fLogicalH : fHeight, fRowBytes, SWEET_FB_FORMAT_BGRA);
-	fPixels = fSurface != NULL ? fSurface->kernelAddress() : 0;
-#if defined(ARM64_BOARD_CONFIG_STARLTE)
-	/* Scaled, the default surface covers only the logical rows (1792 of
-	 * 2960): scaledCopy() writes the whole panel, so it needs a mapping of
-	 * all of it, or the lower rows go past the end (black lower third and
-	 * stray writes, seen on the S9). */
+	 * every swap layer empty). Scaled, it is a buffer of its own, presented
+	 * like any other: CoreAnimation double-buffers between it and a surface
+	 * of its own, and when it was the panel's top-left part every other
+	 * frame landed on the panel unscaled (iPadOS 18 boot52: the doubled
+	 * band above the scaled picture). */
+	fSurface = fScaled ? sweet_surface_create_buffer(fLogicalW, fLogicalH, SWEET_FB_FORMAT_BGRA) :
+	    sweet_surface_create_physical(fPhys, fWidth, fHeight, fRowBytes, SWEET_FB_FORMAT_BGRA);
+	fPixels = fSurface != NULL && !fScaled ? fSurface->kernelAddress() : 0;
+	/* Scaled, scaledCopy() writes the whole panel, so it needs a mapping of
+	 * all of it (with the panel's top-left part as the default surface, the
+	 * lower rows went past its end: black lower third and stray writes, seen
+	 * on the S9). */
 	if (fScaled && fSurface != NULL) {
 		SweetSurface *panel = sweet_surface_create_physical(fPhys, fWidth, fHeight, fRowBytes,
 		    SWEET_FB_FORMAT_BGRA);
 		fPixels = panel != NULL ? panel->kernelAddress() : 0;
 		IOLog("SWEET FB: scaled: panel mapping %ux%u for the scaler\n", fWidth, fHeight);
 	}
-#endif
 	fWorkLoop = IOWorkLoop::workLoop();
 	if (fLock == NULL || fClients == NULL || fPixels == 0 || fWorkLoop == NULL) {
 		IOLog("SWEET FB: setup failed\n");
@@ -760,7 +775,7 @@ AppleCLCD::present(const uint8_t *rec)
 			    s ? s->pixelFormat : 0, s ? s->bytesPerRow : 0, sx, sy, get32(a, 8),
 			    get32(a, 12), dx, dy, w, h);
 		}
-		if (s == NULL || s == fSurface) {
+		if (s == NULL || (s == fSurface && !fScaled)) {
 			OSSafeReleaseNULL(s);
 			continue;
 		}
@@ -840,6 +855,9 @@ AppleCLCD::present(const uint8_t *rec)
 		}
 		s->release();
 	}
+	if (copied != 0 && sweet_fb_first_present == 0) {
+		sweet_fb_first_present = mach_absolute_time();
+	}
 	return copied;
 }
 
@@ -856,6 +874,12 @@ AppleCLCD::gpuPresent(SweetSurface *s, int32_t sx, int32_t sy, int32_t w, int32_
 {
 	static uint64_t pages[SWEET_FB_GPU_MAX_PAGES];
 	static uint32_t failures;
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+	/* Until the G72 is up (about 8 s into boot) the CPU copies, uncounted. */
+	if (!starlte_gpu_present_ready()) {
+		return false;
+	}
+#endif
 	if (failures >= 8 || s->memory == NULL) {
 		return false;
 	}
@@ -874,7 +898,9 @@ AppleCLCD::gpuPresent(SweetSurface *s, int32_t sx, int32_t sy, int32_t w, int32_
 		slot = ok ? herolte_gpu_present_map(s->id, pages, n) : -1;
 	}
 	if (slot < 0) {
-		failures++;
+		/* (eight of these and the CPU copies for good: say why, as it used to happen silently) */
+		IOLog("SWEET FB: GPU present: surface %u (%llu bytes, first page %#llx) not mapped (%u of 8)\n", s->id,
+		    (unsigned long long)s->memory->getLength(), (unsigned long long)pa0, ++failures);
 		return false;
 	}
 	uint64_t off = (uint64_t)s->offset + (uint64_t)sy * s->bytesPerRow + (uint64_t)sx * 4;
@@ -885,7 +911,7 @@ AppleCLCD::gpuPresent(SweetSurface *s, int32_t sx, int32_t sy, int32_t w, int32_
 	}
 	__asm__ volatile ("dsb sy" ::: "memory");
 	if (!herolte_gpu_present_draw(slot, (uint32_t)off, s->bytesPerRow, (uint32_t)w, (uint32_t)h)) {
-		failures++;
+		IOLog("SWEET FB: GPU present: %dx%d stride %u not drawn (%u of 8)\n", w, h, s->bytesPerRow, ++failures);
 		return false;
 	}
 	return true;
diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index ef50879..b9aa6ff 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -255,6 +255,37 @@ sweet_surface_create_physical(uint64_t phys, uint32_t width, uint32_t height,
 	return s;
 }
 
+SweetSurface *
+sweet_surface_create_buffer(uint32_t width, uint32_t height, uint32_t pixelFormat)
+{
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		return NULL;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = (width * 4 + SWEET_SURFACE_ROW_ALIGN - 1) & ~(uint32_t)(SWEET_SURFACE_ROW_ALIGN - 1);
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = pixelFormat;
+	s->allocSize = (uint32_t)round_page((uint64_t)s->bytesPerRow * height);
+	IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared, s->allocSize, page_size);
+	if (mem == NULL) {
+		s->release();
+		return NULL;
+	}
+	OSAddAtomic64(s->allocSize, (volatile SInt64 *)&sweet_surface_wired);
+	bzero(mem->getBytesNoCopy(), s->allocSize);
+	s->memory = mem;
+	s->mapCache = kIOMapDefaultCache;
+	if (!sweet_surface_publish(s)) {
+		s->release();
+		return NULL;
+	}
+	return s;
+}
+
 mach_port_name_t
 sweet_surface_port_in_task(SweetSurface *s, task_t task)
 {
diff --git a/iokit/Kernel/arm/SweetSurface.h b/iokit/Kernel/arm/SweetSurface.h
index f1f816e..7dbcd98 100644
--- a/iokit/Kernel/arm/SweetSurface.h
+++ b/iokit/Kernel/arm/SweetSurface.h
@@ -59,6 +59,9 @@ SweetSurface *sweet_surface_copy(uint32_t id);
 SweetSurface *sweet_surface_create_physical(uint64_t phys, uint32_t width,
     uint32_t height, uint32_t bytesPerRow, uint32_t pixelFormat);
 
+/* Publish a zeroed kernel buffer as a surface (retained, as above). */
+SweetSurface *sweet_surface_create_buffer(uint32_t width, uint32_t height, uint32_t pixelFormat);
+
 /* Send right for the surface in task (IOSurfaceLookupFromMachPort). */
 mach_port_name_t sweet_surface_port_in_task(SweetSurface *surface, task_t task);
 
