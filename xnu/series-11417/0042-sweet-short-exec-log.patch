From 72ccb89c57bb36e9ab64254fbf3f41fb1b273687 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:30:20 +0200
Subject: [PATCH] patch: 0042-sweet-short-exec-log.patch

---
 bsd/kern/kern_exec.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 240bbf6..34a3c4a 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7849,9 +7849,14 @@ process_signature(proc_t p, struct image_params *imgp)
 				error = EACCES;
 				goto done;
 			}
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+			/* SWEET runs every iOS binary this way: one short line per exec. */
+			printf("exec %s\n", p->p_name);
+#else
 			printf("Allowing spawn of iOS binary %s since it has "
 			    "com.apple.private.security.no-sandbox entitlement or unentitled_ios_sim_launch "
 			    "boot-arg set to true\n", p->p_name);
+#endif
 		} else if (psa->psa_platform != PLATFORM_IOS) {
 			/* Simulator binary spawned with wrong platform */
 			signature_failure_reason = os_reason_create(OS_REASON_EXEC,
