 bsd/dev/starlte_pmsg.c | 143 +++++++++++++++++++++++++++++++++++++++++
 osfmk/kern/debug.c     |  13 ++++
 3 files changed, 157 insertions(+)
 create mode 100644 bsd/dev/starlte_pmsg.c

diff --git a/bsd/conf/files b/bsd/conf/files
index e85fea2..1fd378b 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -113,6 +113,7 @@ bsd/dev/starlte_smp.c			standard
 bsd/dev/starlte_gpu.c			standard
 bsd/dev/starlte_overlay.c		standard
 bsd/dev/starlte_sd.c			standard
+bsd/dev/starlte_pmsg.c			standard
 bsd/dev/herolte_battery.c		standard
 bsd/dev/herolte_gpu.c			standard
