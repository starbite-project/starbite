         .host_lines = {0},                  /* the guest kernel has the shared-distributor patch */
         .repair = 0,
         .boot_timeout_ms = 30000, .stop_timeout_ms = 5000,
+        /* contract v2 (the block devices) only when the store has the base image: the other guests stay v1 */
+        .v2 = (blk_dev[SBSHM_BLK_BASE].flags & SBSHM_BLKDEV_PRESENT) ? 1U : 0U,
     };
