# shots.sh's steps after shot 1, per catalog id: hostsim script commands separated by ';', "shot" dumps the next
# screenshot (2, 3). Keys are Linux key codes (28 Enter, 15 Tab, 1 Esc, 103 Up, 108 Down); taps in surface pixels
# (720 x 1344). Apps not listed: shot 1 only.
gnome-calculator: type 1234*56; key 28; shot; type 2^10; key 28; shot
qalculate-gtk: type 1 mile in km; key 28; shot
gnome-text-editor: type Shopping list for Sunday: bread, coffee, apples, oranges, tea and a birthday cake for Anna.; shot
gnome-chess: shot
gnome-sudoku: key 28; shot
gnome-mines: key 28; shot
