+    if (AP.on && is_app("store")) (void)sh_linux_hold(0);
+    for (int k = 0; k < 4; k++) { relayer(&aplin[k]); aplin[k].hidden = 1; aplin[k].clip = 0; }
+    relayer(&apkb); apkb.hidden = 1;
+    relayer(&aplst); aplst.hidden = 1;
