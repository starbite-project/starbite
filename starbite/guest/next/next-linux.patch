+/* ---- the home's third page: the App Store, then the catalog's apps (not the Terminal: page 2 has it) ---- */
+static void lx_build_page3(void)
+{
+    if (!store_ic.px) lx_make_store_icon(&store_ic, (int)(PT(ICON_PT) + .5f));
+    relayer(&hparts[5]);
