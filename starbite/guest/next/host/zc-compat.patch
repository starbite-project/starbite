# Test-only (gwin-host): Track A's zero-copy API from the trunk (claude/starbite-os-05b163, 16925a8: tk_layer_external,
# sh_linux_zero_copy), for a UI tree that does not have it yet; run.sh applies it to its scratch copy only.
diff --git a/starbite/sbos/ui/sbtk.h b/starbite/sbos/ui/sbtk.h
index ff12cb3..b857be8 100644
--- a/starbite/sbos/ui/sbtk.h
+++ b/starbite/sbos/ui/sbtk.h
@@ -169,6 +169,8 @@ struct tk_layer {
     float alpha;
     int hidden;
     int opaque;                /* every px of bmp (or solid) is opaque: what is under it need not be drawn */
+    int external;              /* 1.0: bmp is memory the layer doesn't own (tk_layer_external: the Linux guest's window
+                                * surface, uncached): the GPU samples it in place; no half copy, no block map, never freed */
     int clip;                  /* clip children and self to clip_r (parent space) */
     tk_rect clip_r;
     float fade_top, fade_bot;  /* mask-image fades inside clip_r (px, 0 = none) */
@@ -196,2 +198,6 @@
 void tk_layer_prepare(tk_layer *l);                       /* make its half copy now (idle time), not on first motion */
+/* 1.0 (Track E's zero-copy Linux window): the layer shows w x h px of memory it doesn't own (opaque ARGB, stride px),
+ * sampled by the GPU in place (the platform maps that range: kernel gpucomp_add_ext). Call it each frame the pointer
+ * or the pixels change (it bumps gen); px 0 detaches. Detach before freeing the layer (relayer would free bmp). */
+void tk_layer_external(tk_layer *l, const uint32_t *px, int w, int h, int stride);
 void tk_layer_glass_shape(tk_layer *l, float x, float y, float w, float h, float r);   /* v8: a rounded box of its mask */
diff --git a/starbite/sbos/ui/shell.h b/starbite/sbos/ui/shell.h
index 60c5d58..38b4aef 100644
--- a/starbite/sbos/ui/shell.h
+++ b/starbite/sbos/ui/shell.h
@@ -152,6 +152,8 @@ int sh_linux_char(char c);               /* one character typed: committed text
                                           * (Shift around capitals); '\n' Return and '\b' BackSpace are always keys */
 int sh_linux_viewport(int rows);         /* the rows the shell shows (SH_LINUX_H, or SH_LINUX_HKB with the keyboard) */
 int sh_linux_icon(int icon, uint32_t *px);     /* a pool icon into px (SH_LINUX_ICON squared); 0: none */
+int sh_linux_zero_copy(void);              /* 1.0: 1 when the GPU samples the guest's window surface in place: show it with
+                                            * tk_layer_external (the front buffer from the header) instead of the strips */
 int sh_linux_hold(int on);               /* 1: the App Store is open: Linux started if off and not stopped while idle */
 int sh_linux_pkg(int pkg, int op);       /* install / remove / cancel a store package; < 0 refused */
 /* the shell, called by the platform */
diff --git a/starbite/sbos/ui/tk_comp.c b/starbite/sbos/ui/tk_comp.c
index 23d4af3..934737f 100644
--- a/starbite/sbos/ui/tk_comp.c
+++ b/starbite/sbos/ui/tk_comp.c
@@ -57,6 +57,17 @@ void tk_layer_add(tk_layer *p, tk_layer *c)
     while (t->next) t = t->next;
     t->next = c;
 }
+void tk_layer_external(tk_layer *l, const uint32_t *px, int w, int h, int stride)
+{
+    if (!l->external) tk_layer_dirty(l), tk_bmp_free(&l->bmp);
+    l->gen++;
+    l->external = px != 0;
+    l->bmp.px = (uint32_t *)(uintptr_t)px;
+    l->bmp.w = px ? w : 0;
+    l->bmp.h = px ? h : 0;
+    l->bmp.stride = px ? stride : 0;
+    if (px) l->opaque = 1;
+}
 void tk_layer_dirty(tk_layer *l)
 {
     l->gen++;
@@ -432,7 +443,7 @@ static void draw_item(const tgt *T, const item *it, tk_irect R /* target px */)
     const tk_bmp *src = &l->bmp;
     const tk_a8 *gm = l->glass.v ? &l->glass : 0;
     float res = 1;
-    if (A < .75f && B < .75f) {
+    if (A < .75f && B < .75f && !l->external) {
         src = half_of(l);
         gm = l->ghalf.v ? &l->ghalf : 0;
         res = .5f;
@@ -973,6 +984,11 @@ static void clean_rows(void *a, int y0, int y1)
 static void gpu_flush_layer(tk_comp *c, tk_layer *l)
 {
     if (l->gpu_gen == l->gen + 1u || !c->gpu_clean) return;
+    if (l->external) {                          /* 1.0: uncached memory another core writes: nothing to clean or map */
+        l->gpu_occ_ok = 0;
+        l->gpu_gen = l->gen + 1u;
+        return;
+    }
     uint32_t fr = c->gpu_frames;
     int busy = l->gpu_occ_seen && fr - l->gpu_occ_frame <= 2u;
     l->gpu_occ_frame = fr;
@@ -1295,7 +1311,7 @@ int tk_comp_frame(tk_comp *c, int motion, int full)
     uint64_t th = tk_us();
     for (int i = 0; i < cur.n; i++) {
         item *it = &cur.it[i];
-        if (it->l->bmp.px && it->a * T.k < .75f && it->b * T.k < .75f) {
+        if (it->l->bmp.px && !it->l->external && it->a * T.k < .75f && it->b * T.k < .75f) {
             if (!it->l->half.px && getenv_dbg) tk_log(it->l->name);
             half_of(it->l);
         }
@@ -1489,13 +1505,13 @@ void tk_flatten(tk_layer *g, tk_bmp *out, tk_a8 *mask, float k)
         }
 }
 
-void tk_layer_prepare(tk_layer *l) { if (l->bmp.px) half_of(l); }
+void tk_layer_prepare(tk_layer *l) { if (l->bmp.px && !l->external) half_of(l); }
 
 static void prep(tk_layer *l)
 {
     for (; l; l = l->next) {
         if (l->hidden) continue;
-        if (l->bmp.px && !l->half.px) half_of(l);
+        if (l->bmp.px && !l->half.px && !l->external) half_of(l);
         prep(l->child);
     }
 }
