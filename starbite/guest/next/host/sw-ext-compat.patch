+/* ==== compat (gwin-host only): the toolkit's keyboard accessory bar, kb_accessory / kb_accessory_tap, as a stand-in:
+ * the keys over the keyboard (540 - KB_ACC_H .. 540) in the keyboard's function-key colours; a latched key (its label
+ * in capitals) lit as shift is */
+static tk_layer kbacc;
+static const char *const *KA;
+static int KAn;
+static void (*KAt)(int);
+static int kbacc_layers(tk_layer **o) { if (!kbacc.name) { tk_layer_init(&kbacc, "kb-accessory"); kbacc.hidden = 1; } o[0] = &kbacc; return 1; }
+static void kb_accessory(const char *const *keys, int n, void (*tap)(int i))
+{
+    KA = keys; KAn = keys && tap ? n : 0; KAt = tap;
+    relayer(&kbacc);
+    kbacc.hidden = 1;
+    if (!KAn) return;
+    float y0 = 540 - KB_ACC_H, w = (390 - 6 - 6.0f * (KAn - 1)) / KAn;
+    dc d = mk(&kbacc, "kb-accessory", 0, y0, 390, KB_ACC_H, 0, 0);
+    d_rrect(&d, 0, y0, 390, KB_ACC_H, 0, tk_hex(0x1e2030, 1));
+    for (int i = 0; i < KAn; i++) {
+        int lit = KA[i][0] >= 'A' && KA[i][0] <= 'Z' && KA[i][1] >= 'A' && KA[i][1] <= 'Z';
+        float x = 3 + (w + 6) * i, tw0 = tw(TK_IT600, 15, KA[i], 0, 0);
+        d_rrect(&d, x, y0 + 5, w, KB_ACC_H - 8, 6, lit ? W(.9f) : tk_hex(0x3a3d4a, 1));
+        int up = !tk_strcmp(KA[i], "\xe2\x86\x91"), dn = !tk_strcmp(KA[i], "\xe2\x86\x93");
+        if (up || dn) {                                  /* the pack's fonts have no up / down arrows: drawn */
+            float cx = x + w / 2, cy = y0 + 5 + (KB_ACC_H - 8) / 2, s = dn ? -1 : 1;
+            d_seg(&d, cx, cy - 6 * s, cx, cy + 6 * s, 1.6f, INK);
+            d_seg(&d, cx, cy - 6 * s, cx - 4.5f, cy - 1.5f * s, 1.6f, INK);
+            d_seg(&d, cx, cy - 6 * s, cx + 4.5f, cy - 1.5f * s, 1.6f, INK);
+            continue;
+        }
+        d_text(&d, TK_IT600, 15, x + (w - tw0) / 2, bl(TK_IT600, 15, y0 + 5 + (KB_ACC_H - 8 - 18) / 2), KA[i], 0, 0, lit ? tk_hex(0x1e2030, 1) : INK, 0);
+    }
+    kbacc.hidden = 0;
+}
+static int kb_accessory_tap(float x, float y)
+{
+    if (!KAn || y < 540 - KB_ACC_H || y >= 540) return 0;
+    int i = (int)((x - 3) / ((390 - 6) / (float)KAn));
+    if (i < 0 || i >= KAn) return 1;
+    sh_haptic();
+    KAt(i);
+    return 1;
+}
+/* the harness's view of the recents: "S:<key>" or "L:<title>" per card, newest first, ',' between */
+int sw_compat_dump(char *out, int cap)
+{
+    int n = 0;
+    out[0] = 0;
+    for (int i = 0; i < swn; i++) {
+        const char *t = SWR[i].kind ? sw_ext_title(SWR[i].subid) : APPS[SWR[i].a].k;
+        if (n + 4 + (int)tk_strlen(t) >= cap) break;
+        if (i) out[n++] = ',';
+        out[n++] = SWR[i].kind ? 'L' : 'S';
+        out[n++] = ':';
+        for (; *t; t++) out[n++] = *t;
+        out[n] = 0;
+    }
+    return swn;
 }
