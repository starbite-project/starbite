+/* compat: the external entries (shell_linux.inc's running Linux apps) */
+static void sw_ext_add(int subid)
+{
+    int i = sw_find_ext(subid);
+    sw_ent e = { -1, { 0, 0, 0, 0 }, 1, subid };
+    if (i < 0) {
+        if (swn == SW_MAX) sw_remove(SW_MAX - 1);
+        i = swn++;
+    } else e = SWR[i];
+    for (int k = i; k > 0; k--) SWR[k] = SWR[k - 1];
+    SWR[0] = e;
+    sw_dirty = 1;
+}
+static void sw_ext_remove(int subid)
+{
+    int i = sw_find_ext(subid);
+    if (i < 0) return;
+    sw_remove(i);
+    if (SW.on) { sw_labels(); relink(); }
+}
