#!/bin/busybox sh
# The guest Linux's init on the M3 cluster (starbite/guest, docs/STARBITE-OS-LINUX-M3.md 6): mount the
# kernel file systems, load sbguest.ko (power off without SYSTEM_OFF, /dev/sbshm), start guestd.
# sbguest.mode= app (default: guestd's demo), term, wayland (sbwl), desktop (the root on sbblk, then /sbin/sbinit).
# The full OS's guest (a distro root, a compositor bridge) replaces this; the contract stays sbshm.h.
/bin/busybox --install -s /bin
# the overlay (ext4 on /dev/sbblk1) checked before it is mounted (Track F, cp3 2026-11-12: after an unclean stop a
# file of apt's came back unreadable): -p replays the journal and fixes what is safe (quick when clean); what -p
# leaves (exit >= 4) -y fixes. 0 usable, 1 not (the caller falls back to a tmpfs upper layer)
fsck_overlay() {
    /sbin/e2fsck -p /dev/sbblk1 > /tmp/e2fsck.log 2>&1
    rc=$?
    if [ $rc -ge 4 ]; then
        /sbin/e2fsck -y /dev/sbblk1 >> /tmp/e2fsck.log 2>&1
        rc=$?
    fi
    say "desktop: overlay check: e2fsck $rc ($(tail -n 1 /tmp/e2fsck.log | cut -c1-120))"
    [ $rc -lt 4 ]
}
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
echo "guest-init: $(uname -r) on $(grep -c ^processor /proc/cpuinfo) CPUs" > /dev/kmsg
if [ -f /sbguest.ko ] && ! grep -q sbguest.nomod /proc/cmdline; then
    insmod /sbguest.ko && echo "guest-init: sbguest.ko loaded" > /dev/kmsg
fi
burn=0
mode=app
for a in $(cat /proc/cmdline); do
    case "$a" in
    sbguest.burn=*) burn=${a#sbguest.burn=} ;;
    sbguest.mode=*) mode=${a#sbguest.mode=} ;;
    esac
done
if [ "$mode" = desktop ]; then
    # No base image offered (the card files not placed yet, or the host has no block devices): with sbwl in this
    # initramfs, run the built-in terminal (the L2 wayland mode) instead of powering off
    i=0
    while [ ! -b /dev/sbblk0 ] && [ $i -lt 100 ]; do
        sleep 0.1
        i=$((i + 1))
    done
    if [ ! -b /dev/sbblk0 ] && [ -x /sbwl ]; then
        echo "guest-init: desktop: no base image (/dev/sbblk0): the built-in terminal instead" > /dev/kmsg
        mode=wayland
    fi
fi
if [ "$mode" = desktop ]; then
    # The desktop guest (docs/STARBITE-LINUX-APPS.md L4): the root is on the host's block devices (sbguest.ko's
    # sbblk, starbite/guest/blk/README.md): /dev/sbblk0 the base image (EROFS, read-only), /dev/sbblk1 the overlay
    # (ext4: upper + work), /dev/sbblk2 the package repo (EROFS, at /repo). Without a usable overlay device the
    # upper layer is a tmpfs (nothing persists) and the kernel log says so. Then switch_root to /sbin/sbinit.
    # The layers stay reachable in the new root under /.sbroot (base, rw) so its shutdown can remount rw read-only.
    say() { echo "guest-init: $*" > /dev/kmsg; }
    giveup() {      # no root: power the cluster off (sbguest.ko: CPU_OFF) instead of sitting there
        say "desktop: $* -- powering off"
        sync
        poweroff -f
        sleep 30
        exec /bin/sh
    }
    i=0
    while [ ! -b /dev/sbblk0 ] && [ $i -lt 100 ]; do
        sleep 0.1
        i=$((i + 1))
    done
    [ -b /dev/sbblk0 ] || giveup "no /dev/sbblk0 (the host offers no base image, or sbguest.ko is missing)"
    mkdir -p /sbroot/base /sbroot/rw /newroot
    mount -t erofs -o ro /dev/sbblk0 /sbroot/base || giveup "/dev/sbblk0 does not mount as EROFS"
    upper=overlay
    if [ ! -b /dev/sbblk1 ]; then
        say "desktop: WARNING: no overlay device (/dev/sbblk1): tmpfs upper layer, nothing will persist"
        upper=tmpfs
    elif [ -x /sbin/e2fsck ] && ! fsck_overlay; then
        say "desktop: WARNING: /dev/sbblk1 has errors e2fsck could not fix: tmpfs upper layer, nothing will persist"
        upper=tmpfs
    elif ! mount -t ext4 -o noatime /dev/sbblk1 /sbroot/rw; then
        say "desktop: WARNING: /dev/sbblk1 does not mount as ext4: tmpfs upper layer, nothing will persist"
        upper=tmpfs
    fi
    [ $upper = overlay ] || mount -t tmpfs -o mode=0755 sbroot-rw /sbroot/rw || giveup "no tmpfs for the upper layer"
    mkdir -p /sbroot/rw/upper /sbroot/rw/work
    mount -t overlay -o lowerdir=/sbroot/base,upperdir=/sbroot/rw/upper,workdir=/sbroot/rw/work overlay /newroot ||
        giveup "the overlay does not mount"
    if [ -b /dev/sbblk2 ]; then
        mkdir -p /newroot/repo
        mount -t erofs -o ro /dev/sbblk2 /newroot/repo || say "desktop: WARNING: /dev/sbblk2 (the repo) does not mount"
    fi
    if [ -b /dev/sbblk3 ]; then             # Track F's offline App Store mirror (appstore.erofs), optional
        mkdir -p /newroot/srv/appstore
        mount -t erofs -o ro /dev/sbblk3 /newroot/srv/appstore || say "desktop: WARNING: /dev/sbblk3 (the App Store mirror) does not mount"
    fi
    mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/.sbroot/base /newroot/.sbroot/rw
    mount -o move /sbroot/base /newroot/.sbroot/base
    mount -o move /sbroot/rw /newroot/.sbroot/rw
    mount -o move /dev /newroot/dev
    mount -o move /proc /newroot/proc
    mount -o move /sys /newroot/sys
    new=/sbin/sbinit
    [ -x /newroot$new ] || [ -L /newroot$new ] || new=/sbin/init
    echo "guest-init: desktop: root = base (sbblk0) + $upper upper$([ -d /newroot/repo ] && grep -q ' /newroot/repo ' /newroot/proc/mounts && echo ', /repo (sbblk2)'); switch_root to $new" > /newroot/dev/kmsg
    exec switch_root /newroot $new
fi
if [ "$mode" = wayland ] && [ -x /sbwl ]; then
    # Linux apps (docs/STARBITE-LINUX-APPS.md, L1): sbwl, our Wayland compositor, publishes the app window into the
    # shared surface and owns the ring (no guestd); it starts the app (foot) and keeps it running
    mount -t tmpfs -o mode=0700 run /run
    mkdir -p /dev/pts && mount -t devpts -o ptmxmode=0666 devpts /dev/pts     # the terminal app's PTY
    mkdir -p /dev/shm && mount -t tmpfs -o mode=1777 shm /dev/shm             # wlroots' buffers (shm_open)
    mkdir -p /root /tmp
    export XDG_RUNTIME_DIR=/run HOME=/root SHELL=/bin/sh LC_ALL=C.UTF-8 PATH=/bin:/usr/bin
    echo "guest-init: Wayland mode (sbwl + the app)" > /dev/kmsg
    while true; do
        /sbwl </dev/null >/dev/null 2>&1
        echo "guest-init: sbwl exited ($?); starting it again" > /dev/kmsg
        sleep 1
    done
fi
if [ "$mode" = term ] && [ -e /dev/tty1 ]; then
    # the terminal (docs 12 step 3): fbcon draws tty1 into the shared surface, guestd publishes the changed rows and
    # turns Starbite's keys into a uinput keyboard; a shell on tty1, started again if it exits
    # no blinking cursor: every blink would be a frame for Starbite to copy (power), and the screen would change
    # under a host reading it
    echo 0 > /sys/class/graphics/fbcon/cursor_blink 2>/dev/null
    /guestd --present </dev/null >/dev/null 2>&1 &
    echo "guest-init: terminal mode (tty1 on the shared surface)" > /dev/kmsg
    export HOME=/ PS1='starbite-linux# ' TERM=linux
    while true; do
        printf '\033[2J\033[HStarbite OS - Linux %s on the M3 cores\n\n' "$(uname -r)" > /dev/tty1
        setsid sh -c 'exec sh -i </dev/tty1 >/dev/tty1 2>&1'
        echo "guest-init: the shell on tty1 exited; starting another" > /dev/kmsg
    done
fi
/guestd --burn "$burn"
echo "guest-init: guestd exited ($?)" > /dev/kmsg
exec /bin/sh
