# The guest kernel of its own (docs/STARBITE-OS-LINUX-M3.md 12, step 2): `make allnoconfig` with this file as
# KCONFIG_ALLCONFIG (build-patched.sh GUEST=1). Linux 7.1 for the M3 cluster next to Starbite OS: no S9 port
# drivers (no initcall blacklist needed), no /dev/mem, the console and DRM on the shared surface (simpledrm on a
# simple-framebuffer node, mk-guest-dts.py --fb), uinput for Starbite's touch and keys, pstore for the log.
CONFIG_LOCALVERSION="-sbguest"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="starbite-guest"
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_HOTPLUG_CPU=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_SUSPEND is not set
# CONFIG_CPU_IDLE is not set
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MODULES=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
# CONFIG_DEVMEM is not set
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
# Terminus 16x32: the starbite-os terminal (720x1060 at 2x, 45x33 characters) picks it with fbcon=font:TER16x32
CONFIG_FONT_TER16x32=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PANIC_TIMEOUT=0
# ---- the desktop guest (docs/STARBITE-LINUX-APPS.md L3-L7): a Debian trixie arm64 userland on EROFS + overlay
# over sbblk (the shared-region block rings), GTK apps, Firefox-class browsers (seccomp + namespaces for their
# sandboxes), zram swap for memory pressure, PSI for the shell's honest RAM numbers
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_FILE_LOCKING=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSCTL=y
CONFIG_PROC_SYSCTL=y
CONFIG_INET=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_PSI=y
