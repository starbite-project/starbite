#!/bin/sh
# /sbin/sbinit: PID 1 of the guest's Debian root (docs/STARBITE-LINUX-APPS.md L4), started by the initramfs's
# switch_root after it has put together the root: base.erofs (sbblk dev 0, read-only) under an overlay whose upper
# is the ext4 image on sbblk dev 1. It
#   - mounts the kernel file systems (proc, sys, dev, devpts, /dev/shm, /run),
#   - turns on zram swap (lz4, ~50 % of RAM),
#   - mounts the App Store's repository (sbblk dev 2, EROFS label sb-repo) on /repo if the initramfs did not,
#   - prepares the desktop user's home on a fresh overlay,
#   - starts sbpkg (the App Store daemon, root: it runs apt) in the background, restarted if it exits,
#   - runs sbwl (/usr/bin/sbwl from sbwl/install-rootfs.sh, else /usr/local/bin/sbwl) as root in a restart loop.
#     sbwl itself makes the user's session: /run/user/1000, the Wayland socket there, a D-Bus session bus, and starts
#     the apps as "user" (uid 1000). Without sbwl, sbinit idles and reaps.
# Kernel command line knobs: sbinit.epoch=SECONDS (the wall clock, UTC), sbinit.repo=/dev/DEV (the repo device), sbinit.zram=0 (no swap), sbinit.nopkg (no
# sbpkg), sbinit.nosbwl (no compositor: a shell-less idle system for tests). sbwl's own arguments:
# /etc/starbite/sbwl.args (one line), if present.
# Logs go to the kernel log (/dev/kmsg), which reaches Starbite through the ramoops zone.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games    # games live in /usr/games
export LANG=C.UTF-8 LC_ALL=C.UTF-8
umask 022

log() { echo "sbinit: $*" > /dev/kmsg 2>/dev/null || echo "sbinit: $*"; }
mnt_t() { t=$1 dev=$2 dir=$3; shift 3; mkdir -p "$dir"; mountpoint -q "$dir" || mount -t "$t" "$@" "$dev" "$dir"; }

# ---- kernel file systems (the initramfs may have moved some of them here already) ----
mnt_t proc proc /proc
mnt_t sysfs sys /sys
mnt_t devtmpfs dev /dev
mnt_t devpts devpts /dev/pts -o gid=5,mode=0620,ptmxmode=0666
mnt_t tmpfs shm /dev/shm -o mode=1777,nosuid,nodev
mnt_t tmpfs run /run -o mode=0755,nosuid,nodev,size=32m
[ -e /dev/fd ] || ln -s /proc/self/fd /dev/fd
# the self tests' marker comes from the user's shell (echo ... > /dev/kmsg in foot, which runs as "user"); the
# guest's kernel log is the guest's own, so letting users write to it is harmless
chmod 0622 /dev/kmsg
mkdir -p /run/lock /tmp /var/tmp && chmod 1777 /tmp /var/tmp
rm -rf /tmp/* /tmp/.[!.]* 2>/dev/null       # /tmp is on the overlay (no RAM for a tmpfs): start clean
hostname starbite 2>/dev/null
ip link set lo up 2>/dev/null
log "$(uname -r), $(grep -c ^processor /proc/cpuinfo) CPUs, $(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo) MB"

# ---- options from the kernel command line ----
REPO_DEV= ZRAM=1 PKG=1 WL=1 EPOCH=
for a in $(cat /proc/cmdline); do
    case "$a" in
    sbinit.epoch=*) EPOCH=${a#sbinit.epoch=} ;;
    sbinit.repo=*) REPO_DEV=${a#sbinit.repo=} ;;
    sbinit.zram=0) ZRAM=0 ;;
    sbinit.nopkg) PKG=0 ;;
    sbinit.nosbwl) WL=0 ;;
    esac
done

# ---- the clock: the guest has no RTC and no network time. hdr.host_time_ms is Starbite's uptime, not a date, so
# the host passes the wall clock as sbinit.epoch=SECONDS (UTC) on the kernel command line; without it, at least not
# 1970: the base image's build date (TLS, apt and file times want a plausible date) ----
if [ -n "$EPOCH" ] && date -u -s "@$EPOCH" >/dev/null 2>&1; then
    log "clock set from the host: $(date -u '+%F %T') UTC"
elif [ "$(date -u +%Y)" -lt 2025 ] && [ -s /usr/share/starbite/base-date ]; then
    date -u -s "$(cat /usr/share/starbite/base-date)" >/dev/null 2>&1 &&
        log "no wall clock from the host: set to the base's build date $(date -u +%F)"
fi

# ---- the guest's kernel module (normally loaded by the initramfs) ----
if [ ! -e /dev/sbshm ]; then
    ko=$(find /lib/modules/"$(uname -r)" -name 'sbguest.ko*' 2>/dev/null | head -1)
    [ -n "$ko" ] && insmod "$ko" && log "sbguest.ko loaded"
fi

# ---- zram swap: lz4, half the RAM ----
if [ "$ZRAM" = 1 ] && ! grep -q zram0 /proc/swaps; then
    [ -e /sys/block/zram0 ] || modprobe zram num_devices=1 2>/dev/null
    if [ -e /sys/block/zram0 ]; then
        kb=$(awk '/MemTotal/{print $2}' /proc/meminfo)
        echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null
        echo $((kb / 2))K > /sys/block/zram0/disksize &&
            mkswap /dev/zram0 >/dev/null && swapon -p 100 /dev/zram0 &&
            log "zram swap $((kb / 2048)) MB ($(sed 's/.*\[\(.*\)\].*/\1/' /sys/block/zram0/comp_algorithm))"
        echo 100 > /proc/sys/vm/swappiness            # compressed RAM is cheap to swap to
        echo 0 > /proc/sys/vm/page-cluster            # zram: no readahead
    else
        log "no zram"
    fi
fi

# ---- the App Store's repository (read-only EROFS) ----
mkdir -p /repo
if ! mountpoint -q /repo; then
    [ -n "$REPO_DEV" ] || REPO_DEV=$(findfs LABEL=sb-repo 2>/dev/null)
    if [ -n "$REPO_DEV" ] && mount -t erofs -o ro "$REPO_DEV" /repo; then
        log "repo $REPO_DEV on /repo"
    else
        log "no repo device (the store shows nothing to install)"
    fi
fi

# ---- first boot on a fresh overlay: machine id, the user's home ----
[ -s /etc/machine-id ] || dbus-uuidgen > /etc/machine-id 2>/dev/null
if id user >/dev/null 2>&1; then
    U_HOME=$(getent passwd user | cut -d: -f6)
    if [ ! -d "$U_HOME/.config" ]; then
        mkdir -p "$U_HOME" && cp -a /etc/skel/. "$U_HOME/" 2>/dev/null
        chown -R user:user "$U_HOME"
    fi
fi

# the apps' environment (sbwl passes it on): software rendering, small memory. GTK 4's cairo renderer (no GL), no
# accessibility bus, Firefox on Wayland, LibreOffice's GTK 3 plugin
export GSK_RENDERER=cairo GDK_BACKEND=wayland NO_AT_BRIDGE=1 GTK_A11Y=none MOZ_ENABLE_WAYLAND=1
export LIBGL_ALWAYS_SOFTWARE=1 GTK_USE_PORTAL=0 SAL_USE_VCLPLUGIN=gtk3 XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Starbite HOME=/root

# ---- sbpkg: the App Store daemon (root: it runs apt in the overlay), restarted if it exits ----
if [ "$PKG" = 1 ] && [ -x /usr/local/sbin/sbpkg ]; then
    (
        while true; do
            /usr/local/sbin/sbpkg </dev/null >/dev/null 2>/dev/kmsg
            log "sbpkg exited ($?); starting it again in 2 s"
            sleep 2
        done
    ) &
fi

# ---- sbwl: the compositor (root; it owns the shm rings and /run/sbwl.sock, starts the apps as "user") ----
# HOOK: mk-base.sh SBWL=/path/to/sbwl runs sbwl/install-rootfs.sh (-> /usr/bin/sbwl, /etc/sbwl/system-apps).
trap 'sync' TERM
SBWL_BIN=/usr/bin/sbwl
[ -x "$SBWL_BIN" ] || SBWL_BIN=/usr/local/bin/sbwl
args=$(cat /etc/starbite/sbwl.args 2>/dev/null)
while true; do
    if [ "$WL" = 1 ] && [ -x "$SBWL_BIN" ]; then
        log "starting $SBWL_BIN"
        # shellcheck disable=SC2086
        (cd / && "$SBWL_BIN" $args </dev/null >/dev/null 2>&1)
        log "sbwl exited ($?); starting it again"
        sleep 1
    else
        sleep 30        # no compositor: stay up (and reap orphans: dash's wait takes any child)
    fi
done
