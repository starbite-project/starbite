		<key>com.apple.kpi.private</key>
		<string>19.0</string>
		<key>com.apple.kpi.unsupported</key>
		<string>19.0</string>
	</dict>
	<key>OSBundleRequired</key>
	<string>Root</string>
</dict>
</plist>
