+    UINT64   WlBase = SB_WL (STARBITE_WINLOAD_STAR2LTE_BASE);   // winload's real load base
+    UINT64   WlP;
+    BOOLEAN  WlHit = FALSE;
+
+    for (WlP = WlBase + 0x1000ULL; WlP + 0x10ULL <= WlBase + STARBITE_WINLOAD_SIZE; WlP += 4ULL) {
+      volatile UINT32  *WlI = (volatile UINT32 *)(UINTN)WlP;
