 #define MMIO_REGION_COUNT  (sizeof (mMmioRegions) / sizeof (mMmioRegions[0]))
 
+//
+// starbite: extra DRAM published at SEC/PEI, staged by STAR2LTE_RAM_STAGE
+// (0 = the 0x90000000+0x2C800000 PcdSystemMemory window only, 711 MiB).
+// Galaxy S9 (starlte, 4 GB) banks from TWRP's /proc/iomem: 0x80000000+0x3C800000,
+// 0xC0000000+0x20000000, 0xE1900000+0x1DF00000, 0x880000000+0x80000000, minus the
+// DT reserved-memory carveouts (device/dtb/starlte.dts). Each range is mapped
+// write-back here and published as tested system memory, so DXE and the OS
+// loader see it as conventional RAM from the start (no RamManagerDxe needed).
+//
+typedef struct {
+  UINT64  Base;
+  UINT64  Size;
+  UINT8   Stage;
+} EXTRA_RAM_RANGE;
+
+STATIC CONST EXTRA_RAM_RANGE  mExtraRam[] = {
+  // Stage 1: bank 1 minus seclog (0xC0000000+0x80000) and the page-rounded
+  // framebuffer (0xCC000000..0xCD044000) -- the published RamManagerDxe ranges.
+  { 0x00000000C0080000ULL, 0x000000000BF80000ULL, 1 },
+  { 0x00000000CD044000ULL, 0x0000000012FBC000ULL, 1 },
+  // Stage 2: bank 2 between secure_camera (0xE1900000+0x1E00000, untouchable)
+  // and modem_if (0xF0000000); the rest of bank 2 is CP/abox/exynos_ss (pstore).
+  { 0x00000000E3700000ULL, 0x000000000C900000ULL, 2 },
+  // Stage 3: the 2 GiB high bank (no carveouts in the DT).
+  { 0x0000000880000000ULL, 0x0000000080000000ULL, 3 },
+};
+
+#define EXTRA_RAM_COUNT  (sizeof (mExtraRam) / sizeof (mExtraRam[0]))
+
 /**
   Build the platform memory map. Caller frees nothing; table is static.
 
@@ -93,7 +127,7 @@
   )
 {
