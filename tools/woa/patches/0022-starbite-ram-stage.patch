+  STATIC ARM_MEMORY_REGION_DESCRIPTOR  Table[MMIO_REGION_COUNT + EXTRA_RAM_COUNT + 5];
   UINTN                                Index;
   UINTN                                Region;
 
@@ -156,6 +190,34 @@
   Index++;
 
   //
+  // --- Extra DRAM banks (starbite STAR2LTE_RAM_STAGE) ---
+  // Map before the framebuffer entry below, which carves its device window out
+  // of bank 1 again. The HOB list exists (PeilessSec builds it before MemoryPeim
+  // asks for this table), so publish each bank as tested system memory here.
+  //
+  for (Region = 0; Region < EXTRA_RAM_COUNT; Region++) {
+    if (mExtraRam[Region].Stage > STAR2LTE_RAM_STAGE) {
+      continue;
+    }
+    Table[Index].PhysicalBase = mExtraRam[Region].Base;
+    Table[Index].VirtualBase  = mExtraRam[Region].Base;
+    Table[Index].Length       = mExtraRam[Region].Size;
+    Table[Index].Attributes   = MMAP_DRAM;
+    Index++;
+    BuildResourceDescriptorHob (
+      EFI_RESOURCE_SYSTEM_MEMORY,
+      EFI_RESOURCE_ATTRIBUTE_PRESENT |
+      EFI_RESOURCE_ATTRIBUTE_INITIALIZED |
+      EFI_RESOURCE_ATTRIBUTE_WRITE_COMBINEABLE |
+      EFI_RESOURCE_ATTRIBUTE_WRITE_THROUGH_CACHEABLE |
+      EFI_RESOURCE_ATTRIBUTE_WRITE_BACK_CACHEABLE |
+      EFI_RESOURCE_ATTRIBUTE_TESTED,
+      mExtraRam[Region].Base,
+      mExtraRam[Region].Size
+      );
+  }
