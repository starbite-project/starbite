+STATIC
+VOID
+EClean (
+  IN UINTN  Start,
+  IN UINTN  End
+  )
+{
+  UINTN  A;
+
+  for (A = Start & ~(UINTN)63; A < End; A += 64) {
+    __asm__ __volatile__ ("dc civac, %0" : : "r" (A) : "memory");
+  }
+
+  __asm__ __volatile__ ("dsb sy" ::: "memory");
+}
