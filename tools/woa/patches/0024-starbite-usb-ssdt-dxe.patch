+STATIC UINT16 DRd16 (CONST UINT8 *p) { UINT16 v; CopyMem (&v, p, 2); return v; }
+STATIC UINT32 DRd32 (CONST UINT8 *p) { UINT32 v; CopyMem (&v, p, 4); return v; }
+STATIC UINT64 DRd64 (CONST UINT8 *p) { UINT64 v; CopyMem (&v, p, 8); return v; }
