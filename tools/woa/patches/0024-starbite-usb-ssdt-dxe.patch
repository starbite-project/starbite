+++ b/Platform/Star2LtePkg/Drivers/Star2LteSsdtDxe/M3Probe.c
@@ -0,0 +1,224 @@
+/** @file
+  M3Probe: do the Mongoose M3 cores run when started from UEFI? (docs/WIN11-BIGCORES.md stage B1)
+
+  Part of Star2LteSsdtDxe when built with STARBITE_M3_PROBE=1; runs during DXE dispatch, before the
+  release BDS parks the A55 secondaries. Nothing here is visible to Windows: the MADT, the PPTT and
+  numproc stay as they are, and every M3 core that arrives powers itself off again.
+
+  What is known (woa's PlatformBootManagerLib.c notes, boot-v20..v36, and our XNU patch 0304):
+    - CPU_ON (0xC4000003) for an M3 target returns SUCCESS and FlexPMU marks the core up, but from
+      woa's UEFI the core never left a visible mark; a SECOND CPU_ON to the same target never
+      returns and the SoC needs a forced reset (the watchdog doesn't help).
+    - XNU starts the M3s on this phone after six PMU writes (Samsung's pmucal_lpm_init entries, as
+      the Linux S9+ port applies them before every M3 CPU_ON): CPU_QCH_CLUSTER1_NONCPU_SYS_PWR_REG
+      0x1088 [31:24] = 0x8D, MEMORY_CLUSTER1_CPU0..3_OPTION 0x2114/0x2180/0x21EC/0x2258 and
+      MEMORY_CLUSTER1_NONCPU_OPTION 0x2384 [1:0] = 2. PSCI targets are 0x100 + n.
+  So this probe applies the six writes, then issues exactly ONE CPU_ON per core, for M3 cores 1, 2
+  and 3 (core 0 shares its affinity 0x100 with A55 core 1 and is not planned for Windows), and
+  stops at the first core that doesn't check in within 200 ms (no second CPU_ON, ever).
+
+  The witness stub (one reserved page below 4 GiB per core, MMU and caches off on entry): stores
+  its own MPIDR and "M3OK" into its page, cleans the line to the point of coherency, then calls
+  PSCI CPU_OFF (0x84000002); if that returns, it waits in WFE. The poller cleans and invalidates
+  the line before each read. Logged as "=M3" lines (StarbiteLog.h).
+
+  Copyright (c) 2026, Starbite. SPDX-License-Identifier: GPL-2.0-only
+**/
+
+#include <PiDxe.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/PrintLib.h>
+#include <Library/TimerLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+
+#include "StarbiteLog.h"
+
+#define PMU_BASE        0x14060000UL
+#define PSCI_CPU_ON     0xC4000003UL
+#define M3_OK           0x4D334F4Bu        // "KO3M" in memory order, reads 0x4D334F4B
+#define POLL_MS         200u
+
+STATIC CONST struct {
+  UINT32    Offset, Mask, Value;
+} mM3Pmu[] = {
+  { 0x1088, 0xFF000000u, 0x8D000000u },     // CPU_QCH_CLUSTER1_NONCPU_SYS_PWR_REG
+  { 0x2114, 3, 2 },                         // MEMORY_CLUSTER1_CPU0_OPTION
+  { 0x2180, 3, 2 },                         // ..._CPU1_OPTION
+  { 0x21EC, 3, 2 },                         // ..._CPU2_OPTION
+  { 0x2258, 3, 2 },                         // ..._CPU3_OPTION
+  { 0x2384, 3, 2 },                         // MEMORY_CLUSTER1_NONCPU_OPTION
+};
+
+STATIC
+UINT64
+Smc (
+  IN UINT64  Fn,
+  IN UINT64  A1,
+  IN UINT64  A2,
+  IN UINT64  A3
+  )
+{
+  register UINT64  x0 __asm__ ("x0") = Fn;
+  register UINT64  x1 __asm__ ("x1") = A1;
+  register UINT64  x2 __asm__ ("x2") = A2;
+  register UINT64  x3 __asm__ ("x3") = A3;
+
+  //
+  // PSCI 0.1 firmware (older than SMCCC 1.1) may change x4..x17: clobbered, as shim/starlte/em.c
+  // psci_call and XNU's 0300 declare them.
+  //
+  __asm__ __volatile__ (
+    "smc #0"
+    : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3)
+    :
+    : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory"
+    );
+  return x0;
+}
+
+STATIC
+VOID
+CleanInvalidate (
+  IN UINTN  Address,
+  IN UINTN  Length
+  )
+{
+  UINTN  A;
+
+  for (A = Address & ~(UINTN)63; A < Address + Length; A += 64) {
+    __asm__ __volatile__ ("dc civac, %0" : : "r" (A) : "memory");
+  }
+  __asm__ __volatile__ ("dsb sy" ::: "memory");
+}
+
+//
+// The witness stub at Page + 0x800; its page base is baked in (Samsung's EL3 doesn't deliver
+// the PSCI context id). Marker at Page + 0x08, MPIDR at Page + 0x10.
+//
+STATIC
+VOID
+EmitStub (
+  OUT UINT32  *Code,
+  IN  UINT64  Page
+  )
+{
+  UINTN  i;
+
+  i         = 0;
+  Code[i++] = 0xD2800001u | (((UINT32)(Page >> 0) & 0xFFFFu) << 5);              // MOVZ X1, #p0
+  Code[i++] = 0xF2A00001u | (((UINT32)(Page >> 16) & 0xFFFFu) << 5);             // MOVK X1, #p1, LSL #16
+  Code[i++] = 0xF2C00001u | (((UINT32)(Page >> 32) & 0xFFFFu) << 5);             // MOVK X1, #p2, LSL #32
+  Code[i++] = 0xF2E00001u | (((UINT32)(Page >> 48) & 0xFFFFu) << 5);             // MOVK X1, #p3, LSL #48
+  Code[i++] = 0xD53800A2u;                                                       // MRS  X2, MPIDR_EL1
+  Code[i++] = 0xF9000822u;                                                       // STR  X2, [X1, #0x10]
+  Code[i++] = 0x52800003u | ((M3_OK & 0xFFFFu) << 5);                            // MOVZ W3, #lo
+  Code[i++] = 0x72A00003u | ((M3_OK >> 16) << 5);                                // MOVK W3, #hi, LSL #16
+  Code[i++] = 0xB9000823u;                                                       // STR  W3, [X1, #0x08]
+  Code[i++] = 0xD5033F9Fu;                                                       // DSB  SY
+  Code[i++] = 0xD50B7E21u;                                                       // DC   CIVAC, X1
+  Code[i++] = 0xD5033F9Fu;                                                       // DSB  SY
+  Code[i++] = 0x52800040u;                                                       // MOVZ W0, #0x0002
+  Code[i++] = 0x72B08000u;                                                       // MOVK W0, #0x8400, LSL #16
+  Code[i++] = 0xD4000003u;                                                       // SMC  #0  (CPU_OFF)
+  Code[i++] = 0xD503205Fu;                                                       // WFE
+  Code[i++] = 0x17FFFFFFu;                                                       // B    .-4
+}
+
+//
+// The six writes, before EVERY M3 CPU_ON as XNU 0304 and the Linux port do (the cluster may power
+// down after a core's CPU_OFF and its option registers with it). Logged on the first pass only.
+//
+STATIC
+VOID
+M3PmuDefaults (
+  IN BOOLEAN  Log
+  )
+{
+  volatile UINT32  *Pmu;
+  UINT32           Before;
+  UINT32           After;
+  UINTN            Index;
+
+  Pmu = (volatile UINT32 *)PMU_BASE;
+  for (Index = 0; Index < ARRAY_SIZE (mM3Pmu); Index++) {
+    Before = Pmu[mM3Pmu[Index].Offset / 4];
+    Pmu[mM3Pmu[Index].Offset / 4] = (Before & ~mM3Pmu[Index].Mask) | mM3Pmu[Index].Value;
+    __asm__ __volatile__ ("dsb sy" ::: "memory");
+    After = Pmu[mM3Pmu[Index].Offset / 4];
+    if (Log || ((After & mM3Pmu[Index].Mask) != mM3Pmu[Index].Value)) {
+      SbLog (
+        "=M3 pmu %04x %08x -> %08x%a",
+        mM3Pmu[Index].Offset,
+        Before,
+        After,
+        ((After & mM3Pmu[Index].Mask) == mM3Pmu[Index].Value) ? "" : " NOT SET"
+        );
+    }
+  }
+}
+
+VOID
+M3Probe (
+  VOID
+  )
+{
+  EFI_PHYSICAL_ADDRESS  Page;
+  volatile UINT32       *Marker;
+  volatile UINT64       *Mpidr;
+  UINT64                Rc;
+  UINTN                 Core;
+  UINTN                 Ms;
+  EFI_STATUS            Status;
+
+  SbLog ("=M3 probe v1: PMU defaults, then one CPU_ON per M3 core 1..3");
+
+  for (Core = 1; Core <= 3; Core++) {
+    Page   = 0xFFFFFFFFu;
+    Status = gBS->AllocatePages (AllocateMaxAddress, EfiReservedMemoryType, 1, &Page);
+    if (EFI_ERROR (Status)) {
+      SbLog ("=M3 core %d: no page (%r), stop", Core, Status);
+      return;
+    }
+
+    ZeroMem ((VOID *)(UINTN)Page, EFI_PAGE_SIZE);
+    EmitStub ((UINT32 *)(UINTN)(Page + 0x800), Page);
+    CleanInvalidate ((UINTN)Page, EFI_PAGE_SIZE);
+    __asm__ __volatile__ ("ic iallu\n dsb sy\n isb" ::: "memory");
+
+    Marker = (volatile UINT32 *)(UINTN)(Page + 0x08);
+    Mpidr  = (volatile UINT64 *)(UINTN)(Page + 0x10);
+    M3PmuDefaults ((BOOLEAN)(Core == 1));
+    Rc = Smc (PSCI_CPU_ON, 0x100 + Core, Page + 0x800, 0);
+    for (Ms = 0; Ms < POLL_MS; Ms++) {
+      CleanInvalidate ((UINTN)Page, 64);
+      if (*Marker == M3_OK) {
+        break;
+      }
+      MicroSecondDelay (1000);
+    }
+
+    SbLog (
+      "=M3 core %d target %x: CPU_ON rc=%lx, %a after %d ms, mpidr=%lx",
+      Core,
+      0x100 + Core,
+      Rc,
+      (*Marker == M3_OK) ? "ARRIVED" : "no mark",
+      Ms,
+      *Mpidr
+      );
+    if ((Rc != 0) || (*Marker != M3_OK)) {
+      SbLog ("=M3 stop: no further CPU_ON this boot");
+      return;
+    }
+
+    //
+    // Let the core finish its CPU_OFF before the next CPU_ON in the same cluster (PSCI 0.1: no
+    // AFFINITY_INFO to ask; woa saw a power transaction in flight block a CPU_ON for good).
+    //
+    MicroSecondDelay (50000);
+  }
+
+  SbLog ("=M3 probe done: cores 1..3 ran and powered off again");
+}
--- /dev/null
+++ b/Platform/Star2LtePkg/Drivers/Star2LteSsdtDxe/PpttBuild.c
@@ -0,0 +1,281 @@
+/** @file
+  PpttBuild: add cache structures to a PPTT that has none (PpttBuild.h).
+
+  ACPI 6.4 section 5.2.29: a processor hierarchy node is type 0 (length 20 + 4 * private
+  resources: flags, parent offset, ACPI processor ID, then the offsets of its private resources);
+  a cache type structure is type 1, 24 bytes, or 28 in table revision 3 (with a cache ID). Flags
+  of a cache: bit 0 size, 1 sets, 2 associativity, 3 allocation type, 4 cache type, 5 write
+  policy, 6 line size, 7 cache ID valid. Attributes: bits 1:0 allocation (0 read, 1 write, 2/3 read+write),
+  bits 3:2 type (0 data, 1 instruction, 2 unified), bit 4 write policy (0 write-back).
+  Layout as Linux's ACPI cacheinfo reads it and ACPI 6.4 describes it: a leaf lists its private
+  (per-core) caches' level 1, each cache points at the next level through "next level of cache",
+  and the caches the cluster's cores share are the cluster node's private resources (they are
+  private to the cluster), also reached from the last per-core level's "next level".
+
+  Copyright (c) 2026, Starbite. SPDX-License-Identifier: GPL-2.0-only
+**/
+
+#include "PpttBuild.h"
+
+#define PB_MAX_NODES  32u
+
+typedef struct {
+  pb_u32    OldOff, NewOff, Flags, OldParent, AcpiId, NumRefs, NewRefs;
+  int       Target;                 // a core of the boot CPU's cluster
+  int       IsCluster;              // the boot CPU's cluster node
+} PB_NODE;
+
+typedef struct {
+  const PB_CACHE    *C;
+  int               Core;           // index into the target cores, -1 = shared
+  pb_u32            Off, Id;
+} PB_OUTCACHE;
+
+static pb_u32 Rd32 (const pb_u8 *p) { return p[0] | (p[1] << 8) | ((pb_u32)p[2] << 16) | ((pb_u32)p[3] << 24); }
+static void Wr32 (pb_u8 *p, pb_u32 v) { p[0] = (pb_u8)v; p[1] = (pb_u8)(v >> 8); p[2] = (pb_u8)(v >> 16); p[3] = (pb_u8)(v >> 24); }
+static void Wr16 (pb_u8 *p, pb_u32 v) { p[0] = (pb_u8)v; p[1] = (pb_u8)(v >> 8); }
+
+//
+// The cache that "next level" of (core, level, kind) points at: the same core's level + 1 if
+// private, else the shared one; unified, or the same kind.
+//
+static pb_u32
+NextOf (const PB_OUTCACHE *Oc, pb_u32 N, int Core, pb_u32 Level, pb_u32 Kind, pb_u32 PrivateLevels)
+{
+  pb_u32  i;
+  int     Want = (Level + 1 <= PrivateLevels) ? Core : -1;
+
+  for (i = 0; i < N; i++) {
+    if ((Oc[i].C->Level == Level + 1) && (Oc[i].Core == Want) &&
+        ((Oc[i].C->Kind == PB_UNIFIED) || (Oc[i].C->Kind == Kind))) {
+      return Oc[i].Off;
+    }
+  }
+  return 0;
+}
+
+pb_u32
+PpttAddCaches (
+  const pb_u8     *In,
+  pb_u32          InLen,
+  const PB_CACHE  *Caches,
+  pb_u32          NumCaches,
+  pb_u32          PrivateLevels,
+  pb_u8           *Out,
+  pb_u32          OutCap,
+  const char      **Why
+  )
+{
+  PB_NODE      Node[PB_MAX_NODES];
+  PB_OUTCACHE  Oc[PB_MAX_NODES * PB_MAX_CACHES];
+  pb_u32       N = 0, NumOc = 0, Off, i, j, k, Rev, CacheLen, Cluster = 0, NumCores = 0, NumL1 = 0, NumShared = 0, Sum, End;
+  int          Found = 0;
+
+  *Why = 0;
+  if ((InLen < 36) || (In[0] != 'P') || (In[1] != 'P') || (In[2] != 'T') || (In[3] != 'T') || (Rd32 (In + 4) != InLen)) {
+    *Why = "not a PPTT";
+    return 0;
+  }
+
+  Rev      = In[8];
+  CacheLen = (Rev >= 3) ? 28u : 24u;
+
+  //
+  // Processor nodes only, none with private resources yet.
+  //
+  for (Off = 36; Off < InLen; Off += In[Off + 1]) {
+    if ((Off + 2 > InLen) || (In[Off + 1] < 20) || (Off + In[Off + 1] > InLen)) {
+      *Why = "bad structure length";
+      return 0;
+    }
+    if (In[Off] != 0) {
+      *Why = "the PPTT already has structures other than processor nodes";
+      return 0;
+    }
+    if (N == PB_MAX_NODES) {
+      *Why = "too many processor nodes";
+      return 0;
+    }
+    Node[N].OldOff    = Off;
+    Node[N].Flags     = Rd32 (In + Off + 4);
+    Node[N].OldParent = Rd32 (In + Off + 8);
+    Node[N].AcpiId    = Rd32 (In + Off + 12);
+    Node[N].NumRefs   = Rd32 (In + Off + 16);
+    Node[N].Target    = 0;
+    Node[N].IsCluster = 0;
+    Node[N].NewRefs   = 0;
+    if ((Node[N].NumRefs != 0) || (In[Off + 1] != 20)) {
+      *Why = "processor nodes already have private resources";
+      return 0;
+    }
+    N++;
+  }
+
+  //
+  // The boot CPU's cluster: the parent of the leaf (flags bit 3) whose valid ACPI ID (bit 1) is 0.
+  //
+  for (i = 0; i < N; i++) {
+    if ((Node[i].Flags & 0x8u) && (Node[i].Flags & 0x2u) && (Node[i].AcpiId == 0)) {
+      Cluster = Node[i].OldParent;
+      Found   = 1;
+    }
+  }
+  if (!Found || (Cluster == 0)) {
+    *Why = "no leaf with ACPI processor ID 0 under a cluster";
+    return 0;
+  }
+  for (i = 0; i < N; i++) {
+    if ((Node[i].Flags & 0x8u) && (Node[i].Flags & 0x2u) && (Node[i].OldParent == Cluster)) {
+      Node[i].Target = (int)++NumCores;          // 1-based core number
+    }
+    if (Node[i].OldOff == Cluster) {
+      Node[i].IsCluster = 1;
+    }
+  }
+
+  //
+  // The caches must make sense: levels 1..7, line 16..2048 and a power of two, sets and ways set.
+  //
+  if ((NumCaches == 0) || (NumCaches > PB_MAX_CACHES)) {
+    *Why = "no or too many caches";
+    return 0;
+  }
+  if ((PrivateLevels < 1) || (PrivateLevels > 7)) {
+    *Why = "the per-core levels must be 1..7";
+    return 0;
+  }
+  for (j = 0; j < NumCaches; j++) {
+    const PB_CACHE  *C = &Caches[j];
+    if ((C->Level < 1) || (C->Level > 7) || (C->Kind > PB_UNIFIED) || (C->LineSize < 16) || (C->LineSize > 2048) ||
+        (C->LineSize & (C->LineSize - 1)) || (C->Sets == 0) || (C->Ways == 0) || (C->Ways > 255) ||
+        ((unsigned long long)C->LineSize * C->Sets * C->Ways > 0x4000000ull)) {
+      *Why = "implausible cache geometry";
+      return 0;
+    }
+    if (C->Level == 1) {
+      NumL1++;
+    }
+    if (C->Level > PrivateLevels) {
+      NumShared++;
+    }
+  }
+  if (NumL1 == 0) {
+    *Why = "no level-1 cache";
+    return 0;
+  }
+
+  //
+  // Layout: the header, the processor nodes (target leaves grow by one reference per level-1
+  // cache, the cluster by one per shared cache), then per target core its private caches, then
+  // the shared ones.
+  //
+  Off = 36;
+  for (i = 0; i < N; i++) {
+    Node[i].NewRefs = Node[i].Target ? NumL1 : (Node[i].IsCluster ? NumShared : 0);
+    Node[i].NewOff  = Off;
+    Off            += 20 + 4 * Node[i].NewRefs;
+    if (20 + 4 * Node[i].NewRefs > 255) {
+      *Why = "a processor node would be too long";
+      return 0;
+    }
+  }
+  for (k = 1; k <= NumCores; k++) {
+    for (j = 0; j < NumCaches; j++) {
+      if (Caches[j].Level <= PrivateLevels) {
+        Oc[NumOc].C    = &Caches[j];
+        Oc[NumOc].Core = (int)k;
+        Oc[NumOc].Off  = Off;
+        Oc[NumOc].Id   = NumOc + 1;
+        NumOc++;
+        Off += CacheLen;
+      }
+    }
+  }
+  for (j = 0; j < NumCaches; j++) {
+    if (Caches[j].Level > PrivateLevels) {
+      Oc[NumOc].C    = &Caches[j];
+      Oc[NumOc].Core = -1;
+      Oc[NumOc].Off  = Off;
+      Oc[NumOc].Id   = NumOc + 1;
+      NumOc++;
+      Off += CacheLen;
+    }
+  }
+  End = Off;
+  if ((End > OutCap) || (End > 0xFFFFu)) {
+    *Why = "output too large";
+    return 0;
+  }
+
+  for (i = 0; i < End; i++) {
+    Out[i] = 0;
+  }
+  for (i = 0; i < 36; i++) {
+    Out[i] = In[i];
+  }
+  Wr32 (Out + 4, End);
+
+  for (i = 0; i < N; i++) {
+    pb_u8   *P      = Out + Node[i].NewOff;
+    pb_u32  Parent  = 0;
+    pb_u32  Refs    = 0;
+
+    for (j = 0; j < N; j++) {
+      if (Node[j].OldOff == Node[i].OldParent) {
+        Parent = Node[j].NewOff;
+      }
+    }
+    if ((Node[i].OldParent != 0) && (Parent == 0)) {
+      *Why = "a parent offset points at no node";
+      return 0;
+    }
+    P[0] = 0;
+    P[1] = (pb_u8)(20 + 4 * Node[i].NewRefs);
+    Wr32 (P + 4, Node[i].Flags);
+    Wr32 (P + 8, Parent);
+    Wr32 (P + 12, Node[i].AcpiId);
+    if (Node[i].Target) {
+      for (k = 0; k < NumOc; k++) {
+        if ((Oc[k].Core == Node[i].Target) && (Oc[k].C->Level == 1)) {
+          Wr32 (P + 20 + 4 * Refs, Oc[k].Off);
+          Refs++;
+        }
+      }
+    }
+    if (Node[i].IsCluster) {
+      for (k = 0; k < NumOc; k++) {
+        if (Oc[k].Core < 0) {
+          Wr32 (P + 20 + 4 * Refs, Oc[k].Off);
+          Refs++;
+        }
+      }
+    }
+    Wr32 (P + 16, Refs);
+  }
+
+  for (k = 0; k < NumOc; k++) {
+    const PB_CACHE  *C = Oc[k].C;
+    pb_u8           *P = Out + Oc[k].Off;
+    pb_u32          Alloc = (C->Kind == PB_INSTRUCTION) ? 0x0u : 0x3u;   // I: read allocate
+
+    P[0] = 1;
+    P[1] = (pb_u8)CacheLen;
+    Wr32 (P + 4, (Rev >= 3) ? 0xFFu : 0x7Fu);
+    Wr32 (P + 8, NextOf (Oc, NumOc, Oc[k].Core, C->Level, C->Kind, PrivateLevels));
+    Wr32 (P + 12, (pb_u32)C->LineSize * C->Sets * C->Ways);
+    Wr32 (P + 16, C->Sets);
+    P[20] = (pb_u8)C->Ways;
+    P[21] = (pb_u8)(Alloc | (C->Kind << 2));   // write-back
+    Wr16 (P + 22, C->LineSize);
+    if (Rev >= 3) {
+      Wr32 (P + 24, Oc[k].Id);
+    }
+  }
+
+  Out[9] = 0;
+  for (Sum = 0, i = 0; i < End; i++) {
+    Sum += Out[i];
+  }
+  Out[9] = (pb_u8)(0x100u - (Sum & 0xFFu));
+  return End;
+}
