@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * s9usb register access (internal). Device memory: every access goes straight to the register,
+ * with the same barriers the loader uses (dmb oshld after reads, dmb oshst before writes).
+ */
+#ifndef S9USB_IO_H
+#define S9USB_IO_H
+#include "s9usb.h"
+
+#if defined(__aarch64__)
+#define S9_DMB_LD() __asm__ volatile("dmb oshld" : : : "memory")
+#define S9_DMB_ST() __asm__ volatile("dmb oshst" : : : "memory")
+#define S9_DSB()    __asm__ volatile("dsb sy" : : : "memory")
+#else
+#define S9_DMB_LD() __asm__ volatile("" : : : "memory")
+#define S9_DMB_ST() __asm__ volatile("" : : : "memory")
+#define S9_DSB()    __asm__ volatile("" : : : "memory")
+#endif
+
+static inline uint32_t s9_rd(const struct s9usb_plat *p, enum s9usb_blk b, uint32_t off)
+{
+    uint32_t v = *(volatile uint32_t *)(p->base[b] + off);
+    S9_DMB_LD();
+    return v;
+}
+
+static inline void s9_wr(const struct s9usb_plat *p, enum s9usb_blk b, uint32_t off, uint32_t v)
+{
+    S9_DMB_ST();
+    *(volatile uint32_t *)(p->base[b] + off) = v;
+}
+
+static inline void s9_rmw(const struct s9usb_plat *p, enum s9usb_blk b, uint32_t off,
+                          uint32_t clear, uint32_t set)
+{
+    s9_wr(p, b, off, (s9_rd(p, b, off) & ~clear) | set);
+}
+
+/* poll until (reg & mask) == want, at most `us` microseconds (1 us steps). 1 on success. */
+static inline int s9_wait(const struct s9usb_plat *p, enum s9usb_blk b, uint32_t off,
+                          uint32_t mask, uint32_t want, unsigned us)
+{
+    for (unsigned i = 0; i <= us; ++i) {
+        if ((s9_rd(p, b, off) & mask) == want)
+            return 1;
+        p->udelay(1);
+    }
+    return 0;
+}
+
+#endif
--- /dev/null
+++ b/Platform/Star2LtePkg/Drivers/Star2LteUsbDxe/s9usb/s9usb_max77705.c
@@ -0,0 +1,238 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * s9usb: the MAX77705's Type-C MCU ("USBC", I2C 0x25) over HSI2C 0x14360000 (USI_CMGP03).
+ *
+ * The bus code and the opcode protocol are starbite/utility/max77705_muic.c (EngineerMode's
+ * HSI2C driver; proven in the loader and the Utility OS) with the registers reached through
+ * struct s9usb_plat. Opcode protocol: opcode + data into AP_DATAOUT0.. (0x21..), a write to
+ * AP_DATAOUT32 (0x41) ends the command, the answer is in AP_DATAIN0.. (0x51..). CONTROL1 =
+ * COM_USB (0x09) puts D+/D- on the AP (Samsung's MUIC com_to_usb_ap); opcode 0x54 is the MCU's
+ * own VBUS control (Samsung's max77705_usbc_{en,dis}able_auto_vbus: 0x02 on, 0x00 off).
+ * Never reads the clear-on-read interrupt registers (0x02..0x05).
+ */
+#include "s9usb_io.h"
+
+#define A_USBC 0x25U
+
+#define R_HW_REV       0x00U
+#define R_FW_REV       0x01U
+#define R_USBC_STATUS1 0x06U
+#define R_BC_STATUS    0x08U
+#define R_CC_STATUS0   0x0aU
+#define R_AP_DATAOUT0  0x21U
+#define R_AP_DATAOUT32 0x41U
+#define R_AP_DATAIN0   0x51U
+#define OP_CONTROL1_READ  0x05U
+#define OP_CONTROL1_WRITE 0x06U
+#define OP_AUTO_VBUS      0x54U
+#define COM_USB 0x09U
+
+/* HSI2C registers (offsets in S9_HSI2C) */
+#define I2C_CTL        0x00U
+#define I2C_FIFO_CTL   0x04U
+#define I2C_INT_EN     0x20U
+#define I2C_INT_STAT   0x24U
+#define I2C_FIFO_STAT  0x30U
+#define I2C_TX_DATA    0x34U
+#define I2C_RX_DATA    0x38U
+#define I2C_CONF       0x40U
+#define I2C_AUTO_CONF  0x44U
+#define I2C_TIMEOUT    0x48U
+#define I2C_TRANS_STAT 0x50U
+#define I2C_TIMING1    0x60U
+#define I2C_TIMING2    0x64U
+#define I2C_TIMING3    0x68U
+#define I2C_ADDR       0x70U
+#define I2C_USI_CON    0xc4U
+
+static void bus_reset(const struct s9usb_plat *p, const struct s9usb_max *m)
+{
+    const enum s9usb_blk b = S9_HSI2C;
+    s9_wr(p, b, I2C_INT_EN, 0);
+    s9_wr(p, b, I2C_USI_CON, 0);
+    s9_rmw(p, b, I2C_CTL, 0, 0x80000000U);
+    s9_rmw(p, b, I2C_CTL, 0x80000000U, 0);
+    s9_wr(p, b, I2C_TIMING3, m->fs[2]);
+    s9_wr(p, b, I2C_TIMING2, m->fs[1]);
+    s9_wr(p, b, I2C_TIMING1, m->fs[0]);
+    s9_wr(p, b, I2C_CTL, 0x8U);
+    s9_wr(p, b, 0x08U, 0x00ffffffU);
+    s9_rmw(p, b, I2C_TIMEOUT, 0x80000000U, 0);
+    s9_rmw(p, b, I2C_CONF, 0, 0x80000000U);
+    s9_wr(p, b, I2C_INT_STAT, s9_rd(p, b, I2C_INT_STAT) & 0xfffU);
+}
+
+/* One auto-mode message (count <= 32), with or without STOP (EngineerMode's bi_msg). */
+static int msg(const struct s9usb_plat *p, struct s9usb_max *m, unsigned addr, int receive,
+               uint8_t *bytes, unsigned count, int stop)
+{
+    const enum s9usb_blk b = S9_HSI2C;
+    int xfer_done = 0;
+    unsigned done = 0, settle = 0;
+    unsigned trig = count < 8 ? count : 8;
+
+    s9_wr(p, b, I2C_FIFO_CTL, 3U | (trig << 4) | (trig << 16));
+    s9_wr(p, b, I2C_ADDR, addr << 10);
+    s9_wr(p, b, I2C_CTL, 0x8U | (receive ? 0x40U : 0x80U));
+    s9_wr(p, b, I2C_INT_EN, 0x80U);
+    s9_wr(p, b, I2C_AUTO_CONF, count | (receive ? 0x10000U : 0) | (stop ? 0x20000U : 0));
+    s9_rmw(p, b, I2C_AUTO_CONF, 0, 0x80000000U);
+    for (unsigned us = 0; us < 50000; ++us) {
+        uint32_t irq = s9_rd(p, b, I2C_INT_STAT);
+        if (irq)
+            s9_wr(p, b, I2C_INT_STAT, irq);
+        if (irq & 0xf00U)
+            break;
+        if (irq & 0x80U)
+            xfer_done = 1;
+        if (receive) {
+            while (done < count && !(s9_rd(p, b, I2C_FIFO_STAT) & (1U << 24)))
+                bytes[done++] = (uint8_t)s9_rd(p, b, I2C_RX_DATA);
+        } else {
+            while (done < count && !(s9_rd(p, b, I2C_FIFO_STAT) & (1U << 7)))
+                s9_wr(p, b, I2C_TX_DATA, bytes[done++]);
+        }
+        if (!receive && !stop && done == count && (s9_rd(p, b, I2C_FIFO_STAT) & (1U << 8)))
+            ++settle;
+        if (done == count && (xfer_done || (receive && stop) || settle > 200)) {
+            s9_wr(p, b, I2C_INT_EN, 0);
+            if (!stop)
+                return 1;
+            for (unsigned n = 0; n < 10000; ++n) {
+                if (!(s9_rd(p, b, I2C_TRANS_STAT) & (1U << 17)))
+                    return 1;
+                p->udelay(1);
+            }
+            break;
+        }
+        p->udelay(1);
+    }
+    s9_wr(p, b, I2C_INT_EN, 0);
+    bus_reset(p, m);
+    ++m->errors;
+    return 0;
+}
+
+static int i2c_read(const struct s9usb_plat *p, struct s9usb_max *m, uint8_t reg, uint8_t *data,
+                    unsigned len)
+{
+    for (unsigned a = 0; a < 2; ++a) {
+        if (msg(p, m, A_USBC, 0, &reg, 1, 0) && msg(p, m, A_USBC, 1, data, len, 1))
+            return 1;
+        bus_reset(p, m);
+        if (msg(p, m, A_USBC, 0, &reg, 1, 1) && msg(p, m, A_USBC, 1, data, len, 1))
+            return 1;
+        bus_reset(p, m);
+        p->udelay(300);
+    }
+    return 0;
+}
+
+/* reg, then n data bytes, one message with STOP */
+static int i2c_write(const struct s9usb_plat *p, struct s9usb_max *m, uint8_t reg,
+                     const uint8_t *data, unsigned n)
+{
+    uint8_t buf[33];
+    if (n > 32)
+        return 0;
+    buf[0] = reg;
+    for (unsigned i = 0; i < n; ++i)
+        buf[1 + i] = data[i];
+    for (unsigned a = 0; a < 2; ++a) {
+        if (msg(p, m, A_USBC, 0, buf, n + 1, 1))
+            return 1;
+        p->udelay(300);
+    }
+    return 0;
+}
+
+int s9usb_max_init(const struct s9usb_plat *p, struct s9usb_max *m)
+{
+    /* CMU_CMGP gates (MANUAL + CG_VAL) and QCH for USI_CMGP03, USI mode I2C, GPM14/15 as I2C,
+     * pulls off (EngineerMode's em.c, the loader's max77705_muic.c) */
+    static const uint16_t gates[4] = { 0x2014, 0x2074, 0x20a8, 0x20ac };
+    for (unsigned i = 0; i < 4; ++i)
+        s9_rmw(p, S9_CMU_CMGP, gates[i], 0, 0x00300000U);
+    s9_rmw(p, S9_CMU_CMGP, 0x3050U, 0, 3U);
+    s9_wr(p, S9_SYSREG_CMGP, 0x2030U, 4U);
+    for (uint32_t g = 0x180U; g <= 0x1a0U; g += 0x20U) {
+        s9_rmw(p, S9_GPIO_CMGP, g, 0xfU, 0x2U);
+        s9_rmw(p, S9_GPIO_CMGP, g + 8U, 0xfU, 0);
+    }
+    S9_DSB();
+    if (!m->bus) {
+        /* S-Boot's timing, or 400 kHz at the 200 MHz source when it left none */
+        m->fs[0] = s9_rd(p, S9_HSI2C, I2C_TIMING1);
+        m->fs[1] = s9_rd(p, S9_HSI2C, I2C_TIMING2);
+        m->fs[2] = s9_rd(p, S9_HSI2C, I2C_TIMING3);
+        if (!((m->fs[2] >> 16) & 0xffU)) {
+            m->fs[2] = (m->fs[2] & ~0x00ff0000U) | (0x21U << 16);
+            m->fs[1] = (m->fs[1] & ~0xffU) | 0xe0U;
+            m->fs[0] = (m->fs[0] & ~0x00ff0000U) | (0xf0U << 16);
+        }
+    }
+    bus_reset(p, m);
+    m->bus = i2c_read(p, m, R_HW_REV, &m->hw, 1) ? 1 : -1;
+    if (m->bus > 0)
+        (void)i2c_read(p, m, R_FW_REV, &m->fw, 1);
+    m->ctrl1 = -1;
+    return m->bus > 0;
+}
+
+int s9usb_max_status(const struct s9usb_plat *p, struct s9usb_max *m)
+{
+    if (m->bus <= 0)
+        return 0;
+    return i2c_read(p, m, R_USBC_STATUS1, &m->usbc1, 1) && i2c_read(p, m, R_BC_STATUS, &m->bc, 1) &&
+           i2c_read(p, m, R_CC_STATUS0, &m->cc0, 1);
+}
+
+/* max77705_i2c_opcode_write(): opcode + data, then the end marker */
+static int opcode_write(const struct s9usb_plat *p, struct s9usb_max *m, uint8_t op,
+                        const uint8_t *data, unsigned n)
+{
+    uint8_t buf[4];
+    uint8_t z = 0;
+    buf[0] = op;
+    for (unsigned i = 0; i < n && i < 3; ++i)
+        buf[1 + i] = data[i];
+    if (!i2c_write(p, m, R_AP_DATAOUT0, buf, 1 + (n < 3 ? n : 3)))
+        return 0;
+    return i2c_write(p, m, R_AP_DATAOUT32, &z, 1);
+}
+
+/* the answer to `op` (AP_DATAIN0 echoes the opcode), polled for 100 ms */
+static int opcode_answer(const struct s9usb_plat *p, struct s9usb_max *m, uint8_t op)
+{
+    for (unsigned i = 0; i < 10; ++i) {
+        p->udelay(10000);
+        if (i2c_read(p, m, R_AP_DATAIN0, m->answer, 4) && m->answer[0] == op)
+            return 1;
+    }
+    return 0;
+}
+
+int s9usb_max_route_usb(const struct s9usb_plat *p, struct s9usb_max *m)
+{
+    uint8_t v = COM_USB;
+    if (m->bus <= 0)
+        return 0;
+    for (unsigned a = 0; a < 4; ++a) {
+        if (opcode_write(p, m, OP_CONTROL1_WRITE, &v, 1)) {
+            p->udelay(50000);
+            m->ctrl1 = (opcode_write(p, m, OP_CONTROL1_READ, 0, 0) &&
+                        opcode_answer(p, m, OP_CONTROL1_READ)) ? m->answer[1] : -1;
+            if (m->ctrl1 == COM_USB)
+                return 1;
+        }
+        p->udelay(200000);
+    }
+    return 0;
+}
+
+int s9usb_max_auto_vbus(const struct s9usb_plat *p, struct s9usb_max *m, int on)
+{
+    uint8_t v = on ? 0x02U : 0x00U;
+    if (m->bus <= 0)
+        return 0;
+    return opcode_write(p, m, OP_AUTO_VBUS, &v, 1) && opcode_answer(p, m, OP_AUTO_VBUS);
+}
--- /dev/null
+++ b/Platform/Star2LtePkg/Drivers/Star2LteUsbDxe/s9usb/s9usb_phy.c
@@ -0,0 +1,216 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * s9usb: USB clocks, PMU isolation and the USB 2.0 PHY (USBCON 0x11100000) of the Exynos 9810.
+ *
+ * The enable sequence is starbite/utility/usb_phy.c usb_phy_start() step for step (Samsung's CAL
+ * phy_exynos_usb_v3p1_enable() for EXYNOS_USBCON_VER_03_0_0, as our Linux driver
+ * tools/linux/port/src/usb/phy-exynos9810-usbdrd.c runs it; woa's UsbDebugHid.c UsbEnablePhy,
+ * BSD-2-Clause-Patent, does the same steps). The only change is the last part: instead of always
+ * the device column, the role's column (docs/WIN11-USB.md 3.2):
+ *   device: VBUS/BVALID forced valid (the board has no VBUS pad), external VBUS-valid selected,
+ *           stock device tuning
+ *   host:   CAL phy_exynos_usb_v3p1_config_host_mode(): the forces off, the 15k DP/DM
+ *           pull-downs on; external VBUS-valid off; stock host tuning
+ * Tuning: stock exynos9810-starlte_common.dtsi usb_hs_tune, tune_value = <device host>.
+ */
+#include "s9usb_io.h"
+
+const uintptr_t s9usb_phys[S9_NBLK] = {
+    [S9_DWC] = 0x10c00000UL,     [S9_USBCON] = 0x11100000UL,   [S9_CMU_TOP] = 0x1a240000UL,
+    [S9_CMU_FSYS0] = 0x11000000UL, [S9_PMU] = 0x14060000UL,    [S9_HSI2C] = 0x14360000UL,
+    [S9_CMU_CMGP] = 0x14200000UL, [S9_SYSREG_CMGP] = 0x14210000UL, [S9_GPIO_CMGP] = 0x14220000UL,
+};
+const uint32_t s9usb_size[S9_NBLK] = {
+    [S9_DWC] = 0x10000U,  [S9_USBCON] = 0x1000U, [S9_CMU_TOP] = 0x3000U, [S9_CMU_FSYS0] = 0x4000U,
+    [S9_PMU] = 0x1000U,   [S9_HSI2C] = 0x1000U,  [S9_CMU_CMGP] = 0x4000U, [S9_SYSREG_CMGP] = 0x3000U,
+    [S9_GPIO_CMGP] = 0x1000U,
+};
+
+#define LINK_CTRL     0x04U
+#define  LC_PIPE3_FORCE_RX_ELEC_IDLE (1U << 18)
+#define  LC_PIPE3_FORCE_PHY_STATUS   (1U << 17)
+#define  LC_PIPE3_FORCE_EN           (1U << 16)
+#define  LC_DIS_QACT_LINKGATE        (1U << 12)
+#define  LC_DIS_QACT_ID0             (1U << 11)
+#define  LC_DIS_QACT_VBUS_VALID      (1U << 10)
+#define  LC_DIS_QACT_BVALID          (1U << 9)
+#define  LC_FORCE_QACT               (1U << 8)
+#define  LC_BUS_FILTER_BYPASS        (0xfU << 4)
+#define LINK_PORT     0x08U
+#define  LP_HUB_PORT_SEL_OCD_U3      (1U << 3)
+#define  LP_HUB_PORT_SEL_OCD_U2      (1U << 2)
+#define CLKRST        0x20U
+#define  CR_PHY_SW_RST               (1U << 3)
+#define  CR_PHY_RST_SEL              (1U << 2)
+#define  CR_PORT_RST                 (1U << 1)
+#define  CR_LINK_SW_RST              (1U << 0)
+#define COMBO_PMA     0x48U
+#define  PMA_LOW_PWRN                (1U << 4)
+#define UTMI          0x50U
+#define  UTMI_FORCE_VBUSVALID        (1U << 5)
+#define  UTMI_FORCE_BVALID           (1U << 4)
+#define  UTMI_DP_PULLDOWN            (1U << 3)
+#define  UTMI_DM_PULLDOWN            (1U << 2)
+#define  UTMI_FORCE_SUSPEND          (1U << 1)
+#define  UTMI_FORCE_SLEEP            (1U << 0)
+#define HSP           0x54U
+#define  HSP_VBUSVLDEXTSEL           (1U << 13)
+#define  HSP_VBUSVLDEXT              (1U << 12)
+#define  HSP_EN_UTMISUSPEND          (1U << 9)
+#define  HSP_COMMONONN               (1U << 8)
+#define HSP_TUNE      0x58U
+#define HSP_TEST      0x5cU
+#define  HSP_TEST_SIDDQ              (1U << 24)
+#define REWA_ENABLE   0x100U
+#define HSREWA_CTRL   0x108U
+#define HSREWA_REFTO  0x10cU
+#define HSREWA_HSTK   0x110U
+#define HSREWA_INT1_MASK 0x11cU
+
+/* HSP_TUNE: tx_vref [31:28], tx_rise [25:24], tx_res [22:21], tx_pre_emp [19:18],
+ * rx_sqrx [10:8], compdis [2:0] */
+#define TUNE(vref, rise, res, pre, sqrx, comp) \
+    (((vref) << 28) | ((rise) << 24) | ((res) << 21) | ((pre) << 18) | ((sqrx) << 8) | (comp))
+#define TUNE_MASK   TUNE(0xfU, 0x3U, 0x3U, 0x3U, 0x7U, 0x7U)
+#define TUNE_DEVICE TUNE(0xdU, 1U, 3U, 3U, 4U, 3U)
+#define TUNE_HOST   TUNE(0x7U, 1U, 1U, 3U, 6U, 7U)
+
+/* the role column (docs/WIN11-USB.md 3.2) */
+#define UTMI_ROLE_BITS (UTMI_FORCE_VBUSVALID | UTMI_FORCE_BVALID | UTMI_DP_PULLDOWN | UTMI_DM_PULLDOWN)
+#define UTMI_DEVICE    (UTMI_FORCE_VBUSVALID | UTMI_FORCE_BVALID)
+#define UTMI_HOST      (UTMI_DP_PULLDOWN | UTMI_DM_PULLDOWN)
+#define HSP_ROLE_BITS  (HSP_VBUSVLDEXTSEL | HSP_VBUSVLDEXT)
+
+/* CMU_TOP / CMU_FSYS0 / PMU offsets */
+#define TOP_MUX_USB30DRD   0x1060U
+#define TOP_DIV_USB30DRD   0x1858U
+#define TOP_GATE_USB30DRD  0x2064U
+#define FSYS0_MUX          0x01e0U
+#define FSYS0_MUX_AUTOGATE 0x0228U
+#define FSYS0_GATE_REF     0x206cU
+#define FSYS0_GATE_DPPHY   0x2008U
+#define FSYS0_QCH_CMU      0x3000U
+#define PMU_USB20_PHY      0x072cU
+#define PMU_USB3DP_PHY     0x0704U
+#define GATE_MANUAL_CGVAL  ((1U << 20) | (1U << 21))
+
+void s9usb_clocks_on(const struct s9usb_plat *p)
+{
+    s9_rmw(p, S9_CMU_TOP, TOP_GATE_USB30DRD, 0, GATE_MANUAL_CGVAL);
+    s9_rmw(p, S9_CMU_FSYS0, FSYS0_GATE_REF, 0, GATE_MANUAL_CGVAL);
+    s9_rmw(p, S9_CMU_FSYS0, FSYS0_GATE_DPPHY, 0, GATE_MANUAL_CGVAL);
+    s9_rmw(p, S9_PMU, PMU_USB20_PHY, 0, 1U);
+    s9_rmw(p, S9_PMU, PMU_USB3DP_PHY, 0, 1U);
+    S9_DSB();
+    p->udelay(10);
+}
+
+/* exynos_cal_usbphy_q_ch(enable): the Q-channel forced active, with the vendor's delays */
+static void q_ch_on(const struct s9usb_plat *p)
+{
+    uint32_t v = s9_rd(p, S9_USBCON, LINK_CTRL);
+    v |= LC_DIS_QACT_ID0 | LC_DIS_QACT_VBUS_VALID | LC_DIS_QACT_BVALID | LC_DIS_QACT_LINKGATE;
+    v &= ~LC_FORCE_QACT;
+    p->udelay(500);
+    s9_wr(p, S9_USBCON, LINK_CTRL, v);
+    p->udelay(500);
+    v = s9_rd(p, S9_USBCON, LINK_CTRL) | LC_FORCE_QACT;
+    p->udelay(500);
+    s9_wr(p, S9_USBCON, LINK_CTRL, v);
+}
+
+void s9usb_phy_set_role(const struct s9usb_plat *p, enum s9usb_role role)
+{
+    if (role == S9USB_HOST) {
+        s9_rmw(p, S9_USBCON, UTMI, UTMI_ROLE_BITS, UTMI_HOST);
+        s9_rmw(p, S9_USBCON, HSP, HSP_ROLE_BITS, 0);
+        s9_rmw(p, S9_USBCON, HSP_TUNE, TUNE_MASK, TUNE_HOST);
+    } else {
+        s9_rmw(p, S9_USBCON, UTMI, UTMI_ROLE_BITS, UTMI_DEVICE);
+        s9_rmw(p, S9_USBCON, HSP, HSP_ROLE_BITS, HSP_ROLE_BITS);
+        s9_rmw(p, S9_USBCON, HSP_TUNE, TUNE_MASK, TUNE_DEVICE);
+    }
+    S9_DSB();
+}
+
+int s9usb_phy_init(const struct s9usb_plat *p, enum s9usb_role role, const char **why)
+{
+    const enum s9usb_blk r = S9_USBCON;
+
+    /* phy_exynos_usb_v3p1_enable(), VER_03_0_0 */
+    q_ch_on(p);
+    s9_rmw(p, r, CLKRST, 0, CR_LINK_SW_RST);                          /* link reset */
+    p->udelay(10);
+    s9_rmw(p, r, CLKRST, CR_LINK_SW_RST, 0);
+    s9_rmw(p, r, CLKRST, 0, CR_PHY_SW_RST | CR_PHY_RST_SEL);          /* PHY reset high */
+    s9_rmw(p, r, HSP_TEST, HSP_TEST_SIDDQ, 0);                        /* PHY power: SIDDQ off */
+    s9_rmw(p, r, UTMI, UTMI_FORCE_SUSPEND | UTMI_FORCE_SLEEP | UTMI_DP_PULLDOWN | UTMI_DM_PULLDOWN, 0);
+    s9_rmw(p, r, HSP, 0, HSP_EN_UTMISUSPEND | HSP_COMMONONN);         /* common_block_disable = 1 */
+    p->udelay(100);
+    s9_rmw(p, r, CLKRST, CR_PHY_SW_RST | CR_PORT_RST, CR_PHY_RST_SEL); /* PHY reset low */
+    s9_rmw(p, r, LINK_CTRL, 0, LC_BUS_FILTER_BYPASS);                 /* no VBUS pad on this board */
+    s9_rmw(p, r, LINK_PORT, 0, LP_HUB_PORT_SEL_OCD_U3 | LP_HUB_PORT_SEL_OCD_U2);
+    /* phy_exynos_usb3p1_rewa_ready(): ReWA parked */
+    s9_rmw(p, r, REWA_ENABLE, 1U, 0);
+    s9_rmw(p, r, HSREWA_CTRL, 1U << 24, 1U << 28);
+    s9_wr(p, r, HSREWA_HSTK, 0x1U);
+    s9_wr(p, r, HSREWA_REFTO, 0xff00U);
+    s9_rmw(p, r, HSREWA_INT1_MASK, 0, (1U << 18) | (1U << 17) | (1U << 16) | 7U);
+    /* phy_exynos_usb_v3p1_pipe_ovrd(): the USB3 side forced idle, its PMA powered down */
+    s9_rmw(p, r, LINK_CTRL, LC_PIPE3_FORCE_PHY_STATUS, LC_PIPE3_FORCE_EN | LC_PIPE3_FORCE_RX_ELEC_IDLE);
+    s9_rmw(p, r, COMBO_PMA, 0, PMA_LOW_PWRN);
+    /* the role: VBUS sensing, pull-downs, tuning */
+    s9usb_phy_set_role(p, role);
+    p->udelay(100);
+
+    if (s9_rd(p, r, HSP_TEST) & HSP_TEST_SIDDQ) {
+        *why = "USBCON: the PHY stayed in SIDDQ";
+        return -1;
+    }
+    if ((s9_rd(p, r, UTMI) & UTMI_ROLE_BITS) != (role == S9USB_HOST ? UTMI_HOST : UTMI_DEVICE)) {
+        *why = "USBCON: the UTMI role bits did not stick";
+        return -1;
+    }
+    *why = 0;
+    return 0;
+}
+
+const char *s9usb_phy_line(const struct s9usb_plat *p)
+{
+    unsigned ls = (s9_rd(p, S9_USBCON, HSP_TEST) >> 20) & 3U;   /* HSP_TEST LINESTATE */
+    return ls == 0 ? "SE0" : ls == 1 ? "J" : ls == 2 ? "K" : "SE1";
+}
+
+static const struct { enum s9usb_blk b; uint16_t off; const char *name; } snap[S9USB_SNAP_N] = {
+    { S9_CMU_TOP, TOP_MUX_USB30DRD, "top.mux" },
+    { S9_CMU_TOP, TOP_DIV_USB30DRD, "top.div" },
+    { S9_CMU_TOP, TOP_GATE_USB30DRD, "top.gate" },
+    { S9_CMU_FSYS0, FSYS0_MUX, "fsys0.mux" },
+    { S9_CMU_FSYS0, FSYS0_MUX_AUTOGATE, "fsys0.mux_ag" },
+    { S9_CMU_FSYS0, FSYS0_GATE_REF, "fsys0.ref_gate" },
+    { S9_CMU_FSYS0, FSYS0_GATE_DPPHY, "fsys0.dpphy_gate" },
+    { S9_CMU_FSYS0, FSYS0_QCH_CMU, "qch.cmu" },
+    { S9_CMU_FSYS0, 0x304cU, "qch.ctrl" },
+    { S9_CMU_FSYS0, 0x3050U, "qch.link" },
+    { S9_CMU_FSYS0, 0x3054U, "qch.phy" },
+    { S9_CMU_FSYS0, 0x3058U, "qch.pcs" },
+    { S9_PMU, PMU_USB20_PHY, "pmu.usb20" },
+    { S9_PMU, PMU_USB3DP_PHY, "pmu.usb3dp" },
+    { S9_USBCON, 0x00U, "usbcon.ver" },
+    { S9_USBCON, LINK_CTRL, "usbcon.link" },
+    { S9_USBCON, CLKRST, "usbcon.clkrst" },
+    { S9_USBCON, UTMI, "usbcon.utmi" },
+    { S9_USBCON, HSP, "usbcon.hsp" },
+    { S9_USBCON, HSP_TUNE, "usbcon.hsp_tune" },
+    { S9_USBCON, HSP_TEST, "usbcon.hsp_test" },
+};
+
+void s9usb_snapshot(const struct s9usb_plat *p, uint32_t *out, unsigned n)
+{
+    for (unsigned i = 0; i < n && i < S9USB_SNAP_N; ++i)
+        out[i] = s9_rd(p, snap[i].b, snap[i].off);
+}
+
+const char *s9usb_snap_name(unsigned i)
+{
+    return i < S9USB_SNAP_N ? snap[i].name : "?";
+}
