+  for (i = 0; i < N; i++) {
+    if ((Oc[i].C->Level == Level + 1) && (Oc[i].Core == Want) &&
+        ((Oc[i].C->Kind == PB_UNIFIED) || (Oc[i].C->Kind == Kind))) {
+      return Oc[i].Off;
+    }
+  }
+  return 0;
+}
