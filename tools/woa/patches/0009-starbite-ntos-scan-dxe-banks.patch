 #define STAR2LTE_NTOS_SCAN_BASE   0x0000000090000000ULL
 #define STAR2LTE_NTOS_SCAN_LIMIT  0x00000000BC800000ULL
 #define STAR2LTE_NTOS_MAX_IMAGE_SIZE  0x08000000u
+//
+// Starbite: the ntoskrnl scan covered only PEI DRAM (0x90000000..0xBC800000), where star2lte's
+// winload put the kernel (0x92400000). On the S9 the kernel is elsewhere (pstore-win5: 0x1c images
+// listed, all <= 0x72000 bytes), so also scan the two banks Star2LteRamManagerDxe adds.
+//
+STATIC CONST UINT64  mStarbiteNtosScan[][2] = {
+  { 0x0000000090000000ULL, 0x00000000BC800000ULL },
+  { 0x00000000C0080000ULL, 0x00000000CC000000ULL },
+  { 0x00000000CD044000ULL, 0x00000000E0000000ULL },
+};
+
+STATIC
+BOOLEAN
+StarbiteInNtosScan (
+  IN UINT64  Base,
+  IN UINT64  End
+  )
+{
+  UINTN  Index;
+
+  for (Index = 0; Index < ARRAY_SIZE (mStarbiteNtosScan); Index++) {
+    if ((Base >= mStarbiteNtosScan[Index][0]) && (End <= mStarbiteNtosScan[Index][1]) && (Base < End)) {
+      return TRUE;
+    }
+  }
+  return FALSE;
+}
