 //
+// Starbite: find winload's image from an address inside it (the GetMemoryMap hook's caller)
+// and set mStarbiteWlDelta. Only the exact star2lte binary (SizeOfImage 0x266000) is accepted.
+//
+STATIC
+VOID
+StarbiteFindWinload (
+  IN UINT64  Ra
+  )
+{
+  UINT64  P;
+  UINTN   Size;
+
+  mStarbiteWlOk = FALSE;
+  for (P = Ra & ~(UINT64)EFI_PAGE_MASK; (P >= 0x0000000090000000ULL) && (P + 0x00400000ULL > Ra); P -= EFI_PAGE_SIZE) {
+    if (Star2LteGetPeImageSize (P, &Size) && (P + Size > Ra)) {
+      BdsPramStr ("\n=WLBASE b=");
+      BdsPramHex ((UINT32)P, 8);
+      BdsPramStr (" s=");
+      BdsPramHex ((UINT32)Size, 8);
+      if (Size == STARBITE_WINLOAD_SIZE) {
+        mStarbiteWlDelta = (INT64)(P - STARBITE_WINLOAD_STAR2LTE_BASE);
+        mStarbiteWlOk    = TRUE;
+        BdsPramStr (" ok");
+      }
+      return;
+    }
+  }
+  BdsPramStr ("\n=WLBASE none");
+}
