+/* Starbite: breadcrumb into the ramoops pmsg ring (0xFED14000, "DBGC"),
+   read from TWRP /sys/fs/pstore/pmsg-ramoops-0. Physical == virtual here. */
+static inline void StarbiteCrumb (char C)
+{
+  volatile unsigned int   *W = (volatile unsigned int *)(unsigned long)0xFED14000UL;
+  volatile unsigned char  *B = (volatile unsigned char *)(unsigned long)0xFED14000UL;
+  unsigned int            S;
+  if (W[0] != 0x43474244u) { W[0] = 0x43474244u; W[1] = 0u; W[2] = 0u; }
+  S = W[2];
+  if (S < 0x3F00u) { B[12u + S] = (unsigned char)C; W[2] = S + 1u; }
+  __asm__ __volatile__ ("dsb sy" ::: "memory");
+}
+
+/* Starbite: catch-all exception vectors for the MMU bring-up. Any exception
+   logs "X" + ESR, ELR, FAR, SPSR into the pmsg ring, then parks the CPU. */
+static void StarbiteHex (unsigned long V)
+{
+  int I;
+  for (I = 60; I >= 0; I -= 4) {
+    StarbiteCrumb ("0123456789abcdef"[(V >> I) & 15]);
+  }
+}
+
+void StarbiteFault (unsigned long Esr, unsigned long Elr, unsigned long Far, unsigned long Spsr)
+{
+  StarbiteCrumb ('\n'); StarbiteCrumb ('X');
+  StarbiteCrumb (' '); StarbiteHex (Esr);
+  StarbiteCrumb (' '); StarbiteHex (Elr);
+  StarbiteCrumb (' '); StarbiteHex (Far);
+  StarbiteCrumb (' '); StarbiteHex (Spsr);
+  StarbiteCrumb ('\n');
+  for (;;) {
+    __asm__ __volatile__ ("wfe");
+  }
+}
+
+__asm__ (
+  ".text\n"
+  ".balign 2048\n"
+  ".globl StarbiteVectors\n"
+  "StarbiteVectors:\n"
+  ".balign 128\n b StarbiteVecEntry\n"
+  ".balign 128\n b StarbiteVecEntry\n"
+  ".balign 128\n b StarbiteVecEntry\n"
+  ".balign 128\n b StarbiteVecEntry\n"
+  ".balign 128\n b StarbiteVecEntry\n"
+  ".balign 128\n b StarbiteVecEntry\n"
+  ".balign 128\n b StarbiteVecEntry\n"
+  ".balign 128\n b StarbiteVecEntry\n"
+  ".balign 128\n b StarbiteVecEntry\n"
+  ".balign 128\n b StarbiteVecEntry\n"
+  ".balign 128\n b StarbiteVecEntry\n"
+  ".balign 128\n b StarbiteVecEntry\n"
+  ".balign 128\n b StarbiteVecEntry\n"
+  ".balign 128\n b StarbiteVecEntry\n"
+  ".balign 128\n b StarbiteVecEntry\n"
+  ".balign 128\n b StarbiteVecEntry\n"
+  "StarbiteVecEntry:\n"
+  " mrs x0, esr_el1\n mrs x1, elr_el1\n mrs x2, far_el1\n mrs x3, spsr_el1\n"
+  " b StarbiteFault\n"
+);
+extern char StarbiteVectors[];
