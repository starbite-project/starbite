diff -ruN a/Platform/Star2LtePkg/Drivers/Star2LteKeysDxe/Star2LteKeysDxe.c b/Platform/Star2LtePkg/Drivers/Star2LteKeysDxe/Star2LteKeysDxe.c
--- a/Platform/Star2LtePkg/Drivers/Star2LteKeysDxe/Star2LteKeysDxe.c	1970-01-01 02:00:00
+++ b/Platform/Star2LtePkg/Drivers/Star2LteKeysDxe/Star2LteKeysDxe.c	2026-11-03 08:12:56
@@ -0,0 +1,339 @@
+/** @file
+  Star2LteKeysDxe: the Galaxy S9's hardware keys as a SimpleTextIn console.
+
+  The phone has no keyboard in UEFI (no USB host stack, touch is not a HID
+  here), so the four keys drive the UEFI Shell through a command palette:
+
+    Volume Down  type the next palette command (ESC clears the line first)
+    Volume Up    type the previous palette command
+    Power        Enter (run it; continue at a "-b" page break or a pause)
+    Bixby        'q' (quit at a "-b" page break)
+
+  Volume keys repeat while held. The palette holds read-only commands only;
+  its last entry is "reset", which returns to the Starbite boot menu.
+
+  Keys (shim/starlte/menu.c keys(), active low): GPIO_ALIVE 0x14050000,
+  GPA0_DAT +0x24 bit 3 Volume Up, bit 4 Volume Down, bit 6 Bixby; GPA2_DAT
+  +0x64 bit 4 Power. The ALIVE page is not in the platform MMU map, so it is
+  added to the GCD as uncached MMIO here.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <Uefi.h>
+#include <Pi/PiDxeCis.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/DxeServicesTableLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/IoLib.h>
+#include <Library/DebugLib.h>
+#include <Protocol/SimpleTextIn.h>
+#include <Protocol/DevicePath.h>
+
+#define ALIVE_GPIO_BASE  0x14050000ULL
+#define ALIVE_GPIO_SIZE  0x1000ULL
+#define GPA0_DAT         (ALIVE_GPIO_BASE + 0x24)
+#define GPA2_DAT         (ALIVE_GPIO_BASE + 0x64)
+
+#define K_UP     BIT0
+#define K_DOWN   BIT1
+#define K_BIXBY  BIT2
+#define K_POWER  BIT3
+
+#define SAMPLE_100NS    (15 * 10000)   // 15 ms
+#define REPEAT_FIRST    34             // samples (~0.5 s) before a held Volume key repeats
+#define REPEAT_EVERY    12             // then every ~180 ms
+
+#define QUEUE_SIZE  256
+
+//
+// Read-only commands; "-b" pages long output (Power continues, Bixby quits).
+//
+STATIC CONST CHAR16  *mPalette[] = {
+  L"ver",
+  L"map -b",
+  L"memmap -b",
+  L"acpiview -l",
+  L"acpiview -s APIC",
+  L"acpiview -s GTDT",
+  L"acpiview -s PPTT",
+  L"acpiview -s FACP",
+  L"acpiview -s DBG2",
+  L"smbiosview -b",
+  L"dmem 0x14050000 0x80",
+  L"drivers -b",
+  L"devtree -b",
+  L"dh -b",
+  L"dmpstore -b",
+  L"ls -b fs0:\\",
+  L"ls -b fs0:\\EFI",
+  L"vol fs0:",
+  L"date",
+  L"time",
+  L"help -b",
+  L"reset"
+};
+
+#define PALETTE_COUNT  (sizeof (mPalette) / sizeof (mPalette[0]))
+
+typedef struct {
+  VENDOR_DEVICE_PATH          Vendor;
+  EFI_DEVICE_PATH_PROTOCOL    End;
+} KEYS_DEVICE_PATH;
+
+STATIC KEYS_DEVICE_PATH  mKeysPath = {
+  {
+    { HARDWARE_DEVICE_PATH, HW_VENDOR_DP, { sizeof (VENDOR_DEVICE_PATH), 0 } },
+    { 0x5b1e5d7a, 0x2c61, 0x4f0b, { 0x9e, 0x2a, 0x53, 0x54, 0x41, 0x52, 0x42, 0x4b } }
+  },
+  { END_DEVICE_PATH_TYPE, END_ENTIRE_DEVICE_PATH_SUBTYPE, { sizeof (EFI_DEVICE_PATH_PROTOCOL), 0 } }
+};
+
+STATIC EFI_SIMPLE_TEXT_INPUT_PROTOCOL  mTextIn;
+STATIC EFI_INPUT_KEY                   mQueue[QUEUE_SIZE];
+STATIC UINTN                           mHead;
+STATIC UINTN                           mTail;
+STATIC UINT32                          mStable;       // debounced key state
+STATIC UINT32                          mLastRaw;
+STATIC UINT32                          mHeld;         // samples the current Volume key has been held
+STATIC INTN                            mPaletteIndex = -1;
+
+STATIC
+UINT32
+RawKeys (
+  VOID
+  )
+{
+  UINT32  A;
+  UINT32  B;
+
+  A = MmioRead32 (GPA0_DAT);
+  B = MmioRead32 (GPA2_DAT);
+  return ((A & BIT3) ? 0 : K_UP) | ((A & BIT4) ? 0 : K_DOWN) |
+         ((A & BIT6) ? 0 : K_BIXBY) | ((B & BIT4) ? 0 : K_POWER);
+}
+
+STATIC
+VOID
+Push (
+  IN UINT16  Scan,
+  IN CHAR16  Char
+  )
+{
+  UINTN  Next;
+
+  Next = (mTail + 1) % QUEUE_SIZE;
+  if (Next == mHead) {
+    return;                       // full: drop
+  }
+
+  mQueue[mTail].ScanCode    = Scan;
+  mQueue[mTail].UnicodeChar = Char;
+  mTail                     = Next;
+}
+
+STATIC
+VOID
+TypePalette (
+  IN INTN  Step
+  )
+{
+  CONST CHAR16  *S;
+
+  if (mPaletteIndex < 0) {
+    mPaletteIndex = (Step > 0) ? 0 : (INTN)PALETTE_COUNT - 1;
+  } else {
+    mPaletteIndex = (mPaletteIndex + Step + (INTN)PALETTE_COUNT) % (INTN)PALETTE_COUNT;
+  }
+
+  Push (SCAN_ESC, CHAR_NULL);     // the shell's line editor clears the line on ESC
+  for (S = mPalette[mPaletteIndex]; *S != L'\0'; S++) {
+    Push (SCAN_NULL, *S);
+  }
+}
+
+STATIC
+VOID
+EFIAPI
+Sample (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  UINT32  Raw;
+  UINT32  Pressed;
+
+  Raw = RawKeys ();
+  if (Raw != mLastRaw) {          // debounce: two equal samples in a row
+    mLastRaw = Raw;
+    return;
+  }
+
+  Pressed = Raw & ~mStable;
+  mStable = Raw;
+
+  if (Pressed & K_DOWN) {
+    TypePalette (1);
+  }
+
+  if (Pressed & K_UP) {
+    TypePalette (-1);
+  }
+
+  if (Pressed & K_POWER) {
+    Push (SCAN_NULL, CHAR_CARRIAGE_RETURN);
+  }
+
+  if (Pressed & K_BIXBY) {
+    Push (SCAN_NULL, L'q');
+  }
+
+  //
+  // Auto-repeat for a single held Volume key.
+  //
+  if ((Raw == K_UP) || (Raw == K_DOWN)) {
+    mHeld++;
+    if ((mHeld >= REPEAT_FIRST) && (((mHeld - REPEAT_FIRST) % REPEAT_EVERY) == 0)) {
+      TypePalette ((Raw == K_DOWN) ? 1 : -1);
+    }
+  } else {
+    mHeld = 0;
+  }
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+KeysReset (
+  IN EFI_SIMPLE_TEXT_INPUT_PROTOCOL  *This,
+  IN BOOLEAN                         ExtendedVerification
+  )
+{
+  EFI_TPL  OldTpl;
+
+  OldTpl = gBS->RaiseTPL (TPL_NOTIFY);
+  mHead  = mTail;
+  gBS->RestoreTPL (OldTpl);
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+KeysRead (
+  IN  EFI_SIMPLE_TEXT_INPUT_PROTOCOL  *This,
+  OUT EFI_INPUT_KEY                   *Key
+  )
+{
+  EFI_TPL     OldTpl;
+  EFI_STATUS  Status;
+
+  if (Key == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  OldTpl = gBS->RaiseTPL (TPL_NOTIFY);
+  if (mHead == mTail) {
+    Status = EFI_NOT_READY;
+  } else {
+    *Key   = mQueue[mHead];
+    mHead  = (mHead + 1) % QUEUE_SIZE;
+    Status = EFI_SUCCESS;
+  }
+
+  gBS->RestoreTPL (OldTpl);
+  return Status;
+}
+
+STATIC
+VOID
+EFIAPI
+KeysWaitNotify (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  if (mHead != mTail) {
+    gBS->SignalEvent (Event);
+  }
+}
+
+STATIC
+EFI_STATUS
+MapAliveGpio (
+  VOID
+  )
+{
+  EFI_GCD_MEMORY_SPACE_DESCRIPTOR  Desc;
+  EFI_STATUS                       Status;
+
+  Status = gDS->GetMemorySpaceDescriptor (ALIVE_GPIO_BASE, &Desc);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  if (Desc.GcdMemoryType == EfiGcdMemoryTypeNonExistent) {
+    Status = gDS->AddMemorySpace (
+                    EfiGcdMemoryTypeMemoryMappedIo,
+                    ALIVE_GPIO_BASE,
+                    ALIVE_GPIO_SIZE,
+                    EFI_MEMORY_UC
+                    );
+    if (EFI_ERROR (Status)) {
+      return Status;
+    }
+  }
+
+  return gDS->SetMemorySpaceAttributes (ALIVE_GPIO_BASE, ALIVE_GPIO_SIZE, EFI_MEMORY_UC);
+}
+
+EFI_STATUS
+EFIAPI
+Star2LteKeysEntry (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS  Status;
+  EFI_EVENT   Timer;
+  EFI_HANDLE  Handle;
+
+  Status = MapAliveGpio ();
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "Star2LteKeys: ALIVE GPIO map failed: %r\n", Status));
+    return Status;
+  }
+
+  mStable  = RawKeys ();          // keys already down at start do not count
+  mLastRaw = mStable;
+
+  mTextIn.Reset         = KeysReset;
+  mTextIn.ReadKeyStroke = KeysRead;
+  Status = gBS->CreateEvent (EVT_NOTIFY_WAIT, TPL_NOTIFY, KeysWaitNotify, NULL, &mTextIn.WaitForKey);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = gBS->CreateEvent (EVT_TIMER | EVT_NOTIFY_SIGNAL, TPL_NOTIFY, Sample, NULL, &Timer);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = gBS->SetTimer (Timer, TimerPeriodic, SAMPLE_100NS);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Handle = NULL;
+  Status = gBS->InstallMultipleProtocolInterfaces (
+                  &Handle,
+                  &gEfiSimpleTextInProtocolGuid,
+                  &mTextIn,
+                  &gEfiDevicePathProtocolGuid,
+                  &mKeysPath,
+                  NULL
+                  );
+  DEBUG ((DEBUG_INFO, "Star2LteKeys: installed: %r (keys 0x%x)\n", Status, mStable));
+  return Status;
+}
