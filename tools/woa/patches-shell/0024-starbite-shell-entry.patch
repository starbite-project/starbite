@@ -9773,7 +9773,121 @@
 // ----------------------------------------------------------------------------
 //
 
+#ifndef STAR2LTE_BOOT_SHELL
+#define STAR2LTE_BOOT_SHELL  0
+#endif
+
+#if STAR2LTE_BOOT_SHELL
+//
+// Starbite "UEFI Shell" store entry (tools/woa/build-shell-uefi.sh): the FV
+// carries the edk2 Shell under the standard gUefiShellFileGuid and
+// Star2LteKeysDxe (Volume/Power/Bixby as SimpleTextIn). BDS never registers or
+// boots Windows in this build: it starts the Shell, restarts it when it exits,
+// and resets to the boot menu if it cannot be loaded.
+//
+STATIC CONST EFI_GUID  mStar2LteShellFileGuid = {
+  0x7C04A583, 0x9E3E, 0x4F1C, { 0xAD, 0x65, 0xE0, 0x52, 0x68, 0xD0, 0xB4, 0xD1 }
+};
+
+/** Every SimpleTextIn handle (the keys driver) becomes a ConIn device. */
+STATIC
 VOID
+Star2LteRegisterKeyConsoles (
+  VOID
+  )
+{
+  EFI_STATUS                Status;
+  UINTN                     HandleCount;
+  EFI_HANDLE                *HandleBuffer;
+  UINTN                     Index;
+  EFI_DEVICE_PATH_PROTOCOL  *DevicePath;
+
+  HandleBuffer = NULL;
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiSimpleTextInProtocolGuid, NULL, &HandleCount, &HandleBuffer);
+  BdsPramStr ("\n=KEYCON n=");
+  BdsPramHex ((UINT32)(EFI_ERROR (Status) ? 0 : HandleCount), 2);
+  BdsPramByte ('\n');
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+
+  for (Index = 0; Index < HandleCount; Index++) {
+    Status = gBS->HandleProtocol (HandleBuffer[Index], &gEfiDevicePathProtocolGuid, (VOID **)&DevicePath);
+    if (!EFI_ERROR (Status)) {
+      EfiBootManagerUpdateConsoleVariable (ConIn, DevicePath, NULL);
+      gBS->ConnectController (HandleBuffer[Index], NULL, NULL, TRUE);
+    }
+  }
+
+  FreePool (HandleBuffer);
+}
+
+STATIC
+VOID
+Star2LteBootShell (
+  VOID
+  )
+{
+  EFI_STATUS                         Status;
+  EFI_LOADED_IMAGE_PROTOCOL          *Self;
+  MEDIA_FW_VOL_FILEPATH_DEVICE_PATH  Node;
+  EFI_DEVICE_PATH_PROTOCOL           *Path;
+  EFI_HANDLE                         Image;
+  UINTN                              Run;
+
+  Status = gBS->HandleProtocol (gImageHandle, &gEfiLoadedImageProtocolGuid, (VOID **)&Self);
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+
+  EfiInitializeFwVolDevicepathNode (&Node, &mStar2LteShellFileGuid);
+  Path = AppendDevicePathNode (DevicePathFromHandle (Self->DeviceHandle), (EFI_DEVICE_PATH_PROTOCOL *)&Node);
+  if (Path == NULL) {
+    return;
+  }
+
+  for (Run = 0; Run < 64; Run++) {
+    Image  = NULL;
+    Status = gBS->LoadImage (TRUE, gImageHandle, Path, NULL, 0, &Image);
+    BdsPramStr ("\n=SHELL run=");
+    BdsPramHex ((UINT32)Run, 2);
+    BdsPramStr (" load=");
+    BdsPramByte (EFI_ERROR (Status) ? (UINT8)'E' : (UINT8)'S');
+    BdsPramHex ((UINT32)(Status & 0xFFFFu), 4);
+    BdsPramByte ('\n');
+    if (EFI_ERROR (Status)) {
+      break;
+    }
+
+    if ((Run == 0) && (gST->ConOut != NULL)) {
+      gST->ConOut->ClearScreen (gST->ConOut);
+      gST->ConOut->OutputString (
+        gST->ConOut,
+        L"Starbite UEFI Shell  |  Volume: pick a command  |  Power: Enter  |  Bixby: q (stop paging)\r\n"
+        L"The last command in the list is 'reset' (back to the boot menu).\r\n\r\n"
+        );
+    }
+
+    gBS->SetWatchdogTimer (0, 0, 0, NULL);
+    Status = gBS->StartImage (Image, NULL, NULL);
+    BdsPramStr ("\n=SHELLRET st=");
+    BdsPramByte (EFI_ERROR (Status) ? (UINT8)'E' : (UINT8)'S');
+    BdsPramHex ((UINT32)(Status & 0xFFFFu), 4);
+    BdsPramByte ('\n');
+  }
+
+  FreePool (Path);
+  if (gST->ConOut != NULL) {
+    gST->ConOut->OutputString (gST->ConOut, L"\r\nUEFI Shell could not be started. Back to the boot menu in 10 s.\r\n");
+  }
+
+  gBS->Stall (10 * 1000 * 1000);
+  gRT->ResetSystem (EfiResetCold, EFI_SUCCESS, 0, NULL);
+  CpuDeadLoop ();
+}
+#endif
