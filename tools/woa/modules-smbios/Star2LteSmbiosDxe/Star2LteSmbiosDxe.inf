## @file
#  Star2LteSmbiosDxe: the Galaxy S9's SMBIOS table (types 0, 1, 3, 4 and, with
#  STARBITE_SMBIOS_TYPE7=1, 7) and both entry points, built here without edk2's SmbiosDxe
#  (which does not fit the release's DXE slot), so Windows has a CPU name (Task Manager)
#  and a system name. docs/WIN11-GPU.md section 6.39.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = Star2LteSmbiosDxe
  FILE_GUID      = c4ce8369-79b3-4382-e763-8799826cce01
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0
  ENTRY_POINT    = Star2LteSmbiosEntry

[Sources]
  SmbiosPlatform.c
  SmbiosBuild.c
  SmbiosBuild.h

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  BaseMemoryLib

[Guids]
  gEfiSmbiosTableGuid       ## PRODUCES ## SystemTable
  gEfiSmbios3TableGuid      ## PRODUCES ## SystemTable

[Protocols]
  gEfiCpuArchProtocolGuid       ## UNDEFINED # Depex
  gEfiRuntimeArchProtocolGuid   ## UNDEFINED # Depex

# After the CPU (memory attributes) and Runtime (runtime memory) architectural protocols, the
# services the runtime-data page relies on; BDS (and its =FWTS A21 line) comes after every driver.
[Depex]
  gEfiCpuArchProtocolGuid AND gEfiRuntimeArchProtocolGuid
