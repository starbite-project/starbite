## @file
#  Star2LteUsbHostDxe: the DWC3 as a USB host for Windows' inbox xHCI driver (docs/WIN11-USB.md).
#  Added to the release DXE volume with tools/woa/dxe-replace.py --add; built by
#  tools/woa/build-win-usbhost.sh (patch 0024, -D STAR2LTE_USB_HOST_DXE -D STARBITE_USBH_VBUS=n).
#  s9usb/ is a copy of starbite/s9usb made by tools/woa/patches/gen-0024.py.
#
#  Copyright (c) 2026, Starbite. SPDX-License-Identifier: GPL-2.0-only
##

[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = Star2LteUsbHostDxe
  FILE_GUID                      = 52cc03fc-adc9-4192-9623-0ac86921f9a1
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = UsbHostDxeEntry

[Sources]
  UsbHostDxe.c
  UsbHostSsdtAml.h
  s9usb/s9usb.h
  s9usb/s9usb_io.h
  s9usb/s9usb_phy.c
  s9usb/s9usb_dwc3.c
  s9usb/s9usb_max77705.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  DxeServicesTableLib
  PrintLib
  TimerLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiAcpiTableProtocolGuid                     ## CONSUMES

[Guids]
  gEfiEventReadyToBootGuid                      ## CONSUMES ## Event

[Depex]
  gEfiAcpiTableProtocolGuid AND gEfiCpuArchProtocolGuid

[BuildOptions]
  *_*_*_CC_FLAGS = -DS9USB_EDK2
