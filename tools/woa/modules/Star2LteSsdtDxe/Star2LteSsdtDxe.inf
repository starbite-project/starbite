## @file
#  Star2LteSsdtDxe: installs every Starbite SSDT blob (FREEFORM FFS files 53534454-5342-5445-<id>,
#  made by tools/woa/ssdt-ffs.py) during DXE dispatch (docs/WIN11-USB.md section 4.1); with
#  STARBITE_PPTT_FIX=1 it first gives the PPTT the CPU's caches (PpttFix.c, section 10); with
#  STARBITE_M3_PROBE=1 it first tries the M3 cores (M3Probe.c, docs/WIN11-BIGCORES.md stage B1); with
#  STARBITE_M3_PARK=1 it parks M3 cores 1..3 for the OS session (stage B2, M3ParkStub.S); with
#  STARBITE_M3_RUN=1 each M3 runs a test in the boot CPU's UEFI context (B3a, M3Run.c); with
#  STARBITE_M3_BOOT=1 M3 core 1 becomes the boot CPU at ExitBootServices (B3, M3Boot.c); with
#  STARBITE_CORES8=1/2 M3 cores 1..3 (/0..3) are parked for Windows and listed in the MADT (Cores8.c,
#  docs/WIN11-24H2-A55.md); with STARBITE_M3_DIAG=1 the log-only M3 diagnostic (M3Diag.c,
#  docs/WIN11-M3-CLEAN.md). Added to the
#  release DXE volume with tools/woa/dxe-replace.py --add; built by patch 0024 under
#  -D STAR2LTE_SSDT_DXE.
#
#  Copyright (c) 2026, Starbite. SPDX-License-Identifier: GPL-2.0-only
##

[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = Star2LteSsdtDxe
  FILE_GUID                      = 5dd14183-80d0-4d05-938e-f74bc42e4e6a
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = SsdtDxeEntry

[Sources]
  SsdtDxe.c
  PpttFix.c
  M3Probe.c
  M3ParkStub.h
  M3Run.c
  M3RunStub.h
  M3Boot.c
  Cores8.c
  Cores8ParkStub.h
  M3PsciEmu.h
  M3Diag.c
  M3Early.c
  PpttBuild.c
  PpttBuild.h
  StarbiteLog.h

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  CacheMaintenanceLib
  DebugLib
  MemoryAllocationLib
  PrintLib
  TimerLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiAcpiTableProtocolGuid                     ## CONSUMES
  gEfiFirmwareVolume2ProtocolGuid               ## CONSUMES
  gEfiAcpiSdtProtocolGuid                       ## SOMETIMES_CONSUMES (PpttFix; not in the depex)
  gEfiLoadedImageProtocolGuid                   ## SOMETIMES_CONSUMES (M3Boot v4 LSE latch guard)

[Guids]
  gEfiEventReadyToBootGuid                      ## SOMETIMES_CONSUMES (M3Boot v6: wrap ExitBootServices at ReadyToBoot)

[Depex]
  gEfiAcpiTableProtocolGuid

[BuildOptions]
  *_*_*_CC_FLAGS = -DPPTT_EDK2
