#!/usr/bin/env python3
"""Fake `heimdall` for installer rehearsals: `detect`, `download-pit --output FILE [--no-reboot] [--resume]`
and `flash [--resume] --RECOVERY FILE [--no-reboot]`, on the fake phone's PIT ($FAKE_ROOT/pit.bin).

Sessions as on a real Samsung: a command that ends with --no-reboot leaves the Download-mode session
open, and the next command must then pass --resume (without it the handshake fails); a command with
--resume on a phone without an open session fails too. A reboot closes the session.
After a RECOVERY flash the fake phone goes to TWRP, standing in for the user's key combination
(Volume Down + Power, then at once Volume Up + Bixby + Power)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import fakephone  # noqa: E402

R = os.environ.get('FAKE_ROOT') or sys.exit('fake heimdall: FAKE_ROOT is not set')
SESSION = os.path.join(R, 'heimdall-session')
a = sys.argv[1:]
on = fakephone.read_state(R) == 'download'
if a[:1] == ['detect']:
    print('Device detected' if on else 'ERROR: Failed to detect compatible download-mode device.')
    sys.exit(0 if on else 1)
if a[:1] == ['version'] or a[:1] == ['--version']:
    print('v1.4.2 (starbite fake heimdall)')
    sys.exit(0)
if not on:
    sys.exit('ERROR: Failed to detect compatible download-mode device.')
resume, no_reboot = '--resume' in a, '--no-reboot' in a
is_open = os.path.exists(SESSION)
if is_open and not resume:
    sys.exit('Initialising protocol...\nERROR: Failed to receive handshake response. Result: -7\n'
             'ERROR: Protocol initialisation failed!')
if resume and not is_open:
    sys.exit('Beginning session...\nERROR: Failed to begin session!')


def end():
    if no_reboot:
        open(SESSION, 'w').write('open\n')
    else:                                           # heimdall reboots the phone: it starts its normal OS
        fakephone.write_state(R, 'android')


if a[:1] == ['download-pit']:
    out = a[a.index('--output') + 1]
    data = open(os.path.join(R, 'pit.bin'), 'rb').read()
    open(out, 'wb').write(data)
    print(f'Downloading device\'s PIT file...\nPIT file download successful.\n({len(data)} bytes)')
    end()
    sys.exit(0)
if a[:1] == ['flash']:
    args = [x for x in a[1:] if x not in ('--resume', '--no-reboot')]
    if len(args) != 2 or args[0] != '--RECOVERY':
        sys.exit(f'fake heimdall: only "flash [--resume] --RECOVERY FILE [--no-reboot]" is faked, not {a}')
    target = os.path.realpath(os.path.join(R, 'dev', 'block', 'by-name', 'RECOVERY'))
    data = open(args[1], 'rb').read()
    with open(target, 'r+b') as f:
        f.write(data)
    open(os.path.join(R, 'recovery-kind'), 'w').write('twrp\n')
    print(f'Uploading RECOVERY\n100%\nRECOVERY upload successful ({len(data)} bytes)')
    if not no_reboot:
        end()
        sys.exit(0)
    fakephone.write_state(R, 'recovery')
    print('(fake: the user held Volume Down + Power, then Volume Up + Bixby + Power: TWRP is up)')
    sys.exit(0)
sys.exit(f'fake heimdall: {a} is not faked')
