#!/usr/bin/env python3
"""Fake `fastboot` for installer rehearsals: the Starbite loader's FB1 subset (docs/USB-FASTBOOT.md),
read-only except reboots and `boot` (an image started from RAM). The phone is $FAKE_ROOT (fakephone.py).

`fastboot boot KERNEL INITRD --dtb DTB --header-version 2 --cmdline "..."` starts the installer
environment (state `env`) when the kernel is an arm64 Image ("ARMd" at 0x38, which the loader checks
before it starts Linux), a DTB came with it, and the whole download fits the loader's 0x04ff0000-byte
buffer. The ssh key the installer appended to the initrd (a newc cpio member root/.ssh/authorized_keys)
is what the fake ssh then accepts. `reboot recovery` is refused: the installer never boots RECOVERY."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import fakephone  # noqa: E402

R = os.environ.get('FAKE_ROOT') or sys.exit('fake fastboot: FAKE_ROOT is not set')
VARS = {'product': 'starlte', 'version-bootloader': 'starbite-fb1', 'serialno': 'FAKE0000SERIAL',
        'unlocked': 'yes', 'secure': 'no', 'battery-level': '87', 'max-download-size': '0x04ff0000'}
MAX_DOWNLOAD = 0x04ff0000
a = sys.argv[1:]
on = fakephone.read_state(R) == 'fastboot'


def cpio_member(data, name):
    """The contents of `name` in any uncompressed newc cpio inside data (the appended key archive)."""
    i = data.find(b'070701')
    while i >= 0:
        h = data[i:i + 110]
        try:
            fsize, nsize = int(h[54:62], 16), int(h[94:102], 16)
        except ValueError:
            i = data.find(b'070701', i + 6)
            continue
        n = data[i + 110:i + 110 + nsize - 1].decode(errors='replace')
        off = i + 110 + nsize
        off += -off % 4
        if n == name:
            return data[off:off + fsize]
        i = data.find(b'070701', off + fsize)
    return None


if a[:1] == ['devices']:
    if on:
        print('FAKE0000SERIAL\tfastboot')
elif a[:1] == ['getvar'] and on:
    sys.stderr.write(f'{a[1]}: {VARS.get(a[1], "")}\nFinished. Total time: 0.001s\n')
elif a[:2] == ['oem', 'boot-next'] and on:
    open(os.path.join(R, 'boot-next'), 'w').write(a[2] + '\n')
    sys.stderr.write('OKAY\nFinished.\n')
elif a[:1] == ['boot'] and on:
    files = [x for j, x in enumerate(a[1:], 1) if not x.startswith('--') and a[j - 1] not in
             ('--dtb', '--header-version', '--cmdline')]
    dtb = a[a.index('--dtb') + 1] if '--dtb' in a else None
    if len(files) != 2 or not dtb:
        sys.exit('fake fastboot: the installer environment is "boot KERNEL INITRD --dtb DTB --header-version 2"')
    kernel, initrd = (open(f, 'rb').read() for f in files)
    total = len(kernel) + len(initrd) + os.path.getsize(dtb) + 3 * 2048
    if total > MAX_DOWNLOAD:
        sys.exit(f'FAILED (remote: \'data too large: {total} > {MAX_DOWNLOAD}\')')
    if kernel[0x38:0x3c] != b'ARMd':
        sys.exit('fake fastboot: the kernel is not an arm64 Image (the loader would not start it as Linux)')
    key = cpio_member(initrd, 'root/.ssh/authorized_keys')
    if key:
        open(os.path.join(R, 'authorized_keys'), 'wb').write(key)
    cl = a[a.index('--cmdline') + 1] if '--cmdline' in a else ''
    open(os.path.join(R, 'env-cmdline'), 'w').write(cl + '\n')
    sys.stderr.write(f'Sending \'boot.img\' ({total // 1024} KB)\nOKAY\nBooting\nOKAY\nFinished.\n')
    fakephone.write_state(R, 'env')
elif a[:1] == ['reboot'] and on:
    to = a[1] if len(a) > 1 else ''
    if to == 'recovery':
        sys.exit('fake fastboot: the installer never boots RECOVERY')
    fakephone.write_state(R, {'bootloader': 'fastboot', 'download': 'download'}.get(to, 'menu'))
    sys.stderr.write('Rebooting\nFinished.\n')
elif a[:1] == ['--version']:
    print('fastboot version (starbite fake fastboot)')
else:
    sys.stderr.write('< waiting for any device >\n' if not on else f'fake fastboot: {a} is not faked\n')
    sys.exit(1)
