#!/bin/sh
# Project Starbite: the installer environment's /init (docs/INSTALLER.md 13). A Linux 7.1 kernel +
# this initramfs, started from RAM by the Starbite loader's fastboot:
#   fastboot boot installer.image installer.initrd+key --dtb installer.dtb --header-version 2 \
#            --cmdline "sb.installer=1 sb.serial=SERIAL"
# It mounts nothing of the phone's storage. It gives the computer a root shell over USB networking
# and nothing else:
#   - USB device: CDC-ECM (usb0 172.16.42.1, udhcpd serves 172.16.42.2 to the computer) + CDC-ACM
#     (a local serial shell for debugging), as tools/linux/init does for the distros;
#   - dropbear on usb0 only, KEY ONLY: /root/.ssh/authorized_keys comes from the cpio the installer
#     appends to the initrd (a key it made for this one computer); no password, no telnet;
#   - Android-style paths so the installer's existing writers run unchanged: /dev/block/NAME for every
#     block device, /dev/block/by-name/PARTNAME from the GPT (sb-byname, run again after a GPT write),
#     /external_sd for card p1, /tmp in RAM, `getprop` for the facts the installer reads;
#   - sb-reboot menu|fastboot|download (INFORM3 / the loader's boot-next mailbox). Never recovery.
# NOT RUN ON THE PHONE YET (2026-11-06): built from this file by tools/installer/env/mk-env.sh.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /run /tmp /external_sd /root/.ssh /etc/dropbear /var/log
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t tmpfs tmpfs /run
chmod 700 /root /root/.ssh
chmod 600 /root/.ssh/authorized_keys 2>/dev/null
echo 0 > /proc/sys/kernel/printk 2>/dev/null
say() { echo "$*" > /dev/tty0 2>/dev/null; echo "sbinst-env: $*" > /dev/kmsg 2>/dev/null; }
say "STARBITE INSTALLER ENVIRONMENT"
say "Leave the USB cable in. The computer does the rest."

# ---- block devices: /dev/block/NAME and /dev/block/by-name/PARTNAME (sb-byname) -----------------
sb-byname
i=0
while [ ! -e /dev/block/by-name/EFS ] && [ $i -lt 50 ]; do sleep 0.2; sb-byname; i=$((i + 1)); done
[ -e /dev/block/by-name/EFS ] || say "WARNING: no UFS partitions found (by-name/EFS missing)"

# ---- USB networking (ECM) + ACM, as tools/linux/init ---------------------------------------------
G=/sys/kernel/config/usb_gadget/sbinst
mount -t configfs none /sys/kernel/config 2>/dev/null
mkdir -p $G $G/strings/0x409 $G/functions/ecm.usb0 $G/functions/acm.GS0 $G/configs/c.1/strings/0x409
echo 0x1d6b > $G/idVendor
echo 0x0104 > $G/idProduct
echo Starbite > $G/strings/0x409/manufacturer
echo "Starbite installer environment" > $G/strings/0x409/product
sed -n 's/.*sb\.serial=\([^ ]*\).*/\1/p' /proc/cmdline > $G/strings/0x409/serialnumber
echo 02:53:39:00:01:01 > $G/functions/ecm.usb0/dev_addr
echo 02:53:39:00:01:02 > $G/functions/ecm.usb0/host_addr
echo "ECM + ACM" > $G/configs/c.1/strings/0x409/configuration
ln -s $G/functions/ecm.usb0 $G/configs/c.1/
ln -s $G/functions/acm.GS0 $G/configs/c.1/
udc=$(ls /sys/class/udc 2>/dev/null | head -1)
[ -n "$udc" ] && echo "$udc" > $G/UDC || say "ERROR: no USB device controller (dwc3): check installer.dtb (dr_mode peripheral)"
i=0
while [ ! -e /sys/class/net/usb0 ] && [ $i -lt 50 ]; do sleep 0.2; i=$((i + 1)); done
ifconfig lo 127.0.0.1 up
ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up || say "ERROR: usb0 did not come up"
cat > /run/udhcpd.conf <<EOF
start 172.16.42.2
end 172.16.42.2
interface usb0
lease_file /run/udhcpd.leases
option subnet 255.255.255.0
option lease 86400
EOF
touch /run/udhcpd.leases
udhcpd /run/udhcpd.conf

# ---- dropbear: key only, usb0 only ---------------------------------------------------------------
[ -s /etc/dropbear/dropbear_ed25519_host_key ] || dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key >/dev/null 2>&1
if [ -s /root/.ssh/authorized_keys ]; then
	dropbear -s -g -p 172.16.42.1:22 -r /etc/dropbear/dropbear_ed25519_host_key
	say "ssh: ready on 172.16.42.1 (this computer's key only)"
else
	say "ERROR: no installer key in the initrd: the computer cannot log in (run the installer again)"
fi
# the local serial shell (debugging; the cable is the access control, as for the distros)
( while :; do [ -c /dev/ttyGS0 ] && setsid sh -c 'exec sh -l </dev/ttyGS0 >/dev/ttyGS0 2>&1'; sleep 1; done ) &

# ---- stay up; the installer reboots with sb-reboot -----------------------------------------------
while :; do sleep 3600; done
