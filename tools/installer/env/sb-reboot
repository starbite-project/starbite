#!/bin/sh
# Project Starbite installer environment: sb-reboot menu|fastboot|download. Never recovery: the phone
# keeps Samsung's stock recovery and the installer never starts it.
#   menu      INFORM3 0x12345670 (normal boot: the Starbite loader's menu)
#   fastboot  the loader's boot-next mailbox (0xFED17FE0 "SBNEXT2!" + "fastboot\0", docs/USB-FASTBOOT.md
#             5.1), then a normal boot: the loader comes up in its fastboot
#   download  INFORM3 0x12345671 (Samsung Download mode)
# The environment has no init system: sync, then sysrq "b" (as tools/rescue/sb-reboot).
case ${1:-} in
menu) magic=0x12345670 ;;
fastboot)
	magic=0x12345670
	devmem 0xFED17FF0 64 0
	devmem 0xFED17FE8 64 0x746f6f6274736166
	devmem 0xFED17FE0 64 0x21325458454e4253 ;;
download) magic=0x12345671 ;;
*) echo "usage: sb-reboot menu|fastboot|download (never recovery)" >&2; exit 2 ;;
esac
echo "Rebooting: $1" > /dev/tty0 2>/dev/null
sync
devmem 0x1406080C 32 $magic || { echo "sb-reboot: devmem failed" >&2; exit 1; }
( sleep 1; echo b > /proc/sysrq-trigger ) </dev/null >/dev/null 2>&1 &
exit 0
