#!/bin/sh
# Project Starbite: Starbite Rescue mode /init (tools/rescue/README.md, docs/STARBITE-RECOVERY.md).
#
# The loader starts this ramdisk when the Starbite Recovery menu (hold Bixby at boot) picks
# "Starbite Rescue mode", or after `reboot-to rescue`. It asks for a Starbite rescue disk, made by
# the Starbite Installer: a USB mass-storage disk (or a microSD card) with a filesystem labelled
# STARBITE-RESCUE (ext4 and other filesystems with 15-character labels) or SB-RESCUE (FAT32 and
# exFAT: their labels hold 11 characters) holding /starbite-rescue/rescue.sh. When one appears it
# is mounted read-only, checked against /starbite-rescue/rescue.sha256 if present, and rescue.sh
# runs.
#
# USB host (docs/RESCUE-USB-HOST.md): with the store's rescue.dtb the DWC3 starts as a host and
# s9p-max77705-muic gives the port 5 V while the Type-C MCU reports a device attached. Volume Down
# turns VBUS off and switches the controller to device mode (the role switch). Every reboot goes
# through /bin/sb-reboot, which switches VBUS off first (sysrq "b" runs no driver shutdown).
#
# Keys (polled with devmem, as tools/linux/init): Power held 2 s reboots to the Starbite menu;
# Volume Up rescans now; Volume Down switches the USB port to device mode and starts a serial
# shell (CDC-ACM) for a Mac or PC, for debugging the rescue system itself.
#
# Every UFS block device is read-only until rescue.sh says otherwise (blockdev --setrw on the one
# partition it restores). A rescue script must never write EFS, CPEFS, PARAM, KEYSTORAGE,
# PERSISTENT, STEADY, BOTA*, DTB, DTBO, the GPT or the boot LUNs.
#
# SB_TEST=1 sources this file without running it (host tests of the helpers).
#
# Embedded in Starbite Maintenance (tools/maint/env/init, docs/MAINTENANCE.md 7): SBMAINT's init runs
# this file as /bin/sb-rescue in rescue mode with SB_RESCUE_EMBEDDED=1 (proc, sys, dev, /run and /tmp
# are already mounted and are not mounted again), SB_RESCUE_DEVICE_HOOK (Volume Down: the whole
# maintenance link, USB networking + ssh, instead of the bare serial shell) and SB_RESCUE_HOST_HOOK
# (Volume Up: back to USB host mode).
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

LABEL=STARBITE-RESCUE
LABELS="STARBITE-RESCUE SB-RESCUE"                 # SB-RESCUE: FAT32/exFAT (11-character labels)
VBUS_PARAM=/sys/module/s9p_max77705_muic/parameters/vbus
MNT=/rescue
LOG=/run/rescue.log
GPA0_DAT=0x14050024                                # bit 3 Vol up, bit 4 Vol down (active low)
GPA2_DAT=0x14050064                                # bit 4 Power (active low)

# ==== helpers (no side effects except where named) ===========================================

say() {                                            # the screen (fbcon on tty0) and the log
	echo "$*" > /dev/tty0 2>/dev/null
	echo "$*" >> "$LOG" 2>/dev/null
	# KERN_DEBUG: in dmesg, but not printed on tty0 a second time (rescue.dtb has loglevel=7)
	echo "<7>rescue: $*" > /dev/kmsg 2>/dev/null
	return 0
}

key_down() {                                       # key_down up|down|power
	case $1 in
	up) a=$GPA0_DAT; m=0x08 ;;
	down) a=$GPA0_DAT; m=0x10 ;;
	power) a=$GPA2_DAT; m=0x10 ;;
	*) return 1 ;;
	esac
	v=$(devmem $a 32 2>/dev/null) || return 1
	[ $(( v & m )) -eq 0 ]
}

# is_usb_disk NAME: sdX on the USB bus (UFS LUNs are sdX too, under the UFS host).
is_usb_disk() {
	p=$(readlink -f "/sys/block/$1" 2>/dev/null)
	case $p in */usb[0-9]*/*) return 0 ;; esac
	return 1
}

# candidates: block devices a rescue disk can be: USB disks and their partitions, microSD partitions.
candidates() {
	for b in /sys/block/sd*; do
		[ -e "$b" ] || continue
		n=${b##*/}
		is_usb_disk "$n" || continue
		found=
		for p in /sys/block/"$n"/"$n"[0-9]*; do
			[ -e "$p" ] || continue
			echo "/dev/${p##*/}"
			found=1
		done
		[ -n "$found" ] || echo "/dev/$n"      # a superfloppy (no partition table)
	done
	for p in /sys/block/mmcblk*/mmcblk*p[0-9]*; do
		[ -e "$p" ] && echo "/dev/${p##*/}"
	done
	return 0
}

is_label() {                                       # is_label LABEL: one of $LABELS
	for x in $LABELS; do [ "$1" = "$x" ] && return 0; done
	return 1
}

# find_rescue: the first candidate whose filesystem label is one of $LABELS. blkid when the
# busybox has it, else findfs (Ubuntu's busybox-static has findfs but no blkid).
find_rescue() {
	c=$(candidates)
	if command -v blkid >/dev/null 2>&1; then
		for d in $c; do
			[ -b "$d" ] || continue
			l=$(blkid -s LABEL -o value "$d" 2>/dev/null)
			[ -z "$l" ] && l=$(blkid "$d" 2>/dev/null | sed -n 's/.* LABEL="\([^"]*\)".*/\1/p')
			is_label "$l" && { echo "$d"; return 0; }
		done
		return 1
	fi
	for x in $LABELS; do
		d=$(findfs "LABEL=$x" 2>/dev/null) || continue
		for e in $c; do                            # only a USB disk or the microSD card
			[ "$e" = "$d" ] && { echo "$d"; return 0; }
		done
	done
	return 1
}

# vbus_state: "on", "off" or "none" (no OTG regulator: not the rescue DTB, or an old kernel)
vbus_state() {
	st=none
	for r in /sys/class/regulator/*; do
		[ "$(cat "$r/name" 2>/dev/null)" = usb-otg-vbus ] || continue
		case $(cat "$r/state" 2>/dev/null) in enabled) st=on ;; *) st=off ;; esac
	done
	echo $st
}

[ "$SB_TEST" = 1 ] && return 0

# ==== hardware ==============================================================================

lock_ufs() {
	for b in /sys/block/sd*; do
		[ -e "$b" ] || continue
		n=${b##*/}
		is_usb_disk "$n" && continue
		blockdev --setro "/dev/$n" 2>/dev/null
		for p in /dev/"$n"[0-9]*; do
			[ -b "$p" ] && blockdev --setro "$p" 2>/dev/null
		done
	done
}

# USB host mode (docs/RESCUE-USB-HOST.md). rescue.dtb: dwc3 dr_mode "otg" + usb-role-switch,
# default host; s9p-max77705-muic drives VBUS (vbus=1: while the Type-C MCU reports a device).
# With the daily DTB there is no role switch and no OTG regulator: only the microSD works then.
usb_host() {
	if [ -n "$SB_RESCUE_HOST_HOOK" ]; then
		$SB_RESCUE_HOST_HOOK
		return 0
	fi
	[ -w $VBUS_PARAM ] && echo 1 > $VBUS_PARAM
	for r in /sys/class/usb_role/*/role; do
		[ -w "$r" ] && echo host > "$r" 2>/dev/null
	done
	return 0
}

# usb_report: one line on the screen about the port
usb_report() {
	role=none
	for r in /sys/class/usb_role/*/role; do
		[ -r "$r" ] && role=$(cat "$r")
	done
	n=0
	for u in /sys/bus/usb/devices/[0-9]*-[0-9]*; do
		[ -e "$u/idVendor" ] && n=$((n + 1))
	done
	say "USB: role $role, VBUS $(vbus_state), $n device(s)"
}

usb_device_shell() {
	if [ -n "$SB_RESCUE_DEVICE_HOOK" ]; then
		$SB_RESCUE_DEVICE_HOOK || return 2
		return 0
	fi
	[ -w $VBUS_PARAM ] && echo 0 > $VBUS_PARAM      # VBUS off before the role changes
	i=0
	while [ "$(vbus_state)" = on ] && [ $i -lt 30 ]; do sleep 0.1; i=$((i + 1)); done
	for r in /sys/class/usb_role/*/role; do
		[ -w "$r" ] && echo device > "$r" 2>/dev/null
	done
	i=0                                            # the UDC appears once dwc3 is a gadget
	while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $i -lt 30 ]; do sleep 0.1; i=$((i + 1)); done
	mount -t configfs none /sys/kernel/config 2>/dev/null
	G=/sys/kernel/config/usb_gadget/rescue
	mkdir -p $G/strings/0x409 $G/functions/acm.GS0 $G/configs/c.1/strings/0x409 || return 1
	echo 0x1d6b > $G/idVendor
	echo 0x0104 > $G/idProduct
	echo Starbite > $G/strings/0x409/manufacturer
	echo "Galaxy S9 Rescue" > $G/strings/0x409/product
	echo ACM > $G/configs/c.1/strings/0x409/configuration
	ln -s $G/functions/acm.GS0 $G/configs/c.1/ 2>/dev/null
	udc=$(ls /sys/class/udc 2>/dev/null | head -1)
	[ -n "$udc" ] && echo "$udc" > $G/UDC || return 2
	( while :; do [ -c /dev/ttyGS0 ] && setsid sh -c 'exec sh -l </dev/ttyGS0 >/dev/ttyGS0 2>&1'; sleep 1; done ) &
	return 0
}

reboot_menu() {
	say "Rebooting to the Starbite menu"
	if command -v sb-reboot >/dev/null 2>&1; then
		sb-reboot menu                         # VBUS off first, then INFORM normal + sysrq b
	fi
	[ -w $VBUS_PARAM ] && echo 0 > $VBUS_PARAM && sleep 1
	sync
	devmem 0x1406080C 32 0x12345670 2>/dev/null       # INFORM: normal boot
	echo b > /proc/sysrq-trigger
	sleep 5
}

# run_rescue DEV: mount it, check it, run its script. Returns the script's status.
run_rescue() {
	dev=$1
	mkdir -p $MNT
	mount -o ro "$dev" $MNT 2>/dev/null || { say "Cannot mount $dev"; return 90; }
	d=$MNT/starbite-rescue
	if [ ! -f $d/rescue.sh ]; then
		say "$dev is labelled $LABEL but has no starbite-rescue/rescue.sh"
		umount $MNT
		return 91
	fi
	if [ -f $d/rescue.sha256 ]; then
		say "Checking the rescue files..."
		( cd $d && sha256sum -c rescue.sha256 >> "$LOG" 2>&1 ) || {
			say "CHECKSUM MISMATCH: not running this rescue disk"
			umount $MNT
			return 92
		}
	fi
	say "Running the rescue script from $dev"
	RESCUE_ROOT=$MNT RESCUE_DIR=$d RESCUE_DEV=$dev RESCUE_LOG=$LOG \
		sh $d/rescue.sh > /dev/tty0 2>&1 < /dev/null
	st=$?
	say "Rescue script finished (status $st)"
	cp "$LOG" /run/rescue-last.log 2>/dev/null
	return $st
}

# ==== main ==================================================================================

if [ "$SB_RESCUE_EMBEDDED" != 1 ]; then
	mount -t proc proc /proc
	mount -t sysfs sysfs /sys
	mount -t devtmpfs devtmpfs /dev 2>/dev/null
	mkdir -p /run /tmp
	mount -t tmpfs tmpfs /run
	mount -t tmpfs tmpfs /tmp
fi
: > "$LOG"
printf '\033[2J\033[H' > /dev/tty0 2>/dev/null
say "=============================================="
say "  STARBITE RESCUE MODE"
say "=============================================="
say ""
say "Connect a Starbite rescue USB disk"
say "(made by the Starbite Installer, label $LABEL or SB-RESCUE)."
say ""
say "Power (hold 2 s): reboot to the Starbite menu"
if [ -n "$SB_RESCUE_DEVICE_HOOK" ]; then
	say "Volume Up: look again   Volume Down: USB maintenance (ssh)"
else
	say "Volume Up: look again   Volume Down: USB serial shell"
fi
say ""
lock_ufs
usb_host
sleep 1
usb_report

held=0
shown=
while :; do
	lock_ufs                                       # late UFS LUNs too
	dev=$(find_rescue)
	if [ -n "$dev" ]; then
		run_rescue "$dev"
		say "Remove the rescue disk, or hold Power to reboot."
		while [ -n "$(find_rescue)" ]; do
			key_down power && reboot_menu
			sleep 1
		done
		say "Waiting for a Starbite rescue USB disk..."
		continue
	fi
	[ -n "$shown" ] || { say "Waiting for a Starbite rescue USB disk..."; shown=1; }
	if key_down power; then
		held=$((held + 1))
		[ $held -ge 4 ] && reboot_menu
	else
		held=0
	fi
	if key_down down; then
		if [ -n "$SB_RESCUE_DEVICE_HOOK" ]; then
			say "USB maintenance: connect a computer, then: tools/maint/sbm status"
		else
			say "USB serial shell: connect the phone to a computer (115200 8N1)"
		fi
		usb_device_shell || say "No USB device controller"
		while key_down down; do sleep 0.2; done
	fi
	if key_down up; then
		say "Looking again..."
		usb_host                               # back to host after the serial shell, too
		usb_report
	fi
	sleep 0.5
done
