#!/bin/sh
# Starbite Maintenance: the environment's state as KEY=VALUE lines (sbm status, sb-status).
S=/run/sbmaint
kv() { printf '%s=%s\n' "$1" "$2"; }
kv release "$(head -1 /etc/sbmaint-release 2>/dev/null)"
cat $S/state 2>/dev/null
kv kernel "$(uname -r)"
kv uptime "$(cut -d. -f1 /proc/uptime)"
kv usb "$(cat /sys/class/udc/*/state 2>/dev/null | head -1)"
kv usb_fn "$(ls /sys/kernel/config/usb_gadget/sbmaint/functions 2>/dev/null | grep usb0 | cut -d. -f1)"
kv ip "$(ifconfig usb0 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')"
kv host "$(awk '$1 == "172.16.42.2" && $3 != "0x0" { print $1 " " $4 }' /proc/net/arp 2>/dev/null | head -1)"
kv ssh_sessions "$(netstat -tn 2>/dev/null | awk '$4 ~ /:22$/ && $6 == "ESTABLISHED"' | wc -l)"
kv ssh_from "$(netstat -tn 2>/dev/null | awk '$4 ~ /:22$/ && $6 == "ESTABLISHED" { sub(/:[0-9]+$/, "", $5); print $5 }' | sort -u | tr '\n' ' ')"
kv job "$(cat $S/job 2>/dev/null)"
b=
for f in /sys/class/power_supply/*/capacity; do [ -r "$f" ] && { b=$(cat "$f"); break; }; done
kv battery "$b"
kv card "$(awk '$2 == "/external_sd" { print $1 " " $3 }' /proc/mounts)"
kv byname "$(ls /dev/block/by-name 2>/dev/null | wc -l)"
kv protected_ro "$(sb-protect list 2>/dev/null | grep -c ' ro$')"
kv allowed "$(tr '\n' ' ' < $S/allowed 2>/dev/null)"
kv mem_free_kb "$(awk '/MemAvailable/ { print $2 }' /proc/meminfo)"
kv tmp_free_kb "$(df -k /tmp | awk 'NR == 2 { print $4 }')"
kv cmdline "$(cat /proc/cmdline)"
