# Starbite: Arch's wlroots0.20 PKGBUILD (gitlab.archlinux.org/archlinux/packaging/packages/wlroots0.20)
# plus phoc's own wlroots patch (phoc v0.57.0 subprojects/packagefiles/wlroots), built by
# tools/linux/distros/mkroot-arch.sh. Arch builds phoc with -D embed-wlroots=disabled, so without
# this phosh dies on its first commit ("height 0 requested without setting top and bottom anchors").
# Maintainer: Robin Candau <antiz@archlinux.org>

pkgname=wlroots0.20
_pkgname=wlroots
pkgver=0.20.2
pkgrel=1.1
pkgdesc="Modular Wayland compositor library (Starbite: with phoc's layer-shell revert, phosh needs it)"
url="https://gitlab.freedesktop.org/wlroots/wlroots"
license=('MIT')
arch=('x86_64' 'aarch64')
depends=('glibc' 'libdisplay-info.so' 'libdrm' 'libglvnd' 'libinput' 'liblcms2.so' 'libliftoff.so' 'libpixman-1.so'
         'libseat.so' 'libudev.so' 'libvulkan.so' 'libwayland-client.so' 'libwayland-server.so' 'libxcb' 'libxkbcommon.so'
         'wayland-protocols' 'opengl-driver' 'xcb-util-errors' 'xcb-util-renderutil' 'xcb-util-wm')
makedepends=('git' 'glslang' 'meson' 'ninja' 'systemd' 'vulkan-headers' 'xorg-xwayland')
optdepends=('xorg-xwayland: Xwayland support'
            'vulkan-validation-layers: validation layers for the experimental vulkan renderer backend')
provides=("libwlroots-${pkgver%.*}.so")
source=("${pkgname}::git+${url}.git#tag=${pkgver}?signed"
        0001-Revert-layer-shell-error-on-0-dimension-without-anch.patch)
sha256sums=('6c8595da579a8df74bc307294c2485e90f5379b84390381f500da33ff3f276d2'
            'db17fba374893d7e00c283dfdaad7abc61170782775c411ab1c79821440ff0a1')
validpgpkeys=('34FF9526CFEF0E97A340E2E40FDE7BE0E88F5E48'  # Simon Ser
              '9DDA3B9FA5D58DD5392C78E652CB6609B22DA89A'  # Drew DeVault
              '4100929B33EEB0FD1DB852797BC79407090047CA') # Sway signing key)

prepare() {
	patch -d "${pkgname}" -Np1 < 0001-Revert-layer-shell-error-on-0-dimension-without-anch.patch
}

build() {
	arch-meson "${pkgname}" build
	ninja -C build
}

package() {
	DESTDIR="${pkgdir}" ninja -C build install
	install -Dm 644 "${pkgname}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
