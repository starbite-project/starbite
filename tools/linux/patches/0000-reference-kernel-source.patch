diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/commonring.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/commonring.c
index e44236cb2..8f8f71860 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/commonring.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/commonring.c
@@ -28,6 +28,36 @@ void brcmf_commonring_register_cb(struct brcmf_commonring *commonring,
 }
 
 
+/*
+ * Every host-to-dongle work item carries a per-ring sequence number in
+ * the common header's 4th byte ("epoch") and a phase bit in the flags
+ * byte, the way Broadcom's DHD stamps them: epoch = seqnum % 253 with
+ * seqnum starting at 254, phase (bit 7) flipped whenever an allocation
+ * lands on the ring base. Firmware that verifies them (BCM4361 B2)
+ * rejects unstamped items with ring status BADOPTION.
+ */
+#define BRCMF_H2D_EPOCH_MODULO	253
+#define BRCMF_H2D_EPOCH_INIT	(BRCMF_H2D_EPOCH_MODULO + 1)
+#define BRCMF_H2D_PHASE_BIT	0x80
+
+static void brcmf_commonring_stamp(struct brcmf_commonring *commonring)
+{
+	u8 *item;
+
+	while (commonring->stamp_ptr != commonring->w_ptr) {
+		if (commonring->stamp_ptr == 0)
+			commonring->phase ^= BRCMF_H2D_PHASE_BIT;
+		item = commonring->buf_addr +
+		       commonring->stamp_ptr * commonring->item_len;
+		item[2] = (item[2] & ~BRCMF_H2D_PHASE_BIT) | commonring->phase;
+		item[3] = commonring->seqnum % BRCMF_H2D_EPOCH_MODULO;
+		commonring->seqnum++;
+		commonring->stamp_ptr++;
+		if (commonring->stamp_ptr == commonring->depth)
+			commonring->stamp_ptr = 0;
+	}
+}
+
 void brcmf_commonring_config(struct brcmf_commonring *commonring, u16 depth,
 			     u16 item_len, void *buf_addr)
 {
@@ -45,6 +75,9 @@ void brcmf_commonring_config(struct brcmf_commonring *commonring, u16 depth,
 	if (commonring->cr_write_wptr)
 		commonring->cr_write_wptr(commonring->cr_ctx);
 	commonring->f_ptr = 0;
+	commonring->stamp_ptr = 0;
+	commonring->phase = 0;
+	commonring->seqnum = BRCMF_H2D_EPOCH_INIT;
 }
 
 
@@ -180,6 +213,8 @@ brcmf_commonring_reserve_for_write_multiple(struct brcmf_commonring *commonring,
 
 int brcmf_commonring_write_complete(struct brcmf_commonring *commonring)
 {
+	brcmf_commonring_stamp(commonring);
+
 	if (commonring->f_ptr > commonring->w_ptr)
 		commonring->f_ptr = 0;
 
