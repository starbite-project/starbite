# Starbite kernel config fragment (docs/LINUX-REBUILD-PLAN.md 2.3).
#
# Merged by the port's build71.sh (patched by tools/linux/patch-mainline.py)
# after its own enables: scripts/kconfig/merge_config.sh -m, then olddefconfig,
# then tools/linux/check-kernel.py config checks that every value below
# survived. A line right after a comment containing "(optional)" only warns.
#
# One kernel for every distro (Ubuntu first, then Debian, postmarketOS, Arch,
# Fedora, Kali): what systemd, NetworkManager, containers, snaps/flatpak and
# Phosh expect, built in where boot needs it, modules (the modules image on
# the card, /distros/_kernel/modules-<release>.img) for the rest.

# ---- identity and command line ---------------------------------------------
CONFIG_LOCALVERSION="-starbite"
# CONFIG_LOCALVERSION_AUTO is not set
# The loader's DTB /chosen/bootargs (tools/linux/mk-starlte-dts.py) plus the
# catalog entry's cmdline reach the kernel. CONFIG_CMDLINE (build-kernel.sh
# sets it to the same daily bootargs) is only the fallback for an empty one.
# CONFIG_CMDLINE_FORCE is not set
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---- initrd: the store file linux.initrd, not a built-in initramfs ---------
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_RD_XZ=y
CONFIG_RD_LZ4=y
CONFIG_BLK_DEV_LOOP=y
# the Shero logo is not vendored; the panel shows the loader's splash
# CONFIG_LOGO is not set

# ---- GPU / power (plan 1.3) ------------------------------------------------
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DEVFREQ_GOV_POWERSAVE=y
CONFIG_DEVFREQ_GOV_USERSPACE=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y

# ---- systemd and friends ---------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FHANDLE=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_PSI=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_KEYS=y
CONFIG_AUDIT=y
CONFIG_BINFMT_MISC=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# ---- filesystems -----------------------------------------------------------
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_CUSE=m
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
CONFIG_NLS_UTF8=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=m

# ---- memory ----------------------------------------------------------------
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=y

# ---- networking: NetworkManager, firewalls (nftables), containers ----------
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET_DIAG=y
CONFIG_UNIX_DIAG=y
CONFIG_PACKET_DIAG=m
CONFIG_NETLINK_DIAG=m
CONFIG_IPV6=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_VXLAN=m
CONFIG_WIREGUARD=m
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VLAN_8021Q=m
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_FQ=m
CONFIG_NET_SCH_HTB=m
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_CGROUP=m
CONFIG_NET_CLS_BPF=m
CONFIG_NET_CLS_ACT=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NETFILTER_NETLINK_LOG=m
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NF_TABLES_BRIDGE=m
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=m
CONFIG_NFT_REJECT=y
CONFIG_NFT_LIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_TPROXY=m
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
# legacy iptables tables (iptables-legacy; Ubuntu and Debian default to iptables-nft)
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP6_NF_MANGLE=m

# ---- input: HID over USB host later, uinput (squeekboard, wvkbd), uhid ------
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_UHID=y
# (optional) a USB keyboard on the host port (rescue.dtb only, see below)
CONFIG_USB_HID=m

# ---- USB host for the rescue ramdisk (docs/RESCUE-USB-HOST.md) --------------
# Built in: the rescue ramdisk has no modules. The daily DTB keeps dwc3 a
# peripheral; rescue.dtb makes it dr_mode "otg" + usb-role-switch, default
# host, with VBUS from the MAX77705 OTG boost (a regulator, hence REGULATOR).
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_REGULATOR=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EXT4_FS=y

# ---- security (optional) ---------------------------------------------------
# Ubuntu, Debian and Kali ship AppArmor profiles; boot with apparmor=0 (entry
# cmdline) if it misbehaves. Landlock and Yama cost nothing.
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_PATH=y
# (optional) AppArmor
CONFIG_SECURITY_APPARMOR=y
# (optional) Landlock
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="landlock,lockdown,yama,safesetid,integrity,apparmor,bpf"

# ---- ChromeOS / ChromiumOS (2026-11-05, master plan 3.5 CR0) -------------------
# Google's arm64-generic image on this kernel: its root is loop-mounted (no verity needed, dm for what
# expects it); cryptohome encrypts home with fscrypt and its keys in the kernel keyring; the software
# TPM (swtpm) reaches Chrome through the vTPM proxy; minijail's uid/gid transitions use SafeSetID.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_ALGS=y
CONFIG_KEYS=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_TCG_TPM=y
CONFIG_TCG_VTPM_PROXY=y
CONFIG_SECURITY_SAFESETID=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
# ChromeOS's init mounts selinuxfs and loads its policy (first boot 2026-11-05: init exited on
# "Unable to mount /sys/fs/selinux"). SELinux and AppArmor are both exclusive LSMs: CONFIG_LSM keeps
# AppArmor for Ubuntu; the ChromiumOS entry picks SELinux with lsm=... (and enforcing=0 for now).
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
# ChromeOS mounts cgroup v1 hierarchies (etc/init/cgroups.conf: cpu freezer devices cpuacct cpuset
# memory net_cls); ui-pre-start writes cpu.cfs_quota_us (boot 6: "ui pre-start terminated with
# status 2", the redirect failing under set -e) and cpuset cpus/mems. systemd distros stay on v2.
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS_V1=y
CONFIG_MEMCG_V1=y
# patchpanel's iptables rules match on owner; Chrome's WebHID / security keys use hidraw.
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_HIDRAW=y
