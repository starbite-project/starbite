# Starbite's config fragment, merged by build71.sh (merge_config.sh -m, then
# olddefconfig) after the port's own enables; tools/linux/build-kernel.sh passes
# it in STARBITE_CONFIG. tools/linux/check-config.py then checks every line of
# it against the final .config, plus its own must-be-built-in list (the way
# back into the phone: USB gadget, PHY, UFS, ext4, microSD, loop, initrd).
# Plan: docs/LINUX-REBUILD-PLAN.md 2.3. Kconfig fragments take no trailing
# comments, so each note sits on the line above.

# -- command line: the DTB's /chosen/bootargs (mk-starlte-dts.py) plus what the
#    loader appends from the catalog entry. FORCE would ignore both.
#    CONFIG_CMDLINE stays as the fallback (build-kernel.sh sets it to
#    mk-starlte-dts.py --print-bootargs: maxcpus=8 s9p_vendor_m3_defaults).
# CONFIG_CMDLINE_FORCE is not set
CONFIG_CMDLINE_FROM_BOOTLOADER=y

# -- uname -r = 7.1.0-starbite: the modules image is named after it
#    (build-kernel.sh exports LOCALVERSION= so no "+" is appended either)
CONFIG_LOCALVERSION="-starbite"
# CONFIG_LOCALVERSION_AUTO is not set

# -- no built-in initramfs: the initrd is the store file linux.initrd, loaded
#    by the Starbite loader at 0xa8000000 (at most 80 MiB)
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y

# -- the way back in: all built in (a module cannot load before the
#    modules image is mounted, and that image lives on the card)
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_EXYNOS5_USBDRD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_EXYNOS9810=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# -- microSD: DW MSHC with the Exynos glue, fixed rails (from the loader),
#    FAT/exFAT for card p1
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_EXYNOS=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# -- watchdog armed by the initrd, fed by the distro
CONFIG_WATCHDOG=y
CONFIG_S3C2410_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y

# -- GPU clock A/B (plan 1.2)
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y

# -- what the distros expect (several were switched off by the port's strip loop)
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_EROFS_FS=y
CONFIG_ZRAM=y
CONFIG_PSI=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y

# -- no boot logo of the port's (its branding/ is not vendored)
# CONFIG_LOGO is not set
