<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starbite: the first Metal test on macOS 26.5 (docs/MACOS-METAL.md section 6). Runs once at boot, as root,
     before (or instead of) WindowServer; its lines go to the console (pmsg tail on the next TWRP boot). -->
<plist version="1.0">
<dict>
	<key>Label</key><string>com.starbite.sbmtltest</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/sbmtltest</string>
		<string>--seconds</string>
		<string>30</string>
	</array>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><false/>
	<key>LaunchOnlyOnce</key><true/>
	<key>StandardOutPath</key><string>/dev/console</string>
	<key>StandardErrorPath</key><string>/dev/console</string>
</dict>
</plist>
