+        let optional = std::env::var_os("METAL2VULKAN_CACHE_OPTIONAL").is_some_and(|v| v == "1");
+        let checked = (|| -> Result<(), Failed> {
+            create_private_dir_all(&directory.root).map_err(failed(&directory.root))?;
