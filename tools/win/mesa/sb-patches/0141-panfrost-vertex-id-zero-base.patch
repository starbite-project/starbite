+/* D3D10/11 SV_VertexID reaches us from d3d10umd as TGSI_SEMANTIC_VERTEXID_NOBASE,
+ * i.e. load_vertex_id_zero_base: the vertex number from 0 for Draw(), the raw
+ * index-buffer value (without BaseVertexLocation) for DrawIndexed(). Neither
+ * the Midgard nor the Bifrost backend implements that intrinsic (Bifrost
+ * printed "Unhandled intrinsic" and left the value undefined). Rewrite it as
+ * load_vertex_id - load_first_vertex: load_vertex_id is what GL uses
+ * (lowered to raw_vertex_id_pan + raw_vertex_offset_pan on v4-v7, native on
+ * v9+), and load_first_vertex is a sysval (index_bias for indexed draws,
+ * start otherwise), which is the base load_vertex_id already includes.
+ */
+static bool
+panfrost_lower_vertex_id_zero_base(nir_builder *b, nir_intrinsic_instr *intr,
+                                   UNUSED void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_load_vertex_id_zero_base)
+      return false;
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def_replace(&intr->def,
+                   nir_isub(b, nir_load_vertex_id(b), nir_load_first_vertex(b)));
+   return true;
+}
+
 static void *
 panfrost_create_shader_state(struct pipe_context *pctx,
                              const struct pipe_shader_state *cso)
@@ -583,6 +606,12 @@ panfrost_create_shader_state(struct pipe_context *pctx,
       so->fragcolor_lowered = true;
    }
 
+   /* Must run before pan_preprocess_nir, which lowers load_vertex_id. */
+   if (nir->info.stage == MESA_SHADER_VERTEX)
+      NIR_PASS(_, nir, nir_shader_intrinsics_pass,
+               panfrost_lower_vertex_id_zero_base, nir_metadata_control_flow,
+               NULL);
+
    /* Then run the suite of lowering and optimization, including I/O lowering */
    struct panfrost_device *dev = pan_device(pctx->screen);
    pan_preprocess_nir(nir, panfrost_device_gpu_id(dev));
