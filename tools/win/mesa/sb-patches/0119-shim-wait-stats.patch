 /* Wait until submission Seq of this device is done, for at most Ms milliseconds (0: just ask). 0 when done;
  * -MK_EBUSY (Ms 0) or -MK_ETIMEDOUT when not. */
+static int sb_wait_seq_inner(struct sbdev *d, uint64_t seq, DWORD ms);
+
+/* T23: every wait timed; a wait that took over 0.1 ms counts as blocked */
 static int
 sb_wait_seq(struct sbdev *d, uint64_t seq, DWORD ms)
+{
+   LARGE_INTEGER f, t0, t1;
+   int ret;
+   if (seq == 0 || seq <= d->done)
+      return 0;
+   QueryPerformanceFrequency(&f);
+   QueryPerformanceCounter(&t0);
+   ret = sb_wait_seq_inner(d, seq, ms);
+   QueryPerformanceCounter(&t1);
+   double el = (double)(t1.QuadPart - t0.QuadPart) * 1000.0 / (double)f.QuadPart;
+   d->st_waits++;
+   if (ret == -MK_EBUSY)
+      d->st_busy++;
+   if (el > 0.1) {
+      d->st_blocked++;
+      d->st_blocked_ms += el;
+      if (el > d->st_longest_ms)
+         d->st_longest_ms = el;
+   }
+   return ret;
+}
+
+static int
+sb_wait_seq_inner(struct sbdev *d, uint64_t seq, DWORD ms)
 {
    int ret;
 
