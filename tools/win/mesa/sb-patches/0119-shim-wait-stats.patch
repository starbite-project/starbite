+      } else if (now.QuadPart - d->st_t0.QuadPart >= 10 * f.QuadPart) {
+         double s10 = (double)(now.QuadPart - d->st_t0.QuadPart) / (double)f.QuadPart;
+         fprintf(stderr, "sbumd: stats %.1f s (device %u): %u submits, %u waits (%u blocked: %.1f ms, longest %.1f ms; "
+                 "%u answered busy), %u new CPU maps\n", s10, d->id, d->st_submits, d->st_waits, d->st_blocked,
+                 d->st_blocked_ms, d->st_longest_ms, d->st_busy, d->st_maps);
+         d->st_t0 = now;
