+static inline unsigned
+sb_present_thread_count(unsigned processors)
+{
+   if (processors < 1)
+      return 1;
+   return processors < SB_PRESENT_MAX_THREADS ? processors : SB_PRESENT_MAX_THREADS;
+}
+
+/* Bands per frame: two per thread, so a thread that wakes late takes fewer, but none under 16 rows. */
+static inline unsigned
+sb_present_band_count(unsigned height, unsigned threads)
+{
+   unsigned n = threads * 2, most = height / SB_PRESENT_BAND_MIN_ROWS;
+   if (n > most)
+      n = most;
+   return n ? n : 1;
+}
+
+/* Rows [*y0, *y1) of band i of n: the bands cover 0..height once, in order, sizes differing by at most one row. */
+static inline void
+sb_present_band_rows(unsigned height, unsigned n, unsigned i, unsigned *y0, unsigned *y1)
+{
+   *y0 = (unsigned)((uint64_t)height * i / n);
+   *y1 = (unsigned)((uint64_t)height * (i + 1) / n);
+}
+
+/* One row from uncached memory: every load is 16 bytes (64 per loop: four loads, then four stores), the tail of
+ * a row that isn't a multiple of 16 bytes by memcpy. */
+static inline void
+sb_present_copy_row_wide(uint8_t *d, const uint8_t *s, size_t n)
+{
+#if defined(SB_PRESENT_NEON)
+   for (; n >= 64; n -= 64, s += 64, d += 64) {
+      uint8x16_t a = vld1q_u8(s), b = vld1q_u8(s + 16), c = vld1q_u8(s + 32), e = vld1q_u8(s + 48);
+      vst1q_u8(d, a);
+      vst1q_u8(d + 16, b);
+      vst1q_u8(d + 32, c);
+      vst1q_u8(d + 48, e);
+   }
+   for (; n >= 16; n -= 16, s += 16, d += 16)
+      vst1q_u8(d, vld1q_u8(s));
+#elif defined(SB_PRESENT_SSE2)
+   for (; n >= 64; n -= 64, s += 64, d += 64) {
+      __m128i a = _mm_loadu_si128((const __m128i *)s), b = _mm_loadu_si128((const __m128i *)(s + 16));
+      __m128i c = _mm_loadu_si128((const __m128i *)(s + 32)), e = _mm_loadu_si128((const __m128i *)(s + 48));
+      _mm_storeu_si128((__m128i *)d, a);
+      _mm_storeu_si128((__m128i *)(d + 16), b);
+      _mm_storeu_si128((__m128i *)(d + 32), c);
+      _mm_storeu_si128((__m128i *)(d + 48), e);
+   }
+   for (; n >= 16; n -= 16, s += 16, d += 16)
+      _mm_storeu_si128((__m128i *)d, _mm_loadu_si128((const __m128i *)s));
+#endif
+   if (n)
+      memcpy(d, s, n);
+}
+
+/* One band's work, all of it CPU-only: the presenting thread and the pool's threads run it on disjoint rows. */
+struct sb_present_job {
+   uint8_t *dst;          /* the cached frame, dst_stride bytes per row */
+   size_t dst_stride;
+   const uint8_t *src;    /* the mapped back buffer, src_stride bytes per row */
+   size_t src_stride;
+   unsigned width;        /* pixels (4 bytes each) */
+   unsigned height;
+   unsigned bands;
+   enum sb_present_kind kind; /* SB_PRESENT_BGRX: copy; SB_PRESENT_RGBX: copy, then swap R/B in the cached row */
+};
+
+static inline void
+sb_present_run_band(const struct sb_present_job *job, unsigned band)
+{
+   unsigned y0, y1;
+   size_t row = (size_t)job->width * 4;
+   sb_present_band_rows(job->height, job->bands, band, &y0, &y1);
+   for (unsigned y = y0; y < y1; y++) {
+      uint8_t *d = job->dst + (size_t)y * job->dst_stride;
+      sb_present_copy_row_wide(d, job->src + (size_t)y * job->src_stride, row);
+      if (job->kind == SB_PRESENT_RGBX)
+         sb_present_rgba_to_bgra_rows(d, row, d, row, job->width, 1); /* in place: the row is cached now */
+   }
+}
+
 #endif
