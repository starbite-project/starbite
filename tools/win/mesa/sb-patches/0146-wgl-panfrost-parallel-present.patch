+
+static int64_t
+wgl_pan_now(void)
+{
+   LARGE_INTEGER t;
+   QueryPerformanceCounter(&t);
+   return t.QuadPart;
+}
+
+static void
+wgl_pan_stat_add(struct wgl_pan_stat *s, int64_t ticks)
+{
+   s->sum += ticks;
+   if (ticks > s->max)
+      s->max = ticks;
+   s->n++;
+}
+
+static double
+wgl_pan_ms(int64_t ticks)
+{
+   return (double)ticks * 1000.0 / (double)wgl_pan_stats.freq;
+}
+
+static void
+wgl_pan_stat_print(char *out, size_t len, const char *name, const struct wgl_pan_stat *s)
+{
+   snprintf(out, len, "%s avg %.1f / max %.1f ms", name, s->n ? wgl_pan_ms(s->sum) / s->n : 0.0,
+            wgl_pan_ms(s->max));
+}
+
+/* One frame's times (ticks; copy/gdi < 0: that step didn't run). Prints and restarts the window every 10 s. */
+static void
+wgl_pan_stats_frame(int64_t start, int64_t map, int64_t copy, int64_t gdi, int mode, unsigned w, unsigned h,
+                    bool hidden)
+{
+   int64_t end = wgl_pan_now();
+   simple_mtx_lock(&wgl_pan_stats_mtx);
+   if (!wgl_pan_stats.freq) {
+      LARGE_INTEGER f;
+      QueryPerformanceFrequency(&f);
+      wgl_pan_stats.freq = f.QuadPart ? f.QuadPart : 1;
+      wgl_pan_stats.window_start = start;
+   }
+   if (wgl_pan_stats.last_present)
+      wgl_pan_stat_add(&wgl_pan_stats.interval, start - wgl_pan_stats.last_present);
+   wgl_pan_stats.last_present = start;
+   wgl_pan_stats.frames++;
+   wgl_pan_stat_add(&wgl_pan_stats.map, map);
+   wgl_pan_stat_add(&wgl_pan_stats.total, end - start);
+   if (hidden) {
+      wgl_pan_stats.hidden++;
+   } else {
+      wgl_pan_stats.by_mode[mode]++;
+      if (copy >= 0)
+         wgl_pan_stat_add(&wgl_pan_stats.copy, copy);
+      if (gdi >= 0)
+         wgl_pan_stat_add(&wgl_pan_stats.gdi, gdi);
+   }
+   wgl_pan_stats.width = w;
+   wgl_pan_stats.height = h;
+
+   int64_t window = end - wgl_pan_stats.window_start;
+   if (window >= 10 * wgl_pan_stats.freq) {
+      double secs = (double)window / (double)wgl_pan_stats.freq;
+      char m[64], c[64], g[64], i[64], t[64];
+      wgl_pan_stat_print(m, sizeof(m), "map", &wgl_pan_stats.map);
+      wgl_pan_stat_print(c, sizeof(c), "copy", &wgl_pan_stats.copy);
+      wgl_pan_stat_print(g, sizeof(g), "gdi", &wgl_pan_stats.gdi);
+      wgl_pan_stat_print(i, sizeof(i), "interval", &wgl_pan_stats.interval);
+      wgl_pan_stat_print(t, sizeof(t), "present", &wgl_pan_stats.total);
+      fprintf(stderr,
+              "sbumd: glstats %.1f s: %u frames (%.1f fps, %u hidden); %s; %s; %s; %s; %s; mode %s, %u threads, "
+              "%ux%u (frames parallel %u, direct %u, copy %u)\n",
+              secs, wgl_pan_stats.frames, wgl_pan_stats.frames / secs, wgl_pan_stats.hidden, m, c, g, i, t,
+              wgl_pan_mode_name[wgl_panfrost_mode()], wgl_pan_pool.created ? wgl_pan_pool.threads : 1, w, h,
+              wgl_pan_stats.by_mode[WGL_PAN_PARALLEL], wgl_pan_stats.by_mode[WGL_PAN_DIRECT],
+              wgl_pan_stats.by_mode[WGL_PAN_COPY]);
+      int64_t freq = wgl_pan_stats.freq, last = wgl_pan_stats.last_present;
+      memset(&wgl_pan_stats, 0, sizeof(wgl_pan_stats));
+      wgl_pan_stats.freq = freq;
+      wgl_pan_stats.last_present = last;
+      wgl_pan_stats.window_start = end;
+   }
+   simple_mtx_unlock(&wgl_pan_stats_mtx);
+}
 
