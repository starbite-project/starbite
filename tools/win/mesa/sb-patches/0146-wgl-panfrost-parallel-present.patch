+
+/* Runs every band of `job` on the pool and this thread; returns when all are done. wgl_pan_present_mtx held. */
+static void
+wgl_pan_pool_run(const struct sb_present_job *job)
+{
+   AcquireSRWLockExclusive(&wgl_pan_pool.lock);
+   wgl_pan_pool.job = *job;
+   wgl_pan_pool.next = 0;
+   wgl_pan_pool.pending = job->bands;
+   ReleaseSRWLockExclusive(&wgl_pan_pool.lock);
+   WakeAllConditionVariable(&wgl_pan_pool.work);
+
+   AcquireSRWLockExclusive(&wgl_pan_pool.lock);
+   while (wgl_pan_pool.next < wgl_pan_pool.job.bands) {
+      unsigned band = wgl_pan_pool.next++;
+      ReleaseSRWLockExclusive(&wgl_pan_pool.lock);
+      sb_present_run_band(job, band);
+      AcquireSRWLockExclusive(&wgl_pan_pool.lock);
+      wgl_pan_pool.pending--;
+   }
+   while (wgl_pan_pool.pending)
+      SleepConditionVariableSRW(&wgl_pan_pool.done, &wgl_pan_pool.lock, INFINITE, 0);
+   ReleaseSRWLockExclusive(&wgl_pan_pool.lock);
+}
