+/* The copy threads. Created once, on the first frame the parallel present copies, and kept for the life of the
+ * process (never joined: joining in DllMain would deadlock on the loader lock). They run this DLL's code, so the
+ * DLL is pinned first (GET_MODULE_HANDLE_EX_FLAG_PIN): a FreeLibrary cannot unload it from under them. Idle, they
+ * sleep on a condition variable. Bands are handed out under the lock together with the job they belong to, so a
+ * thread that wakes late never mixes one frame's band number with another frame's pointers; the presenting thread
+ * takes bands too and waits until every band handed out is finished before it lets the mapping go. Only one
+ * present uses the pool at a time (wgl_pan_present_mtx). */
+static struct {
+   SRWLOCK lock;
+   CONDITION_VARIABLE work, done;
+   struct sb_present_job job; /* the frame being copied; job.bands == 0 until the first */
+   unsigned next;             /* next band to hand out; >= job.bands: none left */
+   unsigned pending;          /* bands handed out or not, not finished */
+   unsigned threads;          /* copying threads including the presenting one; 1: no pool */
+   bool created;
+} wgl_pan_pool = { SRWLOCK_INIT, CONDITION_VARIABLE_INIT, CONDITION_VARIABLE_INIT };
+
+static DWORD WINAPI
+wgl_pan_pool_main(void *arg)
+{
+   (void)arg;
+   AcquireSRWLockExclusive(&wgl_pan_pool.lock);
+   for (;;) {
+      while (wgl_pan_pool.next >= wgl_pan_pool.job.bands)
+         SleepConditionVariableSRW(&wgl_pan_pool.work, &wgl_pan_pool.lock, INFINITE, 0);
+      unsigned band = wgl_pan_pool.next++;
+      struct sb_present_job job = wgl_pan_pool.job;
+      ReleaseSRWLockExclusive(&wgl_pan_pool.lock);
+
+      sb_present_run_band(&job, band);
+
+      AcquireSRWLockExclusive(&wgl_pan_pool.lock);
+      if (--wgl_pan_pool.pending == 0)
+         WakeConditionVariable(&wgl_pan_pool.done);
+   }
+   return 0;
+}
+
+/* Called with wgl_pan_present_mtx held. */
+static unsigned
+wgl_pan_pool_threads(void)
+{
+   if (wgl_pan_pool.created)
+      return wgl_pan_pool.threads;
+   wgl_pan_pool.created = true;
+   wgl_pan_pool.threads = 1;
+
+   unsigned want = sb_present_thread_count((unsigned)GetActiveProcessorCount(ALL_PROCESSOR_GROUPS));
+   HMODULE self;
+   if (want < 2 || !GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                                       (LPCWSTR)(void *)wgl_pan_pool_main, &self)) {
+      fprintf(stderr, "sbumd: gl present: no copy threads (%u wanted, pin error %lu); one thread copies\n", want,
+              want < 2 ? 0ul : (unsigned long)GetLastError());
+      return 1;
+   }
+   for (unsigned i = 1; i < want; i++) {
+      HANDLE t = CreateThread(NULL, 64 * 1024, wgl_pan_pool_main, NULL, STACK_SIZE_PARAM_IS_A_RESERVATION, NULL);
+      if (!t)
+         break;
+      CloseHandle(t);
+      wgl_pan_pool.threads++;
+   }
+   fprintf(stderr, "sbumd: gl present: %u copy threads (this one + %u kept), %s loads\n", wgl_pan_pool.threads,
+           wgl_pan_pool.threads - 1, SB_PRESENT_SIMD);
