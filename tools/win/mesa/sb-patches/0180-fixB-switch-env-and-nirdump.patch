-   int nl = GetFileAttributesA("C:\\ProgramData\\Starbite\\zcnolist2") != INVALID_FILE_ATTRIBUTES;
+   int ds = malikm_switch("devstate");
+   int ro = malikm_switch("zcro2");
+   int nl = malikm_switch("zcnolist2");
 
