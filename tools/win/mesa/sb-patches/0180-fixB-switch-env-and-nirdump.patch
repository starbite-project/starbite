 static int
 trace_on(void)
 {
@@ -1175,15 +1189,121 @@ malikm_stat(unsigned id)
 }
 
 /* sb-patches/0126 (docs/WIN11-GPU.md 6.42): file switches under C:\ProgramData\Starbite (every process sees them,
- * DWM and the shell included, unlike environment variables), this process's image name, and the resource canary. */
-int
-malikm_switch(const char *name)
+ * DWM and the shell included, unlike environment variables), this process's image name, and the resource canary.
+ *
+ * T90: a flag file is a switch for the whole system. The conformance run created nirshaders for its own test
+ * programs, Windows started the Settings app a minute later, and that got the new shader translator too. So every
+ * switch can be set for one process tree instead: the environment variable SBSW_<NAME> (the name in upper case,
+ * anything that is not a letter or a digit as '_': SBSW_NIRSHADERS, SBSW_UMDLOG_DUMP) = 1 turns the switch on in
+ * this process whether the file is there or not, = 0 turns it off even if the file is there, and children inherit
+ * it. No variable (or any other value): the file decides, as before. The variable is read once per process per
+ * name; the file is looked at on every call, as before. One log line per switch an override decides. */
+struct sb_sw {
+   char name[80];
+   signed char ov;      /* 1 on, 0 off, -1 no variable, -2 a value that is neither 0 nor 1 */
+   char logged;
+   char val[8];
+};
+static struct sb_sw sb_sw_tab[40];
+static unsigned sb_sw_n;
+static SRWLOCK sb_sw_lock = SRWLOCK_INIT;
+
+static void
+sb_sw_var(const char *name, char *var, size_t size)
+{
+   size_t n = (size_t)snprintf(var, size, "SBSW_");
+
+   for (; *name && n + 1 < size; name++, n++) {
+      char c = *name;
+      if (c >= 'a' && c <= 'z')
+         c = (char)(c - 'a' + 'A');
+      else if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')))
+         c = '_';
+      var[n] = c;
+   }
+   var[n] = 0;
+}
+
+static int
+sb_sw_file(const char *name)
 {
    char p[MAX_PATH];
    snprintf(p, sizeof(p), "C:\\ProgramData\\Starbite\\%s", name);
    return GetFileAttributesA(p) != INVALID_FILE_ATTRIBUTES;
 }
 
+/* with sb_sw_lock held */
+static void
+sb_sw_log(struct sb_sw *s)
+{
+   char var[96];
+
+   if (s->logged || !sb_log_ready || s->ov == -1)
+      return;
+   s->logged = 1;
+   sb_sw_var(s->name, var, sizeof(var));
+   if (s->ov == -2)
+      fprintf(stderr, "sbumd: switch %s: %s=%s is neither 0 nor 1 and is ignored, the flag file decides\n",
+              s->name, var, s->val);
+   else
+      fprintf(stderr, "sbumd: switch %s: %s by the environment of this process (%s=%d; the flag file is %s)\n",
+              s->name, s->ov ? "ON" : "OFF", var, s->ov, sb_sw_file(s->name) ? "present" : "absent");
+}
+
+static void
+sb_sw_report(void)
+{
+   AcquireSRWLockExclusive(&sb_sw_lock);
+   for (unsigned i = 0; i < sb_sw_n; i++)
+      sb_sw_log(&sb_sw_tab[i]);
+   ReleaseSRWLockExclusive(&sb_sw_lock);
+}
+
+/* 1 / 0: the environment decides; -1: it does not */
+static int
+sb_sw_override(const char *name)
+{
+   struct sb_sw *s = NULL, tmp;
+   int ov;
+
+   AcquireSRWLockExclusive(&sb_sw_lock);
+   for (unsigned i = 0; i < sb_sw_n && !s; i++)
+      if (!strcmp(sb_sw_tab[i].name, name))
+         s = &sb_sw_tab[i];
+   if (!s) {
+      char var[96], val[8];
+      DWORD n;
+
+      /* a name too long for the table, or a full table: read every time, said once per call */
+      s = sb_sw_n < sizeof(sb_sw_tab) / sizeof(sb_sw_tab[0]) && strlen(name) < sizeof(s->name) ?
+          &sb_sw_tab[sb_sw_n++] : &tmp;
+      memset(s, 0, sizeof(*s));
+      snprintf(s->name, sizeof(s->name), "%s", name);
+      sb_sw_var(name, var, sizeof(var));
+      n = GetEnvironmentVariableA(var, val, sizeof(val));
+      if (n == 0) {
+         s->ov = -1;                     /* not set, or set to nothing */
+      } else if (n == 1 && (val[0] == '0' || val[0] == '1')) {
+         s->ov = val[0] == '1';
+      } else {
+         s->ov = -2;
+         snprintf(s->val, sizeof(s->val), "%s", n < sizeof(val) ? val : "...");
+      }
+   }
+   sb_sw_log(s);
+   ov = s->ov;
+   ReleaseSRWLockExclusive(&sb_sw_lock);
+   return ov >= 0 ? ov : -1;
+}
+
+int
+malikm_switch(const char *name)
+{
+   int ov = sb_sw_override(name);
+
+   return ov >= 0 ? ov : sb_sw_file(name);
+}
+
 const char *
