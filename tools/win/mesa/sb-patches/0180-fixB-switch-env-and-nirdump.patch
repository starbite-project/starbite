From f36a7ef9b153ce187656e89584054ceeec406bd0 Mon Sep 17 00:00:00 2001
From: Starbite build <build@starbite.invalid>
Date: Mon, 16 Nov 2026 22:49:20 +0200
Subject: [PATCH 2/2] fixB-2: with the switch nirdump every shader given to the
 NIR translator is written to umdlog as a DXBC container the host harness
 reads (SHDR/SHEX + an SBSG chunk with the DDI signature entries); every
 compiled variant (all stages) logs its stage, address and size, and with
 nirdump its NIR and binary; harness reads .dxbc files (T90: 134 fragment jobs
 INSTR_INVALID_ENC from XAML shaders through the NIR translator, no copy of
 the shaders off the phone)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/gallium/drivers/panfrost/pan_shader.c     | 37 ++++++++++
 src/gallium/frontends/d3d10umd/Shader.cpp     | 70 +++++++++++++++++++
 .../d3d10umd/tests/dxbc_nir_harness.c         | 53 ++++++++++++++
 3 files changed, 160 insertions(+)

diff --git a/src/gallium/drivers/panfrost/pan_shader.c b/src/gallium/drivers/panfrost/pan_shader.c
index 1315f9b..6a6cb88 100644
--- a/src/gallium/drivers/panfrost/pan_shader.c
+++ b/src/gallium/drivers/panfrost/pan_shader.c
@@ -97,6 +97,12 @@ static bool sb_retype_int_attribs(nir_builder *b, nir_intrinsic_instr *intr, voi
 
 #ifdef _WIN32
 int malikm_switch(const char *name);   /* the shim: SBSW_<NAME> of this process, else the flag file */
+__declspec(dllimport) unsigned long __stdcall GetCurrentProcessId(void);
+static unsigned long
+sb_pid(void)
+{
+   return GetCurrentProcessId();
+}
 #endif
 static bool
 sb_no_idvs(void)
@@ -338,6 +344,37 @@ panfrost_shader_get(struct pipe_screen *pscreen,
                                  res.binary.size, 128));
    }
 
+#ifdef _WIN32
+   /* fixB (from sb-b78 c3b663c, all stages): a line per compiled variant, so a failing job's shader address can be
+    * matched; with the switch nirdump its NIR and binary go to umdlog\nir-<pid>-<n>.txt */
+   if (res.binary.size) {
+      static int dump = -1;
+      static unsigned seq;
+      if (dump < 0)
+         dump = malikm_switch("nirdump") != 0;
+      fprintf(stderr, "sbumd: %s variant %p code 0x%llx, %u bytes%s\n",
+              mesa_shader_stage_name(uncompiled->nir->info.stage), (void *)state,
+              (unsigned long long)state->bin.gpu, (unsigned)res.binary.size, dump ? " (nirdump)" : "");
+      if (dump && seq < 600) {
+         char path[160];
+         snprintf(path, sizeof(path), "C:\\ProgramData\\Starbite\\umdlog\\nir-%lu-%u.txt",
+                  sb_pid(), seq++);
+         FILE *f = fopen(path, "w");
+         if (f) {
+            const uint8_t *d = (const uint8_t *)res.binary.data;
+            fprintf(f, "%s variant %p code 0x%llx size %u\n", mesa_shader_stage_name(uncompiled->nir->info.stage),
+                    (void *)state, (unsigned long long)state->bin.gpu, (unsigned)res.binary.size);
+            nir_print_shader(uncompiled->nir, f);
+            fprintf(f, "\nBINARY %u bytes:", (unsigned)res.binary.size);
+            for (unsigned i = 0; i < res.binary.size; i++)
+               fprintf(f, "%s%02x", (i % 32) ? "" : "\n", d[i]);
+            fprintf(f, "\nEND\n");
+            fclose(f);
+         }
+      }
+   }
+#endif
+
    util_dynarray_fini(&res.binary);
 
    /* Don't upload RSD for fragment shaders since they need draw-time
diff --git a/src/gallium/frontends/d3d10umd/Shader.cpp b/src/gallium/frontends/d3d10umd/Shader.cpp
index 7c50f60..2fb653d 100644
--- a/src/gallium/frontends/d3d10umd/Shader.cpp
+++ b/src/gallium/frontends/d3d10umd/Shader.cpp
@@ -165,6 +165,74 @@ static struct nir_shader *
 SbTranslateNirSig(Device *pDevice, mesa_shader_stage stage, const UINT *pCode,
                   const struct Shader_nir_signature *signature, unsigned *output_mapping, bool force = false);
 
+/* fixB (T90: 134 fragment jobs failed with INSTR_INVALID_ENC once a XAML app's shaders went through the NIR
+ * translator; no copy of those shaders exists off the phone). With the switch nirdump, every shader the NIR
+ * translator is given is written to umdlog\dxbc-<pid>-<n>.dxbc as a DXBC container the host harness reads
+ * (tests/dxbc_nir_harness.c): the token stream as an SHDR / SHEX chunk, and the DDI's signature entries as a chunk
+ * "SBSG" (counts in, out, patch constants, then 4 words per entry: system value, register, mask, stream). The hash in
+ * the log line is FNV-1a of the tokens. At most 600 files a process. */
+static void
+SbDumpDxbc(mesa_shader_stage stage, const UINT *pCode, const struct Shader_nir_signature *sig)
