+/* Starbite (sb-patches/0153, docs/WIN11-GPU.md 6.60): the CPU range of a resource's BO. wgl's async present checks
+ * that a READ map of a window's back buffer points into it (the BO itself, linear: no staging copy), so the pointer
+ * stays valid after the unmap while the resource is referenced. */
+bool panfrost_sb_bo_cpu_range(struct pipe_resource *p, const uint8_t **base, size_t *size);
+bool
+panfrost_sb_bo_cpu_range(struct pipe_resource *p, const uint8_t **base, size_t *size)
+{
+   struct panfrost_resource *rsc = p ? pan_resource(p) : NULL;
+   if (!rsc || !rsc->bo || !rsc->bo->ptr.cpu)
+      return false;
+   *base = (const uint8_t *)rsc->bo->ptr.cpu;
+   *size = panfrost_bo_size(rsc->bo);
+   return true;
+}
