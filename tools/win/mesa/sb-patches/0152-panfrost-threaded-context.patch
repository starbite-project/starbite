+/* Starbite (sb-patches/0152): u_threaded_context's buffer invalidation. tc allocated `src` (a fresh buffer, mapped
+ * from the application thread as tc's "latest" storage) and queued this call: `dst` (the resource GL binds) takes
+ * src's BO. Runs in the driver thread, in order with the draws.
+ *  - Batches still using dst's old BO hold their own references to it (panfrost_batch_add_bo_old), so it lives
+ *    until they are done; tracking is per BO handle, so later draws track the new BO.
+ *  - Every descriptor that may hold the old address is re-emitted (all state dirty; sampler views compare
+ *    texture_bo with plane.base and rebuild).
+ *  - dst's writer entry described the old storage; dst's index-bounds cache too, and later writes reach the new
+ *    storage through tc's "latest" resource, whose unmaps invalidate *its* cache: dst stops caching for good. */
+void
+panfrost_sb_tc_replace_buffer_storage(struct pipe_context *pctx, struct pipe_resource *pdst,
+                                      struct pipe_resource *psrc, unsigned num_rebinds,
+                                      uint64_t rebind_mask, uint32_t delete_buffer_id)
+{
+   struct panfrost_context *ctx = pan_context(pctx);
+   struct panfrost_resource *dst = pan_resource(pdst);
+   struct panfrost_resource *src = pan_resource(psrc);
+
+   assert(pdst->target == PIPE_BUFFER && psrc->target == PIPE_BUFFER);
+   assert(!dst->separate_stencil && !dst->shadow_image);
+
+   _mesa_hash_table_remove_key(ctx->writers, dst);
+
+   if (dst->owns_label) {
+      char *old_label = (char *)panfrost_bo_replace_label(dst->bo, "Replaced buffer storage", false);
+      free(old_label);
+   }
+   panfrost_bo_reference(src->bo);
+   panfrost_bo_unreference(dst->bo);
+   dst->bo = src->bo;
+   dst->owns_label = false; /* src keeps the label */
+   dst->plane.base = dst->bo->ptr.gpu;
+   pan_crc_state_set_ptr(&dst->crc_state, &dst->bo->ptr);
+
+   util_range_set_empty(&dst->valid_buffer_range);
+   util_range_add(&dst->base, &dst->valid_buffer_range, 0, dst->base.width0);
+   BITSET_SET(dst->valid.data, 0);
+
+   free(dst->index_cache);
+   dst->index_cache = NULL;
+
+   panfrost_dirty_state_all(ctx);
+
+   if (delete_buffer_id)
+      util_idalloc_mt_free(&pan_screen(pctx->screen)->buffer_ids, delete_buffer_id);
+}
