+/* sb-patches/0152: tc asks this from the application thread, for buffers no unexecuted tc batch references. Busy
+ * if an unsubmitted batch holds the BO (sb_batch_users, any context), else if the GPU still uses it. Reads only
+ * atomics and the kernel: bo->gpu_access is left to the driver thread. */
+bool
+panfrost_sb_tc_is_resource_busy(struct pipe_screen *pscreen, struct pipe_resource *pres, unsigned usage)
+{
+   struct panfrost_bo *bo = pan_resource(pres)->bo;
+
+   if (!bo)
+      return true;
+   if (p_atomic_read(&bo->sb_batch_users))
+      return true;
+
+   bool wait_readers = usage & PIPE_MAP_WRITE;
+
+   if (!(bo->flags & PAN_BO_SHARED)) {
+      uint32_t access = p_atomic_read(&bo->gpu_access);
+
+      if (!access)
+         return false;
+      if (!wait_readers && !(access & PAN_BO_ACCESS_WRITE))
+         return false;
+   }
+
+   return !pan_kmod_bo_wait(bo->kmod_bo, 0, !wait_readers);
+}
