+/* Starbite (sb-patches/0152): u_threaded_context for Panfrost, PAN_THREADED=1 (default off).
+ * The GL thread records gallium calls; a driver thread runs Panfrost's state processing and command building.
+ * - Fences: no create_fence callback, so every tc flush is synchronous (tc drains its queue, then panfrost_flush
+ *   runs and creates the fence as before); deferred fences behave as before.
+ * - Buffer renames: panfrost_sb_tc_replace_buffer_storage; Panfrost no longer renames buffers itself under tc.
+ * - Busy checks: panfrost_sb_tc_is_resource_busy (unsubmitted batches per BO + the kernel).
+ * - get_query_result: tc calls it from the application thread once the query was flushed; Panfrost's version
+ *   reads the context's batches, so it syncs first.
+ * - The WGL present maps the back buffer through the wrapped context: tc_texture_map drains the queue first. */
+static bool
+panfrost_sb_tc_get_query_result(struct pipe_context *pipe, struct pipe_query *q, bool wait,
+                                union pipe_query_result *result)
+{
+   struct panfrost_context *ctx = pan_context(threaded_context(pipe)->pipe);
+
+   threaded_context_unwrap_sync(pipe);
+   return ctx->sb_tc_get_query_result(pipe, q, wait, result);
+}
+
+static struct pipe_context *
+panfrost_sb_wrap_threaded(struct panfrost_context *ctx, unsigned flags)
+{
+   struct pipe_context *gallium = &ctx->base;
+   struct panfrost_screen *screen = pan_screen(gallium->screen);
+
+   if (!screen->sb_threaded || !(flags & PIPE_CONTEXT_PREFER_THREADED) ||
+       (flags & PIPE_CONTEXT_COMPUTE_ONLY))
+      return gallium;
+
+   ctx->sb_tc = true; /* before tc can call a create_* from the application thread */
+
+   struct threaded_context *tc = NULL;
+   struct pipe_context *tpipe = threaded_context_create(
+      gallium, &screen->transfer_pool, panfrost_sb_tc_replace_buffer_storage,
+      &(struct threaded_context_options){
+         .is_resource_busy = panfrost_sb_tc_is_resource_busy,
+      },
+      &tc);
+
+   if (!tpipe)
+      return NULL; /* tc destroyed the context */
+
+   if (tpipe == gallium) {
+      ctx->sb_tc = false; /* GALLIUM_THREAD=0 */
+      return gallium;
+   }
+
+   ctx->tc = tc;
+   threaded_context_init_bytes_mapped_limit(tc, 16);
+   tc->bytes_replaced_limit = tc->bytes_mapped_limit / 4;
+
+   ctx->sb_tc_get_query_result = tpipe->get_query_result;
+   tpipe->get_query_result = panfrost_sb_tc_get_query_result;
+
+   static bool logged;
+   if (!logged) {
+      logged = true;
+      fprintf(stderr, "sbumd: panfrost: threaded context on (PAN_THREADED=1)\n");
+   }
+   return tpipe;
+}
