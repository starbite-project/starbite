diff --git a/src/gallium/frontends/d3d10umd/DxgiFns.cpp b/src/gallium/frontends/d3d10umd/DxgiFns.cpp
index 475941b..1f4f2f0 100644
--- a/src/gallium/frontends/d3d10umd/DxgiFns.cpp
+++ b/src/gallium/frontends/d3d10umd/DxgiFns.cpp
@@ -61,6 +61,46 @@
  * copies all tested right. One row (the middle one) of the source is GPU-copied to a staging texture and read:
  * 32 samples across it, logged to the umdlog and as UmdNote_20 (the centre pixel), 21/22 (presents with some /
  * no non-black sample). The first 24 presents of each process, then every 64th. */
+struct Resource *sbOpened[SB_OPENED_MAX];
+
+/* One row (the middle one) of a 32-bit 2D resource, GPU-copied to staging and read: the non-black count of 32
+ * samples, the centre pixel. -1 if it cannot be sampled. */
+static int
+sb_sample_row(struct pipe_context *pipe, struct pipe_resource *src, uint32_t *centre)
+{
+   if (!src || src->target != PIPE_TEXTURE_2D || util_format_get_blocksize(src->format) != 4)
+      return -1;
+   struct pipe_resource t;
+   memset(&t, 0, sizeof t);
+   t.target = PIPE_TEXTURE_2D;
+   t.format = src->format;
+   t.width0 = src->width0;
+   t.height0 = 1;
+   t.depth0 = 1;
+   t.array_size = 1;
+   t.usage = PIPE_USAGE_STAGING;
+   struct pipe_resource *st = pipe->screen->resource_create(pipe->screen, &t);
+   if (!st)
+      return -1;
+   struct pipe_box box, all;
+   u_box_2d(0, src->height0 / 2, src->width0, 1, &box);
+   pipe->resource_copy_region(pipe, st, 0, 0, 0, 0, src, 0, &box);
+   u_box_2d(0, 0, src->width0, 1, &all);
+   struct pipe_transfer *tr = NULL;
+   const uint32_t *px = (const uint32_t *)pipe->texture_map(pipe, st, 0, PIPE_MAP_READ, &all, &tr);
+   int k = -1;
+   if (px) {
+      k = 0;
+      for (unsigned i = 0; i < 32; i++)
+         if (px[(src->width0 * (2 * i + 1)) / 64] & 0x00ffffffu)
+            k++;
+      *centre = px[src->width0 / 2];
+      pipe->texture_unmap(pipe, tr);
+   }
+   pipe_resource_reference(&st, NULL);
+   return k;
+}
+
 static void
 sb_sample_present(struct pipe_context *pipe, Resource *res, unsigned alloc, unsigned flags)
 {
@@ -107,6 +147,15 @@ sb_sample_present(struct pipe_context *pipe, Resource *res, unsigned alloc, unsi
                   flags, centre, nonblack, s[0], s[4], s[8], s[12], s[16], s[20], s[24], s[28]);
    }
    pipe_resource_reference(&st, NULL);
+   /* sb-patches/0108: what this process (DWM) sees in the surfaces it opened from others */
+   for (unsigned i = 0; i < SB_OPENED_MAX; i++) {
+      Resource *o = sbOpened[i];
+      uint32_t c = 0;
+      int k = o ? sb_sample_row(pipe, o->resource, &c) : -1;
+      if (k >= 0)
+         DebugPrintf("sbumd:   opened alloc 0x%x %ux%u: centre 0x%08x, %d/32 non-black\n", o->sbAllocation,
+                     o->resource->width0, o->resource->height0, c, k);
+   }
 }
 
