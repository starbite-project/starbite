+static bool sb_retype_int_attribs(nir_builder *b, nir_intrinsic_instr *intr, void *data);
+
 static void
 panfrost_shader_compile(struct panfrost_screen *screen, const nir_shader *ir,
                         struct util_debug_callback *dbg,
@@ -104,6 +106,9 @@ panfrost_shader_compile(struct panfrost_screen *screen, const nir_shader *ir,
 
    nir_shader *s = nir_shader_clone(NULL, ir);
 
+   if (s->info.stage == MESA_SHADER_VERTEX && key->vs.int_attribs)
+      NIR_PASS(_, s, nir_shader_intrinsics_pass, sb_retype_int_attribs, nir_metadata_all, &key->vs.int_attribs);
+
    /* While graphics shaders are preprocessed at CSO create time, compute
     * kernels are not preprocessed until they're cloned since the driver does
     * not get ownership of the NIR from compute CSOs. Do this preprocessing now.
@@ -302,6 +307,23 @@ panfrost_build_vs_key(struct panfrost_context *ctx,
 
    assert(fs != NULL && "too early");
    key->noperspective_varyings = fs->noperspective_varyings;
+   key->int_attribs = ctx->sb_int_attribs;   /* element i = input i (driver_location; inputs_read is VERT_ATTRIB-based) */
+}
+
+/* Starbite (sb-patches/0115): a float32 vertex input fed by a pure-integer element is loaded as uint32 (Bifrost's
+ * .auto32: the bits as they are, as for GL's integer attributes). Input i is element i (d3d10umd puts each element
+ * at its input register; tgsi_to_nir's driver_location is that register). */
+static bool
+sb_retype_int_attribs(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   uint32_t mask = *(const uint32_t *)data;
+   if (intr->intrinsic != nir_intrinsic_load_input || !nir_src_is_const(intr->src[0]))
+      return false;
+   unsigned slot = nir_intrinsic_base(intr) + nir_src_as_uint(intr->src[0]);
+   if (slot >= 32 || !(mask & (1u << slot)) || nir_intrinsic_dest_type(intr) != nir_type_float32)
+      return false;
+   nir_intrinsic_set_dest_type(intr, nir_type_uint32);
+   return true;
 }
 
