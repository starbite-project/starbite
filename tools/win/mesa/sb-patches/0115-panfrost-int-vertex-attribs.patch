+++ b/src/gallium/drivers/panfrost/pan_context.c
@@ -305,6 +305,21 @@ panfrost_bind_vertex_elements_state(struct pipe_context *pctx, void *hwcso)
    struct panfrost_context *ctx = pan_context(pctx);
    ctx->vertex = hwcso;
    ctx->dirty |= PAN_DIRTY_VERTEX;
+
+   /* Starbite (sb-patches/0115, docs/WIN11-GPU.md 6.26): D3D10 vertex shaders (TGSI) carry no input types, so
+    * tgsi_to_nir loads every input as float32, and the hardware would convert an integer attribute (R32_UINT...)
+    * to a float value. The vertex shader variant is keyed on which elements are pure integers; those inputs are
+    * loaded raw. (T18 loaded every attribute raw: Bifrost's .auto32 then broke the float formats.) */
+   uint32_t mask = hwcso ? *(const uint32_t *)hwcso : 0;   /* panfrost_vertex_state.sb_int_mask, first member */
+   if (mask != ctx->sb_int_attribs) {
+      ctx->sb_int_attribs = mask;
+      if (ctx->uncompiled[MESA_SHADER_VERTEX]) {
+         ctx->dirty |= PAN_DIRTY_TLS_SIZE;
+         ctx->dirty_shader[MESA_SHADER_VERTEX] |= PAN_DIRTY_STAGE_SHADER;
+         panfrost_update_shader_variant(ctx, MESA_SHADER_VERTEX);
+         panfrost_update_shader_variant(ctx, MESA_SHADER_FRAGMENT);
+      }
+   }
 }
 
