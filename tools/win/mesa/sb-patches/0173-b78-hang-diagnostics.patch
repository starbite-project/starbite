From e2037d3b4b9e4d42684456611d039daadd580f20 Mon Sep 17 00:00:00 2001
From: Starbite build <build@starbite.invalid>
Date: Mon, 16 Nov 2026 17:08:31 +0200
Subject: [PATCH] b78: diagnostics for the DWM job-timeout storm (T78) and no
 destroy after a timed-out idle wait

- malikm_drm.c: every 10 s stats block gets the wall clock, the longest allocation list and the KMD failure counters
  (MW_ESCAPE_STATS); a line with the clock when the KMD timeout counter moved (at the 10 s tick, after a wait of
  300 ms or more, after a wait that gave up), with this device submissions, live BOs and what its last allocation
  list held; opens and closes of another process allocation carry the clock; a full allocation list (256 entries)
  is counted and the BOs left out are counted (first four logged)
- draw trace: after a KMD timeout this process waited behind, the next 96 chains log one line per chain and per draw
  (job GPU address, vertex shader, vertex and index counts, index buffer address, target size), at most 3 times per
  process: the KMD hang record names the hung job by address
- GEM_CLOSE of a resource allocation waited 10 s for the device to be idle and destroyed the allocation whatever the
  wait said; now it keeps waiting (up to 60 s, logged). Flag file b78nowait: the old behaviour
- flag file listall = SB_LIST_ALL=1 (environment variables do not reach DWM)
Compiled only (ARM64X, verify FAILS 0, init tables 0); never run.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 include/win32-compat/malikm_drm.c     | 187 +++++++++++++++++++++++++-
 src/gallium/drivers/panfrost/pan_jm.c |  26 ++++
 2 files changed, 207 insertions(+), 6 deletions(-)

diff --git a/include/win32-compat/malikm_drm.c b/include/win32-compat/malikm_drm.c
index 19be571..c6c336f 100644
--- a/include/win32-compat/malikm_drm.c
+++ b/include/win32-compat/malikm_drm.c
@@ -904,6 +904,11 @@ struct sbdev {
    uint32_t *pend_bos;
    unsigned st_merged;
    int no_merge;           /* SB_NO_MERGE=1 */
+   /* b78 (docs/WIN11-GPU.md 6.104, T78: DWM job timeouts): the KMD's failure counters as last seen by this device,
+    * what the last allocation list held, and how often a list was full before every BO that wanted in was in it */
+   uint32_t k_timeouts, k_failed, k_resets, k_seen;
+   uint32_t ll_named, ll_opened, ll_other, ll_total, ll_dropped;
+   unsigned st_list_max, st_list_dropped, st_wait_timeouts;
 };
 
 /* T30: Panfrost's mark on a vertex/tiler submit whose fragment submit follows at once (pan_jm.c, sb-patches/0124) */
@@ -1217,6 +1222,99 @@ malikm_canary(const char *what, const void *rsrc, unsigned magic, const void *re
 
 static __declspec(thread) HRESULT sb_alloc_hr;   /* T15: the runtime's answer to the last allocation */
 
+/* ---- b78: when did the KMD start timing jobs out, and what was this device doing ----
+ * T78's logs carry no clock after the first line and the KMD's hang times count from its own start, so the storm's
+ * first second could only be bracketed (docs: build/win/patchwork/b78-report.md). Every line below has the wall
+ * clock. Nothing here changes what is submitted. */
+static const char *
+sb_clock(char *b, size_t n)
+{
+   SYSTEMTIME t;
+   GetLocalTime(&t);
+   snprintf(b, n, "%02u:%02u:%02u.%03u", t.wHour, t.wMinute, t.wSecond, t.wMilliseconds);
+   return b;
+}
+
+/* Per-draw lines for the next sb_draw_trace chains of this process (Panfrost asks malikm_draw_trace per draw and
+ * tells malikm_draw_trace_chain per submitted chain): armed when this process itself sat behind a KMD timeout, at
+ * most SB_TRACE_ARMS times, so the log stays small. The KMD's Live_HangLog names the hung job by GPU address
+ * ("head 0x..."): the draw line with that address says which draw it was. */
+#define SB_TRACE_CHAINS 96
+#define SB_TRACE_ARMS 3
+static volatile LONG sb_draw_trace, sb_draw_arms;
+
+int
+malikm_draw_trace(void)
+{
+   return sb_draw_trace > 0;
+}
+
+void
+malikm_draw_trace_chain(unsigned long long jc, unsigned reqs, unsigned bos, unsigned w, unsigned h, unsigned draws)
+{
+   char c[16];
+   if (sb_draw_trace <= 0)
+      return;
+   fprintf(stderr, "sbumd: %s chain jc 0x%llx %s, %u BOs named, target %ux%u, %u draws in the batch (trace: %ld left)\n",
+           sb_clock(c, sizeof c), jc, (reqs & 1) ? "fragment" : "vertex/tiler", bos, w, h, draws,
+           (long)InterlockedDecrement(&sb_draw_trace));
+}
+
+/* Ask the KMD for its failure counters; when timeouts were added since this device last looked, say so with the
+ * clock, where this device stood and what its last allocation list held. `ms`: how long the caller was just blocked
+ * (0: the 10 s tick). Returns the number of new timeouts. Called with d->lock held. */
+static unsigned
+sb_kmd_check(struct sbdev *d, const char *why, double ms)
+{
+   MW_ESCAPE_STATS_DATA st = {0};
+   unsigned add;
+   char c[16];
+
+   if (!d->on || !sb_log_active)
+      return 0;
+   st.Code = MW_ESCAPE_STATS;
+   if (w_escape(d, &st, sizeof(st)) < 0)
+      return 0;
+   if (!d->k_seen) {
+      d->k_seen = 1;
+      d->k_timeouts = st.JobsTimedOut;
+      d->k_failed = st.JobsFailed;
+      d->k_resets = st.Resets;
+      if (!st.JobsTimedOut)
+         return 0;
+      add = st.JobsTimedOut;            /* already there when this device first looked */
+   } else {
+      add = st.JobsTimedOut - d->k_timeouts;
+   }
+   if (add || st.JobsFailed != d->k_failed) {
+      unsigned live = 0, opened = 0;
+      for (uint32_t i = 0; i < d->bo_cap; i++)
+         if (d->bo[i].h) {
+            live++;
+            opened += d->bo[i].kind == 2;
+         }
+      fprintf(stderr, "sbumd: %s KMD job timeouts %u (+%u), failed jobs %u (+%u), resets %u; js 0x%x fault 0x%x @0x%llx; "
+              "queued %u running %u; maps %u unmaps %u; seen at %s (%.1f ms)\n", sb_clock(c, sizeof c),
+              (unsigned)st.JobsTimedOut, add, (unsigned)st.JobsFailed, (unsigned)(st.JobsFailed - d->k_failed),
+              (unsigned)st.Resets, (unsigned)st.LastJsStatus, (unsigned)st.LastFaultStatus,
+              (unsigned long long)st.LastFaultAddress, (unsigned)st.Queued, (unsigned)st.Running, (unsigned)st.Maps,
+              (unsigned)st.Unmaps, why, ms);
+      fprintf(stderr, "sbumd:   device %u: submissions %llu, known done %llu, closed not destroyed %u; %u BOs live "
+              "(%u opened from other processes); last list %u = %u named + %u opened + %u others of %u, %u left out\n",
+              d->id, (unsigned long long)d->seq, (unsigned long long)d->done, d->dead_n, live, opened, d->ll_total,
+              d->ll_named, d->ll_opened, d->ll_other, d->alloc_size, d->ll_dropped);
+      /* this process waited behind the timeouts: its own chains are the suspects (the KMD's counter is global) */
+      if (add && ms >= 300.0 && InterlockedIncrement(&sb_draw_arms) <= SB_TRACE_ARMS) {
+         InterlockedExchange(&sb_draw_trace, SB_TRACE_CHAINS);
+         fprintf(stderr, "sbumd:   draw trace on for the next %d chains of this process\n", SB_TRACE_CHAINS);
+      }
+   }
+   d->k_timeouts = st.JobsTimedOut;
+   d->k_failed = st.JobsFailed;
+   d->k_resets = st.Resets;
+   return add;
+}
+
 static NTSTATUS
 w_create(struct sbdev *d, D3DDDI_ALLOCATIONINFO *ai)
 {
@@ -1604,6 +1702,17 @@ sb_wait_seq(struct sbdev *d, uint64_t seq, DWORD ms)
       if (el > d->st_longest_ms)
          d->st_longest_ms = el;
    }
+   /* b78: a wait the GPU should never need (a chain's limit in the KMD is 750 ms), or one that gave up */
+   if (ret == -MK_ETIMEDOUT && ms >= 1000) {
+      char c[16];
+      if (d->st_wait_timeouts++ < 40 && sb_log_active)
+         fprintf(stderr, "sbumd: %s a wait for submission %llu gave up after %.0f ms (device %u: made %llu, known done "
+                 "%llu)\n", sb_clock(c, sizeof c), (unsigned long long)seq, el, d->id, (unsigned long long)d->seq,
+                 (unsigned long long)d->done);
+      (void)sb_kmd_check(d, "a wait that gave up", el);
+   } else if (el >= 300.0) {
+      (void)sb_kmd_check(d, "a long wait", el);
+   }
    return ret;
 }
 
@@ -1693,6 +1802,30 @@ wddm_idle(struct sbdev *d)
    return ret;
 }
 
+/* b78: wddm_idle for callers that destroy something next. wddm_idle gives up after 10 s and its callers went on to
+ * destroy a resource's allocation that queued jobs could still use (T78: DWM's log has waits of 9999.5-10000.9 ms in
+ * six 10 s windows of the storm, each timeout of 752 ms holding the queue). A job that reads a destroyed allocation
+ * finds no page there, which is how this GPU's vertex/tiler jobs stalled in T46-T48. Now: up to a minute, each
+ * round logged. The flag file b78nowait gives the old behaviour (one 10 s wait). */
+static int
+sb_idle_sure(struct sbdev *d, const char *what)
+{
+   int ret = wddm_idle(d);
+   if (ret != -MK_ETIMEDOUT || malikm_switch("b78nowait"))
+      return ret;
+   for (int round = 1; round <= 5 && ret == -MK_ETIMEDOUT; round++) {
+      char c[16];
+      if (sb_log_active)
+         fprintf(stderr, "sbumd: %s device %u not idle after %d s, before %s: waiting on (made %llu, known done %llu)\n",
+                 sb_clock(c, sizeof c), d->id, round * 10, what, (unsigned long long)d->seq,
+                 (unsigned long long)d->done);
+      ret = wddm_idle(d);
+   }
+   if (ret == -MK_ETIMEDOUT && sb_log_active)
+      fprintf(stderr, "sbumd: device %u still not idle after 60 s, before %s: going on\n", d->id, what);
+   return ret;
+}
+
 /* A relative timeout from the marshalled call (ns; MALIKM_TIMEOUT_INFINITE), in ms, bounded by 10 s as
  * before (a GPU that does not finish in 10 s has hung; the KMD's own timeout is 2 s per job). */
 static DWORD
@@ -1786,7 +1919,7 @@ malikm_bind_d3dddi(HANDLE hRTAdapter, HANDLE hRTDevice, const void *pKTCallbacks
    g.Code = MW_ESCAPE_GPU_INFO;
    if (cb->pfnEscapeCb(hRTAdapter, &e) >= 0 && g.Count != 0 && g.Valid != 0 && (d = sb_new_dev()) != NULL) {
       const char *la = getenv("SB_LIST_ALL");
-      d->list_all = la && *la == '1';
+      d->list_all = (la && *la == '1') || malikm_switch("listall");   /* b78: flag file; SB_LIST_ALL never reaches DWM */
       const char *nm = getenv("SB_NO_MERGE");
       d->no_merge = nm && *nm == '1';   /* T30: SB_NO_MERGE=1, every chain its own Render */
       sb_read_flags(d, "its creation");
@@ -2062,6 +2195,7 @@ wddm_drm(struct sbdev *d, uint32_t nr, uint8_t *b, uint32_t size)
        * translation faults (0x4002c3) at 0xa131000, the first byte of a 64 KiB BO, in every present.exe
        * run. T15: listed as read, not written (no write hazards for VidMm to order on). */
       uint32_t named = n;
+      uint32_t b78_opened = 0, b78_dropped = 0;
       /* T25: a BO not named here is listed until it has been made resident once, then only in a full refresh every
        * 64 submissions (VidMm keeps allocations resident unless it needs the room). T23: every DWM submission listed
        * 120-250 allocations, all processed by the runtime and VidMm, ~135 submissions a second on the A55s. */
@@ -2071,8 +2205,15 @@ wddm_drm(struct sbdev *d, uint32_t nr, uint8_t *b, uint32_t size)
          if (bo)
             bo->listed_once = 1;
       }
-      for (uint32_t i = 0; i < d->bo_cap && n < d->alloc_size; i++) {
+      for (uint32_t i = 0; i < d->bo_cap; i++) {
          struct wbo *bo = &d->bo[i];
+         if (n >= d->alloc_size) {
+            /* b78: the list is full (MW_LIST_SIZE entries): count what wanted in and stays out. An opened allocation
+             * left out is exactly what 0138 was written to prevent; a new BO left out has never been resident. */
+            if (bo->h && bo->listed != d->mark && !(bo->listed_once && !refresh && (bo->kind != 2 || d->nolist2)))
+               b78_dropped++;
+            continue;
+         }
          /* sb-patches/0138 (docs/WIN11-GPU.md 6.54, T46): an allocation opened from another process (kind 2: a
           * window surface DWM composes) goes into EVERY submission. T46 resolved all its GPU faults to such
           * allocations: owned by explorer / TextInputHost, unmapped by VidMm (mapped 0, unmaps > 0), not listed by
@@ -2085,8 +2226,22 @@ wddm_drm(struct sbdev *d, uint32_t nr, uint8_t *b, uint32_t size)
          bo->list_idx = n;
          memset(&d->alloc[n], 0, sizeof(d->alloc[n]));
          d->alloc[n].hAllocation = bo->h;
+         b78_opened += bo->kind == 2;
          n++;
       }
+      d->ll_named = named;
+      d->ll_opened = b78_opened;
+      d->ll_other = n - named - b78_opened;
+      d->ll_total = n;
+      d->ll_dropped = b78_dropped;
+      if (n > d->st_list_max)
+         d->st_list_max = n;
+      if (b78_dropped) {
+         if (d->st_list_dropped++ < 4 && sb_log_active)
+            fprintf(stderr, "sbumd: allocation list full: %u of %u entries (%u named, %u opened), %u more BOs left out "
+                    "(device %u, submission %llu%s)\n", n, d->alloc_size, named, b78_opened, b78_dropped, d->id,
+                    (unsigned long long)d->seq + 1, refresh ? ", a refresh" : "");
+      }
       if (trace_on() && n != named)
          fprintf(stderr, "malikm-wddm: submit names %u BOs, %u more listed for residency\n",
                  named, n - named);
@@ -2159,13 +2314,20 @@ wddm_drm(struct sbdev *d, uint32_t nr, uint8_t *b, uint32_t size)
       if (bo->cpu)
          w_unlock(d, bo->h);
       if (bo->kind == 2) {               /* opened: the runtime's */
+         if (sb_log_active) {            /* b78: when DWM lets go of another process's surface */
+            char c[16];
+            fprintf(stderr, "sbumd: %s closed opened allocation 0x%x (bo %u, va 0x%llx; device %u: made %llu, known "
+                    "done %llu, last named by %llu)\n", sb_clock(c, sizeof c), (unsigned)bo->h,
+                    ((struct drm_gem_close *)b)->handle, (unsigned long long)bo->va, d->id,
+                    (unsigned long long)d->seq, (unsigned long long)d->done, (unsigned long long)bo->used);
+         }
          memset(bo, 0, sizeof(*bo));
          return 0;
       }
       d->mem_live -= bo->size;
       if (bo->kind == 1) {               /* a resource's: released by resource, once nothing uses it */
          HANDLE hres = bo->hres;
-         wddm_idle(d);
+         (void)sb_idle_sure(d, "a resource's allocation is destroyed");   /* b78: was wddm_idle, result ignored */
          w_destroy_res(d, hres);
          memset(bo, 0, sizeof(*bo));
          return 0;
@@ -2175,7 +2337,7 @@ wddm_drm(struct sbdev *d, uint32_t nr, uint8_t *b, uint32_t size)
          uint32_t cap = d->dead_cap ? d->dead_cap * 2 : WDEAD_FLUSH * 2;
          struct wdead *n = realloc(d->dead, cap * sizeof(*n));
          if (!n) {
-            wddm_idle(d);
+            (void)sb_idle_sure(d, "a closed allocation is destroyed");    /* b78 */
             w_destroy(d, bo->h);
             memset(bo, 0, sizeof(*bo));
             return 0;
@@ -2330,6 +2492,15 @@ wddm_ioctl(int fd, DWORD code, void *buf, DWORD len)
                  InterlockedExchange(&sb_stat[0], 0), InterlockedExchange(&sb_stat[1], 0),
                  InterlockedExchange(&sb_stat[2], 0), InterlockedExchange(&sb_stat[3], 0),
                  InterlockedExchange(&sb_stat[4], 0));
+         {
+            /* b78: the clock, the longest allocation list of the window, and the KMD's failure counters */
+            char c[16];
+            fprintf(stderr, "sbumd: stats at %s; allocation list max %u of %u, %u submissions left BOs out; waits that "
+                    "gave up %u\n", sb_clock(c, sizeof c), d->st_list_max, d->alloc_size, d->st_list_dropped,
+                    d->st_wait_timeouts);
+            d->st_list_max = d->st_list_dropped = d->st_wait_timeouts = 0;
+            (void)sb_kmd_check(d, "the 10 s tick", 0.0);
+         }
          d->st_t0 = now;
          d->st_submits = d->st_waits = d->st_blocked = d->st_busy = d->st_maps = 0;
          d->st_blocked_ms = d->st_longest_ms = 0;
@@ -2464,8 +2635,12 @@ malikm_import_alloc(unsigned hAllocation, uint64_t size)
    }
    fd = (int)(SB_PRIME_TAG | h);
    if (trace_on() || sb_log_active)
-      fprintf(stderr, "sbumd: opened allocation 0x%x as bo %u va 0x%llx (device %u)\n", hAllocation, h,
-              (unsigned long long)d->bo[h - 1].va, d->id);
+   {
+      char c[16];
+      fprintf(stderr, "sbumd: opened allocation 0x%x as bo %u va 0x%llx (device %u) at %s, submissions %llu\n",
+              hAllocation, h, (unsigned long long)d->bo[h - 1].va, d->id, sb_clock(c, sizeof c),
+              (unsigned long long)d->seq);
+   }
    (void)sb_devstate_note(d, "the open of allocation", hAllocation);   /* 0163 */
 out:
    ReleaseSRWLockExclusive(&d->lock);
diff --git a/src/gallium/drivers/panfrost/pan_jm.c b/src/gallium/drivers/panfrost/pan_jm.c
index 8b14474..279f9a7 100644
--- a/src/gallium/drivers/panfrost/pan_jm.c
+++ b/src/gallium/drivers/panfrost/pan_jm.c
@@ -168,6 +168,15 @@ jm_submit_jc(struct panfrost_batch *batch, uint64_t first_job_desc,
       void malikm_submit_writes(const uint32_t *handles, unsigned n);
       malikm_submit_writes(sb_wr, sb_wr_n <= ARRAY_SIZE(sb_wr) ? sb_wr_n : ~0u);
    }
+   {
+      /* b78: one line per chain while the shim's draw trace is on (after a KMD job timeout this process waited for) */
+      int malikm_draw_trace(void);
+      void malikm_draw_trace_chain(unsigned long long jc, unsigned reqs, unsigned bos, unsigned w, unsigned h,
+                                   unsigned draws);
+      if (malikm_draw_trace())
+         malikm_draw_trace_chain(first_job_desc, reqs & PANFROST_JD_REQ_FS ? 1 : 0, submit.bo_handle_count,
+                                 batch->key.width, batch->key.height, batch->draw_count);
+   }
 #endif
    if (ctx->is_noop)
       ret = 0;
@@ -1050,6 +1059,23 @@ GENX(jm_launch_draw)(struct panfrost_batch *batch,
       jm_emit_vertex_job(batch, info, &invocation, vertex.cpu);
       jm_push_vertex_tiler_jobs(batch, &vertex, &tiler);
    }
+#ifdef _WIN32
+   {
+      /* b78: which draw is the job at this GPU address (the KMD's hang record gives "head 0x...")? Only while the
+       * shim's draw trace is on. */
+      int malikm_draw_trace(void);
+      if (malikm_draw_trace())
+         fprintf(stderr,
+                 "sbumd: draw job 0x%llx %s index %u: vs %p (code 0x%llx), %u vertices from %u, %u instances, "
+                 "mode %u; %u indices of %u bytes at 0x%llx (start %u, bias %d, restart %u); target %ux%u\n",
+                 (unsigned long long)tiler.gpu, idvs ? "idvs" : "vertex+tiler", batch->jm.jobs.vtc_jc.job_index,
+                 (void *)vs, (unsigned long long)vs->bin.gpu, vertex_count, ctx->offset_start,
+                 info->instance_count, (unsigned)info->mode, info->index_size ? draw->count : 0, info->index_size,
+                 (unsigned long long)(info->index_size ? batch->indices : 0), draw->start,
+                 info->index_size ? draw->index_bias : 0, (unsigned)info->primitive_restart, batch->key.width,
+                 batch->key.height);
+   }
+#endif
 #endif
 }
 
