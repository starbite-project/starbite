+   int vp[4];                          /* last viewport x, y, w, h */
+   unsigned nscissor;
+   int sc[4];                          /* first scissor rect */
+   unsigned pred_set, pred_on;         /* SetPredication calls, last predicate non-null */
+   unsigned copies, blits;
+};
