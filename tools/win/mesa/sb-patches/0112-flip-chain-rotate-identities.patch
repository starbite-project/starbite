+/* Starbite (sbumd, sb-patches/0112, docs/WIN11-GPU.md 6.21): DXGI's RotateResourceIdentities for a flip-model
+ * swap chain, as identities rather than contents: resource i takes resource i+1's BO (with its allocation), the
+ * last takes the first's. d3d10umd copied the contents instead, so buffer 0 kept the allocation DWM had just
+ * been handed by the flip, and the runtime refused every later render into it (T14e: 'Render failed' from
+ * the second second of a flip-model app on). The same swap as this file's own rename path (a new BO under a
+ * resource, plane.base, panfrost_dirty_state_all), after flushing everything. Only plain 2D linear resources
+ * of one layout; false = not done (the caller copies). */
+bool
+panfrost_sb_rotate_bos(struct pipe_context *pctx, struct pipe_resource **res, unsigned n)
+{
+   struct panfrost_context *ctx = pan_context(pctx);
+   struct panfrost_bo *bo0;
+   if (n < 2 || n > 16)
+      return false;
+   struct panfrost_resource *r0 = pan_resource(res[0]);
+   for (unsigned i = 0; i < n; i++) {
+      struct panfrost_resource *r = pan_resource(res[i]);
+      if (!r || !r->bo || r->base.target != PIPE_TEXTURE_2D || r->base.last_level != 0 ||
+          r->base.array_size != 1 || r->separate_stencil || r->shadow_image ||
+          r->modifier != DRM_FORMAT_MOD_LINEAR || r->base.format != r0->base.format ||
+          r->base.width0 != r0->base.width0 || r->base.height0 != r0->base.height0 ||
+          panfrost_bo_size(r->bo) != panfrost_bo_size(r0->bo))
+         return false;
+   }
+   /* recorded batches re-read plane.base when they are emitted: submit them all first */
+   pctx->flush(pctx, NULL, 0);
+   bo0 = r0->bo;
+   BITSET_DECLARE(valid0, PAN_MAX_MIP_LEVELS);
+   memcpy(valid0, r0->valid.data, sizeof(valid0));
+   for (unsigned i = 0; i + 1 < n; i++) {
+      struct panfrost_resource *a = pan_resource(res[i]), *b = pan_resource(res[i + 1]);
+      a->bo = b->bo;
+      a->plane.base = a->bo->ptr.gpu;
+      memcpy(a->valid.data, b->valid.data, sizeof(valid0));
+   }
+   struct panfrost_resource *last = pan_resource(res[n - 1]);
+   last->bo = bo0;
+   last->plane.base = bo0->ptr.gpu;
+   memcpy(last->valid.data, valid0, sizeof(valid0));
+   panfrost_dirty_state_all(ctx);
+   return true;
+}
