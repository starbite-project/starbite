+/* sb-patches/0171 (the system-wide ICD, build/win/patchwork/glsys-report.md): this DLL is used two ways.
+ *  - The game kit: libgallium_wgl.dll next to Mesa's opengl32.dll in ONE game's folder. Its switches are the flag
+ *    files C:\ProgramData\Starbite\<name> (glzc*, glsync, glcached, gltouch, ...), tuned for that game.
+ *  - The system ICD: the same code installed as System32\sbgl-arm64.dll / sbgl-x64.dll and loaded by the
+ *    system opengl32.dll (through sbglicd.dll) into ANY program. There the game's switches must not apply: the
+ *    flag files are read from C:\ProgramData\Starbite\glsys\<name> instead, the new-GPU row's zero-copy default
+ *    (0169) is off, and a process that cannot reach the Mali gets no ICD pixel formats (= Microsoft's OpenGL, as
+ *    before the ICD was registered) instead of softpipe, unless glsys\softpipe exists.
+ * Which one this is: the DLL's own file name starts with "sbgl-" (system) or not (kit). */
+int
+wgl_sb_system_icd(void)
+{
+   static int v = -1;
+   int c = p_atomic_read(&v);
+   if (c < 0) {
+      HMODULE self = NULL;
+      char name[MAX_PATH];
+      c = 0;
+      if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                             (LPCSTR)(void *)wgl_sb_system_icd, &self)) {
+         DWORD n = GetModuleFileNameA(self, name, sizeof(name));
+         if (n && n < sizeof(name)) {
+            const char *b = strrchr(name, '\\');
+            c = _strnicmp(b ? b + 1 : name, "sbgl-", 5) == 0;
+         }
+      }
+      p_atomic_set(&v, c);
+   }
+   return c;
+}
+
+/* sb-patches/0171: this file's log lines ("sbumd: gl ...", the glstats every 10 s). The kit writes them to
+ * stderr as before. The system ICD is in any program, console programs and launchers that keep a child's stderr
+ * included, so there they are written only while the test log folder C:\\ProgramData\\Starbite\\umdlog exists (the
+ * shim then has stderr in this process's file there). */
+static int
+wgl_sb_log_on(void)
+{
+   static int v = -1;
+   int c = p_atomic_read(&v);
+   if (c < 0) {
+      DWORD a = GetFileAttributesA("C:\\ProgramData\\Starbite\\umdlog");
+      c = !wgl_sb_system_icd() || (a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_DIRECTORY));
+      p_atomic_set(&v, c);
+   }
+   return c;
+}
+#define WGL_SB_LOG(...) do { if (wgl_sb_log_on()) fprintf(stderr, __VA_ARGS__); } while (0)
+
+/* the flag file <name> of this mode exists */
+int
+wgl_sb_flag_file(const char *name)
+{
+   char path[128];
+   snprintf(path, sizeof(path), "C:\\ProgramData\\Starbite\\%s%s", wgl_sb_system_icd() ? "glsys\\" : "", name);
+   return GetFileAttributesA(path) != INVALID_FILE_ATTRIBUTES;
+}
+
 static struct pipe_screen *
 wgl_panfrost_create(void)
 {
@@ -104,11 +164,12 @@ wgl_panfrost_create(void)
     * invalidate by the KMD) when SB_GL_CACHED=1 or C:\ProgramData\Starbite\glcached exists */
