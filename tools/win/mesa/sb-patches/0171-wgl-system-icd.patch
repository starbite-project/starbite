    if (want < 2 || !GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
                                        (LPCWSTR)(void *)wgl_pan_pool_main, &self)) {
-      fprintf(stderr, "sbumd: gl present: no copy threads (%u wanted, pin error %lu); one thread copies\n", want,
+      WGL_SB_LOG("sbumd: gl present: no copy threads (%u wanted, pin error %lu); one thread copies\n", want,
               want < 2 ? 0ul : (unsigned long)GetLastError());
