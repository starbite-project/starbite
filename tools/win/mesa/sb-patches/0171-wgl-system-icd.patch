       }
       if (!hidden)
@@ -956,6 +1016,18 @@ wgl_screen_create(HDC hDC)
     * sorted list. Don't do this if GALLIUM_DRIVER is specified.
     */
    for (unsigned i = 0; i < ARRAY_SIZE(drivers); ++i) {
+#ifdef GALLIUM_PANFROST
+      /* sb-patches/0171: the system ICD does not put softpipe (seconds per frame at this screen size) under a
+       * program whose process cannot reach the Mali: no screen = no ICD pixel formats = the system opengl32
+       * goes on with Microsoft's implementation, as before the ICD was registered. Asked for by name
+       * (GALLIUM_DRIVER, LIBGL_ALWAYS_SOFTWARE) or by the flag file glsys\softpipe, softpipe still comes. */
+      if (i > 0 && !sw_only && wgl_sb_system_icd() && strcmp(drivers[i], "softpipe") == 0 &&
