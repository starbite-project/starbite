               secs, wgl_pan_stats.frames, wgl_pan_stats.frames / secs, wgl_pan_stats.hidden, m, c, g, i, t, wt,
@@ -468,10 +529,10 @@ wgl_pan_stats_frame(int64_t start, int64_t map, int64_t copy, int64_t gdi, int m
          wgl_pan_hist_print(hw, sizeof(hw), &wgl_pan_hist_win);
          wgl_pan_hist_print(hr, sizeof(hr), &wgl_pan_hist_run);
          double run_s = (double)(end - wgl_pan_low.run_start) / (double)wgl_pan_stats.freq;
-         fprintf(stderr, "sbumd: gllows %.1f s: %s\n", secs, hw);
-         fprintf(stderr, "sbumd: gllows run %.0f s, %u frames (%.1f fps avg): %s\n", run_s, wgl_pan_low.run_frames,
+         WGL_SB_LOG("sbumd: gllows %.1f s: %s\n", secs, hw);
+         WGL_SB_LOG("sbumd: gllows run %.0f s, %u frames (%.1f fps avg): %s\n", run_s, wgl_pan_low.run_frames,
                  run_s > 0 ? wgl_pan_low.run_frames / run_s : 0.0, hr);
-         fprintf(stderr,
+         WGL_SB_LOG(
                  "sbumd: glworst %.1f ms: game thread cpu %.1f ms, page faults %u; frame before: map %.1f copy %.1f "
                  "gdi %.1f wait %.1f present %.1f; frame after: map %.1f copy %.1f gdi %.1f wait %.1f present %.1f\n",
                  wgl_pan_low.worst_ms, wgl_pan_low.worst_cpu_ms, wgl_pan_low.worst_faults, WGL_PAN_PMS(a[0]),
@@ -587,11 +648,10 @@ wgl_panfrost_async_enabled(void)
       /* sb-patches/0154: on by default since T55 (GD menu 13.9 -> 18.9 fps); off with SB_GL_ASYNC=0 or the file
        * C:\ProgramData\Starbite\glsync */
       const char *env = getenv("SB_GL_ASYNC");
-      on = env ? env[0] == '1'
-               : GetFileAttributesA("C:\\ProgramData\\Starbite\\glsync") == INVALID_FILE_ATTRIBUTES;
+      on = env ? env[0] == '1' : !wgl_sb_flag_file("glsync");
       p_atomic_set(&wgl_pan_async_on, on);
-      fprintf(stderr, "sbumd: gl present: async %s (%s)\n", on ? "on" : "off",
-              env ? "SB_GL_ASYNC" : "C:\\ProgramData\\Starbite\\glsync");
+      WGL_SB_LOG("sbumd: gl present: async %s (%s)\n", on ? "on" : "off",
+              env ? "SB_GL_ASYNC" : "flag file glsync");
    }
    return on;
 }
