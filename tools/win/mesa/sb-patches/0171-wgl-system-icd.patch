-              e ? "SB_GL_CACHED" : "C:\\ProgramData\\Starbite\\glcached");
+      WGL_SB_LOG("sbumd: gl: %s\n", wgl_sb_system_icd() ? "system ICD (flag files in C:\\ProgramData\\Starbite\\glsys)"
+                                                             : "game kit (flag files in C:\\ProgramData\\Starbite)");
