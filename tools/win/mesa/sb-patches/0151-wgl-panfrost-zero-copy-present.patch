+struct pipe_resource;
+struct stw_winsys_framebuffer;
+
+/* A framebuffer whose back buffers are D3D11 shared textures presented by a DXGI swap chain; NULL (= the GDI
+ * present) when SB_GL_PRESENT=gdi|copy, for unsuitable pixel formats, or when any step of making it fails. */
+struct stw_winsys_framebuffer *wgl_sb_zc_create_framebuffer(struct pipe_screen *screen, HWND hWnd, int iPixelFormat);
+
+/* wgl.c: show a Panfrost resource in the window through GDI (0145's present), with the current GL context. */
+void wgl_sb_gdi_present(struct pipe_resource *res, HWND hwnd);
