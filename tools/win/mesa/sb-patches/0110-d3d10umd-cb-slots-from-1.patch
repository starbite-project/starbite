diff --git a/src/gallium/frontends/d3d10umd/Shader.cpp b/src/gallium/frontends/d3d10umd/Shader.cpp
index df6ffa1..bf7ab58 100644
--- a/src/gallium/frontends/d3d10umd/Shader.cpp
+++ b/src/gallium/frontends/d3d10umd/Shader.cpp
@@ -33,6 +33,13 @@
 
 #include "Shader.h"
 #include "ShaderParse.h"
+/* Starbite (sbumd, sb-patches/0110, docs/WIN11-GPU.md 6.18): D3D constant-buffer slot n is gallium constant
+ * buffer n + 1 (TGSI CONST[n + 1]). Gallium buffer 0 is the default uniform block: tgsi_to_nir turns CONST[0]
+ * into load_uniform and Bifrost lowers that to UBO 0, a path that read zeros or other memory on the Mali
+ * (T13w: cb0 failed in vertex and pixel shaders, b1 passed). DWM keeps its transform in cb0, so every one of
+ * its frames came out empty. Slots 0..13 become 1..14 (PIPE_MAX_CONSTANT_BUFFERS 16). */
+#define SB_CB_SHIFT 1
+
 #include "State.h"
 #include "Query.h"
 
@@ -173,7 +180,7 @@ SetConstantBuffers(mesa_shader_stage shader_type,    // IN
       cb.buffer_size = cb.buffer ? cb.buffer->width0 : 0;
       pipe->set_constant_buffer(pipe,
                                 shader_type,
-                                StartBuffer + i,
+                                StartBuffer + i + SB_CB_SHIFT,
                                 &cb);
    }
 }
