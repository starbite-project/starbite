+      DebugPrintf("sbumd: OpenResource: allocation 0x%x (%ux%u pitch %u fmt %u) not importable\n",
+                  oi->hAllocation, w, h, pitch, fmt);
+      SetError(hDevice, E_OUTOFMEMORY);
+      return;
+   }
+   struct pipe_resource templat;
+   memset(&templat, 0, sizeof templat);
+   templat.target = PIPE_TEXTURE_2D;
+   templat.format = pf;
+   templat.width0 = w;
+   templat.height0 = h;
+   templat.depth0 = 1;
+   templat.array_size = 1;
+   templat.bind = PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_RENDER_TARGET | PIPE_BIND_SHARED | PIPE_BIND_LINEAR |
+                  PIPE_BIND_DISPLAY_TARGET;
+   templat.usage = PIPE_USAGE_DEFAULT;
+   struct winsys_handle wh;
+   memset(&wh, 0, sizeof wh);
+   wh.type = WINSYS_HANDLE_TYPE_FD;
+   wh.handle = (HANDLE)(intptr_t)fd;
+   wh.stride = pitch;
+   wh.offset = 0;
+   wh.modifier = DRM_FORMAT_MOD_LINEAR;
+   pResource->resource = screen->resource_from_handle(screen, &templat, &wh, 0);
+   if (!pResource->resource) {
+      DebugPrintf("sbumd: OpenResource: import of allocation 0x%x failed\n", oi->hAllocation);
+      SetError(hDevice, E_OUTOFMEMORY);
+      return;
+   }
+   pResource->Format = df;
+   pResource->MipLevels = 1;
+   pResource->NumSubResources = 1;
+   pResource->transfers = (struct pipe_transfer **)calloc(1, sizeof *pResource->transfers);
+   pResource->sbAllocation = oi->hAllocation;
+   DebugPrintf("sbumd: OpenResource: allocation 0x%x %ux%u pitch %u fmt %u\n", oi->hAllocation, w, h, pitch, fmt);
 }
 
 
