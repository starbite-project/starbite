+/* ---- Starbite: d3d10umd's resources as runtime allocations (docs/WIN11-GPU.md 6.12) ----
+ * The design of arehnman/virtio-win-mesa (yttrium): a resource the runtime must know is backed by an
+ * allocation made with its hResource; presents name the resources' own allocations; shared resources are
+ * opened from the runtime's allocation handle; the primary is set with pfnSetDisplayModeCb. */
+
+int
+malikm_hw(void)
+{
+   return ddi.on;
+}
+
+void
+malikm_next_alloc(void *hres, int primary, unsigned vidpn, unsigned w, unsigned h, unsigned pitch, unsigned fmt)
+{
+   sb_next.armed = 1;
+   sb_next.hres = hres;
+   sb_next.primary = primary;
+   sb_next.vidpn = vidpn;
+   sb_next.w = w;
+   sb_next.h = h;
+   sb_next.pitch = pitch;
+   sb_next.fmt = fmt;
+}
+
+/* 1 if the armed association was not consumed (the resource's BO came from elsewhere). */
+int
+malikm_next_alloc_clear(void)
+{
+   int left = sb_next.armed;
+   sb_next.armed = 0;
+   return left;
+}
+
+/* The allocation behind a PRIME "fd" from drmPrimeHandleToFD, and whether it is a resource's. */
+unsigned
+malikm_prime_alloc(int fd, int *kind)
+{
+   uint32_t h;
+   struct wbo *bo;
+   if (drmPrimeFDToHandle(0, fd, &h) != 0)
+      return 0;
+   AcquireSRWLockShared(&wddm_lock);
+   bo = wddm_bo(h);
+   unsigned a = bo ? bo->h : 0;
+   if (kind)
+      *kind = bo ? bo->kind : -1;
+   ReleaseSRWLockShared(&wddm_lock);
+   return a;
+}
+
+/* Size of the BO behind a PRIME "fd" (pan_kmod's import; lseek() cannot be used). 0 if unknown. */
+uint64_t
+malikm_prime_size(int fd)
+{
+   uint32_t h;
+   struct wbo *bo;
+   uint64_t size = 0;
+   if (drmPrimeFDToHandle(0, fd, &h) != 0)
+      return 0;
+   AcquireSRWLockShared(&wddm_lock);
+   bo = wddm_bo(h);
+   if (bo)
+      size = bo->size;
+   ReleaseSRWLockShared(&wddm_lock);
+   return size;
+}
+
+/* An allocation another process shared (OpenResource), as a BO of ours: its PRIME "fd", or -1. */
+int
+malikm_import_alloc(unsigned hAllocation, uint64_t size)
+{
+   MW_ESCAPE_ALLOC_INFO_DATA where = {0};
+   uint32_t h = 0;
+   int fd = -1;
+
+   AcquireSRWLockExclusive(&wddm_lock);
+   for (uint32_t i = 0; i < wbo_cap; i++)
+      if (wbo[i].h == hAllocation) {
+         h = i + 1;                      /* already ours (opened twice) */
+         break;
+      }
+   if (!h) {
+      where.Code = MW_ESCAPE_ALLOC_INFO;
+      where.hAllocation = hAllocation;
+      if (w_escape(&where, sizeof(where)) < 0 || where.GpuVa == 0)
+         goto out;
+      for (uint32_t i = 0; i < wbo_cap && !h; i++)
+         if (!wbo[i].h)
+            h = i + 1;
+      if (!h) {
+         uint32_t cap = wbo_cap ? wbo_cap * 2 : 256;
+         struct wbo *n = realloc(wbo, cap * sizeof(*n));
+         if (!n)
+            goto out;
+         memset(n + wbo_cap, 0, (cap - wbo_cap) * sizeof(*n));
+         wbo = n;
+         h = wbo_cap + 1;
+         wbo_cap = cap;
+      }
+      wbo[h - 1] = (struct wbo){hAllocation, where.Size ? where.Size : size, where.GpuVa, NULL, 0, 2, NULL};
+   }
+   fd = (int)(SB_PRIME_TAG | h);
+   if (trace_on() || sb_log_active)
+      fprintf(stderr, "sbumd: opened allocation 0x%x as bo %u va 0x%llx\n", hAllocation, h,
+              (unsigned long long)wbo[h - 1].va);
+out:
+   ReleaseSRWLockExclusive(&wddm_lock);
+   return fd;
+}
+
+/* A DXGI present of resources' own allocations. 0 = presented. */
+int
+malikm_present_allocs(unsigned src, unsigned dst, void *dxgi_context)
+{
+   int ret = -1;
+   HRESULT hr = E_FAIL;
+   AcquireSRWLockExclusive(&wddm_lock);
+   if (ddi.on && ddi.dxgi && ddi.dxgi->pfnPresentCb) {
+      DXGIDDICB_PRESENT p = {0};
+      p.hSrcAllocation = src;
+      p.hDstAllocation = dst;
+      p.pDXGIContext = dxgi_context;
+      p.hContext = ddi.context;
+      hr = ddi.dxgi->pfnPresentCb(ddi.device, &p);
+      ret = hr >= 0 ? 0 : -1;
+   }
+   ReleaseSRWLockExclusive(&wddm_lock);
+   if (ret && (trace_on() || sb_log_active))
+      fprintf(stderr, "sbumd: pfnPresentCb(src 0x%x, dst 0x%x) failed: 0x%08lx\n", src, dst, (unsigned long)hr);
+   return ret;
+}
+
+/* The scanout primary (DXGI SetDisplayMode). 0 = done. */
+int
+malikm_set_display_mode(unsigned hPrimaryAllocation)
+{
+   HRESULT hr = E_FAIL;
+   AcquireSRWLockExclusive(&wddm_lock);
+   if (ddi.on && ddi.cb.pfnSetDisplayModeCb) {
+      D3DDDICB_SETDISPLAYMODE m = {0};
+      m.hPrimaryAllocation = hPrimaryAllocation;
+      hr = ddi.cb.pfnSetDisplayModeCb(ddi.device, &m);
+   }
+   ReleaseSRWLockExclusive(&wddm_lock);
+   if (trace_on() || sb_log_active)
+      fprintf(stderr, "sbumd: SetDisplayMode(0x%x): 0x%08lx\n", hPrimaryAllocation, (unsigned long)hr);
+   return hr >= 0 ? 0 : -1;
+}
