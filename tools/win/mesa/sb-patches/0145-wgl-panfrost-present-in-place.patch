-      for (unsigned y = 0; y < h; y++) {
-         const uint32_t *src = (const uint32_t *)(map + (size_t)y * xfer->stride);
-         uint32_t *dst = bits + (size_t)y * w;
-         if (rgba) {
-            for (unsigned x = 0; x < w; x++) {
-               uint32_t p = src[x];
-               dst[x] = (p & 0xff00ff00u) | ((p & 0xffu) << 16) | ((p >> 16) & 0xffu);
-            }
-         } else {
-            memcpy(dst, src, (size_t)w * 4);
+
+   if (!hidden) {
+      enum sb_present_kind kind = sb_present_kind(format);
+      unsigned dib_width = sb_present_dib_width(xfer->stride, w);
+      int direct = p_atomic_read(&wgl_pan_direct);
+
+      if (direct < 0) {
+         const char *mode = debug_get_option_sb_gl_present();
+         direct = !(mode && strcmp(mode, "copy") == 0);
+         p_atomic_set(&wgl_pan_direct, direct);
+      }
+
+      bool tried_direct = false;
+      int shown = 0;
+      if (kind == SB_PRESENT_BGRX && dib_width && direct) {
+         tried_direct = true;
+         shown = wgl_panfrost_dib(hDC, map, dib_width, w, h);
+      }
+      if (!shown) {
+         shown = wgl_panfrost_present_copy(hDC, format, kind, map, xfer->stride, w, h);
+         /* GDI refused the mapped back buffer but took the copy: copy from now on. */
+         if (tried_direct && shown) {
+            p_atomic_set(&wgl_pan_direct, 0);
+            mesa_logw("sb gl present: StretchDIBits failed on the mapped back buffer, copying frames from now on");
          }
       }
+      GdiFlush(); /* GDI has read the frame before the mapping is let go */
