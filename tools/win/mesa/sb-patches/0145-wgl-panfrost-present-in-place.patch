diff --git a/src/gallium/targets/wgl/wgl_sb_present.h b/src/gallium/targets/wgl/wgl_sb_present.h
new file mode 100644
index 0000000..e401b95
--- /dev/null
+++ b/src/gallium/targets/wgl/wgl_sb_present.h
@@ -0,0 +1,80 @@
+/*
+ * Starbite (sb-patches/0145, docs/WIN11-GPU-CAPS.md 5a): the CPU side of the Panfrost WGL present, kept free of
+ * Windows and gallium so a host test can build it (tools/win/mesa/tests/glpresent-rows-test.c).
+ *
+ * GDI's 32-bit BI_RGB DIBs are B, G, R, X in memory, rows DWORD-aligned. A back buffer in that byte order is shown
+ * straight from its mapping: the DIB is stride/4 pixels wide and GDI draws its first width pixels of each row, so a
+ * padded linear stride (Panfrost aligns rows to 64 bytes: 2220 px -> 8896 B) needs no repacking either.
+ */
+#ifndef WGL_SB_PRESENT_H
+#define WGL_SB_PRESENT_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "util/format/u_formats.h"
+
+enum sb_present_kind {
+   SB_PRESENT_BGRX,    /* B, G, R, A/X bytes: GDI's own layout, no conversion */
+   SB_PRESENT_RGBX,    /* R, G, B, A/X bytes: swap R and B */
+   SB_PRESENT_CONVERT, /* anything else: util_format_translate to B8G8R8X8 */
+};
+
+static inline enum sb_present_kind
+sb_present_kind(enum pipe_format format)
+{
+   switch (format) {
+   case PIPE_FORMAT_B8G8R8A8_UNORM:
+   case PIPE_FORMAT_B8G8R8X8_UNORM:
+   case PIPE_FORMAT_B8G8R8A8_SRGB:
+   case PIPE_FORMAT_B8G8R8X8_SRGB:
+      return SB_PRESENT_BGRX;
+   case PIPE_FORMAT_R8G8B8A8_UNORM:
+   case PIPE_FORMAT_R8G8B8X8_UNORM:
+   case PIPE_FORMAT_R8G8B8A8_SRGB:
+   case PIPE_FORMAT_R8G8B8X8_SRGB:
+      return SB_PRESENT_RGBX;
+   default:
+      return SB_PRESENT_CONVERT;
+   }
+}
+
+/* The DIB width that lets GDI read a 32-bit image of `width` pixels in place, rows `stride` bytes apart; 0 when it
+ * can't (a stride that isn't whole pixels, or narrower than the image). */
+static inline unsigned
+sb_present_dib_width(size_t stride, unsigned width)
+{
+   if (stride % 4 || stride / 4 < width || stride / 4 > 0x7fffffffu)
+      return 0;
+   return (unsigned)(stride / 4);
+}
+
+static inline void
+sb_present_copy_rows(void *dst, size_t dst_stride, const void *src, size_t src_stride, size_t row_bytes,
+                     unsigned height)
+{
+   if (dst_stride == row_bytes && src_stride == row_bytes) {
+      memcpy(dst, src, row_bytes * height);
+      return;
+   }
+   for (unsigned y = 0; y < height; y++)
+      memcpy((uint8_t *)dst + y * dst_stride, (const uint8_t *)src + y * src_stride, row_bytes);
+}
+
+/* R, G, B, A bytes -> B, G, R, A bytes (the A/X byte is kept; GDI ignores it). */
+static inline void
+sb_present_rgba_to_bgra_rows(void *dst, size_t dst_stride, const void *src, size_t src_stride, unsigned width,
+                             unsigned height)
+{
+   for (unsigned y = 0; y < height; y++) {
+      const uint32_t *s = (const uint32_t *)((const uint8_t *)src + y * src_stride);
+      uint32_t *d = (uint32_t *)((uint8_t *)dst + y * dst_stride);
+      for (unsigned x = 0; x < width; x++) {
+         uint32_t p = s[x];
+         d[x] = (p & 0xff00ff00u) | ((p & 0xffu) << 16) | ((p >> 16) & 0xffu);
+      }
+   }
+}
+
+#endif
