+/* sb-patches/0145: the present costs as little CPU as GDI allows.
+ *  - The window's back buffers are linear already: stw creates them with PIPE_BIND_DISPLAY_TARGET (stw_st.c), and
+ *    Panfrost makes every DISPLAY_TARGET/SCANOUT/SHARED resource created without a modifier linear
+ *    (panfrost_resource_create_with_modifier, PAN_BIND_SHARED_MASK). So the READ map below is the BO itself:
+ *    panfrost_ptr_map waits for the frame's writer and returns the pointer, with no detile or staging copy.
+ *  - stw's pixel formats are B8G8R8X8/B8G8R8A8 first, which is GDI's own layout: those go to StretchDIBits straight
+ *    from the mapping (a DIB stride/4 pixels wide, drawn 1:1), so this code touches no pixel at all.
+ *  - Other formats (RGBA swaps, A8R8G8B8, 10-bit, FP16) are converted into a buffer kept across frames.
+ *  - A minimized window or an empty clip box still waits for the frame (the map), but copies nothing.
+ * The back buffer is write-combined CPU memory (sbwddm's segment is not cache-coherent), so the one read GDI makes
+ * of it stays the main cost. SB_GL_PRESENT=copy forces the buffered path, for A/B tests. */
+#include "wgl_sb_present.h"
+#include "util/log.h"
+#include "util/simple_mtx.h"
+#include "util/u_atomic.h"
+
+DEBUG_GET_ONCE_OPTION(sb_gl_present, "SB_GL_PRESENT", NULL)
+
+static simple_mtx_t wgl_pan_present_mtx = SIMPLE_MTX_INITIALIZER;
+static void *wgl_pan_present_buf;   /* the converted frame, kept: no malloc per frame */
+static size_t wgl_pan_present_size;
+static int wgl_pan_direct = -1;     /* -1: not decided, 1: GDI reads the mapping, 0: it doesn't, copy */
+
+static int
+wgl_panfrost_dib(HDC hDC, const void *bits, unsigned dib_width, unsigned w, unsigned h)
+{
+   BITMAPINFO bmi = {0};
+   bmi.bmiHeader.biSize = sizeof(bmi.bmiHeader);
+   bmi.bmiHeader.biWidth = (LONG)dib_width;
+   bmi.bmiHeader.biHeight = -(LONG)h; /* top-down, as gdi_sw_display: the GL frontend flips window framebuffers */
+   bmi.bmiHeader.biPlanes = 1;
+   bmi.bmiHeader.biBitCount = 32;
+   bmi.bmiHeader.biCompression = BI_RGB;
+   return StretchDIBits(hDC, 0, 0, (int)w, (int)h, 0, 0, (int)w, (int)h, bits, &bmi, DIB_RGB_COLORS, SRCCOPY);
+}
+
+/* Converts the mapped frame into the kept buffer and shows it; returns StretchDIBits' result (0: nothing shown). */
+static int
+wgl_panfrost_present_copy(HDC hDC, enum pipe_format format, enum sb_present_kind kind, const uint8_t *map,
+                          size_t stride, unsigned w, unsigned h)
+{
+   size_t row = (size_t)w * 4, size = row * h;
+   int shown = 0;
+
+   simple_mtx_lock(&wgl_pan_present_mtx);
+   if (size > wgl_pan_present_size) {
+      free(wgl_pan_present_buf);
+      wgl_pan_present_buf = malloc(size);
+      wgl_pan_present_size = wgl_pan_present_buf ? size : 0;
+   }
+   void *buf = wgl_pan_present_buf;
+   bool ok = buf != NULL;
+   if (ok) {
+      switch (kind) {
+      case SB_PRESENT_BGRX:
+         sb_present_copy_rows(buf, row, map, stride, row, h);
+         break;
+      case SB_PRESENT_RGBX:
+         sb_present_rgba_to_bgra_rows(buf, row, map, stride, w, h);
+         break;
+      default:
+         ok = util_format_translate(util_format_is_srgb(format) ? PIPE_FORMAT_B8G8R8X8_SRGB
+                                                                 : PIPE_FORMAT_B8G8R8X8_UNORM,
+                                    buf, (unsigned)row, 0, 0, format, map, (unsigned)stride, 0, 0, w, h);
+         break;
+      }
+   }
+   if (ok)
+      shown = wgl_panfrost_dib(hDC, buf, w, w, h);
+   simple_mtx_unlock(&wgl_pan_present_mtx);
+   return shown;
+}
+
 static void
 wgl_panfrost_present(struct pipe_context *pipe, struct pipe_resource *res, HDC hDC)
 {
