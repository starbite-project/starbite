From 9a1c5d5e8034dc9d2cce43172626feddbad7470f Mon Sep 17 00:00:00 2001
From: Starbite build <build@starbite.invalid>
Date: Mon, 16 Nov 2026 18:44:39 +0200
Subject: [PATCH 4/8] d3d10umd: multisampling is answered per format family,
 depth formats included

T82 passes M, D, F, T (flag file msaa): every test ran on the Basic Render
Driver. In each process the driver log ends with
  CheckFormatSupport DXGI_FORMAT_D32_FLOAT_S8X24_UINT (20) -> ...: caps 0x1
The runtime walks the formats family by family, typeless first, asks each
format's capabilities and then its quality levels at 2, 4, 8, 16 samples,
and drops the device at the first member whose answer the family's typeless
format does not back (T76b: R32G32B32_TYPELESS without the multisample bit,
R32G32B32_FLOAT one level at 4x, last line). Here CheckFormatSupport gave
D3D10_DDI_FORMAT_SUPPORT_MULTISAMPLE_RENDERTARGET only to colour render
targets, so R32G8X24_TYPELESS and the depth formats never had it, while
CheckMultisampleQualityLevels answered one level for a depth format that
Panfrost multisamples.

Now one answer per family (SbFormatFamily / SbFamilyMultisample): a sample
count is supported when every member that is a colour render target or a
depth buffer takes it; every member reports the same number of levels; the
capability bit is set on the typeless format, the colour render targets and
the depth formats (D32_FLOAT_S8X24_UINT, D32_FLOAT, D24_UNORM_S8_UINT,
D16_UNORM, R32G8X24_TYPELESS, R24G8_TYPELESS) of a family with levels.
Nothing changes without the flag file msaa.

The quality level answers are logged up to 640 lines instead of 24, so the
next run shows where the walk stops if it still does.

Compiled only; the rule is inferred from two logs, not documented.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/gallium/frontends/d3d10umd/Device.cpp | 192 +++++++++++++++++++---
 1 file changed, 172 insertions(+), 20 deletions(-)

diff --git a/src/gallium/frontends/d3d10umd/Device.cpp b/src/gallium/frontends/d3d10umd/Device.cpp
index ec398ef..85c7d8a 100644
--- a/src/gallium/frontends/d3d10umd/Device.cpp
+++ b/src/gallium/frontends/d3d10umd/Device.cpp
@@ -589,6 +589,158 @@ Flush(D3D10DDI_HDEVICE hDevice)  // IN
  * ----------------------------------------------------------------------
  */
 
+/*
+ * Multisampling is answered per format family (the typeless format and the formats a resource of it can be viewed
+ * as), not per format. The runtime walks the formats family by family, the typeless one first, asking the
+ * capabilities of each and then the quality levels at 2, 4, 8 and 16 samples, and gives up the device (the
+ * application then gets the Basic Render Driver) at the first answer of a member that its family's typeless
+ * format does not back:
+ *   T76b: R32G32B32_TYPELESS without the multisample capability, R32G32B32_FLOAT "x4: 1": the last line.
+ *   T82 pass M: R32G8X24_TYPELESS and D32_FLOAT_S8X24_UINT answered capabilities 0x1 (no multisample bit; this
+ *   function only gave the bit to formats that are colour render targets) while CheckMultisampleQualityLevels
+ *   answered 1 level at 4 samples for the depth format: the last line of every process is the capability line
+ *   of D32_FLOAT_S8X24_UINT.
+ * So: one answer per family, which is yes for a sample count when every member that is a colour render target
+ * or a depth buffer takes it; the multisample capability bit on the typeless format, on every colour render
+ * target and on the depth formats of a family that has levels; and the same number of levels from every member.
+ * (VirtualBox's WDDM driver, which the runtime accepts, also keys both answers on one per-format bit that its
+ * host sets for depth formats.)
+ */
+static DXGI_FORMAT
+SbFormatFamily(DXGI_FORMAT Format)
+{
+   switch (Format) {
+   case DXGI_FORMAT_R32G32B32A32_FLOAT:
+   case DXGI_FORMAT_R32G32B32A32_UINT:
+   case DXGI_FORMAT_R32G32B32A32_SINT:
+      return DXGI_FORMAT_R32G32B32A32_TYPELESS;
+   case DXGI_FORMAT_R32G32B32_FLOAT:
+   case DXGI_FORMAT_R32G32B32_UINT:
+   case DXGI_FORMAT_R32G32B32_SINT:
+      return DXGI_FORMAT_R32G32B32_TYPELESS;
+   case DXGI_FORMAT_R16G16B16A16_FLOAT:
+   case DXGI_FORMAT_R16G16B16A16_UNORM:
+   case DXGI_FORMAT_R16G16B16A16_UINT:
+   case DXGI_FORMAT_R16G16B16A16_SNORM:
+   case DXGI_FORMAT_R16G16B16A16_SINT:
+      return DXGI_FORMAT_R16G16B16A16_TYPELESS;
+   case DXGI_FORMAT_R32G32_FLOAT:
+   case DXGI_FORMAT_R32G32_UINT:
+   case DXGI_FORMAT_R32G32_SINT:
+      return DXGI_FORMAT_R32G32_TYPELESS;
+   case DXGI_FORMAT_D32_FLOAT_S8X24_UINT:
+   case DXGI_FORMAT_R32_FLOAT_X8X24_TYPELESS:
+   case DXGI_FORMAT_X32_TYPELESS_G8X24_UINT:
+      return DXGI_FORMAT_R32G8X24_TYPELESS;
+   case DXGI_FORMAT_R10G10B10A2_UNORM:
+   case DXGI_FORMAT_R10G10B10A2_UINT:
+   case DXGI_FORMAT_R10G10B10_XR_BIAS_A2_UNORM:
+      return DXGI_FORMAT_R10G10B10A2_TYPELESS;
+   case DXGI_FORMAT_R8G8B8A8_UNORM:
+   case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+   case DXGI_FORMAT_R8G8B8A8_UINT:
+   case DXGI_FORMAT_R8G8B8A8_SNORM:
+   case DXGI_FORMAT_R8G8B8A8_SINT:
+      return DXGI_FORMAT_R8G8B8A8_TYPELESS;
+   case DXGI_FORMAT_R16G16_FLOAT:
+   case DXGI_FORMAT_R16G16_UNORM:
+   case DXGI_FORMAT_R16G16_UINT:
+   case DXGI_FORMAT_R16G16_SNORM:
+   case DXGI_FORMAT_R16G16_SINT:
+      return DXGI_FORMAT_R16G16_TYPELESS;
+   case DXGI_FORMAT_D32_FLOAT:
+   case DXGI_FORMAT_R32_FLOAT:
+   case DXGI_FORMAT_R32_UINT:
+   case DXGI_FORMAT_R32_SINT:
+      return DXGI_FORMAT_R32_TYPELESS;
+   case DXGI_FORMAT_D24_UNORM_S8_UINT:
+   case DXGI_FORMAT_R24_UNORM_X8_TYPELESS:
+   case DXGI_FORMAT_X24_TYPELESS_G8_UINT:
+      return DXGI_FORMAT_R24G8_TYPELESS;
+   case DXGI_FORMAT_R8G8_UNORM:
+   case DXGI_FORMAT_R8G8_UINT:
+   case DXGI_FORMAT_R8G8_SNORM:
+   case DXGI_FORMAT_R8G8_SINT:
+      return DXGI_FORMAT_R8G8_TYPELESS;
+   case DXGI_FORMAT_R16_FLOAT:
+   case DXGI_FORMAT_D16_UNORM:
+   case DXGI_FORMAT_R16_UNORM:
+   case DXGI_FORMAT_R16_UINT:
+   case DXGI_FORMAT_R16_SNORM:
+   case DXGI_FORMAT_R16_SINT:
+      return DXGI_FORMAT_R16_TYPELESS;
+   case DXGI_FORMAT_R8_UNORM:
+   case DXGI_FORMAT_R8_UINT:
+   case DXGI_FORMAT_R8_SNORM:
+   case DXGI_FORMAT_R8_SINT:
+      return DXGI_FORMAT_R8_TYPELESS;
+   case DXGI_FORMAT_B8G8R8A8_UNORM:
+   case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+      return DXGI_FORMAT_B8G8R8A8_TYPELESS;
+   case DXGI_FORMAT_B8G8R8X8_UNORM:
+   case DXGI_FORMAT_B8G8R8X8_UNORM_SRGB:
+      return DXGI_FORMAT_B8G8R8X8_TYPELESS;
+   default:
+      /* the typeless formats themselves, the formats without a family, and the block-compressed ones (never a
+       * render target) */
+      return Format;
+   }
+}
+
+static bool
+SbIsDepthFormat(DXGI_FORMAT Format)
+{
+   return Format == DXGI_FORMAT_D32_FLOAT_S8X24_UINT || Format == DXGI_FORMAT_D32_FLOAT ||
+          Format == DXGI_FORMAT_D24_UNORM_S8_UINT || Format == DXGI_FORMAT_D16_UNORM;
+}
+
+/* Can Format itself be drawn to with this many samples (0: at all)? known: it is a colour render target or a
+ * depth buffer in the first place. */
+static bool
+SbFormatTargetSamples(struct pipe_screen *screen, DXGI_FORMAT Format, unsigned samples, bool *known)
+{
+   *known = false;
+   if (SbIsDepthFormat(Format)) {
+      enum pipe_format depth = FormatTranslate(Format, true);
+      if (depth == PIPE_FORMAT_NONE || !util_format_is_depth_or_stencil(depth) ||
+          !screen->is_format_supported(screen, depth, PIPE_TEXTURE_2D, 0, 0, PIPE_BIND_DEPTH_STENCIL))
+         return false;
+      *known = true;
+      return screen->is_format_supported(screen, depth, PIPE_TEXTURE_2D, samples, samples, PIPE_BIND_DEPTH_STENCIL);
+   }
+   /* creation only (CheckFormatSupport): not a render target */
+   if (Format == DXGI_FORMAT_R10G10B10_XR_BIAS_A2_UNORM)
+      return false;
+   enum pipe_format color = FormatTranslate(Format, false);
+   if (color == PIPE_FORMAT_NONE || util_format_is_depth_or_stencil(color) ||
+       !screen->is_format_supported(screen, color, PIPE_TEXTURE_2D, 0, 0, PIPE_BIND_RENDER_TARGET))
+      return false;
+   *known = true;
+   return screen->is_format_supported(screen, color, PIPE_TEXTURE_2D, samples, samples, PIPE_BIND_RENDER_TARGET);
+}
+
+/* The family's answer for a sample count above 1. */
+static bool
+SbFamilyMultisample(struct pipe_screen *screen, DXGI_FORMAT Format, unsigned samples)
+{
+   const DXGI_FORMAT family = SbFormatFamily(Format);
+   bool any = false, known;
+
+   if (!SbFormatTargetSamples(screen, family, samples, &known) && known)
+      return false;
+   any |= known;
+   if (SbFormatFamily(family) == family && family <= DXGI_FORMAT_B8G8R8X8_UNORM_SRGB) {
+      for (unsigned m = 1; m <= (unsigned)DXGI_FORMAT_B8G8R8X8_UNORM_SRGB; m++) {
+         if ((DXGI_FORMAT)m == family || SbFormatFamily((DXGI_FORMAT)m) != family)
+            continue;
+         if (!SbFormatTargetSamples(screen, (DXGI_FORMAT)m, samples, &known) && known)
+            return false;
+         any |= known;
+      }
+   }
+   return any;
+}
+
 void APIENTRY
 CheckFormatSupport(D3D10DDI_HDEVICE hDevice, // IN
                    DXGI_FORMAT Format,       // IN
@@ -631,31 +783,34 @@ CheckFormatSupport(D3D10DDI_HDEVICE hDevice, // IN
       return;
    }
 
+#if SUPPORT_MSAA
+   /* the family's answer (see SbFormatFamily): any sample count the levels are asked for */
+   const bool sbMsaa = SbMsaaOn() &&
+                       (SbFamilyMultisample(screen, Format, 4) || SbFamilyMultisample(screen, Format, 8) ||
+                        SbFamilyMultisample(screen, Format, 16) || SbFamilyMultisample(screen, Format, 2));
+#else
+   const bool sbMsaa = false;
+#endif
+
    if (screen->is_format_supported(screen, format, PIPE_TEXTURE_2D, 0, 0,
                                    PIPE_BIND_RENDER_TARGET)) {
       *pFormatCaps |= D3D10_DDI_FORMAT_SUPPORT_RENDERTARGET;
       *pFormatCaps |= D3D10_DDI_FORMAT_SUPPORT_BLENDABLE;
 
-#if SUPPORT_MSAA
-      if (SbMsaaOn() &&
-          screen->is_format_supported(screen, format, PIPE_TEXTURE_2D, 4, 4,
-                                      PIPE_BIND_RENDER_TARGET)) {
+      if (sbMsaa)
          *pFormatCaps |= D3D10_DDI_FORMAT_SUPPORT_MULTISAMPLE_RENDERTARGET;
-      }
-#endif
+   } else if (sbMsaa && (SbIsDepthFormat(Format) || Format == DXGI_FORMAT_R32G8X24_TYPELESS ||
+                         Format == DXGI_FORMAT_R24G8_TYPELESS)) {
+      /* a multisampled depth buffer, and the typeless format it is created with (T82 pass M) */
+      *pFormatCaps |= D3D10_DDI_FORMAT_SUPPORT_MULTISAMPLE_RENDERTARGET;
    }
 
    if (screen->is_format_supported(screen, format, PIPE_TEXTURE_2D, 0, 0,
                                    PIPE_BIND_SAMPLER_VIEW)) {
       *pFormatCaps |= D3D10_DDI_FORMAT_SUPPORT_SHADER_SAMPLE;
 
-#if SUPPORT_MSAA
-      if (SbMsaaOn() &&
-          screen->is_format_supported(screen, format, PIPE_TEXTURE_2D, 4, 4,
-                                      PIPE_BIND_RENDER_TARGET)) {
+      if (sbMsaa && (*pFormatCaps & D3D10_DDI_FORMAT_SUPPORT_RENDERTARGET))
          *pFormatCaps |= D3D10_DDI_FORMAT_SUPPORT_MULTISAMPLE_LOAD;
-      }
-#endif
    }
 }
 
@@ -693,16 +848,13 @@ CheckMultisampleQualityLevels(D3D10DDI_HDEVICE hDevice,        // IN
    }
    if (!SbMsaaOn())
       return;
-   enum pipe_format color = FormatTranslate(Format, false), depth = FormatTranslate(Format, true);
-   if ((color != PIPE_FORMAT_NONE && !util_format_is_depth_or_stencil(color) &&
-        screen->is_format_supported(screen, color, PIPE_TEXTURE_2D, SampleCount, SampleCount,
-                                    PIPE_BIND_RENDER_TARGET)) ||
-       (depth != PIPE_FORMAT_NONE && util_format_is_depth_or_stencil(depth) &&
-        screen->is_format_supported(screen, depth, PIPE_TEXTURE_2D, SampleCount, SampleCount,
-                                    PIPE_BIND_DEPTH_STENCIL)))
+   /* one answer for the whole family, the same from each of its members (see SbFormatFamily) */
+   if (FormatTranslate(Format, false) != PIPE_FORMAT_NONE && SbFamilyMultisample(screen, Format, SampleCount))
       *pNumQualityLevels = 1;
