From 422fd0766391a90b997a51facdc1848463d54638 Mon Sep 17 00:00:00 2001
From: Starbite build <build@starbite.invalid>
Date: Mon, 16 Nov 2026 18:35:54 +0200
Subject: [PATCH 1/8] d3d10umd: the NIR translator records which texture and
 sampler slots a shader reads

T82 pass N (nirshaders): buffer_srv, copy_subresource_region,
depth_stencil_sampling, initial_texture_data, null_sampler, rtv_depth_slice,
shader_input_registers_limits, swapchain_flip, texture1d, texture,
texture_compressed_3d, unbind_shader_resource_view, update_subresource pass
with the TGSI translator and fail with this one: every lookup reads nothing
(the draw leaves the target as it was).

Cause: info.textures_used / textures_used_by_txf / samplers_used were never
set. nir_lower_samplers and nir_shader_gather_info do not record them (the
GLSL linker and tgsi_to_nir do it themselves), and Panfrost's shader
descriptor takes texture_count and sampler_count from textures_used
(pan_compiler.c), so every shader said "0 textures". info.texture_buffers,
derived from textures_used here, was empty too.

sn_gather_textures_used() walks the texture instructions left after the
cleanup.

Harness: every shader compiled for Bifrost has its texture instructions
compared with pan_shader_info.texture_count / sampler_count and
info.texture_buffers. Before this change 94 of 468 shaders failed that check
through the new translator (0 of 235 through the old); now 0. Two self
tests (a texture in slot 5 with a buffer in slot 7; slot 0).

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/gallium/frontends/d3d10umd/ShaderNIR.c    | 41 +++++++++++
 .../d3d10umd/tests/dxbc_nir_harness.c         | 68 +++++++++++++++++++
 .../d3d10umd/tests/dxbc_nir_selftest.c        | 47 +++++++++++++
 3 files changed, 156 insertions(+)

diff --git a/src/gallium/frontends/d3d10umd/ShaderNIR.c b/src/gallium/frontends/d3d10umd/ShaderNIR.c
index 93ff6d2..b7f15cd 100644
--- a/src/gallium/frontends/d3d10umd/ShaderNIR.c
+++ b/src/gallium/frontends/d3d10umd/ShaderNIR.c
@@ -5030,6 +5030,38 @@ sn_optimize(nir_shader *nir)
    } while (progress);
 }
 
+/* textures_used, textures_used_by_txf and samplers_used from the texture
+ * instructions that are left after the cleanup.
+ */
+static void
+sn_gather_textures_used(nir_shader *nir)
+{
+   BITSET_ZERO(nir->info.textures_used);
+   BITSET_ZERO(nir->info.textures_used_by_txf);
+   BITSET_ZERO(nir->info.samplers_used);
+
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            nir_tex_instr *tex;
+
+            if (instr->type != nir_instr_type_tex)
+               continue;
+            tex = nir_instr_as_tex(instr);
+
+            if (tex->texture_index < SN_MAX_RESOURCES) {
+               BITSET_SET(nir->info.textures_used, tex->texture_index);
+               if (tex->op == nir_texop_txf || tex->op == nir_texop_txf_ms)
+                  BITSET_SET(nir->info.textures_used_by_txf, tex->texture_index);
+            }
+            if (nir_tex_instr_need_sampler(tex) &&
+                tex->sampler_index < SN_MAX_SAMPLERS)
+               BITSET_SET(nir->info.samplers_used, tex->sampler_index);
+         }
+      }
+   }
+}
+
 static void
 sn_finalize(struct sn_xlate *sx)
 {
@@ -5089,6 +5121,15 @@ sn_finalize(struct sn_xlate *sx)
    sn_optimize(nir);
    nir_shader_gather_info(nir, sx->impl);
 
+   /* Which sampler view and sampler state slots the code reads. Neither
+    * nir_lower_samplers nor nir_shader_gather_info records it (the GLSL
+    * linker and tgsi_to_nir do it themselves), and Panfrost takes the
+    * texture and sampler counts of the shader's descriptor from it: without
+    * it the count is 0 and every lookup reads nothing (T82: every test that
+    * samples a texture).
+    */
+   sn_gather_textures_used(nir);
+
    /* Not derived by nir_shader_gather_info; Bifrost needs it to give buffer
     * resources a descriptor (sb-patches/0118).
     */
diff --git a/src/gallium/frontends/d3d10umd/tests/dxbc_nir_harness.c b/src/gallium/frontends/d3d10umd/tests/dxbc_nir_harness.c
index 3cd79cd..6afdd16 100644
--- a/src/gallium/frontends/d3d10umd/tests/dxbc_nir_harness.c
+++ b/src/gallium/frontends/d3d10umd/tests/dxbc_nir_harness.c
@@ -662,12 +662,74 @@ panfrost_compile(nir_shader *nir)
    return panfrost_compile_lowered(nir, false);
 }
 
+/* The texture and sampler counts Panfrost puts in a Bifrost shader's
+ * descriptor come from pan_shader_info, which takes them from
+ * info.textures_used / samplers_used, and a buffer resource is reached
+ * through an attribute counted from info.texture_buffers. A translator that
+ * leaves these empty gives code that compiles and reads nothing (T82, pass N:
+ * every texture test). Check them against the texture instructions.
+ */
+struct tex_slots {
+   int max_texture;
+   int max_sampler;
+   int max_buffer;
+};
+
+static void
+collect_tex_slots(nir_shader *nir, struct tex_slots *slots)
+{
+   slots->max_texture = slots->max_sampler = slots->max_buffer = -1;
+
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            nir_tex_instr *tex;
+
+            if (instr->type != nir_instr_type_tex)
+               continue;
+            tex = nir_instr_as_tex(instr);
+
+            slots->max_texture = MAX2(slots->max_texture, (int)tex->texture_index);
+            if (nir_tex_instr_need_sampler(tex))
+               slots->max_sampler = MAX2(slots->max_sampler, (int)tex->sampler_index);
+            if (tex->sampler_dim == GLSL_SAMPLER_DIM_BUF && tex->op == nir_texop_txf)
+               slots->max_buffer = MAX2(slots->max_buffer, (int)tex->texture_index);
+         }
+      }
+   }
+}
+
+static bool
+check_tex_slots(const nir_shader *nir, const struct tex_slots *slots,
+                const struct pan_shader_info *info)
+{
+   bool ok = true;
+
+   if (slots->max_texture >= (int)info->texture_count) {
+      fprintf(stderr, "texture slots: the code reads sampler view %d, the shader descriptor counts %u textures\n",
+              slots->max_texture, info->texture_count);
+      ok = false;
+   }
+   if (slots->max_sampler >= (int)info->sampler_count) {
+      fprintf(stderr, "texture slots: the code uses sampler %d, the shader descriptor counts %u samplers\n",
+              slots->max_sampler, info->sampler_count);
+      ok = false;
+   }
+   if (slots->max_buffer >= (int)BITSET_LAST_BIT(nir->info.texture_buffers)) {
+      fprintf(stderr, "texture slots: the code loads from buffer view %d, info.texture_buffers ends at %u\n",
+              slots->max_buffer, (unsigned)BITSET_LAST_BIT(nir->info.texture_buffers));
+      ok = false;
+   }
+   return ok;
+}
+
 /* The rest, for a shader whose I/O is lowered: also what the pieces a
  * geometry shader is turned into go through.
  */
 static unsigned
 panfrost_compile_lowered(nir_shader *nir, bool no_idvs)
 {
+   struct tex_slots tex_slots;
    uint64_t gpu_id = opt.gpu_id;
    struct pan_varying_layout varying_layout = { 0 };
    struct pan_compile_inputs inputs = { .gpu_id = gpu_id };
@@ -686,6 +748,7 @@ panfrost_compile_lowered(nir_shader *nir, bool no_idvs)
    }
 
    s = nir_shader_clone(NULL, nir);
+   collect_tex_slots(s, &tex_slots);
 
    inputs.trust_varying_flat_highp_types = false;
    /* A separately created pixel shader has no vertex shader layout. */
@@ -722,6 +785,11 @@ panfrost_compile_lowered(nir_shader *nir, bool no_idvs)
 
    pan_shader_compile(s, &inputs, &binary, &info);
 
+   if (pan_arch(gpu_id) < 9 && !check_tex_slots(nir, &tex_slots, &info)) {
+      fflush(NULL);
+      _exit(3);
+   }
+
    size = binary.size;
    util_dynarray_fini(&binary);
    ralloc_free(s);
diff --git a/src/gallium/frontends/d3d10umd/tests/dxbc_nir_selftest.c b/src/gallium/frontends/d3d10umd/tests/dxbc_nir_selftest.c
index 4bf6079..da075e7 100644
--- a/src/gallium/frontends/d3d10umd/tests/dxbc_nir_selftest.c
+++ b/src/gallium/frontends/d3d10umd/tests/dxbc_nir_selftest.c
@@ -821,6 +821,51 @@ texture_test(void)
    finish(&t, "ps41_textures", NULL);
 }
 
+/* The slots a shader reads must reach the driver's shader descriptor: a
+ * texture in a slot above 0, a sampler numbered above every texture, and a
+ * buffer resource (the harness compares pan_shader_info and
+ * info.texture_buffers with the texture instructions of every shader it
+ * compiles; T82 pass N had 0 textures in every descriptor).
+ */
+static void
+texture_slot_test(const char *name, unsigned tex_slot, unsigned sampler_slot, bool buffer)
+{
+   struct tpf t;
+
+   begin(&t, D3D10_SB_PIXEL_SHADER, 0);
+   dcl_resource(&t, tex_slot, D3D10_SB_RESOURCE_DIMENSION_TEXTURE2D, D3D10_SB_RETURN_TYPE_FLOAT);
+   if (buffer)
+      dcl_resource(&t, tex_slot + 2, D3D10_SB_RESOURCE_DIMENSION_BUFFER, D3D10_SB_RETURN_TYPE_FLOAT);
+   dcl_sampler(&t, sampler_slot, D3D10_SB_SAMPLER_MODE_DEFAULT);
+   dcl_input_ps(&t, 0, ALL, D3D10_SB_INTERPOLATION_LINEAR, 0, false);
+   dcl_output(&t, 0, ALL, 0);
+   dcl_temps(&t, 2);
+
+   /* sample r0, v0.xyxx, tN.xyzw, sM */
+   op(&t, D3D10_SB_OPCODE_SAMPLE, 0);
+   reg(&t, T_TEMP, 0, MASK(ALL));
+   reg(&t, T_IN, 0, SWZ(0, 1, 0, 0));
+   reg(&t, T_RES, tex_slot, XYZW);
+   reg(&t, T_SAMP, sampler_slot, C0);
+   if (buffer) {
+      /* ftoi r1, v0; ld r1, r1.xxxx, tN+2.xyzw; add r0, r0, r1 */
+      op(&t, D3D10_SB_OPCODE_FTOI, 0);
+      reg(&t, T_TEMP, 1, MASK(ALL));
+      reg(&t, T_IN, 0, XYZW);
+      op(&t, D3D10_SB_OPCODE_LD, 0);
+      reg(&t, T_TEMP, 1, MASK(ALL));
+      reg(&t, T_TEMP, 1, SWZ(0, 0, 0, 0));
+      reg(&t, T_RES, tex_slot + 2, XYZW);
+      op(&t, D3D10_SB_OPCODE_ADD, 0);
+      reg(&t, T_TEMP, 0, MASK(ALL));
+      reg(&t, T_TEMP, 0, XYZW);
+      reg(&t, T_TEMP, 1, XYZW);
+   }
+   return_temp(&t, 0);
+
+   finish(&t, name, NULL);
+}
+
 /* sampleinfo / samplepos, each in a shader of its own: the backend lacks
  * some of what they need and the report should say which.
  */
@@ -1732,6 +1777,8 @@ selftest_add_shaders(void)
    indexable_temp_test();
 
    texture_test();
+   texture_slot_test("ps_texture_slot0", 0, 0, false);
+   texture_slot_test("ps_texture_slot5_buffer7", 5, 1, true);
    sample_query_test("ps41_sampleinfo", false, false, false);
    sample_query_test("ps41_sampleinfo_uint", false, false, true);
    sample_query_test("ps41_sampleinfo_rasterizer", false, true, false);
-- 
