@@ -769,6 +769,10 @@ struct panfrost_compiled_shader *
 panfrost_get_gs_capture(struct panfrost_context *ctx,
                         struct panfrost_uncompiled_shader *vs);
 
+void panfrost_sb_special_vs_variant(struct panfrost_context *ctx,
+                                    struct panfrost_uncompiled_shader *vs,
+                                    struct panfrost_compiled_shader *variant);
+
 static inline void
 panfrost_dirty_state_all(struct panfrost_context *ctx)
 {
diff --git a/src/gallium/drivers/panfrost/pan_shader.c b/src/gallium/drivers/panfrost/pan_shader.c
index 293358a..20c9021 100644
--- a/src/gallium/drivers/panfrost/pan_shader.c
+++ b/src/gallium/drivers/panfrost/pan_shader.c
@@ -131,6 +131,14 @@ panfrost_shader_compile(struct panfrost_screen *screen, const nir_shader *ir,
 
    nir_shader *s = nir_shader_clone(NULL, ir);
 
+   /* Starbite: the transform feedback variant is made again when the vertex
+    * elements change (panfrost_sb_special_vs_variant), by which time the
+    * shader it is made from no longer says it has transform feedback
+    * (panfrost_create_shader_state clears that once the variant exists).
+    */
+   if (s->info.stage == MESA_SHADER_VERTEX && key->vs.is_xfb)
+      s->info.has_transform_feedback_varyings = true;
+
    if (s->info.stage == MESA_SHADER_VERTEX && key->vs.int_attribs)
       NIR_PASS(_, s, nir_shader_intrinsics_pass, sb_retype_int_attribs, nir_metadata_all, &key->vs.int_attribs);
 
@@ -879,13 +887,50 @@ panfrost_get_gs_capture(struct panfrost_context *ctx,
    if (!vs->gs_capture) {
       vs->gs_capture = calloc(1, sizeof(struct panfrost_compiled_shader));
       vs->gs_capture->key.vs.gs_capture = true;
+      vs->gs_capture->key.vs.int_attribs = ctx->sb_int_attribs;
 
       panfrost_shader_get(ctx->base.screen, &ctx->shaders, &ctx->descs, vs,
                           &ctx->base.debug, vs->gs_capture, 0);
    }
+   panfrost_sb_special_vs_variant(ctx, vs, vs->gs_capture);
    return vs->gs_capture;
 }
 
+/*
+ * Starbite: the two vertex shader variants that are kept outside the variant
+ * list (the transform feedback one, vs->xfb, and the one that runs ahead of
+ * a geometry shader, vs->gs_capture) read the vertex elements like any other
+ * and so depend on which of them are pure integers (sb_retype_int_attribs),
+ * but were compiled once, for no integer element: an R32_UINT attribute
+ * reached stream output converted to float (d3d11 test_vertex_id, T82: 1.0f
+ * captured where the id 1 was expected). The variant is compiled again when
+ * the elements bound for this draw differ from the ones it was made for.
+ * Batches that used the old code hold their own references to it.
+ */
+void
+panfrost_sb_special_vs_variant(struct panfrost_context *ctx,
+                               struct panfrost_uncompiled_shader *vs,
+                               struct panfrost_compiled_shader *variant)
+{
+   if (!variant || variant->key.vs.int_attribs == ctx->sb_int_attribs)
+      return;
+
+   const bool is_xfb = variant->key.vs.is_xfb;
+   const bool gs_capture = variant->key.vs.gs_capture;
+
+   panfrost_bo_unreference(variant->bin.bo);
+   panfrost_bo_unreference(variant->state.bo);
+   panfrost_bo_unreference(variant->linkage.bo);
+
+   memset(variant, 0, sizeof(*variant));
+   variant->key.vs.is_xfb = is_xfb;
+   variant->key.vs.gs_capture = gs_capture;
+   variant->key.vs.int_attribs = ctx->sb_int_attribs;
+
+   panfrost_shader_get(ctx->base.screen, &ctx->shaders, &ctx->descs, vs,
+                       &ctx->base.debug, variant, 0);
+}
+
 /* What poly made of a geometry shader, as the state objects a draw uses. */
 static struct panfrost_gs *
 panfrost_gs_from_nir(struct pipe_context *pctx, nir_shader *nir,
