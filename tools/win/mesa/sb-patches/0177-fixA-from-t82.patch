 }
 
 static float
-panfrost_z_depth_offset(struct panfrost_context *ctx, float offset_units)
+panfrost_z_depth_offset(struct panfrost_context *ctx,
+                        const struct pipe_rasterizer_state *rast)
 {
+   float offset_units = rast->offset_units;
+
    if (ctx->pipe_framebuffer.zsbuf.texture) {
       if (util_format_is_float(ctx->pipe_framebuffer.zsbuf.format)) {
          /* no scaling necessary, hw will do this at run time */
          return offset_units;
       }
    }
+   /* Starbite: Direct3D's unit is one step of the depth buffer, and that is
+    * what the hardware's unit is: d3d10core test_depth_bias (T82) read back
+    * exactly twice the bias from D24 and D16 buffers, in all of its 437
+    * failures and nowhere else.
+    */
+   if (rast->sb_offset_units_exact)
+      return offset_units;
    /* if fixed point, apply the minimum resolvable difference scaling here */
    return 2.0f * offset_units;
 }
@@ -604,7 +614,7 @@ panfrost_prepare_fs_state(struct panfrost_context *ctx, uint64_t *blend_shaders,
 #endif
 
       cfg.stencil_mask_misc.alpha_to_coverage = alpha_to_coverage;
-      cfg.depth_units = panfrost_z_depth_offset(ctx, rast->offset_units);
+      cfg.depth_units = panfrost_z_depth_offset(ctx, rast);
       cfg.depth_factor = rast->offset_scale;
       cfg.depth_bias_clamp = rast->offset_clamp;
 
@@ -890,7 +900,7 @@ panfrost_emit_depth_stencil(struct panfrost_batch *batch)
       cfg.depth_source = pan_depth_source(&fs->info);
 
       cfg.depth_bias_enable = rast->base.offset_tri;
-      cfg.depth_units = panfrost_z_depth_offset(ctx, rast->base.offset_units);
+      cfg.depth_units = panfrost_z_depth_offset(ctx, &rast->base);
       cfg.depth_factor = rast->base.offset_scale;
       cfg.depth_bias_clamp = rast->base.offset_clamp;
 
diff --git a/src/gallium/frontends/d3d10umd/Rasterizer.cpp b/src/gallium/frontends/d3d10umd/Rasterizer.cpp
index 4a4504c..500adbd 100644
--- a/src/gallium/frontends/d3d10umd/Rasterizer.cpp
+++ b/src/gallium/frontends/d3d10umd/Rasterizer.cpp
@@ -232,6 +232,9 @@ CreateRasterizerState(
    state.scissor = (pRasterizerDesc->ScissorEnable ? 1 : 0);
    state.line_smooth = (pRasterizerDesc->AntialiasedLineEnable ? 1 : 0);
    state.offset_units = (float)pRasterizerDesc->DepthBias;
+   /* Direct3D 10: DepthBias counts steps of a fixed-point depth buffer (bias = DepthBias * 2^-n). Panfrost
+    * doubles the units otherwise (its minimum resolvable difference for GL): test_depth_bias, T82. */
+   state.sb_offset_units_exact = 1;
    state.offset_scale = pRasterizerDesc->SlopeScaledDepthBias;
    state.offset_clamp = pRasterizerDesc->DepthBiasClamp;
    /* sb-patches/0173: the values alone switch nothing on. Gallium applies the bias to polygons per fill mode
diff --git a/src/gallium/include/pipe/p_state.h b/src/gallium/include/pipe/p_state.h
index 2ae8e40..f0d56a0 100644
--- a/src/gallium/include/pipe/p_state.h
+++ b/src/gallium/include/pipe/p_state.h
@@ -192,6 +192,15 @@ struct pipe_rasterizer_state
     */
    unsigned offset_units_unscaled:1;
 
+   /**
+    * Starbite: one offset unit is exactly one step of a fixed-point depth
+    * buffer (Direct3D 10: bias = DepthBias * 2^-n). A driver that scales the
+    * units by a larger minimum resolvable difference of its own (Panfrost:
+    * two steps, which GL allows) does not do so when this is set. Float
+    * depth buffers are not affected.
+    */
+   unsigned sb_offset_units_exact:1;
+
    /**
     * Depth values output from fragment shader may be outside 0..1.
     * These have to be clamped for use with UNORM buffers.
