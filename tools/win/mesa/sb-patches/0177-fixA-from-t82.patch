From ea8a080763c2c0aadcd0c9fc556a890dfef02663 Mon Sep 17 00:00:00 2001
From: Starbite build <build@starbite.invalid>
Date: Mon, 16 Nov 2026 18:57:20 +0200
Subject: [PATCH 8/8] gallium/util: the draws made without primitive restart do
 not claim index bounds they do not have

T82 pass G (gsemu), d3d10core test_index_buffer_offset: three draws of four
points with the index buffer bound at byte offsets 0, 16 and 32. The first
captures the right vertices, the other two capture (0, 0, 0, 1) for every
attribute.

Direct3D always has the restart index on, and Panfrost sends an indexed
draw with a geometry shader through util_draw_vbo_without_prim_restart.
That function stored what util_prim_restart_convert_to_direct returns as
min_index / max_index in the draw info and set index_bounds_valid; but the
helper computes the first and last position read in the index buffer
(add_range: start, start + count - 1), not the smallest and largest index.
Panfrost goes by valid bounds: for the draws at offsets 16 and 32 (start 4
and 8) it shaded vertices 4..7 and 8..11 of a buffer of four. With start 0
and indices that are a permutation of 0..n-1 the two happen to agree.

The bounds are no longer stored or declared valid; bounds the caller gave
are kept. Only the geometry path of Panfrost calls this function here.

Host: the harness runs the function against a recording draw_vbo
(--selftest, "restart-free draws"): 2 of 15 checks failed before, 0 now.
On the phone: not run.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/gallium/auxiliary/util/u_prim_restart.c   |  16 ++-
 .../d3d10umd/tests/dxbc_nir_harness.c         | 112 ++++++++++++++++++
 2 files changed, 126 insertions(+), 2 deletions(-)

diff --git a/src/gallium/auxiliary/util/u_prim_restart.c b/src/gallium/auxiliary/util/u_prim_restart.c
index 07164cc..cff3ee5 100644
--- a/src/gallium/auxiliary/util/u_prim_restart.c
+++ b/src/gallium/auxiliary/util/u_prim_restart.c
@@ -263,15 +263,27 @@ util_draw_vbo_without_prim_restart(struct pipe_context *context,
    }
 
    unsigned total_index_count;
+   /* Starbite: what the helper returns as "min_index" and "max_index" are the
+    * first and last position in the index buffer that the draws read
+    * (add_range: start, start + count - 1), not the smallest and largest
+    * index. They were stored in the draw info as its index bounds and
+    * declared valid; a driver that goes by the bounds (Panfrost) then shaded
+    * the vertices numbered like the positions. With the index buffer bound
+    * at offset 0 and indices that are a permutation of their positions that
+    * is the same range, otherwise not: d3d10core test_index_buffer_offset
+    * (T82 pass G, the draws at index buffer offsets 16 and 32 read vertices
+    * 4..7 and 8..11 of a buffer of four). The caller's bounds, if it gave
+    * any, stay as they are; they cover every piece.
+    */
+   unsigned first_position, last_position;
    direct_draws = util_prim_restart_convert_to_direct(src_map, &new_info, &new_draw, &num_draws,
-                                                      &new_info.min_index, &new_info.max_index,
+                                                      &first_position, &last_position,
                                                       &total_index_count);
    /* unmap index buffer */
    if (src_transfer)
       pipe_buffer_unmap(context, src_transfer);
 
    new_info.primitive_restart = false;
-   new_info.index_bounds_valid = true;
    if (direct_draws)
       context->draw_vbo(context, &new_info, drawid_offset, NULL, direct_draws, num_draws);
    free(direct_draws);
diff --git a/src/gallium/frontends/d3d10umd/tests/dxbc_nir_harness.c b/src/gallium/frontends/d3d10umd/tests/dxbc_nir_harness.c
index 6afdd16..79b50cf 100644
--- a/src/gallium/frontends/d3d10umd/tests/dxbc_nir_harness.c
+++ b/src/gallium/frontends/d3d10umd/tests/dxbc_nir_harness.c
@@ -44,7 +44,10 @@
 #include "dxbc_nir_harness.h"
 
 #include "nir/tgsi_to_nir.h"
+#include "pipe/p_context.h"
 #include "pipe/p_screen.h"
+#include "util/u_draw.h"
+#include "util/u_prim_restart.h"
 #include "tgsi/tgsi_dump.h"
 #include "tgsi/tgsi_ureg.h"
 
@@ -1547,6 +1550,111 @@ so_bookkeeping_selftest(void)
 
 #endif /* HAVE_PANFROST_COMPILER */
 
+/*
+ * util_draw_vbo_without_prim_restart, which the driver's geometry path
+ * sends every indexed draw through (Direct3D always has the restart index
+ * on): the pieces it hands to draw_vbo must not carry index bounds that are
+ * positions in the index buffer (T82 pass G, test_index_buffer_offset).
+ */
+static struct {
+   unsigned calls, draws;
+   struct pipe_draw_start_count_bias draw[8];
+   bool bounds_valid;
+   unsigned min_index, max_index;
+   bool restart;
+} restart_seen;
+
+static void
+restart_selftest_draw_vbo(struct pipe_context *pipe, const struct pipe_draw_info *info,
+                          unsigned drawid_offset, const struct pipe_draw_indirect_info *indirect,
+                          const struct pipe_draw_start_count_bias *draws, unsigned num_draws)
+{
+   restart_seen.calls++;
+   restart_seen.bounds_valid = info->index_bounds_valid;
+   restart_seen.min_index = info->min_index;
+   restart_seen.max_index = info->max_index;
+   restart_seen.restart = info->primitive_restart;
+   for (unsigned i = 0; i < num_draws && restart_seen.draws < ARRAY_SIZE(restart_seen.draw); i++)
+      restart_seen.draw[restart_seen.draws++] = draws[i];
+}
+
+static unsigned
+restart_draw_selftest(void)
+{
+   /* as test_index_buffer_offset: three draws of four points, the index
+    * buffer bound at 0, 16 and 32 bytes */
+   static const uint32_t indices[] = {
+      3, 2, 1, 0,
+      1, 3, 2, 0,
+      1, 0xffffffff, 2, 0,
+   };
+   struct pipe_context pipe;
+   unsigned checks = 0, failed = 0;
+
+   memset(&pipe, 0, sizeof pipe);
+   pipe.draw_vbo = restart_selftest_draw_vbo;
+
+#define RESTART_CHECK(cond, what)                                              \
+   do {                                                                        \
+      checks++;                                                                \
+      if (!(cond)) {                                                           \
+         failed++;                                                             \
+         printf("restart-free draws: FAILED: %s\n", what);                     \
+      }                                                                        \
+   } while (0)
+
+   for (unsigned n = 0; n < 3; n++) {
+      struct pipe_draw_info info;
+      struct pipe_draw_start_count_bias draw = { .start = 4 * n, .count = 4 };
+      unsigned lowest = ~0u, highest = 0;
+
+      util_draw_init_info(&info);
+      info.mode = MESA_PRIM_POINTS;
+      info.index_size = 4;
+      info.has_user_indices = true;
+      info.index.user = indices;
+      info.primitive_restart = true;
+      info.restart_index = 0xffffffff;
+
+      memset(&restart_seen, 0, sizeof restart_seen);
+      util_draw_vbo_without_prim_restart(&pipe, &info, 0, NULL, &draw);
+
+      for (unsigned i = 0; i < restart_seen.draws; i++) {
+         for (unsigned j = 0; j < restart_seen.draw[i].count; j++) {
+            uint32_t index = indices[restart_seen.draw[i].start + j];
+
+            lowest = MIN2(lowest, index);
+            highest = MAX2(highest, index);
+         }
+      }
+
+      RESTART_CHECK(restart_seen.calls == 1 && !restart_seen.restart, "one draw call, restart off");
+      RESTART_CHECK(restart_seen.draws == (n == 2 ? 2 : 1), "the pieces between the restart indices");
+      RESTART_CHECK(restart_seen.draws && restart_seen.draw[0].start == 4 * n,
+                    "the first piece starts where the draw does");
+      /* what the draw reads, without the restart index */
+      unsigned want_lowest = ~0u, want_highest = 0;
+
+      for (unsigned j = 0; j < draw.count; j++) {
+         uint32_t index = indices[draw.start + j];
+
+         if (index != info.restart_index) {
+            want_lowest = MIN2(want_lowest, index);
+            want_highest = MAX2(want_highest, index);
+         }
+      }
+      RESTART_CHECK(lowest == want_lowest && highest == want_highest,
+                    "the pieces hold the indices of the draw");
+      RESTART_CHECK(!restart_seen.bounds_valid ||
+                    (restart_seen.min_index <= lowest && restart_seen.max_index >= highest),
+                    "index bounds, if declared valid, bound the index values (not positions in the buffer)");
+   }
+#undef RESTART_CHECK
+
+   printf("restart-free draws: %u checks, %u failed\n", checks, failed);
+   return failed;
+}
+
 
 /*
  * One shader
@@ -2255,6 +2363,10 @@ main(int argc, char **argv)
       so_bookkeeping_selftest();
       tessellator_selftest();
    }
+#endif
+   if (so_selftest)
+      restart_draw_selftest();
+#ifdef HAVE_PANFROST_COMPILER
    if (opt.compile && !opt.tgsi)
       print_tess_pairs();
 #endif
