From 0149fb53e5e9171a51d899565df09ea495064585 Mon Sep 17 00:00:00 2001
From: Starbite build <build@starbite.invalid>
Date: Mon, 16 Nov 2026 18:35:54 +0200
Subject: [PATCH 2/8] panfrost: the sampler count of a shader covers samplers
 numbered above its textures

pan_shader_info.sampler_count was the texture count (GL's combined samplers).
A Direct3D shader pairs any sampler with any resource: t0 read through s6
gave a descriptor with 1 sampler and code that uses sampler 6. Both
translators record samplers_used; take the larger of the two. The count
never gets smaller, and a GL shader's stays what it was.

Found by the harness check of the previous commit with a self test
(ps_sampler_above_textures); no T82 test is known to depend on it. Whether
Bifrost enforces the count was not measured.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/gallium/frontends/d3d10umd/tests/dxbc_nir_selftest.c | 1 +
 src/panfrost/compiler/pan_compiler.c                     | 6 ++++++
 2 files changed, 7 insertions(+)

diff --git a/src/gallium/frontends/d3d10umd/tests/dxbc_nir_selftest.c b/src/gallium/frontends/d3d10umd/tests/dxbc_nir_selftest.c
index da075e7..bf61234 100644
--- a/src/gallium/frontends/d3d10umd/tests/dxbc_nir_selftest.c
+++ b/src/gallium/frontends/d3d10umd/tests/dxbc_nir_selftest.c
@@ -1779,6 +1779,7 @@ selftest_add_shaders(void)
    texture_test();
    texture_slot_test("ps_texture_slot0", 0, 0, false);
    texture_slot_test("ps_texture_slot5_buffer7", 5, 1, true);
+   texture_slot_test("ps_sampler_above_textures", 0, 6, false);
    sample_query_test("ps41_sampleinfo", false, false, false);
    sample_query_test("ps41_sampleinfo_uint", false, false, true);
    sample_query_test("ps41_sampleinfo_rasterizer", false, true, false);
diff --git a/src/panfrost/compiler/pan_compiler.c b/src/panfrost/compiler/pan_compiler.c
index cd6f231..6dabd4f 100644
--- a/src/panfrost/compiler/pan_compiler.c
+++ b/src/panfrost/compiler/pan_compiler.c
@@ -304,6 +304,12 @@ pan_shader_update_info(struct pan_shader_info *info, nir_shader *s,
 
    info->sampler_count = info->texture_count =
       BITSET_LAST_BIT(s->info.textures_used);
+   /* Starbite: Direct3D pairs any sampler with any resource, so a sampler
+    * can be numbered above every texture (t0 read through s6). GL's combined
+    * samplers never are, and there the two counts stay equal.
+    */
+   info->sampler_count =
+      MAX2(info->sampler_count, BITSET_LAST_BIT(s->info.samplers_used));
 
    unsigned execution_mode = s->info.float_controls_execution_mode;
    info->ftz_fp16 = nir_is_denorm_flush_to_zero(execution_mode, 16);
-- 
