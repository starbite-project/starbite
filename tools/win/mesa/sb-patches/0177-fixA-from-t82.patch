From a0b8c946d8404a39b494c037014608bad4e26d92 Mon Sep 17 00:00:00 2001
From: Starbite build <build@starbite.invalid>
Date: Mon, 16 Nov 2026 18:44:39 +0200
Subject: [PATCH 3/8] d3d10umd: a vertex or pixel shader the TGSI translator
 refuses goes through NIR

T82 pass O (no flag files): test_cube_maps, test_sample_c_lz and
test_unbound_multisample_texture crash. Each creates a pixel shader with a
switch; ShaderTGSI.c refuses it ("no TGSI translation for opcode
D3D10_SB_OPCODE_SWITCH", tgsi_to_nir has none), the creation fails with
E_OUTOFMEMORY and the test dereferences the missing shader. In pass N the
NIR translator made the same three shaders.

Without the nirshaders switch the NIR translator is now asked when, and only
when, the TGSI one returned nothing (SbTranslateNirAfterTgsiRefusal): also
lod, gather4, samplepos, sampleinfo. A shader the TGSI translator takes is
created exactly as before. The stream output variant of a vertex shader that
is NIR is translated by NIR whatever the switch says.

Compiled only. The three shaders translate and compile for Bifrost in the
host harness (d3d10core.c:7843, 8403, 17805: "OK" through NIR, "the TGSI
translator refused the shader" through TGSI).

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/gallium/frontends/d3d10umd/Shader.cpp | 61 ++++++++++++++++++++---
 1 file changed, 53 insertions(+), 8 deletions(-)

diff --git a/src/gallium/frontends/d3d10umd/Shader.cpp b/src/gallium/frontends/d3d10umd/Shader.cpp
index f0c60bb..c18cf40 100644
--- a/src/gallium/frontends/d3d10umd/Shader.cpp
+++ b/src/gallium/frontends/d3d10umd/Shader.cpp
@@ -163,11 +163,12 @@ SbSignatureEntries(const D3D10DDIARG_STAGE_IO_SIGNATURES *pSignatures, unsigned
 
 static struct nir_shader *
 SbTranslateNirSig(Device *pDevice, mesa_shader_stage stage, const UINT *pCode,
-                  const struct Shader_nir_signature *signature, unsigned *output_mapping);
+                  const struct Shader_nir_signature *signature, unsigned *output_mapping, bool force = false);
 
+/* force: also without the nirshaders switch (SbTranslateNirAfterTgsiRefusal) */
 static struct nir_shader *
 SbTranslateNir(Device *pDevice, mesa_shader_stage stage, const UINT *pCode,
-               const D3D10DDIARG_STAGE_IO_SIGNATURES *pSignatures, unsigned *output_mapping)
+               const D3D10DDIARG_STAGE_IO_SIGNATURES *pSignatures, unsigned *output_mapping, bool force = false)
 {
    unsigned num_in, num_out;
    struct Shader_nir_signature_entry *entries = SbSignatureEntries(pSignatures, &num_in, &num_out);
@@ -175,18 +176,18 @@ SbTranslateNir(Device *pDevice, mesa_shader_stage stage, const UINT *pCode,
       return NULL;
    struct Shader_nir_signature signature = { entries, num_in, entries + num_in, num_out };
 
-   struct nir_shader *nir = SbTranslateNirSig(pDevice, stage, pCode, &signature, output_mapping);
+   struct nir_shader *nir = SbTranslateNirSig(pDevice, stage, pCode, &signature, output_mapping, force);
    free(entries);
    return nir;
 }
 
 static struct nir_shader *
 SbTranslateNirSig(Device *pDevice, mesa_shader_stage stage, const UINT *pCode,
-                  const struct Shader_nir_signature *signature, unsigned *output_mapping)
+                  const struct Shader_nir_signature *signature, unsigned *output_mapping, bool force)
 {
    struct pipe_screen *screen = pDevice->screen;
 
-   if (!SbNirShaders() ||
+   if ((!force && !SbNirShaders()) ||
        (screen->shader_caps[stage].supported_irs & (1 << PIPE_SHADER_IR_TGSI)) ||
        !(screen->shader_caps[stage].supported_irs & (1 << PIPE_SHADER_IR_NIR)) ||
        !screen->nir_options[stage])
@@ -318,7 +319,7 @@ SbVsStreamOutputVariant(Device *pDevice, Shader *vs, Shader *so)
       if (vs->sb_code && vs->sb_sig) {
          struct Shader_nir_signature signature = { vs->sb_sig, vs->sb_sig_in, vs->sb_sig + vs->sb_sig_in,
                                                    vs->sb_sig_out };
-         nir = SbTranslateNirSig(pDevice, MESA_SHADER_VERTEX, vs->sb_code, &signature, mapping);
+         nir = SbTranslateNirSig(pDevice, MESA_SHADER_VERTEX, vs->sb_code, &signature, mapping, true);
       }
       if (!nir)
          why = "the vertex shader could not be translated again";
@@ -363,6 +364,30 @@ SbVsStreamOutputVariant(Device *pDevice, Shader *vs, Shader *so)
 }
 
 
+/*
+ * Without the nirshaders switch, a vertex or pixel shader the TGSI translator refuses (switch, lod, gather4,
+ * samplepos, sampleinfo: it said which) is given to the NIR translator instead of failing the creation. T82
+ * pass O: test_cube_maps, test_sample_c_lz and test_unbound_multisample_texture each lost a pixel shader with a
+ * switch this way and then crashed on the missing object; the same shaders were created in pass N. Nothing
+ * changes for a shader the TGSI translator takes. NULL if the NIR translator refuses it too, or the switch is
+ * on (it was asked first then).
+ */
+static struct nir_shader *
+SbTranslateNirAfterTgsiRefusal(Device *pDevice, mesa_shader_stage stage, const UINT *pCode,
+                               const D3D10DDIARG_STAGE_IO_SIGNATURES *pSignatures, unsigned *output_mapping)
+{
+   static unsigned said;
+
+   if (SbNirShaders())
+      return NULL;
+
+   struct nir_shader *nir = SbTranslateNir(pDevice, stage, pCode, pSignatures, output_mapping, true);
+   if (nir && said++ < 4)
+      DebugPrintf("sbumd: the shader the TGSI translator refused goes through DXBC -> NIR\n");
+   return nir;
+}
+
+
 /*
  * Neither translator has a shader for this code (the TGSI one refuses lod, gather4, samplepos, sampleinfo and
  * anything past Shader Model 4.1, and said which). Fail the creation: E_OUTOFMEMORY is the one error the runtime
@@ -987,7 +1012,16 @@ CreateVertexShader(D3D10DDI_HDEVICE hDevice,                                  //
 
    pShader->state.tokens = Shader_tgsi_translate(pCode, pShader->output_mapping);
    if (!pShader->state.tokens) {
-      SbShaderRefused(hDevice, pShader);
+      nir = SbTranslateNirAfterTgsiRefusal(CastDevice(hDevice), MESA_SHADER_VERTEX, pCode, pSignatures,
+                                           pShader->output_mapping);
+      if (!nir) {
+         SbShaderRefused(hDevice, pShader);
+         return;
+      }
+      SbUseNir(pShader, nir);
+      pShader->handle = pipe->create_vs_state(pipe, &pShader->state);
+      pShader->state.ir.nir = NULL;
+      SbKeepVertexShaderSource(pShader, pCode, pSignatures);
       return;
    }
 
@@ -1623,7 +1657,18 @@ CreatePixelShader(D3D10DDI_HDEVICE hDevice,                                // IN
    pShader->state.tokens = Shader_tgsi_translate(pShaderCode,
                                                  pShader->output_mapping);
    if (!pShader->state.tokens) {
-      SbShaderRefused(hDevice, pShader);
+      nir = SbTranslateNirAfterTgsiRefusal(CastDevice(hDevice), MESA_SHADER_FRAGMENT, pShaderCode, pSignatures,
+                                           pShader->output_mapping);
+      if (!nir) {
+         SbShaderRefused(hDevice, pShader);
+         return;
+      }
+      pShader->writes_o1 = (nir->info.outputs_written & BITFIELD64_BIT(FRAG_RESULT_DATA1)) != 0;
+      if (pShader->writes_o1)
+         pShader->sb_dual_nir = nir_shader_clone(NULL, nir);
+      SbUseNir(pShader, nir);
+      pShader->handle = pipe->create_fs_state(pipe, &pShader->state);
+      pShader->state.ir.nir = NULL;
       return;
    }
 
