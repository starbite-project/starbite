 static int sb_log_active, sb_log_trace;
+/* T13e: how sb_log_open ended, for UmdNote_1: 0 = logging, 1 = no umdlog folder, 0x100|errno = the umdlog
+ * file failed (then C:\Windows\Temp was tried: 0x10000 more if that worked). T13d's umdlog stayed empty. */
+static unsigned sb_log_status = 1;
+void malikm_note(unsigned id, unsigned value);
 
 /* A Mesa abort() (no recovery point exists for it) ends the process; before that, the stack as offsets in
  * this DLL, so the call that aborted can be found with the build's map/PDB. */
@@ -141,6 +145,7 @@ sb_on_abort(int sig)
    (void)sig;
    GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
                       (LPCSTR)(void *)sb_on_abort, &self);
+   malikm_note(16, (unsigned)GetCurrentProcessId());   /* UmdNote_16: a process aborted */
    fprintf(stderr, "sbumd: abort(), stack (+offset in this DLL, else absolute):\n");
    for (USHORT i = 0; i < n; i++) {
       HMODULE m = NULL;
@@ -174,8 +179,16 @@ sb_log_open(void)
    base = base ? base + 1 : exe;
    snprintf(path, sizeof(path), "C:\\ProgramData\\Starbite\\umdlog\\%s-%lu-%lu.log", base,
             (unsigned long)GetCurrentProcessId(), (unsigned long)GetTickCount());
-   if (!freopen(path, "a", stderr))
-      return;
+   if (!freopen(path, "a", stderr)) {
+      sb_log_status = 0x100 | (errno & 0xff);
+      snprintf(path, sizeof(path), "C:\\Windows\\Temp\\sbumd-%s-%lu-%lu.log", base,
+               (unsigned long)GetCurrentProcessId(), (unsigned long)GetTickCount());
+      if (!freopen(path, "a", stderr))
+         return;
+      sb_log_status |= 0x10000;
+   } else {
+      sb_log_status = 0;
+   }
    setvbuf(stderr, NULL, _IONBF, 0);
    sb_log_active = 1;
    signal(SIGABRT, sb_on_abort);
@@ -833,6 +846,32 @@ w_escape(void *data, UINT size)
    return kmt_escape(wdevice, data, size);
 }
 
+/* Starbite (sbumd, T13e): a fact for the KMD's registry trace, UmdNote_<id> = value (sbwddm's
+ * MW_ESCAPE_SB_NOTE). Needs no file access: T13d's processes left no umdlog at all. Ids: see
+ * docs/WIN11-GPU.md 6.13. Counters are sent at 1-4 and each power of two. */
+#define SB_ESCAPE_NOTE 0x5B01
+static volatile LONG sb_counts[64];
+
+void
+malikm_note(unsigned id, unsigned value)
+{
+   struct { uint32_t Code, Id, Value, Reserved; } n = { SB_ESCAPE_NOTE, id, value, 0 };
+   if (!ddi.on || id >= 64)
+      return;
+   (void)w_escape(&n, sizeof n);
+}
+
+void
+malikm_note_count(unsigned id)
+{
+   LONG c;
+   if (id >= 64)
+      return;
+   c = InterlockedIncrement(&sb_counts[id]);
+   if (c <= 4 || (c & (c - 1)) == 0)
+      malikm_note(id, (unsigned)c);
+}
