    }
    ReleaseSRWLockExclusive(&wddm_lock);
+   if (ret == 0) {
+      malikm_note(1, sb_log_status);
+      malikm_note(2, (unsigned)GetCurrentProcessId());
+      malikm_note_count(3);
+   }
    if (trace_on() || sb_log_active)
       fprintf(stderr, "malikm: bind to the runtime device %p: %s\n", hRTDevice,
               ret == 0 ? "yes, through its callbacks" : "no (not maliwddm, or software runtime)");
@@ -1546,6 +1590,12 @@ malikm_present_allocs(unsigned src, unsigned dst, void *dxgi_context)
       ret = hr >= 0 ? 0 : -1;
    }
    ReleaseSRWLockExclusive(&wddm_lock);
+   if (ret) {
+      malikm_note_count(10);
+      malikm_note(11, (unsigned)hr);
+   } else {
+      malikm_note_count(9);
+   }
    if (ret && (trace_on() || sb_log_active))
       fprintf(stderr, "sbumd: pfnPresentCb(src 0x%x, dst 0x%x) failed: 0x%08lx\n", src, dst, (unsigned long)hr);
    return ret;
@@ -1563,6 +1613,7 @@ malikm_set_display_mode(unsigned hPrimaryAllocation)
       hr = ddi.cb.pfnSetDisplayModeCb(ddi.device, &m);
    }
    ReleaseSRWLockExclusive(&wddm_lock);
+   malikm_note(12, (unsigned)hr);
    if (trace_on() || sb_log_active)
       fprintf(stderr, "sbumd: SetDisplayMode(0x%x): 0x%08lx\n", hPrimaryAllocation, (unsigned long)hr);
    return hr >= 0 ? 0 : -1;
