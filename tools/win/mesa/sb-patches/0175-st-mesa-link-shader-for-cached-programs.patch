From 8909baf50e98cc39e161e50053609fb6baba57fc Mon Sep 17 00:00:00 2001
From: Starbite build <build@starbite.invalid>
Date: Mon, 16 Nov 2026 17:31:45 +0200
Subject: [PATCH 2/2] 0172: st/mesa: pipe_context::link_shader also for a
 program from the shader cache

st_link_glsl_to_nir returned early for a cached program and never told the
driver which shaders belong together. Panfrost then compiles the fragment
shader without the varying layout of the vertex shader: the general form,
under another cache key than at the first start. Measured on the host
(48 programs): second start 96 hits / 48 misses and every fragment shader
compiled again; with this 144 hits / 0 misses, and the same fragment shader
code as without a cache.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/mesa/state_tracker/st_glsl_to_nir.cpp | 55 +++++++++++++++--------
 1 file changed, 37 insertions(+), 18 deletions(-)

diff --git a/src/mesa/state_tracker/st_glsl_to_nir.cpp b/src/mesa/state_tracker/st_glsl_to_nir.cpp
index 07f1344..e69a7c7 100644
--- a/src/mesa/state_tracker/st_glsl_to_nir.cpp
+++ b/src/mesa/state_tracker/st_glsl_to_nir.cpp
@@ -434,6 +434,41 @@ st_nir_lower_wpos_ytransform(struct nir_shader *nir,
    return progress;
 }
 
+/* Tell the driver which of its shaders make up the linked program
+ * (pipe_context::link_shader).
+ *
+ * sb-patches/0172: its own function, because a program that comes from the
+ * on-disk cache needs this as much as one that was just linked.  Without it
+ * Panfrost never learns the varying layout of the vertex shader for a cached
+ * program: its fragment shader is then compiled in the general form and under
+ * another key than at the first start, so the second start of an application
+ * compiled every fragment shader once more (and ran other fragment shader
+ * code than a start without the cache).
+ */
+static void
+st_link_driver_shaders(struct gl_context *ctx,
+                       struct gl_shader_program *shader_program)
+{
+   struct pipe_context *pctx = st_context(ctx)->pipe;
+   if (pctx->link_shader) {
+      void *driver_handles[MESA_SHADER_MESH_STAGES];
+      memset(driver_handles, 0, sizeof(driver_handles));
+
+      for (uint32_t i = 0; i < MESA_SHADER_MESH_STAGES; ++i) {
+         struct gl_linked_shader *shader = shader_program->_LinkedShaders[i];
+         if (shader) {
+            struct gl_program *p = shader->Program;
+            if (p && p->variants) {
+               mesa_shader_stage type = shader->Stage;
+               driver_handles[type] = p->variants->driver_shader;
+            }
+         }
+      }
+
+      pctx->link_shader(pctx, driver_handles);
+   }
+}
+
 static bool
 st_link_glsl_to_nir(struct gl_context *ctx,
                     struct gl_shader_program *shader_program)
@@ -444,6 +479,7 @@ st_link_glsl_to_nir(struct gl_context *ctx,
 
    /* Return early if we are loading the shader from on-disk cache */
    if (st_load_nir_from_disk_cache(ctx, shader_program)) {
+      st_link_driver_shaders(ctx, shader_program); /* sb-patches/0172 */
       return GL_TRUE;
    }
 
@@ -652,24 +688,7 @@ st_link_glsl_to_nir(struct gl_context *ctx,
       }
    }
 
-   struct pipe_context *pctx = st_context(ctx)->pipe;
-   if (pctx->link_shader) {
-      void *driver_handles[MESA_SHADER_MESH_STAGES];
-      memset(driver_handles, 0, sizeof(driver_handles));
-
-      for (uint32_t i = 0; i < MESA_SHADER_MESH_STAGES; ++i) {
-         struct gl_linked_shader *shader = shader_program->_LinkedShaders[i];
-         if (shader) {
-            struct gl_program *p = shader->Program;
-            if (p && p->variants) {
-               mesa_shader_stage type = shader->Stage;
-               driver_handles[type] = p->variants->driver_shader;
-            }
-         }
-      }
-
-      pctx->link_shader(pctx, driver_handles);
-   }
+   st_link_driver_shaders(ctx, shader_program);
 
    return true;
 }
