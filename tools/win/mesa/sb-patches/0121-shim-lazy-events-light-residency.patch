+/* T25: a CPU event the scheduler sets once this context has done everything submitted so far */
+static void
+sb_enqueue_event(struct sbdev *d)
+{
+   HANDLE ev = CreateEventW(NULL, TRUE, FALSE, NULL);
+   if (ev) {
+      D3DDDICB_SIGNALSYNCHRONIZATIONOBJECT2 sig = {0};
+      sig.hContext = d->context;
+      sig.Flags.EnqueueCpuEvent = 1;
+      sig.CpuEventHandle = ev;
+      if (d->cb.pfnSignalSynchronizationObject2Cb(d->device, &sig) >= 0) {
+         ring_push(d, d->seq, ev);
+         return;
+      }
+      CloseHandle(ev);
+   }
+   if (!d->noevent || trace_on())
+      fprintf(stderr, "malikm-wddm: no completion event; waits poll the KMD until it catches up\n");
+   d->noevent = d->seq;
+}
