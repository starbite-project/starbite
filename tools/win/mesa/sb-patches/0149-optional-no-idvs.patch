+#ifdef _WIN32
+/* only this one call: windows.h's macros clash with Mesa's headers */
+__declspec(dllimport) unsigned long __stdcall GetFileAttributesA(const char *lpFileName);
+#endif
+static bool
+sb_no_idvs(void)
+{
+   static int v = -1;
+   if (v < 0) {
+      const char *e = getenv("PAN_NO_IDVS");
+      if (e && *e)
+         v = *e == '1';
+#ifdef _WIN32
+      else
+         v = GetFileAttributesA("C:\\ProgramData\\Starbite\\noidvs") != 0xFFFFFFFFul;
+#else
+      else
+         v = 0;
+#endif
+   }
+   return v;
+}
