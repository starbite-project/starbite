@@ -1745,7 +1761,7 @@ panfrost_ptr_map(struct pipe_context *pctx, struct pipe_resource *resource,
 
             if (!copy_resource && drm_is_afbc(rsrc->modifier)) {
                if (panfrost_resource_init_afbc_headers(rsrc))
-                  return NULL;
+                  return pan_ptr_map_fail(transfer, out_transfer);
             }
 
             bo = newbo;
