                  unsigned level,
@@ -1608,7 +1623,8 @@ panfrost_ptr_map(struct pipe_context *pctx, struct pipe_resource *resource,
        drm_is_afrc(rsrc->modifier)) {
       struct panfrost_resource *staging =
          pan_alloc_staging(ctx, rsrc, level, box);
-      assert(staging);
+      if (!staging)
+         return pan_ptr_map_fail(transfer, out_transfer);
 
       /* Staging resources have one LOD: level 0. Query the strides
        * on this LOD.
@@ -1639,7 +1655,7 @@ panfrost_ptr_map(struct pipe_context *pctx, struct pipe_resource *resource,
       }
 
       if (panfrost_bo_mmap(staging->bo))
-         return NULL;
+         return pan_ptr_map_fail(transfer, out_transfer);
 
       return staging->bo->ptr.cpu;
    }
@@ -1648,7 +1664,7 @@ panfrost_ptr_map(struct pipe_context *pctx, struct pipe_resource *resource,
 
