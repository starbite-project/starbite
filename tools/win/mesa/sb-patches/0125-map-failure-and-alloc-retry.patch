+/* Starbite (sb-patches/0125, docs/WIN11-GPU.md 6.41): a failed map releases the transfer and its staging
+ * resource and leaves *out_transfer NULL. Before, the AFBC path dereferenced a NULL staging resource when the
+ * allocation failed (the user's DWM, out of video memory with Steam and a game: panfrost_ptr_map+0x2e8), and
+ * the other failures left a transfer behind that the D3D10 frontend kept as mapped. */
+static void *
+pan_ptr_map_fail(struct panfrost_transfer *transfer, struct pipe_transfer **out_transfer)
+{
+   if (transfer->staging.rsrc)
+      pipe_resource_reference(&transfer->staging.rsrc, NULL);
+   pipe_resource_reference(&transfer->base.resource, NULL);
+   ralloc_free(transfer);
+   *out_transfer = NULL;
+   return NULL;
+}
+
 static void *
