+/* sb-patches/0158: frame-time lows. Present intervals go into 1 ms buckets (0..1999 ms, last = 2 s or more), per
+ * window and for the whole run; "1% low" = 1000 / the 99th-percentile interval (0.1%: 99.9th). The slowest interval
+ * of each window is explained: the present costs of the frame before it and of the one ending it (map = GPU wait,
+ * copy, gdi, async wait), the game thread's CPU time inside it (CPU ~ wall: the game computed, e.g. x64 JIT; CPU << wall:
+ * it waited: page-ins, locks, preemption, a GPU wait outside present) and the process' page faults inside it. */
+#define WGL_PAN_BUCKETS 2000
+struct wgl_pan_hist {
+   unsigned b[WGL_PAN_BUCKETS];
+   unsigned n, over100, over250;
+};
+
+static void
+wgl_pan_hist_add(struct wgl_pan_hist *h, double ms)
+{
+   unsigned i = ms < 0 ? 0 : ms >= WGL_PAN_BUCKETS - 1 ? WGL_PAN_BUCKETS - 1 : (unsigned)ms;
+   h->b[i]++;
+   h->n++;
+   if (ms >= 100.0)
+      h->over100++;
+   if (ms >= 250.0)
+      h->over250++;
+}
+
+/* the interval (upper edge of its 1 ms bucket) that a fraction `q` of the frames do not exceed */
+static double
+wgl_pan_hist_pct(const struct wgl_pan_hist *h, double q)
+{
+   if (!h->n)
+      return 0.0;
+   unsigned want = (unsigned)(q * h->n + 0.999999), seen = 0;
+   if (want < 1)
+      want = 1;
+   for (unsigned i = 0; i < WGL_PAN_BUCKETS; i++) {
+      seen += h->b[i];
+      if (seen >= want)
+         return (double)(i + 1);
+   }
+   return (double)WGL_PAN_BUCKETS;
+}
+
+static void
+wgl_pan_hist_print(char *out, size_t len, const struct wgl_pan_hist *h)
+{
+   double p99 = wgl_pan_hist_pct(h, 0.99), p999 = wgl_pan_hist_pct(h, 0.999);
+   snprintf(out, len, "1%% low %.1f fps (p99 %.0f ms), 0.1%% low %.1f fps (p99.9 %.0f ms), %u over 100 ms, %u over 250 ms",
+            p99 > 0 ? 1000.0 / p99 : 0.0, p99, p999 > 0 ? 1000.0 / p999 : 0.0, p999, h->over100, h->over250);
+}
+
+static struct wgl_pan_hist wgl_pan_hist_win, wgl_pan_hist_run;
+static struct {
+   int64_t run_start;
+   unsigned run_frames;
+   uint64_t last_cpu100ns; /* the game thread's user+kernel time at the last present */
+   unsigned last_faults;   /* the process' page faults at the last present */
+   bool have_last;
+   /* the window's slowest interval */
+   double worst_ms, worst_cpu_ms;
+   unsigned worst_faults;
+   int64_t worst_prev[5], worst_this[5]; /* map, copy, gdi, wait, total */
+   int64_t prev[5];
+} wgl_pan_low;
+
+static uint64_t
+wgl_pan_thread_cpu(void)
+{
+   FILETIME c, e, k, u;
+   if (!GetThreadTimes(GetCurrentThread(), &c, &e, &k, &u))
+      return 0;
+   return ((uint64_t)k.dwHighDateTime << 32 | k.dwLowDateTime) + ((uint64_t)u.dwHighDateTime << 32 | u.dwLowDateTime);
+}
+
+static unsigned
+wgl_pan_faults(void)
+{
+   PROCESS_MEMORY_COUNTERS pmc;
+   pmc.cb = sizeof(pmc);
+   return K32GetProcessMemoryInfo(GetCurrentProcess(), &pmc, sizeof(pmc)) ? pmc.PageFaultCount : 0;
+}
