new file mode 100644
index 0000000..8a2441b
--- /dev/null
+++ b/src/util/disk_cache_os_portable.c
@@ -0,0 +1,1101 @@
+/*
+ * Copyright © 2014 Intel Corporation
+ * SPDX-License-Identifier: MIT
+ *
+ * sb-patches/0171: the multi-file disk cache on systems without the POSIX
+ * calls that disk_cache_os.c is written with (Windows).
+ *
+ * The cache directory has the same layout as on Linux
+ * (<dir>/index, <dir>/xx/<rest of the key in hex>), and an entry has the same
+ * bytes (disk_cache_create_item_blob / disk_cache_parse_and_validate_item in
+ * disk_cache_os.c).  Everything in this file is written on top of a dozen
+ * file primitives (dc_*), which exist twice:
+ *
+ *  - for Windows, with Win32 calls on UTF-8 paths;
+ *  - for POSIX, only so that the rest of this file can be run by the unit
+ *    tests (src/util/tests/cache_test.cpp) on a build host: compile with
+ *    -DSB_DISK_CACHE_PORTABLE_TEST.  Without that define a POSIX build uses
+ *    disk_cache_os.c as before and this file is empty.
+ *
+ * Differences from disk_cache_os.c, all on purpose:
+ *
+ *  - an entry that does not check out when it is read (cut short, damaged,
+ *    not ours) is deleted, so that it is written again; disk_cache_os.c
+ *    leaves it and the entry stays a miss for ever;
+ *  - the total size in the index is counted again once per process, on the
+ *    cache's own thread (disk_cache_recompute_size_async): the counter lives
+ *    in a mapped file, and a machine that is switched off or crashes loses
+ *    the last updates, which would add up to a cache that is larger than its
+ *    limit says;
+ *  - the time of last use is written by us (at most once a day per entry):
+ *    Windows may not keep last-access times;
+ *  - a file counts with its size rounded up to 4 KiB (there is no st_blocks).
+ */
+
+#include "util/disk_cache_os.h"
+
+#if defined(ENABLE_SHADER_CACHE) && DISK_CACHE_OS_PORTABLE
+
+#include <assert.h>
+#include <inttypes.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "util/blob.h"
+#include "util/macros.h"
+#include "util/os_misc.h"
+#include "util/ralloc.h"
+#include "util/rand_xor.h"
+#include "util/u_atomic.h"
+#include "util/u_debug.h"
+#include "util/u_math.h"
+
+/* What one file is taken to cost on the volume. */
+#define DC_CLUSTER 4096u
+
+/* A file larger than this is not an entry of ours (a linked GLSL program is
+ * some hundred KiB at most); it is not read into memory. */
+#define DC_MAX_ENTRY ((uint64_t)64 << 20)
+
+/* File times are counted in steps of 100 ns (what Windows keeps), so that
+ * entries written in one burst still have an order for the eviction. */
+#define DC_TICKS_PER_SECOND ((int64_t)10000000)
+
+/* A .tmp file older than this was left behind by a writer that died. */
+#define DC_STALE_TMP_AGE (60 * 60 * DC_TICKS_PER_SECOND)
+
+/* The time of last use of an entry is brought up to date when it is older
+ * than this (one metadata write a day per entry, not one per read). */
+#define DC_USE_TIME_STEP (24 * 60 * 60 * DC_TICKS_PER_SECOND)
+
+/* Where the cache lives on Windows when MESA_SHADER_CACHE_DIR is not set:
+ * %LOCALAPPDATA%\<this>\mesa_shader_cache */
+#define DC_WIN_DEFAULT_SUBDIR "Starbite\\shader-cache"
+
+struct dc_dirent {
+   const char *name;   /* UTF-8, without the directory */
+   bool is_dir;
+   uint64_t size;
+   int64_t use_time;   /* last access, in 100 ns steps */
+   int64_t write_time; /* last write, in 100 ns steps */
+};
+
+typedef void (*dc_list_cb)(const struct dc_dirent *e, void *data);
+
+enum dc_read {
+   DC_READ_NONE, /* no such file, or it cannot be opened */
+   DC_READ_OK,   /* *data (malloc) and *size are set */
+   DC_READ_BAD,  /* the file is there but cannot be an entry; *size is set */
+};
+
+enum dc_write {
+   DC_WRITE_DONE,
+   DC_WRITE_SKIPPED, /* the entry exists, another writer has it, or an error */
+   DC_WRITE_NO_DIR,  /* the directory of the file does not exist */
+};
+
+static char *
+dc_asprintf(const char *fmt, ...)
+{
+   va_list ap;
+   va_start(ap, fmt);
+   int n = vsnprintf(NULL, 0, fmt, ap);
+   va_end(ap);
+   if (n < 0)
+      return NULL;
+
+   char *s = malloc((size_t)n + 1);
+   if (s) {
+      va_start(ap, fmt);
+      vsnprintf(s, (size_t)n + 1, fmt, ap);
+      va_end(ap);
+   }
+   return s;
+}
+
+static uint64_t
+dc_cost(uint64_t file_size)
+{
+   return align64(MAX2(file_size, 1), DC_CLUSTER);
+}
+
+/* ------------------------------------------------------------------------
+ * The file primitives
+ * ------------------------------------------------------------------------ */
+
+#if DETECT_OS_WINDOWS
+
+#include <windows.h>
+
+/* A UTF-8 path as the wide string the W calls take (malloc), or NULL. */
+static WCHAR *
+dc_wide(const char *path)
+{
+   int n = MultiByteToWideChar(CP_UTF8, 0, path, -1, NULL, 0);
+   if (n <= 0)
+      return NULL;
+
+   WCHAR *w = malloc((size_t)n * sizeof(WCHAR));
+   if (w && MultiByteToWideChar(CP_UTF8, 0, path, -1, w, n) != n) {
+      free(w);
+      w = NULL;
+   }
+   return w;
+}
+
+/* FILETIME: 100 ns steps since 1601. */
+static int64_t
+dc_ticks(FILETIME ft)
+{
+   return (int64_t)(((uint64_t)ft.dwHighDateTime << 32) | ft.dwLowDateTime);
+}
+
+static int64_t
+dc_now(void)
+{
+   FILETIME ft;
+   GetSystemTimeAsFileTime(&ft);
+   return dc_ticks(ft);
+}
+
+static bool
+dc_is_dir(const char *path)
+{
+   WCHAR *w = dc_wide(path);
+   if (!w)
+      return false;
+
+   DWORD a = GetFileAttributesW(w);
+   free(w);
+   return a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+/* True when `path` is a directory afterwards (its parent must exist). */
+static bool
+dc_mkdir(const char *path)
+{
+   WCHAR *w = dc_wide(path);
+   if (!w)
+      return false;
+
+   bool ok = CreateDirectoryW(w, NULL) ||
+             GetLastError() == ERROR_ALREADY_EXISTS;
+   free(w);
+   return ok && dc_is_dir(path);
+}
+
+/* True (and *size) when `path` is a file. */
+static bool
+dc_file_size(const char *path, uint64_t *size)
+{
+   WCHAR *w = dc_wide(path);
+   if (!w)
+      return false;
+
+   WIN32_FILE_ATTRIBUTE_DATA d;
+   bool ok = GetFileAttributesExW(w, GetFileExInfoStandard, &d) &&
+             !(d.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY);
+   free(w);
+   if (ok)
+      *size = ((uint64_t)d.nFileSizeHigh << 32) | d.nFileSizeLow;
+   return ok;
+}
+
+static bool
+dc_delete(const char *path)
+{
+   WCHAR *w = dc_wide(path);
+   if (!w)
+      return false;
+
+   bool ok = DeleteFileW(w);
+   free(w);
+   return ok;
+}
+
+/* Calls cb for everything in the directory except "." and "..". */
+static bool
+dc_list(const char *path, dc_list_cb cb, void *data)
+{
+   char *pattern = dc_asprintf("%s/*", path);
+   WCHAR *w = pattern ? dc_wide(pattern) : NULL;
+   free(pattern);
+   if (!w)
+      return false;
+
+   WIN32_FIND_DATAW fd;
+   HANDLE h = FindFirstFileW(w, &fd);
+   free(w);
+   if (h == INVALID_HANDLE_VALUE)
+      return false;
+
+   do {
+      char name[MAX_PATH * 3 + 1];
+      if (!WideCharToMultiByte(CP_UTF8, 0, fd.cFileName, -1, name,
+                               sizeof(name), NULL, NULL))
+         continue;
+      if (!strcmp(name, ".") || !strcmp(name, ".."))
+         continue;
+
+      struct dc_dirent e = {
+         .name = name,
+         .is_dir = (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0,
+         .size = ((uint64_t)fd.nFileSizeHigh << 32) | fd.nFileSizeLow,
+         .use_time = dc_ticks(fd.ftLastAccessTime),
+         .write_time = dc_ticks(fd.ftLastWriteTime),
+      };
+      cb(&e, data);
+   } while (FindNextFileW(h, &fd));
+
+   FindClose(h);
+   return true;
+}
+
+/* Reads a whole file, and notes that it was used. */
+static enum dc_read
+dc_read_file(const char *path, void **data, size_t *size)
+{
+   WCHAR *w = dc_wide(path);
+   if (!w)
+      return DC_READ_NONE;
+
+   /* Everything is shared: a reader must not stand in the way of another
+    * process that deletes the entry (eviction) while we read it. */
+   const DWORD share = FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE;
+   HANDLE h = CreateFileW(w, GENERIC_READ | FILE_WRITE_ATTRIBUTES, share, NULL,
+                          OPEN_EXISTING, FILE_FLAG_SEQUENTIAL_SCAN, NULL);
+   if (h == INVALID_HANDLE_VALUE && GetLastError() == ERROR_ACCESS_DENIED) {
+      /* a cache we may read but not write: no time of last use then */
+      h = CreateFileW(w, GENERIC_READ, share, NULL, OPEN_EXISTING,
+                      FILE_FLAG_SEQUENTIAL_SCAN, NULL);
+   }
+   free(w);
+   if (h == INVALID_HANDLE_VALUE)
+      return DC_READ_NONE;
+
+   enum dc_read ret = DC_READ_BAD;
+   uint8_t *buf = NULL;
+   LARGE_INTEGER len;
+   if (!GetFileSizeEx(h, &len)) {
+      ret = DC_READ_NONE;
+      goto out;
+   }
+   *size = (size_t)len.QuadPart;
+   if (len.QuadPart <= 0 || (uint64_t)len.QuadPart > DC_MAX_ENTRY)
+      goto out;
+
+   buf = malloc((size_t)len.QuadPart);
+   if (!buf) {
+      ret = DC_READ_NONE;
+      goto out;
+   }
+
+   size_t done = 0;
+   while (done < (size_t)len.QuadPart) {
+      DWORD got = 0;
+      DWORD want = (DWORD)MIN2((size_t)len.QuadPart - done, (size_t)1 << 30);
+      if (!ReadFile(h, buf + done, want, &got, NULL) || got == 0)
+         goto out; /* shorter than its size says: not an entry */
+      done += got;
+   }
+
+   FILETIME used, now;
+   GetSystemTimeAsFileTime(&now);
+   if (GetFileTime(h, NULL, &used, NULL) &&
+       dc_ticks(now) - dc_ticks(used) > DC_USE_TIME_STEP)
+      SetFileTime(h, NULL, &now, NULL);
+
+   *data = buf;
+   buf = NULL;
+   ret = DC_READ_OK;
+
+out:
+   free(buf);
+   CloseHandle(h);
+   return ret;
+}
+
+/* Writes `final` by way of `tmp` so that no reader ever sees a part of it. */
+static enum dc_write
+dc_write_new_file(const char *tmp, const char *final, const void *data,
+                  size_t size)
+{
+   enum dc_write ret = DC_WRITE_SKIPPED;
+   WCHAR *wt = dc_wide(tmp);
+   WCHAR *wf = dc_wide(final);
+   if (!wt || !wf)
+      goto out;
+
+   /* Share mode 0 is the lock that disk_cache_os.c takes with flock(): a
+    * second writer of the same entry (another process) fails right here and
+    * leaves the entry to the first.  CREATE_ALWAYS empties a .tmp file that a
+    * dead writer left. */
+   HANDLE h = CreateFileW(wt, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS,
+                          FILE_ATTRIBUTE_NORMAL, NULL);
+   if (h == INVALID_HANDLE_VALUE) {
+      if (GetLastError() == ERROR_PATH_NOT_FOUND)
+         ret = DC_WRITE_NO_DIR;
+      goto out;
+   }
+
+   /* With the .tmp file ours: did somebody finish the entry meanwhile? */
+   bool ok = GetFileAttributesW(wf) == INVALID_FILE_ATTRIBUTES;
+
+   const uint8_t *p = data;
+   size_t done = 0;
+   while (ok && done < size) {
+      DWORD put = 0;
+      DWORD want = (DWORD)MIN2(size - done, (size_t)1 << 30);
+      ok = WriteFile(h, p + done, want, &put, NULL) && put > 0;
+      done += put;
+   }
+   CloseHandle(h);
+
+   /* Without MOVEFILE_REPLACE_EXISTING: an entry that exists stays.  A file
+    * cut short by a full disk never gets its final name.  Something that
+    * looks at every new file (a virus scanner) can hold the .tmp file for a
+    * moment after we closed it: try again a few times (this is the cache's
+    * own thread; nobody waits for it). */
+   for (unsigned attempt = 0; ok && ret != DC_WRITE_DONE; attempt++) {
+      if (MoveFileExW(wt, wf, 0)) {
+         ret = DC_WRITE_DONE;
+      } else {
+         DWORD err = GetLastError();
+         if (attempt == 3 || (err != ERROR_SHARING_VIOLATION &&
+                              err != ERROR_ACCESS_DENIED))
+            break;
+         Sleep(20);
+      }
+   }
+   if (ret != DC_WRITE_DONE)
+      DeleteFileW(wt);
+
+out:
+   free(wt);
+   free(wf);
+   return ret;
+}
+
+/* Maps a file of exactly `size` bytes read-write, shared between processes.
+ * A file of another size starts again as zeroes. */
+static void *
+dc_map_shared(const char *path, size_t size)
+{
+   WCHAR *w = dc_wide(path);
+   if (!w)
+      return NULL;
+
+   HANDLE f = CreateFileW(w, GENERIC_READ | GENERIC_WRITE,
+                          FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                          NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+   free(w);
+   if (f == INVALID_HANDLE_VALUE)
+      return NULL;
+
+   void *map = NULL;
+   LARGE_INTEGER len, zero = {.QuadPart = 0}, want = {.QuadPart = (LONGLONG)size};
+   if (!GetFileSizeEx(f, &len))
+      goto out;
+   if ((uint64_t)len.QuadPart != size) {
+      /* SetEndOfFile takes the clusters now: a full disk fails here and not
+       * later at a write into the mapping. */
+      if (!SetFilePointerEx(f, zero, NULL, FILE_BEGIN) || !SetEndOfFile(f) ||
+          !SetFilePointerEx(f, want, NULL, FILE_BEGIN) || !SetEndOfFile(f))
+         goto out;
+   }
+
+   HANDLE m = CreateFileMappingW(f, NULL, PAGE_READWRITE, 0, 0, NULL);
+   if (m) {
+      map = MapViewOfFile(m, FILE_MAP_ALL_ACCESS, 0, 0, size);
+      CloseHandle(m); /* the view keeps the mapping */
+   }
+
+out:
+   CloseHandle(f);
+   return map;
+}
+
+static void
+dc_unmap(void *map, UNUSED size_t size)
+{
+   UnmapViewOfFile(map);
+}
+
+/* The size of the volume `path` is on, 0 when unknown. */
+static uint64_t
+dc_volume_bytes(const char *path)
+{
+   WCHAR *w = dc_wide(path);
+   if (!w)
+      return 0;
+
+   ULARGE_INTEGER total;
+   bool ok = GetDiskFreeSpaceExW(w, NULL, &total, NULL);
+   free(w);
+   return ok ? total.QuadPart : 0;
+}
+
+/* The directory the cache directory is made in when MESA_SHADER_CACHE_DIR is
+ * not set (ralloc), or NULL.  The W call: a user name need not fit the ANSI
+ * code page. */
+static char *
+dc_default_root(void *mem_ctx)
+{
+   WCHAR w[MAX_PATH];
+   DWORD n = GetEnvironmentVariableW(L"LOCALAPPDATA", w, ARRAY_SIZE(w));
+   if (n == 0 || n >= ARRAY_SIZE(w))
+      return NULL;
+
+   char u[MAX_PATH * 3 + 1];
+   if (!WideCharToMultiByte(CP_UTF8, 0, w, -1, u, sizeof(u), NULL, NULL))
+      return NULL;
+
+   return ralloc_asprintf(mem_ctx, "%s\\%s", u, DC_WIN_DEFAULT_SUBDIR);
+}
+
+static bool
+dc_is_sep(char c)
+{
+   return c == '/' || c == '\\';
+}
