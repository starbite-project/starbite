diff --git a/meson.build b/meson.build
index 4e1879c..5479ac7 100644
--- a/meson.build
+++ b/meson.build
@@ -1171,9 +1171,9 @@ if with_split_debug.allowed() and get_option('debug')
   add_project_link_arguments('-Wl,--gdb-index', language : ['c', 'cpp'])
 endif
 
-with_shader_cache = get_option('shader-cache') \
-  .require(host_machine.system() != 'windows', error_message : 'Shader Cache does not currently work on Windows') \
-  .allowed()
+# sb-patches/0171: the multi-file shader cache works on Windows
+# (src/util/disk_cache_os_portable.c), so the option is no longer refused there.
+with_shader_cache = get_option('shader-cache').allowed()
 
 if with_shader_cache
   pre_args += '-DENABLE_SHADER_CACHE'
@@ -1816,7 +1816,10 @@ with_compression = dep_zlib.found() or dep_zstd.found()
 if with_compression
   pre_args += '-DHAVE_COMPRESSION'
