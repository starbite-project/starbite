+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/file.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <sys/time.h>
+#include <time.h>
+#include <unistd.h>
+
+static int64_t
+dc_ticks(struct timespec ts)
+{
+   return (int64_t)ts.tv_sec * DC_TICKS_PER_SECOND + ts.tv_nsec / 100;
+}
+
+static int64_t
+dc_now(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_REALTIME, &ts);
+   return dc_ticks(ts);
+}
+
+static bool
+dc_is_dir(const char *path)
+{
+   struct stat sb;
+   return stat(path, &sb) == 0 && S_ISDIR(sb.st_mode);
+}
+
+static bool
+dc_mkdir(const char *path)
+{
+   return (mkdir(path, 0700) == 0 || errno == EEXIST) && dc_is_dir(path);
+}
+
+static bool
+dc_file_size(const char *path, uint64_t *size)
+{
+   struct stat sb;
+   if (stat(path, &sb) != 0 || S_ISDIR(sb.st_mode))
+      return false;
+   *size = sb.st_size;
+   return true;
+}
+
+static bool
+dc_delete(const char *path)
+{
+   return unlink(path) == 0;
+}
+
+static bool
+dc_list(const char *path, dc_list_cb cb, void *data)
+{
+   DIR *dir = opendir(path);
+   if (!dir)
+      return false;
+
+   struct dirent *d;
+   while ((d = readdir(dir)) != NULL) {
+      if (!strcmp(d->d_name, ".") || !strcmp(d->d_name, ".."))
+         continue;
+
+      struct stat sb;
+      if (fstatat(dirfd(dir), d->d_name, &sb, 0) != 0)
+         continue;
+
+      struct dc_dirent e = {
+         .name = d->d_name,
+         .is_dir = S_ISDIR(sb.st_mode),
+         .size = sb.st_size,
+         .use_time = dc_ticks(sb.st_atim),
+         .write_time = dc_ticks(sb.st_mtim),
+      };
+      cb(&e, data);
+   }
+   closedir(dir);
+   return true;
+}
+
+static enum dc_read
+dc_read_file(const char *path, void **data, size_t *size)
+{
+   int fd = open(path, O_RDONLY | O_CLOEXEC);
+   if (fd == -1)
+      return DC_READ_NONE;
+
+   enum dc_read ret = DC_READ_BAD;
+   uint8_t *buf = NULL;
+   struct stat sb;
+   if (fstat(fd, &sb) == -1) {
+      ret = DC_READ_NONE;
+      goto out;
+   }
+   *size = sb.st_size;
+   if (sb.st_size <= 0 || (uint64_t)sb.st_size > DC_MAX_ENTRY)
+      goto out;
+
+   buf = malloc(sb.st_size);
+   if (!buf) {
+      ret = DC_READ_NONE;
+      goto out;
+   }
+
+   size_t done = 0;
+   while (done < (size_t)sb.st_size) {
+      ssize_t got = read(fd, buf + done, sb.st_size - done);
+      if (got <= 0)
+         goto out;
+      done += got;
+   }
+
+   if (dc_now() - dc_ticks(sb.st_atim) > DC_USE_TIME_STEP) {
+      struct timespec times[2] = {{.tv_nsec = UTIME_NOW}, {.tv_nsec = UTIME_OMIT}};
+      futimens(fd, times);
+   }
+
+   *data = buf;
+   buf = NULL;
+   ret = DC_READ_OK;
+
+out:
+   free(buf);
+   close(fd);
+   return ret;
+}
+
+static enum dc_write
+dc_write_new_file(const char *tmp, const char *final, const void *data,
+                  size_t size)
+{
+   int fd = open(tmp, O_WRONLY | O_CLOEXEC | O_CREAT, 0644);
+   if (fd == -1)
+      return errno == ENOENT ? DC_WRITE_NO_DIR : DC_WRITE_SKIPPED;
+
+   enum dc_write ret = DC_WRITE_SKIPPED;
+   if (flock(fd, LOCK_EX | LOCK_NB) == -1)
+      goto out;
+
+   bool ok = access(final, F_OK) != 0 && ftruncate(fd, 0) == 0;
+
+   const uint8_t *p = data;
+   size_t done = 0;
+   while (ok && done < size) {
+      ssize_t put = write(fd, p + done, size - done);
+      ok = put > 0;
+      if (ok)
+         done += put;
+   }
+
+   if (ok && rename(tmp, final) == 0)
+      ret = DC_WRITE_DONE;
+   else
+      unlink(tmp);
+
+out:
+   close(fd);
+   return ret;
+}
+
+static void *
+dc_map_shared(const char *path, size_t size)
+{
+   int fd = open(path, O_RDWR | O_CREAT | O_CLOEXEC, 0644);
+   if (fd == -1)
+      return NULL;
+
+   void *map = NULL;
+   struct stat sb;
+   if (fstat(fd, &sb) == -1)
+      goto out;
+   if ((size_t)sb.st_size != size &&
+       (ftruncate(fd, 0) == -1 || ftruncate(fd, size) == -1))
+      goto out;
+
+   map = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+   if (map == MAP_FAILED)
+      map = NULL;
+
+out:
+   close(fd);
+   return map;
+}
+
+static void
+dc_unmap(void *map, size_t size)
+{
+   munmap(map, size);
+}
+
+static uint64_t
+dc_volume_bytes(const char *path)
+{
+   struct statvfs vfs;
+   if (statvfs(path, &vfs) != 0)
+      return 0;
+   return (uint64_t)vfs.f_blocks * vfs.f_frsize;
+}
