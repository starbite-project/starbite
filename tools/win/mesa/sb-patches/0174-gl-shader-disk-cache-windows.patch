diff --git a/src/gallium/drivers/panfrost/pan_disk_cache.c b/src/gallium/drivers/panfrost/pan_disk_cache.c
index b192093..bdb159d 100644
--- a/src/gallium/drivers/panfrost/pan_disk_cache.c
+++ b/src/gallium/drivers/panfrost/pan_disk_cache.c
@@ -22,8 +22,105 @@
 static bool debug = false;
 #endif
 
+#ifdef _WIN32
+/* sb-patches/0171: the on-disk shader cache on Windows, and what it says in the log (stderr, which the shim sends to
+ * C:\ProgramData\Starbite\umdlog when that folder exists):
+ *
+ *  - one line when the screen is made: on or off, the directory, the size limit, the driver identity;
+ *  - one line with the counters at every 32nd compiled-shader lookup, at the first frame, and when the process ends
+ *    (with the cache off: the first-frame line alone, so that an on/off comparison has the same time in both logs).
+ *
+ * "lookups" counts every disk_cache_get of the process: the linked GLSL programs of the GL state tracker and the
+ * compiled shaders of this file. "compiled shaders" are the lookups of this file alone, with the time the hits took
+ * to read and the time the misses took to compile (the Bifrost compiler: the work a hit saves).
+ */
+#include <stdlib.h>
+#include <windows.h>
+
+#include "util/u_atomic.h"
+
+static double
+sb_cache_process_seconds(void)
+{
+   FILETIME made, gone, kernel, user, now;
+   if (!GetProcessTimes(GetCurrentProcess(), &made, &gone, &kernel, &user))
+      return 0.0;
+   GetSystemTimeAsFileTime(&now);
+   uint64_t a = ((uint64_t)made.dwHighDateTime << 32) | made.dwLowDateTime;
+   uint64_t b = ((uint64_t)now.dwHighDateTime << 32) | now.dwLowDateTime;
+   return b > a ? (double)(b - a) / 1e7 : 0.0;
+}
+
+#if defined(ENABLE_SHADER_CACHE)
+#include "util/disk_cache_os.h" /* struct disk_cache: the path, the limit and the counters */
+#include "util/os_time.h"
+#include "c11/threads.h"
+#include "git_sha1.h"
+
+static struct {
+   int on;                     /* a screen has a cache */
+   unsigned hits, misses;      /* compiled shaders */
+   int64_t read_ns, compile_ns;
+   unsigned all_hits, all_misses, puts; /* the cache's own counters, as last seen */
+} sb_cache;
+
+static thread_local int64_t sb_cache_miss_start;
+
+static void
+sb_cache_log(const char *when)
+{
+   fprintf(stderr,
+           "sbumd: shader cache: %s, %.1f s after process start: %u lookups, %u hits, %u misses; compiled shaders: "
+           "%u hits (%.0f ms reading), %u misses (%.0f ms compiling); %u entries written\n",
+           when, sb_cache_process_seconds(), sb_cache.all_hits + sb_cache.all_misses, sb_cache.all_hits,
+           sb_cache.all_misses, sb_cache.hits, (double)p_atomic_read(&sb_cache.read_ns) / 1e6, sb_cache.misses,
+           (double)p_atomic_read(&sb_cache.compile_ns) / 1e6, sb_cache.puts);
+   fflush(stderr);
+}
+
+static void
+sb_cache_seen(struct disk_cache *cache)
+{
+   sb_cache.all_hits = cache->stats.hits;
+   sb_cache.all_misses = cache->stats.misses;
+   sb_cache.puts = cache->stats.puts;
+}
+
+static void
+sb_cache_at_exit(void)
+{
+   /* the counters as last seen: the screen and its cache may be gone by now */
+   if (sb_cache.on)
+      sb_cache_log("process end");
+}
+#endif /* ENABLE_SHADER_CACHE */
+
+/* the first PIPE_FLUSH_END_OF_FRAME of the process (panfrost_flush): how far the process was when its first frame
+ * was complete, and what the cache had done until then */
+void
+panfrost_disk_cache_first_frame(struct panfrost_screen *screen)
+{
+   static int done;
+
+   if (done || p_atomic_xchg(&done, 1))
+      return;
+
+#ifdef ENABLE_SHADER_CACHE
+   if (screen->disk_cache) {
+      sb_cache_seen(screen->disk_cache);
+      sb_cache_log("first frame");
+      return;
+   }
+#endif
+   fprintf(stderr, "sbumd: shader cache: off; first frame, %.1f s after process start\n",
+           sb_cache_process_seconds());
+   fflush(stderr);
+}
+#endif /* _WIN32 */
+
 extern int midgard_debug;
 extern int bifrost_debug;
+void bifrost_init_debug_options(void); /* sb-patches/0171: src/panfrost/compiler/bifrost/bi_debug.c */
 
 /**
  * Compute a disk cache key for the given uncompiled shader and shader key.
@@ -60,6 +157,15 @@ panfrost_disk_cache_store(struct disk_cache *cache,
 
    PAN_TRACE_FUNC(PAN_TRACE_GL_DISK_CACHE);
 
+#ifdef _WIN32
+   /* sb-patches/0171: a store follows a miss on the same thread (panfrost_shader_get); between the two the shader
+    * was compiled */
+   if (sb_cache_miss_start) {
+      p_atomic_add(&sb_cache.compile_ns, os_time_get_nano() - sb_cache_miss_start);
+      sb_cache_miss_start = 0;
+   }
+#endif
+
    cache_key cache_key;
    panfrost_disk_cache_compute_key(cache, uncompiled, key, cache_key);
 
@@ -113,12 +219,33 @@ panfrost_disk_cache_retrieve(struct disk_cache *cache,
       fprintf(stderr, "[mesa disk cache] retrieving %s: ", blake3);
    }
 
+#ifdef _WIN32
+   const int64_t sb_start = os_time_get_nano(); /* sb-patches/0171 */
+#endif
+
    size_t size;
    void *buffer = disk_cache_get(cache, cache_key, &size);
 
    if (debug)
       fprintf(stderr, "%s\n", buffer ? "found" : "missing");
 
+#ifdef _WIN32
+   {  /* sb-patches/0171: count, and say where we are at every 32nd lookup */
+      const int64_t now = os_time_get_nano();
+      unsigned n;
+      if (buffer) {
+         p_atomic_add(&sb_cache.read_ns, now - sb_start);
+         n = p_atomic_inc_return(&sb_cache.hits) + sb_cache.misses;
+      } else {
+         sb_cache_miss_start = now; /* panfrost_disk_cache_store ends the measurement */
+         n = p_atomic_inc_return(&sb_cache.misses) + sb_cache.hits;
+      }
+      sb_cache_seen(cache);
+      if (n % 32 == 0)
+         sb_cache_log("so far");
+   }
+#endif
+
    if (!buffer)
       return false;
 
@@ -150,7 +277,29 @@ panfrost_disk_cache_init(struct panfrost_screen *screen)
 {
 #ifdef ENABLE_SHADER_CACHE
    const char *renderer = screen->base.get_name(&screen->base);
+   char timestamp[BLAKE3_HEX_LEN];
 
+#ifdef _WIN32
+   /* sb-patches/0171: a PE image has no build-id note. What names this build of the driver: the identity of the
+    * module this function is in (its link time stamp and section layout, util/disk_cache_os.c) and the Mesa version
+    * with the git commit. Every cache key starts from this, so shaders compiled by another build are never found.
+    * Without an identity there is no cache. */
+   uint32_t sb_link_stamp = 0;
+   {
+      static const char version[] = PACKAGE_VERSION MESA_GIT_SHA1;
+      blake3_hasher hasher;
+      blake3_hash id;
+
+      _mesa_blake3_init(&hasher);
+      if (!disk_cache_get_module_identifier(panfrost_disk_cache_init, &hasher, &sb_link_stamp)) {
+         fprintf(stderr, "sbumd: shader cache: off (no build identity for this module)\n");
+         return;
+      }
+      _mesa_blake3_update(&hasher, version, sizeof(version));
+      _mesa_blake3_final(&hasher, id);
+      _mesa_blake3_format(timestamp, id);
+   }
+#else
    const struct build_id_note *note =
       build_id_find_nhdr_for_addr(panfrost_disk_cache_init);
    assert(note && build_id_length(note) == BUILD_ID_EXPECTED_HASH_LENGTH); /* sha1 */
@@ -158,13 +307,43 @@ panfrost_disk_cache_init(struct panfrost_screen *screen)
    const uint8_t *id_sha1 = build_id_data(note);
    assert(id_sha1);
 
-   char timestamp[BLAKE3_HEX_LEN];
    _mesa_sha1_format(timestamp, id_sha1);
+#endif
+
+   /* sb-patches/0171: BIFROST_MESA_DEBUG is read at the first compile, which is after this: read it now, or a
+    * cache filled without it would serve its shaders to a run with (say) BIFROST_MESA_DEBUG=noopt. */
+   bifrost_init_debug_options();
 
    /* Consider any flags affecting the compile when caching */
    uint64_t driver_flags = screen->dev.debug;
    driver_flags |= ((uint64_t)(midgard_debug | bifrost_debug) << 32);
 
    screen->disk_cache = disk_cache_create(renderer, timestamp, driver_flags);
+
+#ifdef _WIN32
+   {  /* sb-patches/0171: a cache that is switched off (MESA_SHADER_CACHE_DISABLE, which the GL target sets for the
+       * flag file glnocache) or has no usable directory comes back as an object that stores nothing. Drop it: with
+       * no cache at all the state tracker takes exactly the path of the builds without -Dshader-cache. */
+      struct disk_cache *cache = screen->disk_cache;
+      if (cache && cache->path_init_failed) {
+         disk_cache_destroy(cache);
+         screen->disk_cache = cache = NULL;
+      }
+      if (cache) {
+         cache->stats.enabled = true;
+         fprintf(stderr,
+                 "sbumd: shader cache: on, %s, limit %llu MiB, driver id %s (link stamp 0x%08x, Mesa "
+                 PACKAGE_VERSION MESA_GIT_SHA1 "), flags 0x%llx; %.1f s after process start\n",
+                 cache->path, (unsigned long long)(cache->max_size >> 20), timestamp, (unsigned)sb_link_stamp,
+                 (unsigned long long)driver_flags, sb_cache_process_seconds());
+         if (!p_atomic_xchg(&sb_cache.on, 1))
+            atexit(sb_cache_at_exit);
+      } else {
+         fprintf(stderr, "sbumd: shader cache: off (switched off, or its directory cannot be used); %.1f s after "
+                         "process start\n", sb_cache_process_seconds());
+      }
+      fflush(stderr);
+   }
+#endif
 #endif
 }
