+
+/* ------------------------------------------------------------------------
+ * The cache on top of the primitives
+ * ------------------------------------------------------------------------ */
+
+/* Makes `path` and the parents it lacks.  Starts at the leaf, so a drive
+ * root or a share is never something we try to create. */
+static bool
+dc_mkdir_p(const char *path)
+{
+   if (dc_is_dir(path) || dc_mkdir(path))
+      return true;
+
+   size_t n = strlen(path);
+   while (n > 0 && dc_is_sep(path[n - 1]))
+      n--;
+   while (n > 0 && !dc_is_sep(path[n - 1]))
+      n--;
+   while (n > 0 && dc_is_sep(path[n - 1]))
+      n--;
+   if (n == 0)
+      return false;
+
+   char *parent = malloc(n + 1);
+   if (!parent)
+      return false;
+   memcpy(parent, path, n);
+   parent[n] = '\0';
+
+   bool ok = dc_mkdir_p(parent);
+   free(parent);
+   return ok && dc_mkdir(path);
+}
+
+static bool
+dc_is_tmp(const char *name)
+{
+   size_t len = strlen(name);
+   return len >= 4 && strcmp(&name[len - 4], ".tmp") == 0;
+}
+
+struct dc_file {
+   char *name;
+   uint64_t size;
+   int64_t use_time;
+};
+
+struct dc_scan {
+   const char *dir;
+   int64_t now;
+   bool want_files;       /* collect the entries in `files` */
+   bool remove_stale_tmp; /* delete .tmp files of dead writers */
+
+   uint64_t total; /* what the entries cost together */
+   struct dc_file *files;
+   unsigned count, capacity;
+};
+
+static void
+dc_scan_cb(const struct dc_dirent *e, void *data)
+{
+   struct dc_scan *s = data;
+
+   if (e->is_dir)
+      return;
+
+   if (dc_is_tmp(e->name)) {
+      if (s->remove_stale_tmp && s->now - e->write_time > DC_STALE_TMP_AGE) {
+         /* On Windows the delete fails while a writer still has the file,
+          * which is what we want. */
+         char *p = dc_asprintf("%s/%s", s->dir, e->name);
+         if (p) {
+            dc_delete(p);
+            free(p);
+         }
+      }
+      return;
+   }
+
+   s->total += dc_cost(e->size);
+
+   if (!s->want_files)
+      return;
+
+   if (s->count == s->capacity) {
+      unsigned capacity = s->capacity ? s->capacity * 2 : 64;
+      struct dc_file *files = realloc(s->files, capacity * sizeof(*files));
+      if (!files)
+         return;
+      s->files = files;
+      s->capacity = capacity;
+   }
+
+   char *name = strdup(e->name);
+   if (!name)
+      return;
+   s->files[s->count++] = (struct dc_file){
+      .name = name,
+      .size = e->size,
+      .use_time = e->use_time,
+   };
+}
+
+static int
+dc_oldest_first(const void *a, const void *b)
+{
+   const struct dc_file *fa = a, *fb = b;
+   if (fa->use_time != fb->use_time)
+      return fa->use_time < fb->use_time ? -1 : 1;
+   return strcmp(fa->name, fb->name);
+}
+
+/* Deletes the tenth of the entries in one xx directory that was not used for
+ * the longest time (one entry at least).  Returns what that frees. */
+static uint64_t
+dc_evict_from_directory(const char *dir)
+{
+   struct dc_scan s = {.dir = dir, .want_files = true};
+   uint64_t freed = 0;
+
+   if (dc_list(dir, dc_scan_cb, &s) && s.count) {
+      qsort(s.files, s.count, sizeof(*s.files), dc_oldest_first);
+
+      unsigned victims = s.count > 10 ? s.count / 10 : 1;
+      for (unsigned i = 0; i < victims; i++) {
+         char *p = dc_asprintf("%s/%s", dir, s.files[i].name);
+         if (p && dc_delete(p))
+            freed += dc_cost(s.files[i].size);
+         free(p);
+      }
+   }
+
+   for (unsigned i = 0; i < s.count; i++)
+      free(s.files[i].name);
+   free(s.files);
+   return freed;
+}
+
+/* Evict least recently used cache items: as in disk_cache_os.c a random xx
+ * directory stands for the whole cache.  When that one has nothing (a nearly
+ * empty cache, the unit tests), the following ones are tried. */
+bool
+disk_cache_evict_lru_item(struct disk_cache *cache)
+{
+   uint64_t rand64 = rand_xorshift128plus(cache->seed_xorshift128plus);
+
+   for (unsigned i = 0; i < 256; i++) {
+      char *dir = dc_asprintf("%s/%02x", cache->path,
+                              (unsigned)((rand64 + i) & 0xff));
+      if (!dir)
+         return false;
+
+      uint64_t freed = dc_evict_from_directory(dir);
+      free(dir);
+
+      if (freed) {
+         p_atomic_add(&cache->size->value, -freed);
+         return true;
+      }
+   }
+
+   return false;
+}
+
+bool
+disk_cache_size_is_valid(struct disk_cache *cache)
+{
+   uint64_t size = p_atomic_read_relaxed(&cache->size->value);
+
+   if (size % 512)
+      return false;
+
+   uint64_t volume = dc_volume_bytes(cache->path);
+   if (volume && size > volume)
+      return false;
+
+   return true;
+}
+
+void
+disk_cache_recompute_size(struct disk_cache *cache)
+{
+   uint64_t total = 0;
+   int64_t now = dc_now();
+
+   for (unsigned i = 0; i < 256; i++) {
+      char *dir = dc_asprintf("%s/%02x", cache->path, i);
+      if (!dir)
+         continue;
+
+      struct dc_scan s = {.dir = dir, .now = now, .remove_stale_tmp = true};
+      dc_list(dir, dc_scan_cb, &s);
+      total += s.total;
+      free(dir);
+   }
+
+   p_atomic_set(&cache->size->value, total);
+}
+
+struct dc_recompute_job {
+   struct util_queue_fence fence;
+   struct disk_cache *cache;
+};
+
+static void
+dc_recompute_execute(void *job, UNUSED void *gdata, UNUSED int thread_index)
+{
+   disk_cache_recompute_size(((struct dc_recompute_job *)job)->cache);
+}
+
+static void
+dc_recompute_cleanup(void *job, UNUSED void *gdata, UNUSED int thread_index)
+{
+   free(job);
+}
+
+/* Counts the cache again on its queue thread (see the top of this file).
+ * The queue has one thread here (disk_cache_init_queue), so no entry of this
+ * process is written while the count runs. */
+void
+disk_cache_recompute_size_async(struct disk_cache *cache)
+{
+   struct dc_recompute_job *job = malloc(sizeof(*job));
+   if (!job)
+      return;
+
+   job->cache = cache;
+   util_queue_fence_init(&job->fence);
+   util_queue_add_job(&cache->cache_queue, job, &job->fence,
+                      dc_recompute_execute, dc_recompute_cleanup, 0);
+}
+
+void
+disk_cache_evict_item(struct disk_cache *cache, char *filename)
+{
+   uint64_t size;
+   if (dc_file_size(filename, &size) && dc_delete(filename))
+      p_atomic_add(&cache->size->value, -dc_cost(size));
+
+   free(filename);
+}
+
+void *
+disk_cache_load_item(struct disk_cache *cache, char *filename, size_t *size)
+{
+   void *file = NULL;
+   size_t file_size = 0;
+   uint8_t *item = NULL;
+
+   enum dc_read r = dc_read_file(filename, &file, &file_size);
+   if (r == DC_READ_OK)
+      item = disk_cache_parse_and_validate_item(cache, file, file_size, size);
+
+   /* A file that is there but is no entry (cut short, damaged, zeroes after
+    * a power loss): away with it, so that the shader is stored again.  Only
+    * complete files ever get the final name, so this is not a file that
+    * somebody is still writing. */
+   if (r != DC_READ_NONE && !item && dc_delete(filename))
+      p_atomic_add(&cache->size->value, -dc_cost(file_size));
+
+   free(file);
+   free(filename);
+   return item;
+}
+
+/* Return a filename within the cache's directory corresponding to 'key'.
+ *
+ * Returns NULL if out of memory.
+ */
+char *
+disk_cache_get_cache_filename(struct disk_cache *cache, const cache_key key)
+{
+   char buf[BLAKE3_HEX_LEN];
+
+   if (cache->path_init_failed)
+      return NULL;
+
+   _mesa_blake3_format(buf, key);
+   return dc_asprintf("%s/%c%c/%s", cache->path, buf[0], buf[1], buf + 2);
+}
+
+void
+disk_cache_write_item_to_disk(struct disk_cache_put_job *dc_job,
+                              char *filename)
+{
+   struct disk_cache *cache = dc_job->cache;
+   struct blob cache_blob;
+   blob_init(&cache_blob);
+
+   char *filename_tmp = dc_asprintf("%s.tmp", filename);
+   if (!filename_tmp)
+      goto done;
+
+   /* Nothing to do when the entry exists (checked once more by
+    * dc_write_new_file when it holds the .tmp file). */
+   uint64_t existing;
+   if (dc_file_size(filename, &existing))
+      goto done;
+
+   if (!disk_cache_create_item_blob(dc_job, &cache_blob))
+      goto done;
+
+   enum dc_write w = dc_write_new_file(filename_tmp, filename,
+                                       cache_blob.data, cache_blob.size);
+   if (w == DC_WRITE_NO_DIR) {
+      /* Make the two-character subdirectory within the cache as needed. */
+      char buf[BLAKE3_HEX_LEN];
+      _mesa_blake3_format(buf, dc_job->key);
+      char *dir = dc_asprintf("%s/%c%c", cache->path, buf[0], buf[1]);
+      if (dir) {
+         dc_mkdir(dir);
+         free(dir);
+      }
+      w = dc_write_new_file(filename_tmp, filename, cache_blob.data,
+                            cache_blob.size);
+   }
+
+   if (w == DC_WRITE_DONE) {
+      p_atomic_add(&cache->size->value, dc_cost(cache_blob.size));
+      p_atomic_inc(&cache->stats.puts);
+   }
+
+done:
+   free(filename_tmp);
+   blob_finish(&cache_blob);
+}
+
+/* Determine path for cache based on the first defined name as follows:
+ *
+ *   $MESA_SHADER_CACHE_DIR/mesa_shader_cache
+ *   Windows: %LOCALAPPDATA%\Starbite\shader-cache\mesa_shader_cache
+ *   (POSIX, unit tests: $XDG_CACHE_HOME or $HOME/.cache, then the same name)
+ *
+ * MESA_SHADER_CACHE_DIR is taken as UTF-8.  Returns NULL when the directory
+ * is not there and cannot be made: the cache is then off for this process.
+ */
+const char *
+disk_cache_generate_cache_dir(void *mem_ctx, const char *gpu_name,
+                              const char *driver_id,
+                              const char *cache_dir_name_custom,
+                              enum disk_cache_type cache_type,
+                              bool mkdir)
+{
+   const char *cache_dir_name = CACHE_DIR_NAME;
+   if (cache_dir_name_custom)
+      cache_dir_name = cache_dir_name_custom;
+   else if (cache_type == DISK_CACHE_SINGLE_FILE)
+      cache_dir_name = CACHE_DIR_NAME_SF;
+   else if (cache_type == DISK_CACHE_DATABASE)
+      cache_dir_name = CACHE_DIR_NAME_DB;
+
+   /* os_get_option's result does not outlive the next call on Windows */
+   const char *env = os_get_option_secure("MESA_SHADER_CACHE_DIR");
+   char *root = env ? ralloc_strdup(mem_ctx, env) : dc_default_root(mem_ctx);
+   if (!root)
+      return NULL;
+
+   char *path = ralloc_asprintf(mem_ctx, "%s/%s", root, cache_dir_name);
+   if (path && cache_type == DISK_CACHE_SINGLE_FILE)
+      path = ralloc_asprintf(mem_ctx, "%s/%s/%s", path, driver_id, gpu_name);
+   if (!path)
+      return NULL;
+
+   if (mkdir ? dc_mkdir_p(path) : dc_is_dir(path))
+      return path;
+
+   if (mkdir)
+      fprintf(stderr, "Failed to create %s for shader cache---disabling.\n",
+              path);
+   return NULL;
+}
+
+/* The marker file is only read by disk_cache_delete_old_cache, which has
+ * nothing to delete here: this backend never had another default cache. */
+void
+disk_cache_touch_cache_user_marker(UNUSED char *path)
+{
+}
+
+void
+disk_cache_delete_old_cache(void)
+{
+}
+
+bool
+disk_cache_mmap_cache_index(void *mem_ctx, struct disk_cache *cache)
+{
+   char *path = ralloc_asprintf(mem_ctx, "%s/index", cache->path);
+   if (path == NULL)
+      return false;
+
+   /* The index: the total size, then one key per slot.  Shared between the
+    * processes that use the cache, as in disk_cache_os.c. */
+   size_t size = sizeof(*cache->size) + CACHE_INDEX_MAX_KEYS * CACHE_KEY_SIZE;
+   uint8_t *map = dc_map_shared(path, size);
+   if (!map)
+      return false;
+
+   cache->index_mmap = map;
+   cache->index_reserve = map;
+   cache->index_reserve_size = size;
+   cache->size = (p_atomic_uint64_t *)map;
+   cache->stored_keys = map + sizeof(uint64_t);
+   return true;
+}
+
+void
+disk_cache_destroy_mmap(struct disk_cache *cache)
+{
+   if (cache->index_reserve)
+      dc_unmap(cache->index_reserve, cache->index_reserve_size);
+}
