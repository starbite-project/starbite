+/* What one build of the driver stored is never found by another build: the
+ * driver id is part of every key, and it is written into every entry. */
+TEST_F(Cache, SbDriverIdChangeMisses)
+{
+#ifndef ENABLE_SHADER_CACHE
+   GTEST_SKIP() << "ENABLE_SHADER_CACHE not defined.";
+#else
+   const char shader[] = "the same shader source, compiled by two builds";
+   const char binary_1[] = "binary of build 1";
+   const char binary_2[] = "binary of build 2, which differs";
+   cache_key key_1, key_2, key_1_again;
+
+   rmrf_local(CACHE_TEST_TMP);
+
+   struct disk_cache *cache = sb_cache_create("build-1");
+   ASSERT_NE(cache, nullptr);
+   disk_cache_compute_key(cache, shader, sizeof(shader), key_1);
+   sb_put(cache, key_1, binary_1, sizeof(binary_1));
+   disk_cache_destroy(cache);
+
+   /* the driver was rebuilt */
+   cache = sb_cache_create("build-2");
+   ASSERT_NE(cache, nullptr);
+   disk_cache_compute_key(cache, shader, sizeof(shader), key_2);
+   EXPECT_NE(memcmp(key_1, key_2, sizeof(key_1)), 0) << "same key for two driver ids";
+   EXPECT_EQ(disk_cache_get(cache, key_2, NULL), nullptr) << "build 2 found an entry before storing one";
+   sb_put(cache, key_2, binary_2, sizeof(binary_2));
+
+   size_t size = 0;
+   char *back = (char *)disk_cache_get(cache, key_2, &size);
+   ASSERT_NE(back, nullptr);
+   EXPECT_STREQ(back, binary_2);
+   free(back);
+
+#ifdef NDEBUG
+   /* even with the very key of build 1 (which no caller can compute), the
+    * entry of build 1 is refused by build 2: its header names build 1 */
+   EXPECT_EQ(disk_cache_get(cache, key_1, NULL), nullptr) << "entry of another driver id handed out";
+#endif
+   disk_cache_destroy(cache);
+
+   /* the gpu name and the driver flags are part of the key in the same way */
+   struct disk_cache *other_gpu = disk_cache_create("test2", "build-2", 0);
+   struct disk_cache *other_flags = disk_cache_create("test", "build-2", 1);
+   ASSERT_NE(other_gpu, nullptr);
+   ASSERT_NE(other_flags, nullptr);
+   cache_key k;
+   disk_cache_compute_key(other_gpu, shader, sizeof(shader), k);
+   EXPECT_NE(memcmp(k, key_2, sizeof(k)), 0);
+   EXPECT_EQ(disk_cache_get(other_gpu, k, NULL), nullptr);
+   disk_cache_compute_key(other_flags, shader, sizeof(shader), k);
+   EXPECT_NE(memcmp(k, key_2, sizeof(k)), 0);
+   EXPECT_EQ(disk_cache_get(other_flags, k, NULL), nullptr);
+   disk_cache_destroy(other_gpu);
+   disk_cache_destroy(other_flags);
+
+   /* back to build 2 (the same binary installed again): a hit */
+   cache = sb_cache_create("build-2");
+   ASSERT_NE(cache, nullptr);
+   disk_cache_compute_key(cache, shader, sizeof(shader), key_1_again);
+   EXPECT_EQ(memcmp(key_1_again, key_2, sizeof(key_2)), 0) << "key not stable for one driver id";
+   back = (char *)disk_cache_get(cache, key_2, &size);
+   EXPECT_NE(back, nullptr) << "no hit for the build that stored the entry";
+   if (back) {
+      EXPECT_STREQ(back, binary_2);
+   }
+   free(back);
+   disk_cache_destroy(cache);
+
+   sb_cache_cleanup();
+#endif
+}
