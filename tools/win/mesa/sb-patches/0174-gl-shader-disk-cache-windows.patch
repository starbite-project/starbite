+/* ------------------------------------------------------------------------
+ * sb-patches/0171: what the shader cache must do for a driver that is rebuilt
+ * often on a machine that is switched off without warning.  These run against
+ * the multi-file cache of either backend (disk_cache_os.c, or with
+ * -DSB_DISK_CACHE_PORTABLE_TEST the code Windows uses,
+ * disk_cache_os_portable.c).
+ * ------------------------------------------------------------------------ */
+
+#include <dirent.h>
+#include <string>
+#include <sys/stat.h>
+
+#include "util/u_atomic.h"
+
+#ifdef ENABLE_SHADER_CACHE
+
+static struct disk_cache *
+sb_cache_create(const char *driver_id)
+{
+#ifdef SHADER_CACHE_DISABLE_BY_DEFAULT
+   os_set_option("MESA_SHADER_CACHE_DISABLE", "false", true);
+#endif
+   os_set_option("MESA_DISK_CACHE_MULTI_FILE", "true", true);
+   os_set_option("MESA_SHADER_CACHE_DIR", CACHE_TEST_TMP "/sb", true);
+   os_unset_option("MESA_SHADER_CACHE_MAX_SIZE");
+   return disk_cache_create("test", driver_id, 0);
+}
+
+static void
+sb_cache_cleanup(void)
+{
+   os_unset_option("MESA_SHADER_CACHE_DIR");
+   os_set_option("MESA_DISK_CACHE_MULTI_FILE", "false", true);
+   rmrf_local(CACHE_TEST_TMP);
+}
+
+/* the file an entry is stored in (a std::string so nobody has to free) */
+static std::string
+sb_entry_path(struct disk_cache *cache, const cache_key key)
+{
+   char *f = disk_cache_get_cache_filename(cache, key);
+   std::string s(f ? f : "");
+   free(f);
+   return s;
+}
+
+static long
+sb_file_size(const std::string &path)
+{
+   struct stat sb;
+   return stat(path.c_str(), &sb) == 0 ? (long)sb.st_size : -1;
+}
+
+static void
+sb_put(struct disk_cache *cache, const cache_key key, const void *data,
+       size_t size)
+{
+   disk_cache_put(cache, key, data, size, NULL);
+   disk_cache_wait_for_idle(cache);
+}
+
+enum sb_damage {
+   SB_CUT_HALF,       /* the file ends in the middle */
+   SB_CUT_ONE,        /* the last byte is missing */
+   SB_EMPTY,          /* the name is there, no bytes */
+   SB_ZEROES,         /* the right length, all zero (data lost at power off) */
+   SB_FLIP_LAST,      /* one bit of the payload */
+   SB_FLIP_CRC,       /* one bit of the stored CRC */
+   SB_FLIP_LENGTH,    /* one bit of the stored length */
+   SB_FLIP_HEADER,    /* one bit of the driver keys at the start */
+   SB_ONE_MORE,       /* a byte after the end */
+   SB_DAMAGE_COUNT,
+};
+
+static const char *const sb_damage_name[] = {
+   "cut in half", "last byte missing", "empty", "all zeroes",
+   "payload bit flipped", "crc bit flipped", "length bit flipped",
+   "header bit flipped",
+   "one byte appended",
+};
+
+static void
+sb_damage_file(const std::string &path, enum sb_damage how, size_t payload)
+{
+   long len = sb_file_size(path);
+   ASSERT_GT(len, (long)payload);
+
+   switch (how) {
+   case SB_CUT_HALF:
+      ASSERT_EQ(truncate(path.c_str(), len / 2), 0);
+      return;
+   case SB_CUT_ONE:
+      ASSERT_EQ(truncate(path.c_str(), len - 1), 0);
+      return;
+   case SB_EMPTY:
+      ASSERT_EQ(truncate(path.c_str(), 0), 0);
+      return;
+   default:
+      break;
+   }
+
+   FILE *f = fopen(path.c_str(), "r+b");
+   ASSERT_NE(f, nullptr);
+   if (how == SB_ZEROES) {
+      for (long i = 0; i < len; i++)
+         fputc(0, f);
+   } else if (how == SB_ONE_MORE) {
+      fseek(f, 0, SEEK_END);
+      fputc(0x5a, f);
+   } else {
+      /* the entry ends with: crc32, uncompressed size, payload */
+      long at = how == SB_FLIP_LAST ? len - 1
+              : how == SB_FLIP_CRC ? len - (long)payload - 6
+              : how == SB_FLIP_LENGTH ? len - (long)payload - 3
+              : 3;
+      fseek(f, at, SEEK_SET);
+      int c = fgetc(f);
+      fseek(f, at, SEEK_SET);
+      fputc(c ^ 0x10, f);
+   }
+   fclose(f);
+}
+
+#endif /* ENABLE_SHADER_CACHE */
+
+/* An entry that is not what was written is not handed out, whatever
+ * happened to it. */
+TEST_F(Cache, SbDamagedEntryRejected)
+{
+#ifndef ENABLE_SHADER_CACHE
+   GTEST_SKIP() << "ENABLE_SHADER_CACHE not defined.";
+#else
+   /* text that does not compress to nothing: the payload offsets above
+    * assume the stored payload has the length of the data only when the
+    * cache stores entries as they are, so use the uncompressed driver id */
+   const char *driver_id = "make_check_uncompressed";
+   uint8_t data[3000];
+   for (unsigned i = 0; i < sizeof(data); i++)
+      data[i] = (uint8_t)(i * 7 + (i >> 5));
+
+   for (int how = 0; how < SB_DAMAGE_COUNT; how++) {
+#ifndef NDEBUG
+      /* a wrong header is an assert in builds with asserts */
+      if (how == SB_FLIP_HEADER || how == SB_ZEROES)
+         continue;
+#endif
+      rmrf_local(CACHE_TEST_TMP);
+      struct disk_cache *cache = sb_cache_create(driver_id);
+      ASSERT_NE(cache, nullptr);
+      ASSERT_EQ(cache->type, DISK_CACHE_MULTI_FILE);
+
+      cache_key key;
+      disk_cache_compute_key(cache, data, sizeof(data), key);
+      sb_put(cache, key, data, sizeof(data));
+
+      size_t size = 0;
+      void *back = disk_cache_get(cache, key, &size);
+      ASSERT_NE(back, nullptr) << "entry readable before the damage";
+      EXPECT_EQ(size, sizeof(data));
+      EXPECT_EQ(memcmp(back, data, sizeof(data)), 0);
+      free(back);
+
+      const std::string path = sb_entry_path(cache, key);
+      sb_damage_file(path, (enum sb_damage)how, sizeof(data));
+
+      /* a new process: nothing of the entry is kept in memory anyway, but
+       * this is what a restart of the game does */
+      disk_cache_destroy(cache);
+      cache = sb_cache_create(driver_id);
+      ASSERT_NE(cache, nullptr);
+
+      size = 123;
+      back = disk_cache_get(cache, key, &size);
+      EXPECT_EQ(back, nullptr) << "damaged entry handed out: " << sb_damage_name[how];
+      EXPECT_EQ(size, 0u) << sb_damage_name[how];
+      free(back);
+
+#if DISK_CACHE_OS_PORTABLE
+      /* the Windows backend removes it, so the next store brings it back */
+      EXPECT_EQ(sb_file_size(path), -1) << "damaged file still there: " << sb_damage_name[how];
+      sb_put(cache, key, data, sizeof(data));
+      back = disk_cache_get(cache, key, &size);
+      EXPECT_NE(back, nullptr) << "entry not stored again after: " << sb_damage_name[how];
+      if (back) {
+         EXPECT_EQ(size, sizeof(data));
+         EXPECT_EQ(memcmp(back, data, sizeof(data)), 0);
+      }
+      free(back);
+#endif
+
+      disk_cache_destroy(cache);
+   }
+
+   sb_cache_cleanup();
+#endif
+}
