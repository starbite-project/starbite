+static char *
+dc_default_root(void *mem_ctx)
+{
+   const char *xdg = os_get_option_secure("XDG_CACHE_HOME");
+   if (xdg)
+      return ralloc_strdup(mem_ctx, xdg);
+
+   const char *home = os_get_option("HOME");
+   return home ? ralloc_asprintf(mem_ctx, "%s/.cache", home) : NULL;
+}
+
+static bool
+dc_is_sep(char c)
+{
+   return c == '/';
+}
