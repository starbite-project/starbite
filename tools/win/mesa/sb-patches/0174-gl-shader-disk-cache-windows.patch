+/* The Windows backend counts the cache again at every start, so a size
+ * counter that lost its last updates (or is plain wrong) does not let the
+ * cache grow past its limit; and .tmp files of dead writers go away. */
+TEST_F(Cache, SbSizeCountedAgainAtStart)
+{
+#ifndef ENABLE_SHADER_CACHE
+   GTEST_SKIP() << "ENABLE_SHADER_CACHE not defined.";
+#elif !DISK_CACHE_OS_PORTABLE
+   GTEST_SKIP() << "only disk_cache_os_portable.c does this.";
+#else
+   rmrf_local(CACHE_TEST_TMP);
+
+   struct disk_cache *cache = sb_cache_create("build-1");
+   ASSERT_NE(cache, nullptr);
+   ASSERT_EQ(cache->type, DISK_CACHE_MULTI_FILE);
+
+   uint8_t data[5000];
+   std::string a_path;
+   uint64_t expected = 0;
+   for (unsigned i = 0; i < 40; i++) {
+      cache_key key;
+      size_t size = 100 + i * 120; /* 100 .. 4780 bytes of payload */
+      memset(data, i + 1, sizeof(data));
+      disk_cache_compute_key(cache, data, size, key);
+      sb_put(cache, key, data, size);
+      const std::string path = sb_entry_path(cache, key);
+      long len = sb_file_size(path);
+      ASSERT_GT(len, 0);
+      expected += ((uint64_t)len + 4095) & ~(uint64_t)4095;
+      if (i == 0)
+         a_path = path;
+   }
+   EXPECT_EQ(p_atomic_read(&cache->size->value), expected) << "running count";
+   disk_cache_destroy(cache);
+
+   /* a .tmp file from long ago and one from just now */
+   const std::string old_tmp = a_path + "-old.tmp", new_tmp = a_path + "-new.tmp";
+   for (const std::string &p : {old_tmp, new_tmp}) {
+      FILE *f = fopen(p.c_str(), "w");
+      ASSERT_NE(f, nullptr);
+      fputs("half an entry", f);
+      fclose(f);
+   }
+   struct utimbuf long_ago = {};
+   long_ago.actime = long_ago.modtime = time(NULL) - 3 * 60 * 60;
+   ASSERT_EQ(utime(old_tmp.c_str(), &long_ago), 0);
+
+   /* three wrong counters: lost updates, far too much (but possible on the
+    * volume), and not a number this code ever writes */
+   const uint64_t wrong[] = {0, expected * 3 + 512 * 1000, 12345};
+   for (uint64_t w : wrong) {
+      FILE *f = fopen(CACHE_TEST_TMP "/sb/" CACHE_DIR_NAME "/index", "r+b");
+      ASSERT_NE(f, nullptr);
+      ASSERT_EQ(fwrite(&w, sizeof(w), 1, f), 1u);
+      fclose(f);
+
+      cache = sb_cache_create("build-1");
+      ASSERT_NE(cache, nullptr);
+      disk_cache_wait_for_idle(cache);
+      EXPECT_EQ(p_atomic_read(&cache->size->value), expected) << "counter was " << w;
+      disk_cache_destroy(cache);
+   }
+
+   EXPECT_EQ(sb_file_size(old_tmp), -1) << "stale .tmp file kept";
+   EXPECT_GT(sb_file_size(new_tmp), 0) << "fresh .tmp file (a writer at work) removed";
+
+   sb_cache_cleanup();
+#endif
+}
+
+/* The size limit holds over many entries (the unit tests above evict one or
+ * two files). */
+TEST_F(Cache, SbLimitHolds)
+{
+#ifndef ENABLE_SHADER_CACHE
+   GTEST_SKIP() << "ENABLE_SHADER_CACHE not defined.";
+#else
+   rmrf_local(CACHE_TEST_TMP);
+
+   /* sets the directory and the cache type; the limit comes after it */
+   struct disk_cache *cache = sb_cache_create("build-1");
+   ASSERT_NE(cache, nullptr);
+   disk_cache_destroy(cache);
+   os_set_option("MESA_SHADER_CACHE_MAX_SIZE", "1M", true);
+   cache = disk_cache_create("test", "build-1", 0);
+   ASSERT_NE(cache, nullptr);
+   ASSERT_EQ(cache->type, DISK_CACHE_MULTI_FILE);
+
+   /* 600 entries of 6000 bytes: 2 disk blocks each, 4.7 MiB together */
+   static uint8_t data[6000];
+   cache_key last_key;
+   for (unsigned i = 0; i < 600; i++) {
+      memset(data, 0, sizeof(data));
+      memcpy(data, &i, sizeof(i));
+      disk_cache_compute_key(cache, data, sizeof(data), last_key);
+      disk_cache_put(cache, last_key, data, sizeof(data), NULL);
+   }
+   disk_cache_wait_for_idle(cache);
+
+   /* what is on disk, counted here and not by the cache */
+   uint64_t on_disk = 0;
+   unsigned files = 0;
+   for (unsigned d = 0; d < 256; d++) {
+      char dir[256];
+      snprintf(dir, sizeof(dir), CACHE_TEST_TMP "/sb/" CACHE_DIR_NAME "/%02x", d);
+      DIR *dp = opendir(dir);
+      if (!dp)
+         continue;
+      struct dirent *de;
+      while ((de = readdir(dp)) != NULL) {
+         struct stat sb;
+         std::string p = std::string(dir) + "/" + de->d_name;
+         if (stat(p.c_str(), &sb) == 0 && S_ISREG(sb.st_mode)) {
+            on_disk += ((uint64_t)sb.st_size + 4095) & ~(uint64_t)4095;
+            files++;
+         }
+      }
+      closedir(dp);
+   }
+
+   EXPECT_GT(files, 20u) << "everything was evicted";
+   /* the limit is checked with the payload size before a file is written,
+    * so the last file may stand a little over it */
+   const uint64_t limit = 1024 * 1024 + 64 * 1024;
+   EXPECT_LE(on_disk, limit) << files << " files on disk";
+   EXPECT_LE(p_atomic_read(&cache->size->value), limit);
+
+#if DISK_CACHE_OS_PORTABLE
+   /* one writer thread, and file times finer than a second: what was written
+    * last is not what gets evicted (disk_cache_os.c writes with four threads
+    * and orders by whole seconds, so it promises less) */
+   void *back = disk_cache_get(cache, last_key, NULL);
+   EXPECT_NE(back, nullptr) << "the entry stored last is gone";
+   free(back);
+#endif
+
+   disk_cache_destroy(cache);
+   os_unset_option("MESA_SHADER_CACHE_MAX_SIZE");
+   sb_cache_cleanup();
+#endif
+}
+
+/* ------------------------------------------------------------------------
+ * sb-patches/0171: the identity of a Windows driver build
+ * (disk_cache_pe_image_identifier).  It needs no cache, so no
+ * ENABLE_SHADER_CACHE here.
+ * ------------------------------------------------------------------------ */
+
+#include <vector>
+
+static void
+sb_put16(std::vector<uint8_t> &b, size_t at, uint16_t v)
+{
+   memcpy(&b[at], &v, sizeof(v));
+}
+
+static void
+sb_put32(std::vector<uint8_t> &b, size_t at, uint32_t v)
+{
+   memcpy(&b[at], &v, sizeof(v));
+}
+
+/* the offsets disk_cache_pe_image_identifier reads, written down a second
+ * time from the PE format: a PE32+ image with two sections */
+enum {
+   SB_PE_AT = 0x80,               /* e_lfanew */
+   SB_PE_FILE = SB_PE_AT + 4,     /* IMAGE_FILE_HEADER */
+   SB_PE_OPT = SB_PE_FILE + 20,   /* IMAGE_OPTIONAL_HEADER64, 240 bytes */
+   SB_PE_SEC = SB_PE_OPT + 240,   /* two IMAGE_SECTION_HEADER */
+   SB_PE_HEADERS = 0x400,
+};
+
+static std::vector<uint8_t>
+sb_pe_headers(void)
+{
+   std::vector<uint8_t> b(SB_PE_HEADERS, 0);
+   b[0] = 'M';
+   b[1] = 'Z';
+   sb_put32(b, 0x3c, SB_PE_AT);
+   memcpy(&b[SB_PE_AT], "PE\0\0", 4);
+   sb_put16(b, SB_PE_FILE + 0, 0xA641);      /* Machine: ARM64EC */
+   sb_put16(b, SB_PE_FILE + 2, 2);           /* NumberOfSections */
+   sb_put32(b, SB_PE_FILE + 4, 0x6AFB0303);  /* TimeDateStamp */
+   sb_put16(b, SB_PE_FILE + 16, 240);        /* SizeOfOptionalHeader */
+   sb_put16(b, SB_PE_OPT + 0, 0x20b);        /* Magic: PE32+ */
+   sb_put32(b, SB_PE_OPT + 4, 0x873200);     /* SizeOfCode */
+   sb_put32(b, SB_PE_OPT + 8, 0xA23800);     /* SizeOfInitializedData */
+   sb_put32(b, SB_PE_OPT + 16, 0x875000);    /* AddressOfEntryPoint */
+   sb_put32(b, SB_PE_OPT + 24, 0x80000000);  /* ImageBase, low half */
+   sb_put32(b, SB_PE_OPT + 28, 0x1);         /* ImageBase, high half */
+   sb_put32(b, SB_PE_OPT + 56, 0x12DB000);   /* SizeOfImage */
+   sb_put32(b, SB_PE_OPT + 64, 0);           /* CheckSum */
+   memcpy(&b[SB_PE_SEC], ".text", 5);
+   sb_put32(b, SB_PE_SEC + 8, 0x873036);     /* VirtualSize */
+   sb_put32(b, SB_PE_SEC + 12, 0x1000);      /* VirtualAddress */
+   sb_put32(b, SB_PE_SEC + 16, 0x873200);    /* SizeOfRawData */
+   sb_put32(b, SB_PE_SEC + 20, 0x400);       /* PointerToRawData */
+   memcpy(&b[SB_PE_SEC + 40], ".rdata", 6);
+   sb_put32(b, SB_PE_SEC + 40 + 8, 0x9E58A0);
+   sb_put32(b, SB_PE_SEC + 40 + 12, 0x875000);
+   sb_put32(b, SB_PE_SEC + 40 + 16, 0x9E5A00);
+   return b;
+}
+
+/* "" when the bytes are not taken for a PE image */
+static std::string
+sb_pe_id(const std::vector<uint8_t> &b, size_t size, uint32_t *stamp = nullptr)
+{
+   blake3_hasher ctx;
+   blake3_hash hash;
+   char hex[BLAKE3_HEX_LEN];
+
+   _mesa_blake3_init(&ctx);
+   if (!disk_cache_pe_image_identifier(b.data(), size, &ctx, stamp))
+      return "";
+   _mesa_blake3_final(&ctx, hash);
+   _mesa_blake3_format(hex, hash);
+   return hex;
+}
+
+static std::vector<uint8_t>
+sb_read_file(const char *path)
+{
+   std::vector<uint8_t> b;
+   FILE *f = fopen(path, "rb");
+   if (!f)
+      return b;
+   uint8_t chunk[65536];
+   size_t n;
+   while ((n = fread(chunk, 1, sizeof(chunk), f)) > 0)
+      b.insert(b.end(), chunk, chunk + n);
+   fclose(f);
+   return b;
+}
+
+TEST(SbPeIdentity, HeaderFields)
+{
+   const std::vector<uint8_t> base = sb_pe_headers();
+   uint32_t stamp = 0;
+   const std::string id = sb_pe_id(base, base.size(), &stamp);
+   ASSERT_NE(id, "");
+   EXPECT_EQ(stamp, 0x6AFB0303u);
+   EXPECT_EQ(sb_pe_id(base, base.size()), id) << "not the same twice";
+
+   /* what a new link changes, one field at a time: each gives a new id */
+   const struct { const char *what; size_t at; } changes[] = {
+      {"TimeDateStamp", SB_PE_FILE + 4},
+      {"SizeOfCode", SB_PE_OPT + 4},
+      {"SizeOfInitializedData", SB_PE_OPT + 8},
+      {"SizeOfImage", SB_PE_OPT + 56},
+      {"CheckSum", SB_PE_OPT + 64},
+      {".text VirtualSize", SB_PE_SEC + 8},
+      {".text SizeOfRawData", SB_PE_SEC + 16},
+      {".rdata name", SB_PE_SEC + 40 + 1},
+      {".rdata VirtualSize", SB_PE_SEC + 40 + 8},
+      {".rdata VirtualAddress", SB_PE_SEC + 40 + 12},
+   };
+   for (const auto &c : changes) {
+      std::vector<uint8_t> b = base;
+      b[c.at] ^= 1;
+      const std::string other = sb_pe_id(b, b.size());
+      EXPECT_NE(other, "") << c.what;
+      EXPECT_NE(other, id) << c.what << " changed, same id";
+   }
+
+   /* one second later, nothing else: a new id (two links of the same code) */
+   {
+      std::vector<uint8_t> b = base;
+      sb_put32(b, SB_PE_FILE + 4, 0x6AFB0304);
+      EXPECT_NE(sb_pe_id(b, b.size()), id);
+   }
+
+   /* a section more */
+   {
+      std::vector<uint8_t> b = base;
+      sb_put16(b, SB_PE_FILE + 2, 3);
+      memcpy(&b[SB_PE_SEC + 80], ".data", 5);
+      EXPECT_NE(sb_pe_id(b, b.size()), "");
+      EXPECT_NE(sb_pe_id(b, b.size()), id);
+   }
+
+   /* what the loader rewrites in a mapped image must not matter: the base
+    * address (ASLR), and for ARM64X images the machine and the entry point */
+   const struct { const char *what; size_t at; } same[] = {
+      {"ImageBase low", SB_PE_OPT + 24},
+      {"ImageBase high", SB_PE_OPT + 28},
+      {"Machine", SB_PE_FILE + 0},
+      {"AddressOfEntryPoint", SB_PE_OPT + 16},
+   };
+   for (const auto &c : same) {
+      std::vector<uint8_t> b = base;
+      b[c.at] ^= 0x40;
+      EXPECT_EQ(sb_pe_id(b, b.size()), id) << c.what << " changed the id";
+   }
+}
+
+TEST(SbPeIdentity, NotAnImage)
+{
+   const std::vector<uint8_t> base = sb_pe_headers();
+   ASSERT_NE(sb_pe_id(base, base.size()), "");
+
+   /* cut anywhere before the end of the section table: refused, and nothing
+    * is read past `size` (the copies are exactly that long: ASan/valgrind
+    * would see a read behind them) */
+   for (size_t size = 0; size < SB_PE_SEC + 80; size++) {
+      std::vector<uint8_t> cut(base.begin(), base.begin() + size);
+      EXPECT_EQ(sb_pe_id(cut, cut.size()), "") << "accepted with " << size << " bytes";
+   }
+   {
+      std::vector<uint8_t> whole(base.begin(), base.begin() + SB_PE_SEC + 80);
+      EXPECT_NE(sb_pe_id(whole, whole.size()), "");
+   }
+
+   std::vector<uint8_t> b = base;
+   b[0] = 'N';
+   EXPECT_EQ(sb_pe_id(b, b.size()), "") << "no MZ";
+
+   b = base;
+   b[SB_PE_AT] = 'N';
+   EXPECT_EQ(sb_pe_id(b, b.size()), "") << "no PE signature";
+
+   b = base;
+   sb_put32(b, 0x3c, 0xfffffff0u);
+   EXPECT_EQ(sb_pe_id(b, b.size()), "") << "e_lfanew outside";
+
+   b = base;
+   sb_put16(b, SB_PE_FILE + 2, 0);
+   EXPECT_EQ(sb_pe_id(b, b.size()), "") << "no sections";
+
+   b = base;
+   sb_put16(b, SB_PE_FILE + 2, 0xffff);
+   EXPECT_EQ(sb_pe_id(b, b.size()), "") << "section table outside";
+
+   b = base;
+   sb_put16(b, SB_PE_FILE + 16, 8);
+   EXPECT_EQ(sb_pe_id(b, b.size()), "") << "optional header too small";
+
+   std::vector<uint8_t> zeroes(4096, 0);
+   EXPECT_EQ(sb_pe_id(zeroes, zeroes.size()), "");
+}
+
+/* Real driver builds: SB_TEST_PE_FILES is a ':' separated list of DLLs that
+ * are different builds; SB_TEST_PE_STAMPS (optional) their link time stamps
+ * in hex as llvm-readobj prints them, in the same order.  SB_TEST_PE_SAME
+ * (optional) is a list of files that are one build and must have one
+ * identity: an ARM64X DLL and the view of it that an x64 process gets (the
+ * loader rewrites the machine, the entry point and some directories). */
+TEST(SbPeIdentity, RealBuildsDiffer)
+{
+   const char *list = getenv("SB_TEST_PE_FILES");
+   if (!list)
+      GTEST_SKIP() << "SB_TEST_PE_FILES not set.";
+
+   std::vector<std::string> files, stamps, ids;
+   for (std::string rest = list; !rest.empty();) {
+      size_t colon = rest.find(':');
+      files.push_back(rest.substr(0, colon));
+      rest = colon == std::string::npos ? "" : rest.substr(colon + 1);
+   }
+   if (const char *s = getenv("SB_TEST_PE_STAMPS")) {
+      for (std::string rest = s; !rest.empty();) {
+         size_t colon = rest.find(':');
+         stamps.push_back(rest.substr(0, colon));
+         rest = colon == std::string::npos ? "" : rest.substr(colon + 1);
+      }
+   }
+   ASSERT_GE(files.size(), 2u);
+
+   for (size_t i = 0; i < files.size(); i++) {
+      const std::vector<uint8_t> b = sb_read_file(files[i].c_str());
+      ASSERT_GT(b.size(), 4096u) << files[i];
+
+      uint32_t stamp = 0;
+      const std::string id = sb_pe_id(b, b.size(), &stamp);
+      ASSERT_NE(id, "") << files[i];
+      printf("            %s  stamp 0x%08X  %s\n", id.c_str(), stamp, files[i].c_str());
+
+      /* the headers alone (what is mapped at the module handle) give the
+       * same id as the whole file */
+      EXPECT_EQ(sb_pe_id(b, 4096), id) << files[i];
+
+      /* the same bytes at another base address (what ASLR does in memory) */
+      std::vector<uint8_t> moved(b.begin(), b.begin() + 4096);
+      uint32_t pe_at;
+      memcpy(&pe_at, &moved[0x3c], 4);
+      moved[pe_at + 24 + 24 + 2] ^= 0x7f;
+      EXPECT_EQ(sb_pe_id(moved, moved.size()), id) << files[i];
+
+      if (i < stamps.size()) {
+         EXPECT_EQ(stamp, (uint32_t)strtoul(stamps[i].c_str(), NULL, 16)) << files[i];
+      }
+
+      for (size_t j = 0; j < ids.size(); j++)
+         EXPECT_NE(ids[j], id) << files[j] << " and " << files[i] << " have one identity";
+      ids.push_back(id);
+   }
+
+   if (const char *s = getenv("SB_TEST_PE_SAME")) {
+      std::string first;
+      for (std::string rest = s; !rest.empty();) {
+         size_t colon = rest.find(':');
+         const std::string file = rest.substr(0, colon);
+         rest = colon == std::string::npos ? "" : rest.substr(colon + 1);
+
+         const std::vector<uint8_t> b = sb_read_file(file.c_str());
+         const std::string id = sb_pe_id(b, b.size());
+         ASSERT_NE(id, "") << file;
+         printf("       same %s  %s\n", id.c_str(), file.c_str());
+         if (first.empty())
+            first = id;
+         EXPECT_EQ(id, first) << file << " is the same build, another identity";
+      }
+   }
+}
