 #include "util/os_time.h"
 #include "drm-uapi/drm.h"
@@ -129,6 +130,30 @@ static void fake_ioctl(DWORD code, void *buf, DWORD len);
  * and said nothing anywhere). With umdlog\trace also present, the full driver-call trace (MALIKM_TRACE). */
 static int sb_log_active, sb_log_trace;
 
+/* A Mesa abort() (no recovery point exists for it) ends the process; before that, the stack as offsets in
+ * this DLL, so the call that aborted can be found with the build's map/PDB. */
+static void
+sb_on_abort(int sig)
+{
+   void *frames[48];
+   HMODULE self = NULL;
+   USHORT n = RtlCaptureStackBackTrace(0, 48, frames, NULL);
+   (void)sig;
+   GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                      (LPCSTR)(void *)sb_on_abort, &self);
+   fprintf(stderr, "sbumd: abort(), stack (+offset in this DLL, else absolute):\n");
+   for (USHORT i = 0; i < n; i++) {
+      HMODULE m = NULL;
+      GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                         (LPCSTR)frames[i], &m);
+      if (m && m == self)
+         fprintf(stderr, "  #%u sbumd+0x%llx\n", i, (unsigned long long)((char *)frames[i] - (char *)self));
+      else
+         fprintf(stderr, "  #%u %p\n", i, frames[i]);
+   }
+   fflush(stderr);
+}
+
 static void
 sb_log_open(void)
 {
@@ -153,6 +178,7 @@ sb_log_open(void)
       return;
    setvbuf(stderr, NULL, _IONBF, 0);
    sb_log_active = 1;
+   signal(SIGABRT, sb_on_abort);
    sb_log_trace = GetFileAttributesA("C:\\ProgramData\\Starbite\\umdlog\\trace") != INVALID_FILE_ATTRIBUTES;
