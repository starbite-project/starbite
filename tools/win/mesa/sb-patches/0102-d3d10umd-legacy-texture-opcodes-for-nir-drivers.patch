@@ -151,6 +151,19 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
    pDevice->pipe = pipe;
    pDevice->cso = cso_create_context(pipe, CSO_NO_VBUF);
 
+   /* Starbite (sbumd, docs/WIN11-GPU.md 6.10): a driver that takes NIR only (Panfrost) gets every shader
+    * through tgsi_to_nir, which implements none of the D3D10 texture opcodes this frontend emits
+    * (SAMPLE, SAMPLE_B/C/C_LZ/D/I/L, SVIEWINFO): "unknown TGSI opcode" and abort(), so DWM and LogonUI
+    * crash-looped at their first textured shader (T13b). The frontend's legacy path (TEX/TXB/TXL/TXD/TXF/TXQ,
+    * which tgsi_to_nir handles) is used for such drivers. Known limits, logged: a texture is read through
+    * its sampler's index, and SAMPLE_C's compare is not applied. A TGSI driver (softpipe) keeps the
+    * D3D10 opcodes. Before the empty shaders below, so every shader of the device takes the same path. */
+   if (!(screen->shader_caps[MESA_SHADER_FRAGMENT].supported_irs & (1 << PIPE_SHADER_IR_TGSI))) {
+      if (!(st_debug & ST_DEBUG_OLD_TEX_OPS))
+         DebugPrintf("d3d10umd: NIR-only driver, legacy texture opcodes\n");
+      st_debug |= ST_DEBUG_OLD_TEX_OPS;
+   }
+
    pDevice->empty_vs = CreateEmptyShader(pDevice, MESA_SHADER_VERTEX);
    pDevice->empty_fs = CreateEmptyShader(pDevice, MESA_SHADER_FRAGMENT);
 
