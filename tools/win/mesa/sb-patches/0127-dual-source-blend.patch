diff --git a/src/gallium/frontends/d3d10umd/Shader.cpp b/src/gallium/frontends/d3d10umd/Shader.cpp
index bf7ab58..41a86ba 100644
--- a/src/gallium/frontends/d3d10umd/Shader.cpp
+++ b/src/gallium/frontends/d3d10umd/Shader.cpp
@@ -47,6 +47,9 @@
 #include "Format.h"
 
 #include "tgsi/tgsi_ureg.h"
+#include "tgsi/tgsi_scan.h"
+#include "compiler/nir/nir.h"
+#include "nir/tgsi_to_nir.h"
 #include "util/u_gen_mipmap.h"
 #include "util/u_sampler.h"
 #include "util/format/u_format.h"
@@ -303,6 +306,14 @@ DestroyShader(D3D10DDI_HDEVICE hDevice,   // IN
 
    struct pipe_context *pipe = CastPipeContext(hDevice);
    Shader *pShader = CastShader(hShader);
+   Device *pDevice = CastDevice(hDevice);
+
+   if (pDevice->sb_ps == pShader)
+      pDevice->sb_ps = NULL;
+   if (pShader->dual_handle) {
+      pipe->delete_fs_state(pipe, pShader->dual_handle);
+      pShader->dual_handle = NULL;
+   }
 
    if (pShader->handle) {
       switch (pShader->type) {
@@ -1011,6 +1022,76 @@ CreatePixelShader(D3D10DDI_HDEVICE hDevice,                                // IN
 
    pShader->handle = pipe->create_fs_state(pipe, &pShader->state);
 
+   /* sb-patches/0127: does it write o1 (a possible dual-source blend input)? */
+   pShader->writes_o1 = false;
+   pShader->dual_tried = false;
+   pShader->dual_handle = NULL;
+   if (pShader->state.tokens) {
+      struct tgsi_shader_info info;
+      tgsi_scan_shader(pShader->state.tokens, &info);
+      for (unsigned i = 0; i < info.num_outputs; i++)
+         if (info.output_semantic_name[i] == TGSI_SEMANTIC_COLOR && info.output_semantic_index[i] == 1)
+            pShader->writes_o1 = true;
+   }
+}
+
+
+/*
+ * sb-patches/0127: the dual-source variant. The same TGSI through tgsi_to_nir, then o1 (FRAG_RESULT_DATA1) becomes
+ * FRAG_RESULT_DATA0 with index 1, which is how NIR and Panfrost spell the second blend source (blend2_pan).
+ */
+static unsigned sb_dual_variants;
+
+static void *
+SbCreateDualFs(Device *pDevice, Shader *pShader)
+{
+   nir_shader *nir = tgsi_to_nir(pShader->state.tokens, pDevice->screen, false);
+   if (!nir)
+      return NULL;
+   bool found = false;
+   nir_foreach_shader_out_variable(var, nir) {
+      if (var->data.location == FRAG_RESULT_DATA1) {
+         var->data.location = FRAG_RESULT_DATA0;
+         var->data.index = 1;
+         found = true;
+      }
+   }
+   if (!found) {
+      ralloc_free(nir);
+      return NULL;
+   }
+   nir_shader_gather_info(nir, nir_shader_get_entrypoint(nir));
+
+   struct pipe_shader_state state;
+   memset(&state, 0, sizeof state);
+   state.type = PIPE_SHADER_IR_NIR;
+   state.ir.nir = nir;
+   return pDevice->pipe->create_fs_state(pDevice->pipe, &state);
+}
+
+
+void
+SbBindFs(Device *pDevice)
+{
+   Shader *pShader = pDevice->sb_ps;
+   void *state = pShader ? pShader->handle : NULL;
+
+   if (pShader && pShader->writes_o1 && pDevice->sb_blend_dual) {
+      if (!pShader->dual_tried) {
+         pShader->dual_tried = true;
+         pShader->dual_handle = SbCreateDualFs(pDevice, pShader);
+         unsigned n = ++sb_dual_variants;
+         if (n <= 16 || !(n & (n - 1)))
+            DebugPrintf("sbumd: dual-source pixel shader variant #%u %s\n", n,
+                        pShader->dual_handle ? "created" : "FAILED (o1 stays a second render target)");
+      }
+      if (pShader->dual_handle)
+         state = pShader->dual_handle;
+   }
+
+   if (!state)
+      state = pDevice->empty_fs;
+   pDevice->pipe->bind_fs_state(pDevice->pipe, state);
 }
 
 
@@ -1032,14 +1113,10 @@ PsSetShader(D3D10DDI_HDEVICE hDevice,  // IN
    LOG_ENTRYPOINT();
 
    Device *pDevice = CastDevice(hDevice);
-   struct pipe_context *pipe = pDevice->pipe;
-   void *state = CastPipeShader(hShader);
-
-   if (!state) {
-      state = pDevice->empty_fs;
-   }
 
-   pipe->bind_fs_state(pipe, state);
+   /* sb-patches/0127: SbBindFs picks the dual-source variant when the blend state needs it */
+   pDevice->sb_ps = CastShader(hShader);
+   SbBindFs(pDevice);
 }
 
 
