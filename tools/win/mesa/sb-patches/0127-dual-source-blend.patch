+/* sb-patches/0127: does RT0 blend with the second source (o1)? Logged for the first blend states of a process. */
+static unsigned sb_dual_blends;
+
+static bool
+sb_is_src1(unsigned f)
+{
+   return f == PIPE_BLENDFACTOR_SRC1_COLOR || f == PIPE_BLENDFACTOR_SRC1_ALPHA ||
+          f == PIPE_BLENDFACTOR_INV_SRC1_COLOR || f == PIPE_BLENDFACTOR_INV_SRC1_ALPHA;
+}
+
+static bool
+sb_blend_dual(const struct pipe_blend_state *s)
+{
+   const struct pipe_rt_blend_state *r = &s->rt[0];
+   bool dual = r->blend_enable && (sb_is_src1(r->rgb_src_factor) || sb_is_src1(r->rgb_dst_factor) ||
+                                   sb_is_src1(r->alpha_src_factor) || sb_is_src1(r->alpha_dst_factor));
+   if (dual) {
+      unsigned n = ++sb_dual_blends;
+      if (n <= 8 || !(n & (n - 1)))
+         DebugPrintf("sbumd: blend state #%u uses SRC1 (dual-source): rgb %u/%u alpha %u/%u mask 0x%x\n", n,
+                     r->rgb_src_factor, r->rgb_dst_factor, r->alpha_src_factor, r->alpha_dst_factor, r->colormask);
+   }
+   return dual;
+}
+
+
